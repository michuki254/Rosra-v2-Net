@model RosraApp.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

@functions {
    public string GetCountryCode(string country)
    {
        if (string.IsNullOrEmpty(country)) return "";

        var countryCodes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            // Africa
            { "Kenya", "ke" },
            { "Nigeria", "ng" },
            { "South Africa", "za" },
            { "Egypt", "eg" },
            { "Ethiopia", "et" },
            { "Ghana", "gh" },
            { "Tanzania", "tz" },
            { "Uganda", "ug" },
            { "Rwanda", "rw" },
            { "Morocco", "ma" },
            { "Algeria", "dz" },
            { "Senegal", "sn" },
            { "Cameroon", "cm" },
            { "Zambia", "zm" },
            { "Zimbabwe", "zw" },
            { "Botswana", "bw" },
            { "Namibia", "na" },
            { "Mozambique", "mz" },
            { "Mali", "ml" },
            { "Burkina Faso", "bf" },
            { "Ivory Coast", "ci" },
            { "Cote d'Ivoire", "ci" },
            { "Malawi", "mw" },
            { "Benin", "bj" },
            { "Togo", "tg" },
            { "Niger", "ne" },
            { "Sierra Leone", "sl" },
            { "Liberia", "lr" },

            // Europe
            { "United Kingdom", "gb" },
            { "UK", "gb" },
            { "Britain", "gb" },
            { "France", "fr" },
            { "Germany", "de" },
            { "Italy", "it" },
            { "Spain", "es" },
            { "Netherlands", "nl" },
            { "Belgium", "be" },
            { "Switzerland", "ch" },
            { "Sweden", "se" },
            { "Norway", "no" },
            { "Portugal", "pt" },
            { "Poland", "pl" },
            { "Denmark", "dk" },
            { "Finland", "fi" },
            { "Austria", "at" },
            { "Ireland", "ie" },
            { "Greece", "gr" },
            { "Czech Republic", "cz" },
            { "Romania", "ro" },
            { "Hungary", "hu" },

            // Americas
            { "United States", "us" },
            { "United States of America", "us" },
            { "USA", "us" },
            { "Canada", "ca" },
            { "Mexico", "mx" },
            { "Brazil", "br" },
            { "Argentina", "ar" },
            { "Chile", "cl" },
            { "Colombia", "co" },
            { "Peru", "pe" },
            { "Venezuela", "ve" },
            { "Ecuador", "ec" },
            { "Bolivia", "bo" },
            { "Paraguay", "py" },
            { "Uruguay", "uy" },
            { "Costa Rica", "cr" },
            { "Panama", "pa" },
            { "Guatemala", "gt" },
            { "Honduras", "hn" },
            { "El Salvador", "sv" },
            { "Nicaragua", "ni" },
            { "Jamaica", "jm" },
            { "Trinidad and Tobago", "tt" },

            // Asia
            { "China", "cn" },
            { "India", "in" },
            { "Japan", "jp" },
            { "Singapore", "sg" },
            { "South Korea", "kr" },
            { "Korea", "kr" },
            { "Thailand", "th" },
            { "Indonesia", "id" },
            { "Malaysia", "my" },
            { "Philippines", "ph" },
            { "Vietnam", "vn" },
            { "Pakistan", "pk" },
            { "Bangladesh", "bd" },
            { "Sri Lanka", "lk" },
            { "Nepal", "np" },
            { "Myanmar", "mm" },
            { "Cambodia", "kh" },
            { "Taiwan", "tw" },
            { "Hong Kong", "hk" },

            // Middle East
            { "UAE", "ae" },
            { "United Arab Emirates", "ae" },
            { "Saudi Arabia", "sa" },
            { "Israel", "il" },
            { "Turkey", "tr" },
            { "Iran", "ir" },
            { "Iraq", "iq" },
            { "Jordan", "jo" },
            { "Lebanon", "lb" },
            { "Kuwait", "kw" },
            { "Qatar", "qa" },
            { "Oman", "om" },
            { "Bahrain", "bh" },

            // Oceania
            { "Australia", "au" },
            { "New Zealand", "nz" },
            { "Fiji", "fj" },
            { "Papua New Guinea", "pg" },

            // Other
            { "Russia", "ru" },
            { "Ukraine", "ua" },
            { "Kazakhstan", "kz" },
            { "Uzbekistan", "uz" }
        };

        return countryCodes.TryGetValue(country, out var code) ? code : "";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/lib/flag-icons/css/flag-icons.min.css" asp-append-version="true" />
    <style>
        :root {
            --brand: #00689D; --brand-dark: #004d73; --brand-soft: rgba(0,104,157,0.08);
            --ink-1: #0f172a; --ink-2: #475569; --ink-3: #94a3b8;
            --line: #e5e7eb; --line-soft: #f1f5f9;
            --surface: #fff; --surface-2: #f8fafc;
            --shadow-sm: 0 1px 2px rgba(15,23,42,0.05), 0 2px 8px rgba(15,23,42,0.05), 0 8px 24px rgba(15,23,42,0.04);
            --shadow-md: 0 2px 4px rgba(15,23,42,0.06), 0 6px 16px rgba(15,23,42,0.08), 0 16px 40px rgba(15,23,42,0.06);
            --radius: 12px; --radius-sm: 8px;
        }
        body { background: #fff; }
        .container.py-4 { padding-top: 1.5rem !important; padding-bottom: 1.5rem !important; }

        /* ── Page header ── */
        .dashboard-header {
            background: var(--surface); border: 1px solid var(--line-soft);
            border-radius: var(--radius); padding: 1.1rem 1.4rem;
            margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);
        }
        .dashboard-header h1 {
            color: var(--ink-1); font-weight: 600; font-size: 1.2rem;
            margin: 0 0 0.15rem; letter-spacing: -0.01em;
        }
        .dashboard-header p { color: var(--ink-2); font-size: 0.85rem; margin: 0; }

        .btn-refresh {
            background: var(--surface); border: 1px solid var(--line); color: var(--ink-1);
            border-radius: var(--radius-sm); font-weight: 500; font-size: 0.82rem;
            padding: 0.5rem 0.95rem; transition: background 0.15s, border-color 0.15s;
        }
        .btn-refresh:hover { background: var(--surface-2); border-color: #cbd5e1; color: var(--ink-1); }

        .btn-create-report {
            background: var(--brand); color: #fff; border: none;
            border-radius: var(--radius-sm); font-weight: 600; font-size: 0.82rem;
            padding: 0.5rem 1.1rem; transition: background 0.15s, transform 0.15s;
            display: inline-flex; align-items: center;
        }
        .btn-create-report:hover { background: var(--brand-dark); color: #fff; transform: translateY(-1px); }

        /* ── Tabs (pill nav) ── */
        .nav-pills .nav-link {
            color: var(--ink-2); font-size: 0.82rem; font-weight: 500;
            padding: 0.45rem 0.95rem; border-radius: 999px;
            transition: background 0.15s, color 0.15s;
        }
        .nav-pills .nav-link.active { background: var(--brand); color: #fff; }

        /* Search pill */
        .form-control.form-control-sm {
            background: var(--surface-2); border: 1px solid transparent;
            border-radius: 999px; padding: 0.4rem 0.95rem; font-size: 0.82rem;
            transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
        }
        .form-control.form-control-sm:focus {
            background: var(--surface); border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-soft); outline: none;
        }
        .btn-outline-secondary, .btn-outline-danger {
            border-radius: 999px; padding: 0.35rem 0.7rem; font-size: 0.78rem;
        }

        /* ── Report cards ── */
        .report-card .card {
            border: 1px solid var(--line-soft); border-radius: var(--radius);
            background: var(--surface); box-shadow: var(--shadow-sm);
            transition: box-shadow 0.25s ease, transform 0.2s ease;
        }
        .report-card .card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }

        .card-header-row {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 0.95rem; padding-bottom: 0.7rem;
            border-bottom: 1px solid var(--line-soft);
        }
        .last-updated {
            color: var(--ink-3); font-size: 0.74rem; font-weight: 500;
            display: flex; align-items: center; gap: 0.4rem;
        }
        .header-actions { display: flex; align-items: center; gap: 0.4rem; }

        .status-badge {
            border-radius: 999px; padding: 0.22rem 0.6rem;
            font-size: 0.7rem; font-weight: 600;
            display: inline-flex; align-items: center; gap: 0.35rem;
            line-height: 1.2;
        }
        .status-badge i { font-size: 0.4rem; }

        .icon-btn {
            background: transparent; border: 1px solid var(--line);
            color: var(--ink-2); padding: 0.3rem 0.45rem;
            border-radius: 8px; font-size: 0.78rem; cursor: pointer;
            transition: border-color 0.15s, color 0.15s, background 0.15s;
        }
        .icon-btn:hover { color: var(--ink-1); border-color: #cbd5e1; background: var(--surface-2); }
        .delete-btn:hover { color: #ef4444; border-color: #fecaca; background: #fef2f2; }
        .submit-btn { color: var(--brand) !important; }
        .submit-btn:hover { color: var(--brand-dark) !important; border-color: rgba(0,104,157,0.25); background: var(--brand-soft); }

        .report-title {
            color: var(--ink-1); font-weight: 600;
            font-size: 0.98rem; margin-bottom: 0.85rem;
            letter-spacing: -0.005em;
        }

        .report-details { display: flex; align-items: start; margin-bottom: 0.5rem; }
        .flag-icon {
            width: 40px; display: flex; align-items: center; justify-content: center;
            margin-right: 0.85rem; flex-shrink: 0;
        }
        .country-flag {
            font-size: 2rem; line-height: 1;
            border-radius: 4px;
            box-shadow: 0 1px 3px rgba(15,23,42,0.15);
        }
        .country-flag.fi { width: 40px; height: 30px; background-size: cover; background-position: center; }
        .default-globe { font-size: 2rem; line-height: 1; color: var(--ink-3); }

        .detail-row { margin-bottom: 0.35rem; }
        .detail-row:last-child { margin-bottom: 0; }
        .detail-label {
            color: var(--brand); font-size: 0.7rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.04em;
        }
        .detail-value { color: var(--ink-1); font-size: 0.8rem; }

        .btn-open {
            background: var(--brand); border: none; color: #fff;
            font-weight: 600; padding: 0.55rem; border-radius: 8px;
            font-size: 0.82rem; letter-spacing: 0.02em;
            transition: background 0.15s, transform 0.15s;
        }
        .btn-open:hover { background: var(--brand-dark); color: #fff; transform: translateY(-1px); }

        .card-footer { background: transparent !important; padding: 0.85rem 1rem 1rem !important; border-top: none !important; }

        /* ── Empty state ── */
        .no-reports-card {
            background: var(--surface); border: 1px solid var(--line-soft);
            border-radius: var(--radius); padding: 3rem 1.5rem; text-align: center;
            box-shadow: var(--shadow-sm);
        }
        .no-reports-card i {
            font-size: 2.5rem; color: var(--ink-3); margin-bottom: 1rem;
        }
        .no-reports-card h5 {
            color: var(--ink-1); font-weight: 600; font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        /* Revision-requested alert */
        .alert-warning {
            background: #fffbeb !important; border: 1px solid #fcd34d !important;
            color: #92400e !important; border-radius: var(--radius-sm) !important;
            font-size: 0.78rem !important;
        }

        /* Feedback toggle / panel */
        .view-feedback-btn { color: var(--brand) !important; }
        .view-feedback-btn:hover { color: var(--brand-dark) !important; }

        /* Pagination */
        .pagination .page-link {
            border: 1px solid transparent; border-radius: 8px;
            color: var(--ink-2); font-weight: 500; font-size: 0.82rem;
            padding: 0.4rem 0.75rem; margin: 0 0.1rem;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }
        .pagination .page-link:hover { background: var(--surface-2); color: var(--ink-1); border-color: var(--line); }
        .pagination .page-item.active .page-link {
            background: var(--brand); border-color: var(--brand); color: #fff;
        }

        /* Modal modern */
        .modal-content.modal-modern {
            border: 1px solid var(--line) !important; border-radius: var(--radius) !important;
            box-shadow: 0 20px 60px -16px rgba(15,23,42,0.18) !important; overflow: hidden;
        }
        .modal-modern .modal-header {
            border-bottom: 1px solid var(--line-soft); padding: 1rem 1.25rem;
            display: flex; align-items: center; gap: 0.7rem;
        }
        .modal-modern .modal-title { font-size: 0.95rem; font-weight: 600; color: var(--ink-1); margin: 0; }
        .modal-modern .modal-icon {
            width: 32px; height: 32px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 0.9rem; flex-shrink: 0;
            background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
        }
        .modal-modern .modal-body { padding: 1.25rem; color: var(--ink-2); font-size: 0.85rem; }
        .modal-modern .modal-footer {
            border-top: 1px solid var(--line-soft); background: var(--surface-2);
            padding: 0.75rem 1.25rem;
        }
        .btn-modal-secondary {
            background: var(--surface); color: var(--ink-1); border: 1px solid var(--line);
            border-radius: 8px; font-weight: 500; font-size: 0.82rem; padding: 0.42rem 0.95rem;
        }
        .btn-modal-secondary:hover { background: var(--surface-2); border-color: #cbd5e1; }
        .btn-modal-danger {
            background: #ef4444; color: #fff; border: none;
            border-radius: 8px; font-weight: 600; font-size: 0.82rem; padding: 0.42rem 0.95rem;
        }
        .btn-modal-danger:hover { background: #dc2626; color: #fff; }
    </style>
}

<div class="container py-4">
    <!-- Header section -->
    <div class="dashboard-header d-flex justify-content-between align-items-center">
        <div>
            <h1>@Localizer["YourSavedReports"]</h1>
            <p>@Localizer["ViewManageReports"]</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-refresh d-flex align-items-center" id="refreshBtn">
                <i class="bi bi-arrow-clockwise me-2"></i> @Localizer["Refresh"]
            </button>
            <a asp-controller="Rosra" asp-action="NewReport" class="btn btn-create-report">
                <i class="bi bi-plus-circle me-2"></i> @Localizer["CreateNewReport"]
            </a>
        </div>
    </div>

    <!-- Search and Tabs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <ul class="nav nav-pills" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(Model.CurrentTab == "active" ? "active" : "")"
                       asp-action="Index" asp-route-tab="active" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-file-earmark-text me-1"></i> Active
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.CurrentTab == "archived" ? "active" : "")"
                       asp-action="Index" asp-route-tab="archived" asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-archive me-1"></i> Archived
                    </a>
                </li>
            </ul>
        </div>
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 350px;">
            <input type="hidden" name="tab" value="@Model.CurrentTab" />
            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search reports..."
                   value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" asp-route-tab="@Model.CurrentTab" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-x"></i>
                </a>
            }
        </form>
    </div>

    <!-- Reports grid -->
    <div class="row g-4" id="reports-container">
        @if (Model.Reports.Any())
        {
            @foreach (var report in Model.Reports)
            {
                <div class="col-lg-4 col-md-6 report-card" data-report-id="@report.Id">
                    <div class="card h-100" style="position:relative;">
                        @if (report.HasNewActivity)
                        {
                            <span style="position:absolute; top:10px; right:10px; width:10px; height:10px; border-radius:50%; background:#3B82F6; box-shadow:0 0 0 3px rgba(59,130,246,0.2); z-index:1;" title="New activity"></span>
                        }
                        <div class="card-body">
                            <!-- Card header row -->
                            <div class="card-header-row">
                                <div class="last-updated">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    @{
                                        var localTime = (report.UpdatedAt ?? report.CreatedAt).ToLocalTime();
                                        var timeDiff = DateTime.Now - localTime;
                                        string timeDisplay;

                                        if (timeDiff.TotalMinutes < 1)
                                        {
                                            timeDisplay = "just now";
                                        }
                                        else if (timeDiff.TotalHours < 1)
                                        {
                                            var mins = (int)timeDiff.TotalMinutes;
                                            timeDisplay = mins + " minute" + (mins > 1 ? "s" : "") + " ago";
                                        }
                                        else if (timeDiff.TotalHours < 24 && localTime.Date == DateTime.Now.Date)
                                        {
                                            // Same day - show "today at HH:mm"
                                            timeDisplay = "today at " + localTime.ToString("HH:mm");
                                        }
                                        else if (timeDiff.TotalHours < 48 && localTime.Date == DateTime.Now.AddDays(-1).Date)
                                        {
                                            // Yesterday
                                            timeDisplay = "yesterday at " + localTime.ToString("HH:mm");
                                        }
                                        else if (timeDiff.TotalDays < 7)
                                        {
                                            // Within a week - show day name and time
                                            timeDisplay = localTime.ToString("dddd") + " at " + localTime.ToString("HH:mm");
                                        }
                                        else
                                        {
                                            // Older - show full date and time
                                            timeDisplay = localTime.ToString("dd MMM yyyy") + " at " + localTime.ToString("HH:mm");
                                        }
                                    }
                                    <span>Last updated @timeDisplay</span>
                                </div>
                                <div class="header-actions">
                                    @{
                                        var reportStatus = (RosraApp.Models.Enums.ReportStatus)report.Status;
                                        var statusBadgeClass = reportStatus switch {
                                            RosraApp.Models.Enums.ReportStatus.Draft => "background: #e2e3e5; color: #383d41;",
                                            RosraApp.Models.Enums.ReportStatus.Submitted => "background: #fff3cd; color: #856404;",
                                            RosraApp.Models.Enums.ReportStatus.UnderReview => "background: #cce5ff; color: #004085;",
                                            RosraApp.Models.Enums.ReportStatus.NeedsRevision => "background: #f8d7da; color: #721c24;",
                                            RosraApp.Models.Enums.ReportStatus.Validated => "background: #d4edda; color: #155724;",
                                            _ => "background: #d3f9d8; color: #2b8a3e;"
                                        };
                                    }
                                    <span class="status-badge" style="@statusBadgeClass">
                                        <i class="bi bi-circle-fill"></i>@reportStatus.ToString()
                                    </span>
                                    @if (reportStatus == RosraApp.Models.Enums.ReportStatus.Draft)
                                    {
                                        <button class="icon-btn submit-btn" type="button" data-report-id="@report.Id" title="Submit for Review" style="color: #4c6ef5;">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    }
                                    <button class="icon-btn archive-btn" type="button" data-report-id="@report.Id" title="@(report.IsArchived ? "Unarchive" : "Archive")">
                                        <i class="bi bi-archive"></i>
                                    </button>
                                    @if (reportStatus == RosraApp.Models.Enums.ReportStatus.Draft || reportStatus == RosraApp.Models.Enums.ReportStatus.NeedsRevision)
                                    {
                                        <button class="icon-btn delete-btn" type="button" data-report-id="@report.Id" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Report title -->
                            <h3 class="report-title">@report.Title</h3>

                            @if (reportStatus == RosraApp.Models.Enums.ReportStatus.NeedsRevision && !string.IsNullOrEmpty(report.RevisionReason))
                            {
                                <div class="alert alert-warning py-1 px-2 mb-2" style="font-size: 0.8125rem;">
                                    <i class="bi bi-exclamation-triangle me-1"></i> <strong>Revision requested:</strong> @report.RevisionReason
                                </div>
                            }
                            @if (reportStatus == RosraApp.Models.Enums.ReportStatus.NeedsRevision || reportStatus == RosraApp.Models.Enums.ReportStatus.Validated)
                            {
                                <button type="button" class="btn btn-sm view-feedback-btn" data-report-id="@report.Id"
                                    style="font-size:0.7rem; color:#3B82F6; background:none; border:none; padding:0 0 4px; cursor:pointer;">
                                    <i class="bi bi-chat-dots me-1"></i>View reviewer feedback
                                </button>
                                <div class="feedback-panel" id="feedback-@report.Id" style="display:none; background:#f8fafc; border-radius:6px; padding:8px 10px; margin-bottom:8px; font-size:0.75rem; max-height:200px; overflow-y:auto;">
                                    <div class="feedback-loading" style="color:#6A6A6A; text-align:center;"><i class="bi bi-hourglass-split"></i> Loading...</div>
                                </div>
                            }

                            <!-- Report details with flag -->
                            <div class="report-details">
                                <div class="flag-icon">
                                    @{
                                        var countryCode = GetCountryCode(report.Country);
                                    }
                                    @if (!string.IsNullOrEmpty(countryCode))
                                    {
                                        <span class="country-flag fi fi-@countryCode"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-globe default-globe"></i>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="detail-row">
                                        <span class="detail-label">@Localizer["Location"] </span>
                                        <span class="detail-value">@{
                                            var locParts = new List<string>();
                                            if (!string.IsNullOrEmpty(report.Country)) locParts.Add(report.Country);
                                            if (!string.IsNullOrEmpty(report.Region)) locParts.Add(report.Region);
                                            if (!string.IsNullOrEmpty(report.City) && (report.FinalUnitLevel ?? 0) >= 2) locParts.Add(report.City);
                                            if (!string.IsNullOrEmpty(report.GovUnitLevel3) && (report.FinalUnitLevel ?? 0) >= 3) locParts.Add(report.GovUnitLevel3);
                                        }@(locParts.Count > 0 ? string.Join(" > ", locParts) : "N/A")</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Last Financial Year Ending in @(report.FinancialYear ?? report.CreatedAt.Year.ToString())</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">@Localizer["Currency"] </span>
                                        <span class="detail-value">@(report.Currency ?? "N/A") @(report.CurrencySymbol != null ? "(" + report.CurrencySymbol + ")" : "")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white p-3 border-top-0">
                            <a asp-controller="Dashboard" asp-action="ViewReport" asp-route-id="@report.PublicId"
                               class="btn btn-open w-100">@Localizer["Open"]</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12" id="no-reports-message">
                <div class="no-reports-card">
                    <i class="bi bi-file-earmark-text d-block"></i>
                    <h5>@Localizer["NoReports"]</h5>
                    <p class="text-muted mb-4">@Localizer["NoReportsDesc"]</p>
                    <a asp-controller="Rosra" asp-action="Index" class="btn btn-create-report">
                        <i class="bi bi-plus-circle me-2"></i> @Localizer["CreateFirst"]
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Report pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-search="@Model.SearchTerm" asp-route-tab="@Model.CurrentTab">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-search="@Model.SearchTerm" asp-route-tab="@Model.CurrentTab">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-search="@Model.SearchTerm" asp-route-tab="@Model.CurrentTab">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
            <p class="text-center text-muted small">Showing @((Model.PageNumber - 1) * 12 + 1)-@Math.Min(Model.PageNumber * 12, Model.TotalCount) of @Model.TotalCount reports</p>
        </nav>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteReportModal" tabindex="-1" aria-labelledby="deleteReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-modern">
            <div class="modal-header">
                <div class="modal-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <h5 class="modal-title" id="deleteReportModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete this report? It will be moved to trash and can be restored by an administrator.</p>
                <input type="hidden" id="reportToDeleteId" value="">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-modal-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-modal-danger" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-2"></i>Delete Report
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast notification for success/error messages -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto" id="toast-title">Notification</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toast-message"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // View feedback toggle
            $('.view-feedback-btn').click(function() {
                var reportId = $(this).data('report-id');
                var panel = $('#feedback-' + reportId);
                if (panel.is(':visible')) {
                    panel.slideUp(200);
                    return;
                }
                panel.slideDown(200);
                var loading = panel.find('.feedback-loading');
                if (loading.length) {
                    $.get('/Submission/MyNotes?reportId=' + reportId, function(notes) {
                        if (notes.success === false) {
                            panel.html('<div style="color:#6A6A6A; text-align:center;">No feedback available</div>');
                            return;
                        }
                        if (!notes.length) {
                            panel.html('<div style="color:#6A6A6A; text-align:center;">No reviewer notes yet</div>');
                            return;
                        }
                        var html = '';
                        notes.forEach(function(n) {
                            var typeColors = { '0':'#3B82F6', '1':'#EF4444', '2':'#10B981', '3':'#F59E0B' };
                            var typeNames = { '0':'General', '1':'Correction', '2':'Validation', '3':'Revision' };
                            var color = typeColors[n.noteType] || '#6A6A6A';
                            var typeName = typeNames[n.noteType] || 'Note';
                            html += '<div style="padding:6px 0; border-bottom:1px solid #eee;">';
                            html += '<div style="display:flex; justify-content:space-between; margin-bottom:2px;">';
                            html += '<span style="font-weight:600; color:#222;">' + n.author + '</span>';
                            html += '<span style="color:#6A6A6A; font-size:0.65rem;">' + n.createdAt + '</span>';
                            html += '</div>';
                            html += '<span style="display:inline-block; padding:1px 6px; border-radius:4px; font-size:0.6rem; font-weight:600; background:' + color + '20; color:' + color + '; margin-bottom:3px;">' + typeName + '</span>';
                            html += '<div style="color:#374151; line-height:1.4;">' + n.content + '</div>';
                            html += '</div>';
                        });
                        panel.html(html);
                    });
                }
            });

            // Refresh button functionality
            $('#refreshBtn').click(function() {
                location.reload();
            });
            
            // Delete report button click
            $('.delete-btn').click(function() {
                const reportId = $(this).data('report-id');
                $('#reportToDeleteId').val(reportId);

                // Show the confirmation modal
                const deleteModal = new bootstrap.Modal(document.getElementById('deleteReportModal'));
                deleteModal.show();
            });
            
            // Confirm delete button click
            $('#confirmDeleteBtn').click(function() {
                const reportId = $('#reportToDeleteId').val();
                
                // Send delete request using AJAX
                $.ajax({
                    url: '@Url.Action("DeleteReport", "Dashboard")',
                    type: 'POST',
                    data: { 
                        id: reportId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        // Hide the modal
                        const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteReportModal'));
                        deleteModal.hide();
                        
                        if (response.success) {
                            // Show success message
                            showToast('Success', response.message, 'success');
                            
                            // Remove the deleted report card from the DOM
                            $(`.report-card[data-report-id="${reportId}"]`).fadeOut(300, function() {
                                $(this).remove();
                                
                                // Check if there are any reports left
                                if ($('.report-card').length === 0) {
                                    // Show the "No Reports Found" message
                                    let noReportsMessage = `
                                        <div class="col-12" id="no-reports-message">
                                            <div class="no-reports-card">
                                                <i class="bi bi-file-earmark-text d-block"></i>
                                                <h5>No Reports Found</h5>
                                                <p class="text-muted mb-4">You haven't created any ROSRA reports yet. Get started by creating your first report.</p>
                                                <a href="@Url.Action("Index", "Rosra")" class="btn btn-create-report">
                                                    <i class="bi bi-plus-circle me-2"></i> @Localizer["CreateFirst"]
                                                </a>
                                            </div>
                                        </div>
                                    `;
                                    $('#reports-container').html(noReportsMessage);
                                }
                            });
                        } else {
                            // Show error message
                            showToast('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        // Hide the modal
                        const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteReportModal'));
                        deleteModal.hide();
                        
                        // Show error message
                        showToast('Error', 'An error occurred while deleting the report. Please try again.', 'error');
                    }
                });
            });
            
            // Submit for Review button click
            $('.submit-btn').click(function() {
                const reportId = $(this).data('report-id');
                if (!confirm('Submit this assessment for review? You will not be able to edit it until the review is complete.')) return;
                $.ajax({
                    url: '@Url.Action("Submit", "Submission")/' + reportId,
                    type: 'POST',
                    data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            showToast('Success', response.message, 'success');
                            setTimeout(function() { location.reload(); }, 1000);
                        } else {
                            showToast('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        showToast('Error', 'An error occurred. Please try again.', 'error');
                    }
                });
            });

            // Archive report button click
            $('.archive-btn').click(function() {
                const reportId = $(this).data('report-id');
                $.ajax({
                    url: '@Url.Action("ArchiveReport", "Dashboard")',
                    type: 'POST',
                    data: {
                        id: reportId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showToast('Success', response.message, 'success');
                            setTimeout(function() { location.reload(); }, 1000);
                        } else {
                            showToast('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        showToast('Error', 'An error occurred. Please try again.', 'error');
                    }
                });
            });

            // Toast notification helper function
            function showToast(title, message, type) {
                $('#toast-title').text(title);
                $('#toast-message').text(message);
                
                // Set toast background color based on type
                if (type === 'success') {
                    $('#toast').removeClass('bg-danger').addClass('bg-success text-white');
                } else {
                    $('#toast').removeClass('bg-success').addClass('bg-danger text-white');
                }
                
                // Show the toast
                const toast = new bootstrap.Toast(document.getElementById('toast'));
                toast.show();
            }
        });
    </script>

    @* Add anti-forgery token *@
    @Html.AntiForgeryToken()
}
