<div class="gap-tabs-container">
    <!-- Gap Analysis Intro Section -->
    <div class="gap-analysis-intro-section">
        <div class="intro-text-box">
            <i class="bi bi-info-circle-fill intro-icon"></i>
            <p class="intro-text">@Localizer["Intro_Text"]</p>
            @if (!string.IsNullOrWhiteSpace(Model.FinancialYear))
            {
                <span class="fy-chip" title="@Localizer["FinancialYear_Tooltip"]">
                    <i class="bi bi-calendar3"></i>
                    <span class="fy-label">@Localizer["FinancialYear_Label"]</span>
                    <span>@Model.FinancialYear</span>
                </span>
            }
        </div>
    </div>

    <!-- Modern Tab Navigation -->
    <div class="gap-tabs-nav" role="tablist" id="gapTabsNav">
        <!-- Property Tax Tab (Fixed - Renameable) -->
        <button type="button" class="gap-tab-btn active" onclick="showTab('property-tax')" data-tab="property-tax">
            <i class="bi bi-house"></i>
            <span class="stream-name-label" id="propertyTaxLabel">@Model.PropertyTaxDisplayName</span>
            @if (!isViewMode)
            {
                <span class="rename-tab-btn" onclick="event.stopPropagation(); openRenameModal('property-tax', '@Model.PropertyTaxDisplayName');" title="@Localizer["RenameTab_Tooltip"]">
                    <i class="bi bi-pencil"></i>
                </span>
            }
        </button>
        <input type="hidden" id="propertyTaxDisplayName" name="PropertyTaxDisplayName" value="@Model.PropertyTaxDisplayName" />

        <!-- Business License Tab (Fixed - Renameable) -->
        <button type="button" class="gap-tab-btn" onclick="showTab('license')" data-tab="license">
            <i class="bi bi-file-earmark-text"></i>
            <span class="stream-name-label" id="businessLicenseLabel">@Model.BusinessLicenseDisplayName</span>
            @if (!isViewMode)
            {
                <span class="rename-tab-btn" onclick="event.stopPropagation(); openRenameModal('license', '@Model.BusinessLicenseDisplayName');" title="@Localizer["RenameTab_Tooltip"]">
                    <i class="bi bi-pencil"></i>
                </span>
            }
        </button>
        <input type="hidden" id="businessLicenseDisplayName" name="BusinessLicenseDisplayName" value="@Model.BusinessLicenseDisplayName" />

        <!-- Dynamic Stream Tabs Container -->
        <div id="dynamicStreamTabs" class="d-contents" style="display: contents;">
            @if (Model.GenericStreams != null && Model.GenericStreams.Count > 0)
            {
                @for (int i = 0; i < Model.GenericStreams.Count; i++)
                {
                    var stream = Model.GenericStreams[i];
                    <button type="button" class="gap-tab-btn" onclick="showTab('stream@(i)')" data-tab="stream@(i)" id="stream@(i)-btn" data-subgroup="@(stream.Subgroup ?? "")" data-subtype="@(stream.Subtype ?? "")">
                        <i class="bi bi-bar-chart-line"></i>
                        <span class="stream-name-label">@stream.StreamName</span>
                        @if (!string.IsNullOrEmpty(stream.Subgroup))
                        {
                            var tabBadgeColor = stream.Subgroup switch { "A" => "#2196F3", "B" => "#FF9800", "C" => "#4CAF50", _ => "#666" };
                            <span class="badge ms-1" style="background-color:@tabBadgeColor; font-size: 0.6rem; vertical-align: middle;">@stream.Subgroup</span>
                        }
                        @if (!isViewMode)
                        {
                            <span class="close-tab" onclick="event.stopPropagation(); deleteStream(@i);" title="@Localizer["RemoveStream_Tooltip"]">&times;</span>
                        }
                    </button>
                }
            }
        </div>

        <!-- Add Stream Button -->
        @if (!isViewMode)
        {
            <button type="button" class="add-stream-btn" onclick="openAddStreamModal()" title="@Localizer["AddStream_Tooltip"]">
                <i class="bi bi-plus-circle"></i>
                @Localizer["AddStream"]
            </button>
        }
    </div>

    <!-- Tab Content -->
    <div class="gap-tab-content">
        <!-- Property Tax Tab -->
        <div id="property-tax-tab" class="revenue-tab" style="display: block;">
            @await Html.PartialAsync("_GapAnalysisPropertyTaxFixed", Model)
        </div>

        <!-- Business License Tab -->
        <div id="license-tab" class="revenue-tab" style="display: none;">
            @await Html.PartialAsync("_GapAnalysisLicense", Model)
        </div>

        <!-- Dynamic Stream Tab Contents -->
        <div id="dynamicStreamContents">
            @if (Model.GenericStreams != null && Model.GenericStreams.Count > 0)
            {
                @for (int i = 0; i < Model.GenericStreams.Count; i++)
                {
                    var stream = Model.GenericStreams[i];
                    stream.StreamIndex = i;
                    <div id="stream@(i)-tab" class="revenue-tab" style="display: none;">
                        @await Html.PartialAsync("_GapAnalysisGenericStream", stream, new ViewDataDictionary(ViewData) { { "CurrencySymbol", currencySymbol } })
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Add Stream Modal (Two-Step: Templates → Classification + Name) -->
