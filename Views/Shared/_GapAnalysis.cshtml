<script>
    // Localized strings used by the "Add Non-Property Revenue Stream" modal.
    // Keyed by template id / subgroup code so the static streamClassification.js bundle
    // stays language-neutral while the rendered UI is fully translated.
    window.streamI18n = {
        templates: {
            'general-business-licence': {
                name: @Json.Serialize(SharedLocalizer["Template_GeneralBusinessLicence_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_GeneralBusinessLicence_Description"].Value)
            },
            'advertising-signage-permit': {
                name: @Json.Serialize(SharedLocalizer["Template_AdvertisingSignagePermit_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_AdvertisingSignagePermit_Description"].Value)
            },
            'solid-waste-fee': {
                name: @Json.Serialize(SharedLocalizer["Template_SolidWasteFee_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_SolidWasteFee_Description"].Value)
            },
            'market-stall-rent': {
                name: @Json.Serialize(SharedLocalizer["Template_MarketStallRent_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_MarketStallRent_Description"].Value)
            },
            'daily-market-fee': {
                name: @Json.Serialize(SharedLocalizer["Template_DailyMarketFee_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_DailyMarketFee_Description"].Value)
            },
            'parking-fee': {
                name: @Json.Serialize(SharedLocalizer["Template_ParkingFee_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_ParkingFee_Description"].Value)
            },
            'other': {
                name: @Json.Serialize(SharedLocalizer["Template_Other_Name"].Value),
                description: @Json.Serialize(SharedLocalizer["Template_Other_Description"].Value)
            }
        },
        subgroups: {
            'A': {
                label: @Json.Serialize(SharedLocalizer["StreamSubgroupA_Label"].Value),
                shortLabel: @Json.Serialize(SharedLocalizer["StreamSubgroupA_ShortLabel"].Value)
            },
            'B': {
                label: @Json.Serialize(SharedLocalizer["StreamSubgroupB_Label"].Value),
                shortLabel: @Json.Serialize(SharedLocalizer["StreamSubgroupB_ShortLabel"].Value)
            },
            'C': {
                label: @Json.Serialize(SharedLocalizer["StreamSubgroupC_Label"].Value),
                shortLabel: @Json.Serialize(SharedLocalizer["StreamSubgroupC_ShortLabel"].Value)
            }
        },
        manualClassification: @Json.Serialize(SharedLocalizer["Template_ManualClassification"].Value)
    };

    // Track the current stream count
    let streamCount = @(Model.GenericStreams?.Count ?? 0);
    let deleteStreamIndex = -1;
    let renameStreamId = null;

    // ===== STREAM RENAMING FUNCTIONALITY =====
    // Open Rename Modal
    function openRenameModal(streamId, currentName) {
        renameStreamId = streamId;
        document.getElementById('renameStreamInput').value = currentName;
        const modal = new bootstrap.Modal(document.getElementById('renameStreamModal'));
        modal.show();
        // Focus the input after modal is shown
        setTimeout(() => document.getElementById('renameStreamInput').focus(), 300);
    }

    // Confirm Rename
    document.getElementById('confirmRenameBtn').addEventListener('click', function() {
        if (!renameStreamId) return;

        const newName = document.getElementById('renameStreamInput').value.trim();
        if (!newName) {
            alert('Please enter a name');
            return;
        }

        // Update the label in the tab button
        if (renameStreamId === 'property-tax') {
            document.getElementById('propertyTaxLabel').textContent = newName;
            document.getElementById('propertyTaxDisplayName').value = newName;
            localStorage.setItem('rosraPropertyTaxDisplayName', newName);
        } else if (renameStreamId === 'license') {
            document.getElementById('businessLicenseLabel').textContent = newName;
            document.getElementById('businessLicenseDisplayName').value = newName;
            localStorage.setItem('rosraBusinessLicenseDisplayName', newName);
        }

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('renameStreamModal'));
        modal.hide();
        renameStreamId = null;
    });

    // Restore saved display names from localStorage on page load
    function restoreSavedDisplayNames() {
        const savedPropertyTaxName = localStorage.getItem('rosraPropertyTaxDisplayName');
        const savedBusinessLicenseName = localStorage.getItem('rosraBusinessLicenseDisplayName');

        if (savedPropertyTaxName) {
            document.getElementById('propertyTaxLabel').textContent = savedPropertyTaxName;
            document.getElementById('propertyTaxDisplayName').value = savedPropertyTaxName;
        }
        if (savedBusinessLicenseName) {
            document.getElementById('businessLicenseLabel').textContent = savedBusinessLicenseName;
            document.getElementById('businessLicenseDisplayName').value = savedBusinessLicenseName;
        }
    }

    // Call restore on page load
    document.addEventListener('DOMContentLoaded', restoreSavedDisplayNames);

    // ===== STREAM METADATA EDITING =====
    let editMetaStreamIndex = -1;

    // Reset overview/recommendation selections for a stream when its subgroup changes
    function resetStreamSelections(streamName) {
        try {
            // Reset overview selections
            var selectionsKey = 'rosraOverviewSelections';
            var solutionsKey = 'rosraSelectedSolutions';

            // Try FormStateManager first, fallback to localStorage
            if (typeof FormStateManager !== 'undefined') {
                var selData = FormStateManager.getData(selectionsKey);
                var solData = FormStateManager.getData(solutionsKey);

                if (selData && selData.selected) {
                    selData.selected = selData.selected.filter(function(id) {
                        // Keep selections that don't belong to this stream
                        var sol = solData ? solData.find(function(s) { return s.solutionId === id; }) : null;
                        return !sol || sol.streamName !== streamName;
                    });
                    selData.skipped = selData.skipped ? selData.skipped.filter(function(id) {
                        var sol = solData ? solData.find(function(s) { return s.solutionId === id; }) : null;
                        return !sol || sol.streamName !== streamName;
                    }) : [];
                    FormStateManager.setData(selectionsKey, selData);
                }

                if (solData) {
                    solData = solData.filter(function(s) { return s.streamName !== streamName; });
                    FormStateManager.setData(solutionsKey, solData);
                }
            }

            // Also clear localStorage copies
            var localSel = localStorage.getItem(selectionsKey);
            if (localSel) {
                var parsed = JSON.parse(localSel);
                var localSol = localStorage.getItem(solutionsKey);
                var parsedSol = localSol ? JSON.parse(localSol) : [];
                if (parsed.selected) {
                    parsed.selected = parsed.selected.filter(function(id) {
                        var sol = parsedSol.find(function(s) { return s.solutionId === id; });
                        return !sol || sol.streamName !== streamName;
                    });
                }
                if (parsed.skipped) {
                    parsed.skipped = parsed.skipped.filter(function(id) {
                        var sol = parsedSol.find(function(s) { return s.solutionId === id; });
                        return !sol || sol.streamName !== streamName;
                    });
                }
                localStorage.setItem(selectionsKey, JSON.stringify(parsed));

                if (parsedSol.length > 0) {
                    parsedSol = parsedSol.filter(function(s) { return s.streamName !== streamName; });
                    localStorage.setItem(solutionsKey, JSON.stringify(parsedSol));
                }
            }

            console.log('Reset selections for stream:', streamName);
        } catch (e) {
            console.error('Error resetting stream selections:', e);
        }
    }

    function openEditMetaModal(streamIndex) {
        editMetaStreamIndex = streamIndex;
        const streamId = 'stream' + streamIndex;
        const container = document.getElementById(streamId + '-container');
        if (!container) return;

        const nameInput = container.querySelector('input[name$=".StreamName"]');
        const subgroupInput = container.querySelector('input[name$=".Subgroup"]');
        const subtypeInput = container.querySelector('input[name$=".Subtype"]');

        document.getElementById('editMetaStreamName').value = nameInput ? nameInput.value : '';
        document.getElementById('editMetaSubgroup').value = subgroupInput ? subgroupInput.value : '';

        // Populate subtypes for current subgroup
        onEditMetaSubgroupChange();

        // Set current subtype after populating
        if (subtypeInput && subtypeInput.value) {
            document.getElementById('editMetaSubtype').value = subtypeInput.value;
        }

        const modal = new bootstrap.Modal(document.getElementById('editStreamMetaModal'));
        modal.show();
    }

    function onEditMetaSubgroupChange() {
        const subgroup = document.getElementById('editMetaSubgroup').value;
        const subtypeSelect = document.getElementById('editMetaSubtype');
        subtypeSelect.innerHTML = '<option value="">-- Select specific type (optional) --</option>';
        if (subgroup && typeof StreamClassification !== 'undefined') {
            StreamClassification.getSubtypesForSubgroup(subgroup).forEach(function(st) {
                const opt = document.createElement('option');
                opt.value = st;
                opt.textContent = st;
                subtypeSelect.appendChild(opt);
            });
        }
    }

    document.getElementById('confirmEditMetaBtn').addEventListener('click', function() {
        if (editMetaStreamIndex < 0) return;

        const newName = document.getElementById('editMetaStreamName').value.trim();
        const newSubgroup = document.getElementById('editMetaSubgroup').value;
        const newSubtype = document.getElementById('editMetaSubtype').value;

        if (!newName) { alert('Please enter a stream name.'); return; }
        if (!newSubgroup) { alert('Please select a stream type.'); return; }

        const streamId = 'stream' + editMetaStreamIndex;
        const container = document.getElementById(streamId + '-container');
        if (!container) return;

        // Check if subgroup changed — warn and reset overview/recommendation selections
        const oldSubgroup = container.getAttribute('data-subgroup') || '';
        if (oldSubgroup && oldSubgroup !== newSubgroup) {
            if (!confirm('Changing the stream type will reset the recommendations already selected for this stream. Do you want to continue?')) {
                return;
            }
            resetStreamSelections(container.querySelector('input[name$=".StreamName"]')?.value || '');
        }

        // Update hidden inputs
        const nameInput = container.querySelector('input[name$=".StreamName"]');
        const localNameInput = container.querySelector('input[name$=".LocalStreamName"]');
        const subgroupInput = container.querySelector('input[name$=".Subgroup"]');
        const subtypeInput = container.querySelector('input[name$=".Subtype"]');
        const visibleNameInput = document.getElementById(streamId + 'Name');

        if (nameInput) nameInput.value = newName;
        if (localNameInput) localNameInput.value = newName;
        if (subgroupInput) subgroupInput.value = newSubgroup;
        if (subtypeInput) subtypeInput.value = newSubtype;
        if (visibleNameInput) visibleNameInput.value = newName;

        // Update container data attributes
        container.setAttribute('data-subgroup', newSubgroup);
        container.setAttribute('data-subtype', newSubtype);

        // Update the subgroup badge in the stream header (prefer localized label).
        const subgroupColor = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupColor(newSubgroup) : '#666';
        const subgroupLabel = (window.streamI18n && window.streamI18n.subgroups && window.streamI18n.subgroups[newSubgroup])
            ? window.streamI18n.subgroups[newSubgroup].shortLabel
            : (typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupShortLabel(newSubgroup) : newSubgroup);
        const headerEditor = container.querySelector('.stream-name-editor');
        if (headerEditor) {
            const existingBadge = headerEditor.querySelector('.badge');
            if (existingBadge) {
                existingBadge.style.backgroundColor = subgroupColor;
                existingBadge.textContent = subgroupLabel;
            }
        }

        // Update the tab button
        const tabBtn = document.getElementById(streamId + '-btn');
        if (tabBtn) {
            const nameLabel = tabBtn.querySelector('.stream-name-label');
            if (nameLabel) nameLabel.textContent = newName;
            tabBtn.setAttribute('data-subgroup', newSubgroup);
            tabBtn.setAttribute('data-subtype', newSubtype);
            const tabBadge = tabBtn.querySelector('.badge');
            if (tabBadge) {
                tabBadge.style.backgroundColor = subgroupColor;
                tabBadge.textContent = newSubgroup;
            }
        }

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('editStreamMetaModal'));
        modal.hide();
        editMetaStreamIndex = -1;
    });

    // Function to switch between tabs
    function showTab(tabId) {
        // Hide all tab contents
        const tabContents = document.querySelectorAll('.revenue-tab');
        tabContents.forEach(content => {
            content.style.display = 'none';
        });

        // Show the selected tab content
        const selectedContent = document.getElementById(tabId + '-tab');
        if (selectedContent) {
            selectedContent.style.display = 'block';
        }

        // Update active state on buttons
        const tabButtons = document.querySelectorAll('.gap-tab-btn');
        tabButtons.forEach(button => {
            button.classList.remove('active');
        });

        // Find the button that was clicked and make it active
        const activeButton = document.querySelector(`.gap-tab-btn[data-tab="${tabId}"]`);
        if (activeButton) {
            activeButton.classList.add('active');
        }

        // Dispatch a custom event to notify that the tab has been shown
        const tabShownEvent = new CustomEvent('tabShown', { detail: { tabId: tabId } });
        document.dispatchEvent(tabShownEvent);

        // Save the active tab to localStorage
        localStorage.setItem('activeGapAnalysisTab', tabId);
    }

    // Open Add Stream Modal
    function openAddStreamModal() {
        // Reset modal to Step 1
        showAddStreamStep1();
        document.getElementById('newStreamName').value = '';
        document.getElementById('newStreamSubgroup').value = '';
        document.getElementById('newStreamSubtype').innerHTML = '<option value="">-- Select specific type (optional) --</option>';
        const modal = new bootstrap.Modal(document.getElementById('addStreamModal'));
        modal.show();
    }

    // Render quick template grid on Step 1
    function renderQuickTemplateGrid() {
        const grid = document.getElementById('quickTemplateGrid');
        if (!grid || typeof StreamClassification === 'undefined') return;
        grid.innerHTML = '';
        const i18n = window.streamI18n || { templates: {}, subgroups: {}, manualClassification: 'Manual classification' };
        StreamClassification.QUICK_TEMPLATES.forEach(function(tpl) {
            const subgroupInfo = tpl.subgroup ? StreamClassification.getSubgroup(tpl.subgroup) : null;
            const badgeColor = subgroupInfo ? subgroupInfo.color : '#666';
            const subgroupI18n = tpl.subgroup ? i18n.subgroups[tpl.subgroup] : null;
            const badgeLabel = subgroupI18n ? subgroupI18n.shortLabel
                              : (subgroupInfo ? subgroupInfo.shortLabel : i18n.manualClassification);
            const tplI18n = i18n.templates[tpl.id] || {};
            const localizedName = tplI18n.name || tpl.name;
            const localizedDescription = tplI18n.description || tpl.description;
            const col = document.createElement('div');
            col.className = 'col-6 col-sm-4 col-md-3';
            col.innerHTML = `
                <div class="card h-100 template-card" style="cursor:pointer; border: 2px solid transparent; transition: border-color 0.2s;"
                     onclick="selectQuickTemplate('${tpl.id}')"
                     onmouseenter="this.style.borderColor='${badgeColor}'"
                     onmouseleave="this.style.borderColor='transparent'">
                    <div class="card-body text-center template-card-body">
                        <i class="bi ${tpl.icon} template-card-icon d-block mb-1" style="color:${badgeColor}"></i>
                        <h6 class="card-title mb-1 template-card-title">${escapeHtml(localizedName)}</h6>
                        <small class="text-muted template-card-desc">${escapeHtml(localizedDescription)}</small>
                        ${tpl.subgroup ? '<div class="mt-1"><span class="badge template-card-badge" style="background-color:' + badgeColor + ';">' + escapeHtml(badgeLabel) + '</span></div>' : ''}
                    </div>
                </div>
            `;
            grid.appendChild(col);
        });
    }

    // Select a quick template → prefill and go to Step 2
    function selectQuickTemplate(templateId) {
        if (typeof StreamClassification === 'undefined') return;
        const tpl = StreamClassification.getTemplate(templateId);
        if (!tpl) return;

        // Prefill classification fields
        document.getElementById('newStreamSubgroup').value = tpl.subgroup || '';
        document.getElementById('newStreamName').value = tpl.defaultStreamName || '';

        // Populate subtypes for the selected subgroup
        onSubgroupChange();

        // Set subtype if template has one
        if (tpl.subtype) {
            document.getElementById('newStreamSubtype').value = tpl.subtype;
        }

        showAddStreamStep2();
    }

    // Show Step 1 (templates)
    function showAddStreamStep1() {
        document.getElementById('addStreamStep1').style.display = '';
        document.getElementById('addStreamStep2').style.display = 'none';
        document.getElementById('addStreamBackBtn').style.display = 'none';
        document.getElementById('addStreamCreateBtn').style.display = 'none';
        renderQuickTemplateGrid();
    }

    // Show Step 2 (classification + name)
    function showAddStreamStep2() {
        document.getElementById('addStreamStep1').style.display = 'none';
        document.getElementById('addStreamStep2').style.display = '';
        document.getElementById('addStreamBackBtn').style.display = '';
        document.getElementById('addStreamCreateBtn').style.display = '';
    }

    // Handle subgroup dropdown change → populate subtypes
    function onSubgroupChange() {
        const subgroup = document.getElementById('newStreamSubgroup').value;
        const subtypeSelect = document.getElementById('newStreamSubtype');
        subtypeSelect.innerHTML = '<option value="">-- Select specific type (optional) --</option>';
        if (subgroup && typeof StreamClassification !== 'undefined') {
            const subtypes = StreamClassification.getSubtypesForSubgroup(subgroup);
            subtypes.forEach(function(st) {
                const opt = document.createElement('option');
                opt.value = st;
                opt.textContent = st;
                subtypeSelect.appendChild(opt);
            });
        }
    }

    // Add New Stream (from Step 2)
    async function addNewStream() {
        const streamName = document.getElementById('newStreamName').value.trim();
        const subgroup = document.getElementById('newStreamSubgroup').value;
        const subtype = document.getElementById('newStreamSubtype').value;

        if (!subgroup) {
            alert('Please select a stream type (subgroup) before creating the stream.');
            return;
        }
        if (!streamName) {
            alert('Please enter a stream name.');
            return;
        }

        const streamIndex = streamCount;
        const streamId = 'stream' + streamIndex;
        const currencySymbol = window.AppContext ? window.AppContext.get('currencySymbol') : '@currencySymbol';

        // Create tab button with subgroup badge
        const tabButton = document.createElement('button');
        tabButton.type = 'button';
        tabButton.className = 'gap-tab-btn';
        tabButton.setAttribute('onclick', `showTab('${streamId}')`);
        tabButton.setAttribute('data-tab', streamId);
        tabButton.setAttribute('data-subgroup', subgroup);
        tabButton.setAttribute('data-subtype', subtype);
        tabButton.id = streamId + '-btn';
        const subgroupColor = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupColor(subgroup) : '#666';
        tabButton.innerHTML = `
            <i class="bi bi-bar-chart-line"></i>
            <span class="stream-name-label">${escapeHtml(streamName)}</span>
            <span class="badge ms-1" style="background-color:${subgroupColor}; font-size: 0.6rem; vertical-align: middle;">${escapeHtml(subgroup)}</span>
            <span class="close-tab" onclick="event.stopPropagation(); deleteStream(${streamIndex});" title="Remove stream">&times;</span>
        `;
        document.getElementById('dynamicStreamTabs').appendChild(tabButton);

        // Fetch the Razor partial — single source of truth shared with saved/sample reports
        let html;
        try {
            const params = new URLSearchParams({
                streamIndex: String(streamIndex),
                subgroup: subgroup || '',
                subtype: subtype || '',
                streamName: streamName,
                currencySymbol: currencySymbol || '$'
            });
            const res = await fetch('/Rosra/RenderGenericStream?' + params.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            html = await res.text();
        } catch (err) {
            tabButton.remove();
            alert('Failed to create stream: ' + err.message);
            return;
        }

        // Inject HTML into a new tab pane
        const tabContent = document.createElement('div');
        tabContent.id = streamId + '-tab';
        tabContent.className = 'revenue-tab';
        tabContent.style.display = 'none';
        tabContent.innerHTML = html;
        document.getElementById('dynamicStreamContents').appendChild(tabContent);

        // <script> tags inserted via innerHTML do NOT execute — re-create them so the
        // partial's IIFE wires up charts, listeners, and tooltips for this new stream.
        tabContent.querySelectorAll('script').forEach(oldScript => {
            const newScript = document.createElement('script');
            for (const attr of oldScript.attributes) {
                newScript.setAttribute(attr.name, attr.value);
            }
            newScript.textContent = oldScript.textContent;
            oldScript.parentNode.replaceChild(newScript, oldScript);
        });

        // Close modal and switch to new tab
        const modal = bootstrap.Modal.getInstance(document.getElementById('addStreamModal'));
        modal.hide();

        streamCount++;
        showTab(streamId);
    }

    // Delete Stream
    function deleteStream(index) {
        deleteStreamIndex = index;
        const streamBtn = document.getElementById('stream' + index + '-btn');
        const streamName = streamBtn ? streamBtn.querySelector('.stream-name-label').textContent : 'Stream ' + (index + 1);
        document.getElementById('deleteStreamName').textContent = streamName;

        const modal = new bootstrap.Modal(document.getElementById('deleteStreamModal'));
        modal.show();
    }

    // Confirm Delete
    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (deleteStreamIndex < 0) return;

        const streamId = 'stream' + deleteStreamIndex;

        // Remove tab button
        const tabBtn = document.getElementById(streamId + '-btn');
        if (tabBtn) tabBtn.remove();

        // Remove tab content
        const tabContent = document.getElementById(streamId + '-tab');
        if (tabContent) tabContent.remove();

        // Get the modal element
        const modalElement = document.getElementById('deleteStreamModal');
        const modal = bootstrap.Modal.getInstance(modalElement);

        // Wait for modal to be fully hidden before switching tabs
        // This prevents the layout snap bug caused by 100vw calculation
        // happening while modal-open class is still on body
        modalElement.addEventListener('hidden.bs.modal', function onHidden() {
            // Remove this one-time listener
            modalElement.removeEventListener('hidden.bs.modal', onHidden);

            // Clean up any remaining Bootstrap modal artifacts
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            document.querySelectorAll('.modal-backdrop').forEach(function(el) { el.remove(); });

            // Now safely switch to Property Tax tab
            showTab('property-tax');
            deleteStreamIndex = -1;
        });

        // Start hiding the modal
        modal.hide();
    });

    // Template button click handlers
    document.querySelectorAll('.stream-template-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('newStreamName').value = this.getAttribute('data-name');
        });
    });

    // Helper function to escape HTML
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }


    // Map Gap Analysis tab data-tab values to RosraStateManager stream ids.
    // property-tax and license are fixed; stream{i} are generic-stream-{i}.
    function gapTabStreamIdFor(dataTab) {
        if (!dataTab) return null;
        if (dataTab === 'property-tax') return 'property-tax';
        if (dataTab === 'license') return 'business-license';
        const m = /^stream(\d+)$/.exec(dataTab);
        if (m) return 'generic-stream-' + m[1];
        return null;
    }

    // Paint an "Excluded" badge on any Gap Analysis tab whose stream has been
    // excluded on the Prioritization step, and fade the tab so the state is
    // obvious without hiding the data (user still needs to see Gap Analysis).
    function refreshGapAnalysisExclusionBadges() {
        if (typeof RosraStateManager === 'undefined') return;
        const excluded = new Set(
            RosraStateManager.getStreams()
                .filter(s => s.included === false)
                .map(s => s.id)
        );
        document.querySelectorAll('.gap-tab-btn[data-tab]').forEach(btn => {
            const streamId = gapTabStreamIdFor(btn.getAttribute('data-tab'));
            const isExcluded = streamId && excluded.has(streamId);
            let badge = btn.querySelector('.gap-tab-excluded-badge');
            if (isExcluded) {
                btn.classList.add('gap-tab-excluded');
                if (!badge) {
                    badge = document.createElement('span');
                    badge.className = 'badge gap-tab-excluded-badge ms-1';
                    badge.textContent = 'Excluded';
                    badge.style.cssText = 'background:#dc2626;color:#fff;font-size:0.6rem;vertical-align:middle;font-weight:600;letter-spacing:0.02em;';
                    btn.appendChild(badge);
                }
            } else {
                btn.classList.remove('gap-tab-excluded');
                if (badge) badge.remove();
            }
        });
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Restore active tab from localStorage
        const savedTab = localStorage.getItem('activeGapAnalysisTab');
        if (savedTab) {
            const tabBtn = document.querySelector(`.gap-tab-btn[data-tab="${savedTab}"]`);
            if (tabBtn) {
                showTab(savedTab);
            }
        }

        refreshGapAnalysisExclusionBadges();
        if (typeof RosraStateManager !== 'undefined' && RosraStateManager.subscribe) {
            RosraStateManager.subscribe('streams', refreshGapAnalysisExclusionBadges);
        }
    });
</script>

<style>
    .gap-tab-btn.gap-tab-excluded .stream-name-label {
        text-decoration: line-through;
        opacity: 0.7;
    }
    .gap-tab-btn.gap-tab-excluded:not(.active) {
        background: #fef2f2;
        border-color: #fecaca;
    }
</style>
