<script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
<script>
// Localised strings used by the Prioritization include/exclude guard (v2 brief §6.4).
// Stashed on window so other modules on the page can reuse the same wording.
window.SharedStrings = window.SharedStrings || {};
window.SharedStrings.streamMinRequired = '@Html.Raw(SharedLocalizer["Stream_AtLeastOneRequired"].Value.Replace("'", "\\'"))';

document.addEventListener('DOMContentLoaded', function() {
    // Server-side authoritative list of generic-stream IDs that exist in the
    // currently saved/active report. RosraStateManager state can be polluted
    // with leftover generic streams from a previous session — only streams
    // listed here should be considered when this page is loaded directly.
    // Property Tax and Business License are always present and don't appear here.
    // Match the id RosraStateManager assigns: 'generic-stream-{index}'
    const validGenericStreamIds = new Set([
        @for (int i = 0; i < (Model.GenericStreams?.Count ?? 0); i++)
        {
            <text>'generic-stream-@(i)',</text>
        }
    ].filter(Boolean));

    // Stream color scheme
    const streamColors = {
        'Property Tax': '#4e79a7',
        'Business License': '#f28e2b',
        'default': '#76b7b2'
    };

    // Generic stream colors (rotating palette)
    const genericStreamPalette = ['#76b7b2', '#59a14f', '#edc948', '#b07aa1', '#ff9da7', '#9c755f', '#bab0ac'];

    // Currency symbol from AppContext (single source of truth)
    let currencySymbol = '$';

    // Get initial currency from AppContext
    function getCurrencyFromContext() {
        if (typeof AppContext !== 'undefined') {
            return AppContext.get('currencySymbol') || '$';
        }
        // Fallback to localStorage if AppContext not available
        return localStorage.getItem('selectedCurrencySymbol') || '$';
    }

    currencySymbol = getCurrencyFromContext();

    // Subscribe to currency changes from AppContext for reactive updates
    if (typeof AppContext !== 'undefined') {
        AppContext.subscribe('currencySymbol', function(newSymbol) {
            console.log('Prioritization: Currency changed to', newSymbol);
            currencySymbol = newSymbol || '$';
            // Re-render tables and charts with new currency
            renderAdjustableTable();
            renderFinalTable();
            updateCharts();
            updateStatistics();
            renderGapAmountsTable();
            renderGapSummary();
            renderMasterPriorityList();
        });
        console.log('Prioritization: Subscribed to AppContext currencySymbol changes');
    }

    // Stream data array
    let streams = [];
    let barChart = null;
    let pieChart = null;
    let paretoChart = null;
    // Hoisted up here (declared again later in the file would shadow it). Several
    // helpers — getStreamPlanStatus, the chart code, the recommendations filter —
    // access this from inside renderCombinedTable() which can run during initial
    // page setup *before* the original declaration site executed, triggering a
    // temporal-dead-zone ReferenceError. Declaring it early makes the empty
    // array the safe default until initializeGapPrioritization() populates it.
    let gapPrioritizationData = [];

    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Load stream data from RosraStateManager (preferred) or localStorage (fallback)
    function loadStreamData() {
        streams = [];
        let genericColorIndex = 0;

        // Try to use RosraStateManager first
        if (typeof RosraStateManager !== 'undefined') {
            const stateStreams = RosraStateManager.getStreams();
            if (stateStreams.length > 0) {
                // Two-stage filter:
                //   1. Drop generic streams that aren't in the server's authoritative
                //      list — those are leftovers from a previous session/report and
                //      must not appear here even if RosraStateManager localStorage
                //      still has data for them. Property Tax and Business License
                //      are fixed streams and always allowed through.
                //   2. Drop streams the user added but never entered data for
                //      (totalFunctionalGap is zero/missing).
                const populatedStreams = stateStreams.filter(s => {
                    const isFixed = s.type === 'property-tax' || s.type === 'business-license';
                    if (!isFixed && !validGenericStreamIds.has(s.id)) return false;
                    return (parseFloat(s.totalFunctionalGap) || 0) > 0;
                });

                populatedStreams.forEach((s, idx) => {
                    // Assign colors based on type
                    let color = streamColors[s.name] || streamColors['default'];
                    if (s.type === 'generic-stream') {
                        color = genericStreamPalette[genericColorIndex % genericStreamPalette.length];
                        genericColorIndex++;
                    }

                    streams.push({
                        ...s,
                        color: color
                    });
                });

                console.log('Prioritization: Loaded', streams.length, 'populated streams from RosraStateManager (skipped',
                            (stateStreams.length - populatedStreams.length), 'empty streams)');

                if (streams.length > 0) {
                    // Sort and assign default ranks
                    streams.sort((a, b) => b.totalFunctionalGap - a.totalFunctionalGap);
                    streams.forEach((stream, index) => {
                        stream.defaultRank = index + 1;
                    });
                    return;
                }
                // If RosraStateManager only contained empty streams, fall through to localStorage
            }
        }

        // Fallback to localStorage if RosraStateManager is empty
        console.log('Prioritization: Falling back to localStorage');

        // Load Property Tax data
        const propertyTaxGap = parseFloat(localStorage.getItem('propertyTaxGapValue')) || 0;
        if (propertyTaxGap > 0) {
            streams.push({
                id: 'property-tax',
                name: 'Property Tax',
                type: 'property-tax',
                totalFunctionalGap: propertyTaxGap,
                currentRevenue: parseFloat(localStorage.getItem('propertyTaxCurrentValue')) || 0,
                potentialRevenue: parseFloat(localStorage.getItem('propertyTaxPotentialValue')) || 0,
                complianceGap: parseFloat(localStorage.getItem('propertyTaxComplianceGap')) || 0,
                coverageGap: parseFloat(localStorage.getItem('propertyTaxCoverageGap')) || 0,
                valuationGap: parseFloat(localStorage.getItem('propertyTaxValuationGap')) || 0,
                complianceRatio: parseFloat(localStorage.getItem('propertyTaxComplianceRatio')) || 0,
                coverageRatio: parseFloat(localStorage.getItem('propertyTaxCoverageRatio')) || 0,
                included: true,
                adjustedRank: null,
                color: streamColors['Property Tax']
            });
        }

        // Load Business License data
        const licenseGap = parseFloat(localStorage.getItem('licenseGapValue')) || 0;
        if (licenseGap > 0) {
            streams.push({
                id: 'business-license',
                name: 'Business License',
                type: 'business-license',
                totalFunctionalGap: licenseGap,
                currentRevenue: parseFloat(localStorage.getItem('licenseCurrentValue')) || 0,
                potentialRevenue: parseFloat(localStorage.getItem('licensePotentialValue')) || 0,
                complianceGap: parseFloat(localStorage.getItem('licenseComplianceGap')) || 0,
                coverageGap: parseFloat(localStorage.getItem('licenseCoverageGap')) || 0,
                liabilityGap: parseFloat(localStorage.getItem('licenseLiabilityGap')) || 0,
                complianceRatio: parseFloat(localStorage.getItem('licenseComplianceRatio')) || 0,
                coverageRatio: parseFloat(localStorage.getItem('licenseCoverageRatio')) || 0,
                included: true,
                adjustedRank: null,
                color: streamColors['Business License']
            });
        }

        // Load Generic Streams data
        const genericStreamsJson = localStorage.getItem('genericStreamsData');
        if (genericStreamsJson) {
            try {
                const genericStreams = JSON.parse(genericStreamsJson);
                if (Array.isArray(genericStreams)) {
                    genericStreams.forEach((gs, index) => {
                        const streamId = gs.streamId || `generic-stream-${index}`;
                        if (!validGenericStreamIds.has(streamId)) return;
                        const gap = parseFloat(localStorage.getItem(streamId + 'GapValue')) || 0;
                        if (gap > 0) {
                            streams.push({
                                id: streamId,
                                name: gs.streamName || `Stream ${index + 1}`,
                                type: 'generic-stream',
                                totalFunctionalGap: gap,
                                currentRevenue: parseFloat(localStorage.getItem(streamId + 'CurrentValue')) || 0,
                                potentialRevenue: parseFloat(localStorage.getItem(streamId + 'PotentialValue')) || 0,
                                complianceGap: parseFloat(localStorage.getItem(streamId + 'ComplianceGap')) || 0,
                                coverageGap: parseFloat(localStorage.getItem(streamId + 'CoverageGap')) || 0,
                                liabilityGap: parseFloat(localStorage.getItem(streamId + 'LiabilityGap')) || 0,
                                included: true,
                                adjustedRank: null,
                                color: genericStreamPalette[genericColorIndex % genericStreamPalette.length]
                            });
                            genericColorIndex++;
                        }
                    });
                }
            } catch (e) {
                console.error('Error parsing generic streams data:', e);
            }
        }

        // Also check for individual generic stream keys
        for (let i = 0; i < 10; i++) {
            const streamId = `generic-stream-${i}`;
            if (!validGenericStreamIds.has(streamId)) continue;
            const gap = parseFloat(localStorage.getItem(streamId + 'GapValue')) || 0;
            const streamName = localStorage.getItem(streamId + 'Name');

            // Check if we already added this stream
            const alreadyExists = streams.some(s => s.id === streamId);

            if (gap > 0 && !alreadyExists) {
                streams.push({
                    id: streamId,
                    name: streamName || `Generic Stream ${i + 1}`,
                    type: 'generic-stream',
                    totalFunctionalGap: gap,
                    currentRevenue: parseFloat(localStorage.getItem(streamId + 'CurrentValue')) || 0,
                    potentialRevenue: parseFloat(localStorage.getItem(streamId + 'PotentialValue')) || 0,
                    complianceGap: parseFloat(localStorage.getItem(streamId + 'ComplianceGap')) || 0,
                    coverageGap: parseFloat(localStorage.getItem(streamId + 'CoverageGap')) || 0,
                    liabilityGap: parseFloat(localStorage.getItem(streamId + 'LiabilityGap')) || 0,
                    included: true,
                    adjustedRank: null,
                    color: genericStreamPalette[genericColorIndex % genericStreamPalette.length]
                });
                genericColorIndex++;
            }
        }

        // Sort by Total Functional Gap (descending) for default ranking
        streams.sort((a, b) => b.totalFunctionalGap - a.totalFunctionalGap);

        // Assign default ranks
        streams.forEach((stream, index) => {
            stream.defaultRank = index + 1;
        });

        return streams;
    }

    // Format currency with abbreviation for large values
    function formatCurrency(value) {
        if (value === null || value === undefined || isNaN(value)) return '-';
        var abs = Math.abs(value);
        if (abs >= 1e9) return currencySymbol + (value / 1e9).toFixed(1) + 'B';
        if (abs >= 1e6) return currencySymbol + (value / 1e6).toFixed(1) + 'M';
        if (abs >= 1e3) return currencySymbol + (value / 1e3).toFixed(1) + 'K';
        return currencySymbol + value.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }

    // Format percentage
    function formatPercent(value) {
        if (value === null || value === undefined || isNaN(value)) return '-';
        return value.toFixed(1) + '%';
    }

    // Get rank badge class
    function getRankBadgeClass(rank) {
        if (rank === 1) return 'rank-1';
        if (rank === 2) return 'rank-2';
        if (rank === 3) return 'rank-3';
        return 'rank-default';
    }

    // Convert "#rrggbb" / "#rgb" / "rgb(...)" to an rgba() string with the
    // requested alpha. Falls back to the original colour if it can't parse.
    function hexToRgba(color, alpha) {
        if (!color) return 'rgba(118, 183, 178, ' + alpha + ')';
        const s = String(color).trim();
        if (s.startsWith('rgba(')) return s.replace(/rgba\(([^)]+),\s*[\d.]+\)/, 'rgba($1, ' + alpha + ')');
        if (s.startsWith('rgb('))  return s.replace(/^rgb\(([^)]+)\)/, 'rgba($1, ' + alpha + ')');
        let hex = s.startsWith('#') ? s.slice(1) : s;
        if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
        if (hex.length !== 6) return color;
        const r = parseInt(hex.slice(0, 2), 16);
        const g = parseInt(hex.slice(2, 4), 16);
        const b = parseInt(hex.slice(4, 6), 16);
        return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
    }

    // Plan status for a stream, derived from its Step 2 Gap Sequencing entries:
    //   'full'    = all 3 priorities active (default)
    //   'partial' = 1-2 priorities removed
    //   'none'    = all 3 priorities removed
    // Falls back to 'full' if gapPrioritizationData hasn't been built yet.
    function getStreamPlanStatus(streamId) {
        if (typeof gapPrioritizationData === 'undefined') return 'full';
        const entry = gapPrioritizationData.find(g => g.streamId === streamId);
        if (!entry || !Array.isArray(entry.currentSequence) || entry.currentSequence.length === 0) return 'full';
        const removedCount = entry.currentSequence.filter(s => s && s.removed).length;
        if (removedCount === 0) return 'full';
        if (removedCount >= entry.currentSequence.length) return 'none';
        return 'partial';
    }

    // Render Adjustable Stream Table
    // ===== COMBINED PRIORITIZATION TABLE (drag-and-drop + up/down arrows) =====
    // Sorts included streams by manualRank (initialised from defaultRank), excluded streams to the bottom.
    function renderCombinedTable() {
        const tbody = document.getElementById('combinedStreamBody');
        const footer = document.getElementById('combinedStreamFooter');
        if (!tbody) return;

        if (streams.length === 0) {
            tbody.innerHTML = `
                <tr class="placeholder-row">
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(Localizer["Prio_NoStreamData"].Value)
                    </td>
                </tr>`;
            if (footer) footer.style.display = 'none';
            return;
        }

        // Initialise manualRank for any stream that doesn't have one
        streams.forEach(s => {
            if (s.included && (s.manualRank == null || isNaN(s.manualRank))) {
                s.manualRank = s.adjustedRank || s.defaultRank || 999;
            }
            if (!s.included) s.manualRank = null;
        });

        const includedOrdered = streams.filter(s => s.included)
            .slice()
            .sort((a, b) => (a.manualRank || 999) - (b.manualRank || 999));
        // Renumber sequentially so manualRank is always 1..N with no gaps
        includedOrdered.forEach((s, idx) => { s.manualRank = idx + 1; s.adjustedRank = idx + 1; });

        const excluded = streams.filter(s => !s.included);
        const ordered = [...includedOrdered, ...excluded];
        const totalGap = includedOrdered.reduce((sum, s) => sum + s.totalFunctionalGap, 0);

        let html = '';
        ordered.forEach((stream) => {
            const isIncluded = stream.included;
            const idxInIncluded = isIncluded ? includedOrdered.indexOf(stream) : -1;
            const isFirstIncluded = idxInIncluded === 0;
            const isLastIncluded = idxInIncluded === includedOrdered.length - 1;
            const sharePct = (isIncluded && totalGap > 0) ? (stream.totalFunctionalGap / totalGap) * 100 : 0;

            // Plan status — derived from this stream's Step 2 Gap Sequencing.
            // 'full'    = all 3 priorities active
            // 'partial' = 1-2 priorities removed
            // 'none'    = all 3 priorities removed (a fully-empty plan)
            const planStatus = (typeof getStreamPlanStatus === 'function')
                ? getStreamPlanStatus(stream.id) : 'full';

            const rowClasses = [
                'priority-row',
                !isIncluded ? 'excluded-row' : '',
                isIncluded && planStatus === 'none'    ? 'plan-empty-row'   : '',
                isIncluded && planStatus === 'partial' ? 'plan-partial-row' : ''
            ].filter(Boolean).join(' ');

            // Badge shown next to the stream name describing the plan state.
            let planBadgeHtml = '';
            if (isIncluded && planStatus === 'partial') {
                planBadgeHtml = `<span class="plan-status-badge plan-status-partial" title="One or more gap priorities are set to (Remove) in Step 2 Gap Sequencing.">Partial plan</span>`;
            } else if (isIncluded && planStatus === 'none') {
                planBadgeHtml = `<span class="plan-status-badge plan-status-empty" title="All gap priorities are set to (Remove) in Step 2 Gap Sequencing — this stream has no actionable plan.">No plan</span>`;
            }

            html += `
                <tr class="${rowClasses}" data-stream-id="${stream.id}" draggable="${isIncluded}">
                    <td class="drag-handle-cell text-center align-middle">
                        ${isIncluded ? '<i class="bi bi-grip-vertical drag-handle" aria-hidden="true" title="Drag to re-rank"></i>' : ''}
                    </td>
                    <td class="text-center align-middle">
                        ${isIncluded
                            ? `<span class="rank-badge ${getRankBadgeClass(stream.manualRank)}">${stream.manualRank}</span>`
                            : `<span class="text-muted">—</span>`}
                    </td>
                    <td class="align-middle">
                        <span class="stream-badge ${stream.type}"></span>
                        <span class="stream-name-text">${stream.name}</span>
                        ${planBadgeHtml}
                    </td>
                    <td class="text-end fw-semibold align-middle">${formatCurrency(stream.totalFunctionalGap)}</td>
                    <td class="align-middle">
                        ${isIncluded ? `
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-semibold" style="min-width: 52px;">${formatPercent(sharePct)}</span>
                                <div class="share-bar flex-grow-1">
                                    <div class="share-bar-fill" style="width: ${sharePct}%; background-color: ${stream.color};"></div>
                                </div>
                            </div>` : '<span class="text-muted">—</span>'}
                    </td>
                    <td class="text-center align-middle">
                        <select class="form-select form-select-sm dropdown-include-exclude"
                                data-stream-id="${stream.id}"
                                onchange="window.handleIncludeExcludeChange(this)">
                            <option value="include" ${isIncluded ? 'selected' : ''}>Include</option>
                            <option value="exclude" ${!isIncluded ? 'selected' : ''}>Exclude</option>
                        </select>
                    </td>
                    <td class="text-center align-middle">
                        ${isIncluded ? `
                            <button type="button" class="btn btn-outline-secondary btn-sm rank-arrow-btn"
                                    data-stream-id="${stream.id}" data-direction="up"
                                    ${isFirstIncluded ? 'disabled' : ''} aria-label="Move up">
                                <i class="bi bi-arrow-up"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rank-arrow-btn ms-1"
                                    data-stream-id="${stream.id}" data-direction="down"
                                    ${isLastIncluded ? 'disabled' : ''} aria-label="Move down">
                                <i class="bi bi-arrow-down"></i>
                            </button>
                        ` : '<span class="text-muted">—</span>'}
                    </td>
                </tr>`;
        });

        tbody.innerHTML = html;
        attachPriorityRowHandlers();

        if (footer) {
            if (includedOrdered.length > 0) {
                footer.style.display = '';
                const totalEl = document.getElementById('totalIncludedGap');
                if (totalEl) totalEl.textContent = formatCurrency(totalGap);
            } else {
                footer.style.display = 'none';
            }
        }
    }

    // Backwards-compatible aliases used elsewhere in this file
    function renderAdjustableTable() { renderCombinedTable(); }
    function renderFinalTable()      { renderCombinedTable(); }

    // ----- Drag-and-drop + arrow handlers for the combined table -----
    function attachPriorityRowHandlers() {
        const tbody = document.getElementById('combinedStreamBody');
        if (!tbody) return;

        let draggedRow = null;
        tbody.querySelectorAll('tr[draggable="true"]').forEach(row => {
            row.addEventListener('dragstart', (e) => {
                draggedRow = row;
                row.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
                try { e.dataTransfer.setData('text/plain', row.dataset.streamId); } catch (_) {}
            });
            row.addEventListener('dragend', () => {
                row.classList.remove('dragging');
                tbody.querySelectorAll('.drag-over').forEach(r => r.classList.remove('drag-over'));
                draggedRow = null;
            });
            row.addEventListener('dragover', (e) => {
                if (!draggedRow || draggedRow === row) return;
                if (row.classList.contains('excluded-row')) return; // can't drop onto excluded
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                row.classList.add('drag-over');
            });
            row.addEventListener('dragleave', () => row.classList.remove('drag-over'));
            row.addEventListener('drop', (e) => {
                e.preventDefault();
                row.classList.remove('drag-over');
                if (!draggedRow || draggedRow === row) return;
                reorderStreamByDrop(draggedRow.dataset.streamId, row.dataset.streamId);
            });
        });

        // Arrow buttons
        tbody.querySelectorAll('.rank-arrow-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                moveStreamByArrow(btn.dataset.streamId, btn.dataset.direction);
            });
        });
    }

    function reorderStreamByDrop(fromId, toId) {
        const fromStream = streams.find(s => s.id === fromId);
        const toStream   = streams.find(s => s.id === toId);
        if (!fromStream || !toStream || !fromStream.included || !toStream.included) return;

        const list = streams.filter(s => s.included)
            .slice()
            .sort((a, b) => (a.manualRank || 999) - (b.manualRank || 999));
        const fromIdx = list.indexOf(fromStream);
        const toIdx   = list.indexOf(toStream);
        if (fromIdx < 0 || toIdx < 0) return;
        list.splice(fromIdx, 1);
        list.splice(toIdx, 0, fromStream);
        list.forEach((s, i) => { s.manualRank = i + 1; s.adjustedRank = i + 1; });

        afterPriorityChange();
    }

    function moveStreamByArrow(streamId, direction) {
        const stream = streams.find(s => s.id === streamId);
        if (!stream || !stream.included) return;
        const list = streams.filter(s => s.included)
            .slice()
            .sort((a, b) => (a.manualRank || 999) - (b.manualRank || 999));
        const idx = list.indexOf(stream);
        const target = direction === 'up' ? idx - 1 : idx + 1;
        if (target < 0 || target >= list.length) return;
        [list[idx], list[target]] = [list[target], list[idx]];
        list.forEach((s, i) => { s.manualRank = i + 1; s.adjustedRank = i + 1; });

        afterPriorityChange();
    }

    function afterPriorityChange() {
        renderCombinedTable();
        updateCharts();
        updateStatistics();
        // Propagate ranks to RosraStateManager so Recommendations / Overview stay in sync
        if (typeof RosraStateManager !== 'undefined') {
            streams.forEach(s => {
                RosraStateManager.setStreamRank(s.id, s.included ? s.manualRank : null);
            });
        }
        savePrioritizationState();
    }

    // Generate rank options
    function generateRankOptions(totalStreams, selectedRank) {
        let options = '';
        for (let i = 1; i <= totalStreams; i++) {
            const selected = selectedRank === i ? 'selected' : '';
            options += `<option value="${i}" ${selected}>${i}</option>`;
        }
        return options;
    }

    // Handle Include/Exclude change
    window.handleIncludeExcludeChange = function(selectElement) {
        const streamId = selectElement.dataset.streamId;
        const included = selectElement.value === 'include';

        // v2 brief §6.4: at least one stream must remain included so the diagnostic
        // is still meaningful. Block the exclusion + revert the select if this
        // would zero everything out.
        if (!included) {
            const remainingIncluded = streams.filter(s => s.included && s.id !== streamId).length;
            if (remainingIncluded < 1) {
                const msg = (window.SharedStrings && window.SharedStrings.streamMinRequired)
                    || 'At least one revenue stream must remain included to generate the diagnostic.';
                alert(msg);
                selectElement.value = 'include';
                return;
            }
        }

        // Update stream data
        const stream = streams.find(s => s.id === streamId);
        if (stream) {
            stream.included = included;
            if (!included) {
                stream.adjustedRank = null;
                stream.manualRank = null;
            }
        }

        // Re-render the whole combined table — it rebuilds rows from `streams`
        // (with included rows on top and excluded rows pushed to the bottom),
        // so we don't need to fiddle with the row's classes manually.
        renderFinalTable();
        updateCharts();
        updateStatistics();

        // Propagate to RosraStateManager so Overview and Recommendations respect the decision
        if (typeof RosraStateManager !== 'undefined') {
            RosraStateManager.setStreamIncluded(streamId, included);
            if (!included) {
                RosraStateManager.setStreamRank(streamId, null);
            }
        }

        // Save state
        savePrioritizationState();
    };

    // Handle Adjust Rank change
    window.handleAdjustRankChange = function(selectElement) {
        const streamId = selectElement.dataset.streamId;
        const newRank = selectElement.value ? parseInt(selectElement.value) : null;

        // Update stream data
        const stream = streams.find(s => s.id === streamId);
        if (stream) {
            stream.adjustedRank = newRank;
        }

        // Recalculate and render
        renderFinalTable();
        updateCharts();

        // Save state
        savePrioritizationState();
    };

    // Calculate final rankings
    function calculateFinalRankings() {
        const includedStreams = streams.filter(s => s.included);

        // Separate streams with and without adjusted ranks
        const adjustedStreams = includedStreams.filter(s => s.adjustedRank !== null);
        const autoStreams = includedStreams.filter(s => s.adjustedRank === null);

        // Sort auto streams by gap (descending)
        autoStreams.sort((a, b) => b.totalFunctionalGap - a.totalFunctionalGap);

        // Create final ranking array
        const finalRanking = [];
        const usedRanks = new Set(adjustedStreams.map(s => s.adjustedRank));

        // Place adjusted streams first
        adjustedStreams.forEach(stream => {
            finalRanking.push({
                ...stream,
                finalRank: stream.adjustedRank
            });
        });

        // Fill in auto streams with remaining ranks
        let autoRank = 1;
        autoStreams.forEach(stream => {
            while (usedRanks.has(autoRank)) {
                autoRank++;
            }
            finalRanking.push({
                ...stream,
                finalRank: autoRank
            });
            usedRanks.add(autoRank);
            autoRank++;
        });

        // Sort by final rank
        finalRanking.sort((a, b) => a.finalRank - b.finalRank);

        // Calculate share of total gap
        const totalGap = finalRanking.reduce((sum, s) => sum + s.totalFunctionalGap, 0);
        finalRanking.forEach(stream => {
            stream.shareOfTotalGap = totalGap > 0 ? (stream.totalFunctionalGap / totalGap) * 100 : 0;
        });

        return { finalRanking, totalGap };
    }

    // The original renderFinalTable() now lives inside renderCombinedTable().
    // This stub is intentionally left blank so callers can be safely renamed without breakage.
    // (Backwards-compat alias is defined further up next to renderCombinedTable.)

    // Update Charts
    function updateCharts() {
        const { finalRanking, totalGap } = calculateFinalRankings();

        // Get placeholder and canvas elements
        const barPlaceholder = document.getElementById('barChartPlaceholder');
        const piePlaceholder = document.getElementById('pieChartPlaceholder');
        const barCanvas = document.getElementById('gapBarChart');
        const pieCanvas = document.getElementById('gapPieChart');

        // Destroy existing charts
        if (barChart) barChart.destroy();
        if (pieChart) pieChart.destroy();

        if (finalRanking.length === 0) {
            // Show placeholders, hide canvases
            if (barPlaceholder) barPlaceholder.style.display = 'block';
            if (piePlaceholder) piePlaceholder.style.display = 'block';
            if (barCanvas) barCanvas.style.display = 'none';
            if (pieCanvas) pieCanvas.style.display = 'none';
            // Pareto empty state
            const ptPlaceholder = document.getElementById('gapParetoPlaceholder');
            const ptWrap = document.getElementById('gapParetoWrap');
            if (ptPlaceholder) ptPlaceholder.style.display = 'block';
            if (ptWrap) ptWrap.style.display = 'none';
            if (paretoChart) { paretoChart.destroy(); paretoChart = null; }
            return;
        }

        // Hide placeholders, show canvases
        if (barPlaceholder) barPlaceholder.style.display = 'none';
        if (piePlaceholder) piePlaceholder.style.display = 'none';
        if (barCanvas) barCanvas.style.display = 'block';
        if (pieCanvas) pieCanvas.style.display = 'block';

        // Annotate each stream with its plan status so we can mute the bar
        // colour when the user has removed all of a stream's priorities (no plan)
        // or some of them (partial plan). Keeping the rank/total stable preserves
        // the Step 1 truth — only the visual weight changes.
        const planStatuses = finalRanking.map(s => getStreamPlanStatus(s.id));
        const labels = finalRanking.map((s, i) => {
            const ps = planStatuses[i];
            if (ps === 'none')    return s.name + '  (no plan)';
            if (ps === 'partial') return s.name + '  (partial plan)';
            return s.name;
        });
        const shareData = finalRanking.map(s => s.shareOfTotalGap);
        const baseColors = finalRanking.map(s => s.color);

        // Helper: alpha multiplier reflecting the stream's plan status.
        function planAlpha(idx) {
            const ps = planStatuses[idx];
            if (ps === 'none')    return 0.25;
            if (ps === 'partial') return 0.55;
            return 1;
        }
        // Helper: stream gap value resilient to property-tax vs non-property fields.
        function gapValue(stream, key) {
            switch (key) {
                case 'compliance': return stream.complianceGap || 0;
                case 'coverage':   return stream.coverageGap || 0;
                case 'thirdGap':   return stream.type === 'property-tax'
                                    ? (stream.valuationGap || 0)
                                    : (stream.liabilityGap || 0);
                case 'mixedComp':  return (stream.mixedGapCompliance != null ? stream.mixedGapCompliance
                                         : stream.mixedGapReg) || 0;
                case 'mixedCov':   return (stream.mixedGapCoverage   != null ? stream.mixedGapCoverage
                                         : stream.mixedGapUnreg) || 0;
                default: return 0;
            }
        }

        // Stacked breakdown of each stream's Total Functional Gap. Each segment
        // is an individual gap-type — same colour palette as the Gap Analysis
        // doughnut/breakdown charts so the visual language is consistent.
        const gapSeries = [
            { key: 'compliance', label: 'Compliance Gap',         color: '#F44336' },
            { key: 'coverage',   label: 'Coverage Gap',           color: '#FF9800' },
            { key: 'thirdGap',   label: 'Valuation / Liability',  color: '#3b82f6' },
            { key: 'mixedComp',  label: 'Mixed (Compliance)',     color: '#9C27B0' },
            { key: 'mixedCov',   label: 'Mixed (Coverage)',       color: '#E91E63' }
        ];

        // ----- Polished horizontal stacked bar (rebuilt). -----
        // Streams sorted by total gap descending. Each row is a stream; coloured
        // segments show gap-type composition; total amount rendered at the end of
        // each bar. Plan status is encoded both in the label suffix ("(no plan)" /
        // "(partial plan)") and in colour opacity (no plan = faded).
        (function renderStackedSummary() {
            const canvas = document.getElementById('gapParetoChart');
            const wrap = document.getElementById('gapParetoWrap');
            const placeholder = document.getElementById('gapParetoPlaceholder');
            if (!canvas) return;
            if (placeholder) placeholder.style.display = 'none';
            if (wrap) wrap.style.display = 'block';

            // Sort streams by total gap descending so the biggest opportunity is on top.
            const sortedRanking = finalRanking
                .map(s => ({ stream: s, total: gapSeries.reduce((sum, g) => sum + gapValue(s, g.key), 0) }))
                .sort((a, b) => b.total - a.total)
                .map(x => x.stream);

            // Re-derive plan statuses + labels in the new sort order.
            const sortedStatuses = sortedRanking.map(s => getStreamPlanStatus(s.id));
            const sortedLabels = sortedRanking.map((s, i) => {
                const ps = sortedStatuses[i];
                if (ps === 'none')    return s.name + '  (no plan)';
                if (ps === 'partial') return s.name + '  (partial plan)';
                return s.name;
            });
            function sortedAlpha(idx) {
                const ps = sortedStatuses[idx];
                if (ps === 'none')    return 0.25;
                if (ps === 'partial') return 0.55;
                return 1;
            }

            const sortedDatasets = gapSeries.map(gs => ({
                label: gs.label,
                data: sortedRanking.map(s => gapValue(s, gs.key)),
                backgroundColor: sortedRanking.map((_, i) => hexToRgba(gs.color, sortedAlpha(i))),
                borderWidth: 0,
                stack: 'total'
            }));

            // Set canvas height proportional to row count (so bars stay ~36px tall).
            const rowH = 44;
            wrap.style.height = (60 + sortedRanking.length * rowH) + 'px';

            // Custom plugin: draw the stream's TOTAL amount just past the right edge of each bar.
            const totalLabelsPlugin = {
                id: 'streamTotalLabels',
                afterDatasetsDraw: function (chart) {
                    const ctx = chart.ctx;
                    // Pull the last visible dataset meta to find the right edge of each bar.
                    const lastDsIdx = chart.data.datasets.length - 1;
                    const lastMeta = chart.getDatasetMeta(lastDsIdx);
                    if (!lastMeta || !lastMeta.data) return;
                    ctx.save();
                    ctx.font = '700 12px Roboto, "Segoe UI", Arial, sans-serif';
                    ctx.fillStyle = '#1f2937';
                    ctx.textAlign = 'left';
                    ctx.textBaseline = 'middle';
                    sortedRanking.forEach((s, i) => {
                        const total = sortedDatasets.reduce((sum, ds) => sum + (ds.data[i] || 0), 0);
                        if (total <= 0) return;
                        // Bar's right edge = last segment's right boundary.
                        const bar = lastMeta.data[i];
                        if (!bar) return;
                        ctx.fillText('  ' + formatCurrency(total), bar.x + 4, bar.y);
                    });
                    ctx.restore();
                }
            };

            if (paretoChart) paretoChart.destroy();
            paretoChart = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: { labels: sortedLabels, datasets: sortedDatasets },
                plugins: [totalLabelsPlugin],
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { right: 90 } }, // room for end-of-bar total labels
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: { boxWidth: 14, boxHeight: 14, font: { size: 12 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    const amt = ctx.parsed.x || 0;
                                    if (amt === 0) return null;
                                    return ctx.dataset.label + ': ' + formatCurrency(amt);
                                },
                                footer: function (items) {
                                    if (!items || !items.length) return '';
                                    const idx = items[0].dataIndex;
                                    const total = sortedDatasets.reduce((sum, ds) => sum + (ds.data[idx] || 0), 0);
                                    return 'Total: ' + formatCurrency(total);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: {
                                font: { size: 11, weight: '700' },
                                color: '#1f2937',
                                callback: function (v) {
                                    var abs = Math.abs(v);
                                    if (abs >= 1e9) return currencySymbol + (v / 1e9).toFixed(1) + 'B';
                                    if (abs >= 1e6) return currencySymbol + (v / 1e6).toFixed(1) + 'M';
                                    if (abs >= 1e3) return currencySymbol + (v / 1e3).toFixed(0) + 'K';
                                    return currencySymbol + v;
                                }
                            },
                            grid: { color: '#eef0f3' }
                        },
                        y: {
                            stacked: true,
                            ticks: {
                                font: { size: 13, weight: '700' },
                                color: '#1f2937',
                                padding: 8
                            },
                            grid: { display: false }
                        }
                    }
                }
            });
            if (window.registerChart) registerChart('gapParetoChart', paretoChart);
        })();

        const datasets = gapSeries.map(gs => ({
            label: gs.label,
            data: finalRanking.map(s => gapValue(s, gs.key)),
            backgroundColor: finalRanking.map((_, i) => hexToRgba(gs.color, planAlpha(i))),
            borderColor: finalRanking.map((_, i) => hexToRgba(gs.color, Math.max(planAlpha(i), 0.6))),
            borderWidth: 0,
            stack: 'total'
        }));

        // Bar Chart (horizontal, stacked)
        const barCtx = document.getElementById('gapBarChart').getContext('2d');
        barChart = new Chart(barCtx, {
            type: 'bar',
            data: { labels: labels, datasets: datasets },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { boxWidth: 12, boxHeight: 12, font: { size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const amt = context.parsed.x || 0;
                                if (amt === 0) return null; // hide empty segments
                                return context.dataset.label + ': ' + formatCurrency(amt);
                            },
                            // Show each stream's total in the footer of the tooltip
                            footer: function(items) {
                                if (!items || !items.length) return '';
                                const idx = items[0].dataIndex;
                                const total = datasets.reduce((sum, ds) => sum + (ds.data[idx] || 0), 0);
                                return 'Total: ' + formatCurrency(total);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                var abs = Math.abs(value);
                                if (abs >= 1e9) return currencySymbol + (value / 1e9).toFixed(1) + 'B';
                                if (abs >= 1e6) return currencySymbol + (value / 1e6).toFixed(1) + 'M';
                                if (abs >= 1e3) return currencySymbol + (value / 1e3).toFixed(0) + 'K';
                                return currencySymbol + value;
                            }
                        }
                    },
                    y: {
                        stacked: true
                    }
                }
            }
        });
        if (window.registerChart) registerChart('gapBarChart', barChart);

        // Pie Chart — share of total gap per stream (per-stream colour palette)
        const pieFillColors = baseColors.map((c, i) => hexToRgba(c, planAlpha(i)));
        const pieCtx = document.getElementById('gapPieChart').getContext('2d');
        pieChart = new Chart(pieCtx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: shareData,
                    backgroundColor: pieFillColors,
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + formatPercent(context.raw);
                            }
                        }
                    }
                }
            }
        });
        if (window.registerChart) registerChart('gapPieChart', pieChart);
    }

    // Update Statistics
    function updateStatistics() {
        const includedStreams = streams.filter(s => s.included);
        const totalGapAll = streams.reduce((sum, s) => sum + s.totalFunctionalGap, 0);
        const totalGapIncluded = includedStreams.reduce((sum, s) => sum + s.totalFunctionalGap, 0);

        document.getElementById('statTotalStreams').textContent = streams.length;
        document.getElementById('statIncludedStreams').textContent = includedStreams.length;
        document.getElementById('statTotalGap').textContent = formatCurrency(totalGapAll);
        document.getElementById('statIncludedGap').textContent = formatCurrency(totalGapIncluded);
    }

    // ======================= STATE PERSISTENCE =======================

    // Save prioritization state to FormStateManager (and localStorage backup)
    function savePrioritizationState() {
        try {
            // Build state object with stream customizations and gap priorities
            const state = {
                streamCustomizations: streams.map(s => ({
                    id: s.id,
                    included: s.included,
                    adjustedRank: s.adjustedRank
                })),
                gapPrioritization: gapPrioritizationData.map(g => ({
                    streamId: g.streamId,
                    currentSequence: g.currentSequence.map(seq => ({
                        type: seq.type,
                        removed: seq.removed,
                        isOverridden: seq.isOverridden
                    }))
                }))
            };

            // Use FormStateManager if available (preferred)
            if (typeof FormStateManager !== 'undefined') {
                FormStateManager.setData('prioritizationState', state);
                console.log('Prioritization: State saved via FormStateManager');
            } else {
                // Fallback to localStorage only
                localStorage.setItem('prioritizationState', JSON.stringify(state));
                console.log('Prioritization: State saved to localStorage');
            }
        } catch (e) {
            console.error('Prioritization: Error saving state', e);
        }
    }

    // Load prioritization state from FormStateManager (or localStorage fallback).
    //
    // The hidden form field that FormStateManager reads first carries the
    // server-rendered state of the saved report, which on sample / older
    // reports uses a legacy shape ({ streams: [...] }) with no
    // streamCustomizations / gapPrioritization arrays. The user's actual
    // include/exclude + (Remove) decisions on this session live in
    // localStorage (savePrioritizationState writes there too as a backup).
    // So if FormStateManager's value lacks BOTH expected arrays, fall through
    // to localStorage instead of returning the legacy stub.
    function loadPrioritizationState() {
        try {
            let state = null;

            if (typeof FormStateManager !== 'undefined') {
                const fromForm = FormStateManager.getData('prioritizationState');
                if (fromForm && (Array.isArray(fromForm.streamCustomizations)
                              || Array.isArray(fromForm.gapPrioritization))) {
                    state = fromForm;
                    console.log('Prioritization: State loaded via FormStateManager');
                }
            }

            if (!state) {
                const localData = localStorage.getItem('prioritizationState');
                if (localData) {
                    const parsed = JSON.parse(localData);
                    if (parsed && (Array.isArray(parsed.streamCustomizations)
                                || Array.isArray(parsed.gapPrioritization))) {
                        state = parsed;
                        console.log('Prioritization: State loaded from localStorage');
                    }
                }
            }

            return state;
        } catch (e) {
            console.error('Prioritization: Error loading state', e);
            return null;
        }
    }

    // Apply saved state to streams
    function applySavedState() {
        const state = loadPrioritizationState();
        if (!state) return false;

        let stateApplied = false;

        // Apply stream customizations (include/exclude, adjusted ranks)
        if (state.streamCustomizations && streams.length > 0) {
            state.streamCustomizations.forEach(saved => {
                const stream = streams.find(s => s.id === saved.id);
                if (stream) {
                    stream.included = saved.included;
                    stream.adjustedRank = saved.adjustedRank;
                    stateApplied = true;

                    // Keep RosraStateManager in sync with restored state
                    if (typeof RosraStateManager !== 'undefined') {
                        RosraStateManager.setStreamIncluded(saved.id, saved.included);
                        if (!saved.included) {
                            RosraStateManager.setStreamRank(saved.id, null);
                        }
                    }
                }
            });
        }

        return stateApplied;
    }

    // Apply saved gap prioritization state
    function applySavedGapPrioritization() {
        const state = loadPrioritizationState();
        if (!state || !state.gapPrioritization) return;

        state.gapPrioritization.forEach(saved => {
            const gapData = gapPrioritizationData.find(g => g.streamId === saved.streamId);
            if (gapData && saved.currentSequence) {
                saved.currentSequence.forEach((seq, idx) => {
                    if (gapData.currentSequence[idx]) {
                        // Only apply if it has been overridden
                        if (seq.isOverridden) {
                            gapData.currentSequence[idx].type = seq.type;
                            gapData.currentSequence[idx].removed = seq.removed;
                            gapData.currentSequence[idx].isOverridden = seq.isOverridden;
                            // Update the amount based on the type
                            if (!seq.removed && seq.type !== 'Remove') {
                                gapData.currentSequence[idx].amount = gapData.gaps[seq.type] || 0;
                            }
                        }
                    }
                });
            }
        });

        console.log('Prioritization: Gap prioritization state applied');
    }

    // Initialize module
    function initializePrioritization() {
        loadStreamData();
        // Apply saved stream customizations (include/exclude, ranks) after loading streams
        applySavedState();
        renderAdjustableTable();
        renderFinalTable();
        updateCharts();
        updateStatistics();
    }

    // Initialize on load
    initializePrioritization();

    // Subscribe to RosraStateManager for reactive updates (preferred method)
    if (typeof RosraStateManager !== 'undefined') {
        RosraStateManager.subscribe('streams', function(updatedStreams) {
            console.log('Prioritization: Received stream update from RosraStateManager');
            loadStreamData();
            renderAdjustableTable();
            renderFinalTable();
            updateCharts();
            updateStatistics();
            initializeGapPrioritization();
        });
        console.log('Prioritization: Subscribed to RosraStateManager');
    }

    // Listen for storage changes (fallback for backward compatibility)
    window.addEventListener('storage', function(e) {
        if (e.key && (e.key.includes('Gap') || e.key.includes('Value') || e.key.includes('generic'))) {
            loadStreamData();
            renderAdjustableTable();
            renderFinalTable();
            updateCharts();
            updateStatistics();
        }
    });

    // Listen for gapDataReady event (fired by print pages after gap calculations complete)
    window.addEventListener('gapDataReady', function() {
        console.log('Prioritization: gapDataReady event received, re-initializing');
        initializePrioritization();
        initializeGapPrioritization();
    });

    // Also listen for custom events from gap analysis tabs
    window.addEventListener('gapAnalysisUpdated', function() {
        loadStreamData();
        renderAdjustableTable();
        renderFinalTable();
        updateCharts();
        updateStatistics();
        initializeGapPrioritization();
    });

    // ======================= GAP PRIORITIZATION (STEP 2) =======================

    // Gap prioritization data structure — declared near the top of this script
    // block so early renderCombinedTable() calls don't hit a TDZ ReferenceError.

    // Internal default-gap-sequencer. The returned `mode` string is no longer
    // surfaced in the UI (the Mode column, badge chips, and explanation
    // accordion were removed) but the ratio-based classification still drives
    // the default gap ordering for each stream. The mode field also persists
    // in saved-report data so older snapshots continue to load.
    function determineMode(stream) {
        // Calculate compliance ratio: Revenue / Billed
        const billedAmount = stream.complianceGap + stream.currentRevenue;
        const complianceRatio = billedAmount > 0 ? (stream.currentRevenue / billedAmount) : 0;

        // Calculate coverage ratio: Registered / Estimated Total
        // For simplicity, use 1 - (coverageGap / totalPotential) as proxy
        const totalPotential = stream.potentialRevenue || (stream.totalFunctionalGap + stream.currentRevenue);
        const coverageRatio = totalPotential > 0 ? 1 - (stream.coverageGap / totalPotential) : 0;

        // Store ratios for display
        stream.complianceRatio = complianceRatio;
        stream.coverageRatio = coverageRatio;

        // Get the third gap label based on stream type
        const isPropertyBased = stream.type === 'property-tax';
        const thirdGapLabel = isPropertyBased ? 'Valuation' : 'Liability';
        const thirdGapValue = isPropertyBased ? (stream.valuationGap || 0) : (stream.liabilityGap || 0);

        // Build gaps array
        const gaps = [
            { type: 'Compliance', amount: stream.complianceGap || 0 },
            { type: 'Coverage', amount: stream.coverageGap || 0 },
            { type: thirdGapLabel, amount: thirdGapValue }
        ];

        let mode, sequence;

        if (complianceRatio >= 0.75) {
            // Revenue potential mode - sort by amount descending
            mode = 'Revenue Potential';
            sequence = [...gaps].sort((a, b) => b.amount - a.amount);
        } else if (coverageRatio >= 0.60) {
            // Compliance first mode
            mode = 'Compliance First';
            sequence = [
                gaps.find(g => g.type === 'Compliance'),
                gaps.find(g => g.type === 'Coverage'),
                gaps.find(g => g.type === thirdGapLabel)
            ];
        } else {
            // Overhaul mode - coverage first
            mode = 'Overhaul';
            sequence = [
                gaps.find(g => g.type === 'Coverage'),
                gaps.find(g => g.type === 'Compliance'),
                gaps.find(g => g.type === thirdGapLabel)
            ];
        }

        return {
            mode,
            sequence,
            thirdGapLabel,
            complianceRatio,
            coverageRatio
        };
    }

    // Get gap badge class
    function getGapBadgeClass(gapType) {
        if (!gapType || gapType === 'Remove') return 'gap-removed';
        switch (gapType) {
            case 'Compliance': return 'gap-compliance';
            case 'Coverage': return 'gap-coverage';
            case 'Valuation': return 'gap-valuation';
            case 'Liability': return 'gap-liability';
            default: return '';
        }
    }

    // Initialize gap prioritization data from included streams
    function initializeGapPrioritization() {
        const { finalRanking } = calculateFinalRankings();
        gapPrioritizationData = [];

        finalRanking.forEach((stream, index) => {
            const modeInfo = determineMode(stream);

            gapPrioritizationData.push({
                streamId: stream.id,
                streamName: stream.name,
                streamType: stream.type,
                finalRank: stream.finalRank,
                mode: modeInfo.mode,
                thirdGapLabel: modeInfo.thirdGapLabel,
                complianceRatio: modeInfo.complianceRatio,
                coverageRatio: modeInfo.coverageRatio,
                defaultSequence: modeInfo.sequence.map(g => g.type),
                currentSequence: modeInfo.sequence.map(g => ({ ...g, isOverridden: false, removed: false })),
                gaps: {
                    Compliance: stream.complianceGap || 0,
                    Coverage: stream.coverageGap || 0,
                    [modeInfo.thirdGapLabel]: modeInfo.thirdGapLabel === 'Valuation' ? (stream.valuationGap || 0) : (stream.liabilityGap || 0)
                }
            });
        });

        // Apply saved gap prioritization state (overrides)
        applySavedGapPrioritization();

        renderGapSequencingTable();
        renderGapAmountsTable();
        renderGapSummary();
        renderMasterPriorityList();

        // gapPrioritizationData is now populated, so the Stream Prioritization
        // table and the bar chart can pick up the "Partial plan" / "No plan"
        // signals on initial page load (otherwise they stay 'full' until the
        // user changes a priority).
        renderFinalTable();
        updateCharts();
    }

    // Generate gap dropdown options
    function generateGapOptions(streamData, currentGap, priorityIndex) {
        const options = ['Compliance', 'Coverage', streamData.thirdGapLabel];
        let html = '';

        // Get already used gaps (excluding current position)
        const usedGaps = streamData.currentSequence
            .filter((g, i) => i !== priorityIndex && !g.removed && g.type !== 'Remove')
            .map(g => g.type);

        options.forEach(opt => {
            const disabled = usedGaps.includes(opt) ? 'disabled' : '';
            const selected = currentGap === opt ? 'selected' : '';
            html += `<option value="${opt}" ${selected} ${disabled}>${opt}</option>`;
        });

        // Add Remove option
        const removeSelected = currentGap === 'Remove' || !currentGap ? 'selected' : '';
        html += `<option value="Remove" ${removeSelected}>(Remove)</option>`;

        return html;
    }

    // Render Gap Sequencing Table
    function renderGapSequencingTable() {
        const tbody = document.getElementById('gapSequencingBody');

        if (gapPrioritizationData.length === 0) {
            tbody.innerHTML = `
                <tr class="placeholder-row">
                    <td colspan="5" class="text-center text-muted py-4">
                        <i class="fas fa-info-circle me-2"></i>@Html.Raw(Localizer["GapSequencing_Placeholder"].Value)
                    </td>
                </tr>
            `;
            return;
        }

        let html = '';
        gapPrioritizationData.forEach((stream) => {
            html += `
                <tr data-stream-id="${stream.streamId}">
                    <td class="text-center">
                        <span class="rank-badge ${getRankBadgeClass(stream.finalRank)}">${stream.finalRank}</span>
                    </td>
                    <td>
                        <span class="stream-badge ${stream.streamType}"></span>
                        ${stream.streamName}
                    </td>
                    ${renderPriorityCell(stream, 0)}
                    ${renderPriorityCell(stream, 1)}
                    ${renderPriorityCell(stream, 2)}
                </tr>
            `;
        });

        tbody.innerHTML = html;
        attachGapPriorityCellHandlers();
    }

    // Render individual priority cell — combined cell shows the dropdown AND the amount.
    // Each cell is also a drop target for the intra-row drag-and-drop reorder, and
    // exposes a left/right arrow pair so the user can shift a priority by one slot
    // without dragging.
    function renderPriorityCell(stream, priorityIndex) {
        const gapData = stream.currentSequence[priorityIndex];
        const gapType = gapData ? gapData.type : null;
        const isRemoved = gapData ? gapData.removed : true;
        const isOverridden = gapData ? gapData.isOverridden : false;
        const totalSlots = stream.currentSequence.length;

        const displayGap = isRemoved ? 'Remove' : gapType;
        const overriddenDot = isOverridden ? '<span class="overridden-indicator" title="Overridden from default"></span>' : '';
        const amount = (!isRemoved && gapType && stream.gaps && stream.gaps[gapType] != null)
                       ? formatCurrency(stream.gaps[gapType])
                       : null;

        const amountMarkup = isRemoved
            ? '<div class="priority-cell-amount text-muted">—</div>'
            : `<div class="priority-cell-amount fw-semibold">${amount ?? '—'}</div>`;

        // Drag handle + arrows are only active on cells that hold a real gap-type.
        // Removed slots show a spacer so the cell layout stays aligned.
        const canMove = !isRemoved;
        const gripHtml = canMove
            ? `<i class="bi bi-grip-vertical gap-drag-grip"
                   draggable="true"
                   data-stream-id="${stream.streamId}"
                   data-priority-index="${priorityIndex}"
                   title="Drag to reorder this priority within the row"
                   aria-label="Drag priority ${priorityIndex + 1} to a new slot"></i>`
            : '<span class="gap-drag-grip-disabled" aria-hidden="true"></span>';

        const leftDisabled  = (!canMove || priorityIndex === 0)              ? 'disabled' : '';
        const rightDisabled = (!canMove || priorityIndex === totalSlots - 1) ? 'disabled' : '';

        return `
            <td class="text-center priority-cell"
                data-stream-id="${stream.streamId}"
                data-priority-index="${priorityIndex}">
                <div class="gap-display">
                    ${gripHtml}
                    <span class="priority-number priority-${priorityIndex + 1}">${priorityIndex + 1}</span>
                    <select class="form-select form-select-sm"
                            data-stream-id="${stream.streamId}"
                            data-priority-index="${priorityIndex}"
                            onchange="window.handleGapPriorityChange(this)">
                        ${generateGapOptions(stream, displayGap, priorityIndex)}
                    </select>
                    ${overriddenDot}
                </div>
                ${amountMarkup}
                <div class="priority-cell-controls">
                    <button type="button" class="gap-shift-btn"
                            data-stream-id="${stream.streamId}"
                            data-priority-index="${priorityIndex}"
                            data-direction="left"
                            ${leftDisabled}
                            title="Move this priority left"
                            aria-label="Move priority ${priorityIndex + 1} left"
                            onclick="window.handleGapShiftClick(this)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button type="button" class="gap-shift-btn"
                            data-stream-id="${stream.streamId}"
                            data-priority-index="${priorityIndex}"
                            data-direction="right"
                            ${rightDisabled}
                            title="Move this priority right"
                            aria-label="Move priority ${priorityIndex + 1} right"
                            onclick="window.handleGapShiftClick(this)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </td>
        `;
    }

    // Handle gap priority change
    window.handleGapPriorityChange = function(selectElement) {
        const streamId = selectElement.dataset.streamId;
        const priorityIndex = parseInt(selectElement.dataset.priorityIndex);
        const newGapType = selectElement.value;

        const streamData = gapPrioritizationData.find(s => s.streamId === streamId);
        if (!streamData) return;

        if (newGapType === 'Remove') {
            streamData.currentSequence[priorityIndex] = { type: 'Remove', amount: 0, removed: true, isOverridden: true };
        } else {
            const gapAmount = streamData.gaps[newGapType] || 0;
            const wasDefault = streamData.defaultSequence[priorityIndex] === newGapType;
            streamData.currentSequence[priorityIndex] = {
                type: newGapType,
                amount: gapAmount,
                removed: false,
                isOverridden: !wasDefault
            };
        }

        // Re-render all tables
        renderGapSequencingTable();
        renderGapAmountsTable();
        renderGapSummary();
        renderMasterPriorityList();
        // Top Gaps to Tackle reads gapPrioritizationData via buildRevenueImpactList,
        // so it must be re-rendered when the user removes / reassigns a priority.
        renderTopGapsTable();
        // Stream Prioritization table shows "Partial plan" / "No plan" badges
        // derived from gapPrioritizationData — rerender so they update live,
        // along with the bar chart's plan-aware colouring.
        renderFinalTable();
        updateCharts();

        // Save state
        savePrioritizationState();
    };

    // ===== Intra-row reorder of gap priorities =====
    // Drag the grip from one priority cell onto another (same stream row only),
    // or click the left/right arrows to shift by one slot. Both routes call
    // swapGapSlots(), which mutates currentSequence, recomputes the per-slot
    // isOverridden flag from defaultSequence, syncs the new priorities back to
    // RosraStateManager (so the PDF export's master priority list matches the
    // on-screen order), and re-renders every downstream view.
    window.handleGapShiftClick = function(btn) {
        if (!btn || btn.disabled) return;
        const streamId  = btn.dataset.streamId;
        const fromIdx   = parseInt(btn.dataset.priorityIndex, 10);
        const direction = btn.dataset.direction;
        if (!streamId || isNaN(fromIdx) || !direction) return;
        const toIdx = fromIdx + (direction === 'left' ? -1 : 1);
        swapGapSlots(streamId, fromIdx, toIdx);
    };

    function swapGapSlots(streamId, fromIdx, toIdx) {
        const stream = gapPrioritizationData.find(s => s.streamId === streamId);
        if (!stream || !Array.isArray(stream.currentSequence)) return;
        const len = stream.currentSequence.length;
        if (fromIdx < 0 || fromIdx >= len) return;
        if (toIdx   < 0 || toIdx   >= len) return;
        if (fromIdx === toIdx) return;

        // Swap the two entries — index === priority slot (0 = P1, 1 = P2, 2 = P3).
        const a = stream.currentSequence[fromIdx];
        const b = stream.currentSequence[toIdx];
        stream.currentSequence[fromIdx] = b;
        stream.currentSequence[toIdx]   = a;

        // Recompute isOverridden from the original defaultSequence so the
        // overridden-dot indicator and the persisted "overridden" flag stay
        // truthful after a reorder.
        stream.currentSequence.forEach((seq, i) => {
            if (!seq) return;
            const defaultType = Array.isArray(stream.defaultSequence) ? stream.defaultSequence[i] : null;
            const currType = seq.removed ? 'Remove' : seq.type;
            seq.isOverridden = (defaultType != null) && (currType !== defaultType);
        });

        // Persist FIRST. RosraStateManager.setGapPriority (called below) fires
        // a 'streams' notification whose subscriber re-runs initializeGapPrioritization
        // → applySavedGapPrioritization, which reads the saved state back. If we
        // saved after syncing, the subscriber would read STALE state and revert
        // our swap on screen. Saving first means the rebuild restores the swap.
        savePrioritizationState();

        // Mirror the new order into RosraStateManager.gapPriorities so
        // recommendationsModule's PDF export (which builds the priority
        // matrix from getMasterPriorityList) reflects the user's choice.
        syncGapPrioritiesToStateManager(stream);

        // Re-render every view that depends on the priority order.
        // If the RosraStateManager subscriber is active, initializeGapPrioritization
        // has already re-rendered the gap-sequencing table — but these calls are
        // idempotent and cover the (rare) case where the subscriber wasn't bound.
        renderGapSequencingTable();
        renderGapAmountsTable();
        renderGapSummary();
        renderMasterPriorityList();
        renderTopGapsTable();
        renderFinalTable();
        updateCharts();
    }

    // Map a stream's currentSequence (priority slot → gap-type) into the
    // gapPriorities shape RosraStateManager exposes:
    //   { compliance: <slot>, coverage: <slot>, third: <slot> }
    // where 'third' covers both Valuation (property tax) and Liability (others).
    // We deliberately ignore Removed slots: their gap-type keeps its previous
    // priority number, which getMasterPriorityList then drops via the removed-
    // gap filter built from currentSequence itself.
    function syncGapPrioritiesToStateManager(stream) {
        if (typeof RosraStateManager === 'undefined') return;
        if (typeof RosraStateManager.setGapPriority !== 'function') return;
        if (!stream || !Array.isArray(stream.currentSequence)) return;

        stream.currentSequence.forEach((seq, idx) => {
            if (!seq || seq.removed) return;
            const t = String(seq.type || '').toLowerCase();
            let key = null;
            if (t === 'compliance')  key = 'compliance';
            else if (t === 'coverage') key = 'coverage';
            else if (t === 'valuation' || t === 'liability') key = 'third';
            if (key) {
                RosraStateManager.setGapPriority(stream.streamId, key, idx + 1);
            }
        });
    }

    // Attach drag-and-drop handlers to every priority cell in the gap-sequencing
    // table. Called after each renderGapSequencingTable() because re-rendering
    // wipes out previously bound listeners.
    let __gapCellDragSource = null;
    function attachGapPriorityCellHandlers() {
        const tbody = document.getElementById('gapSequencingBody');
        if (!tbody) return;

        // Grips initiate the drag — anchoring drag to the grip keeps the cell's
        // <select> open/close behaviour intact (a draggable <td> would otherwise
        // hijack pointer events from the dropdown on some browsers).
        tbody.querySelectorAll('.gap-drag-grip[draggable="true"]').forEach(grip => {
            grip.addEventListener('dragstart', (e) => {
                const streamId = grip.dataset.streamId;
                const fromIdx  = parseInt(grip.dataset.priorityIndex, 10);
                if (!streamId || isNaN(fromIdx)) return;
                __gapCellDragSource = { streamId, fromIdx };
                const cell = grip.closest('.priority-cell');
                if (cell) cell.classList.add('gap-cell-dragging');
                try {
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', `${streamId}:${fromIdx}`);
                } catch (_) { /* IE / Safari fall-back */ }
            });
            grip.addEventListener('dragend', () => {
                tbody.querySelectorAll('.priority-cell.gap-cell-dragging')
                     .forEach(c => c.classList.remove('gap-cell-dragging'));
                tbody.querySelectorAll('.priority-cell.gap-cell-drag-over')
                     .forEach(c => c.classList.remove('gap-cell-drag-over'));
                __gapCellDragSource = null;
            });
        });

        // Every priority cell is a drop target, but we restrict drops to the
        // same stream row — dragging across rows would silently reshape another
        // stream's plan, which the user wouldn't expect.
        tbody.querySelectorAll('td.priority-cell[data-stream-id]').forEach(cell => {
            cell.addEventListener('dragover', (e) => {
                if (!__gapCellDragSource) return;
                if (cell.dataset.streamId !== __gapCellDragSource.streamId) return;
                const toIdx = parseInt(cell.dataset.priorityIndex, 10);
                if (isNaN(toIdx) || toIdx === __gapCellDragSource.fromIdx) return;
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                cell.classList.add('gap-cell-drag-over');
            });
            cell.addEventListener('dragleave', () => {
                cell.classList.remove('gap-cell-drag-over');
            });
            cell.addEventListener('drop', (e) => {
                e.preventDefault();
                cell.classList.remove('gap-cell-drag-over');
                if (!__gapCellDragSource) return;
                if (cell.dataset.streamId !== __gapCellDragSource.streamId) return;
                const toIdx = parseInt(cell.dataset.priorityIndex, 10);
                if (isNaN(toIdx)) return;
                const { streamId, fromIdx } = __gapCellDragSource;
                __gapCellDragSource = null;
                swapGapSlots(streamId, fromIdx, toIdx);
            });
        });
    }

    // Gap Amounts table is now combined into renderPriorityCell() — this stub keeps callers safe.
    function renderGapAmountsTable() { /* merged into the gap sequencing cells */ }

    // Render Gap Summary
    function renderGapSummary() {
        const totalStreams = gapPrioritizationData.length;
        const totalCombinations = totalStreams * 3;
        let removedGaps = 0;
        let activeGaps = 0;

        gapPrioritizationData.forEach(stream => {
            stream.currentSequence.forEach(gap => {
                if (gap.removed) removedGaps++;
                else activeGaps++;
            });
        });

        document.getElementById('gapStatTotalStreams').textContent = totalStreams;
        document.getElementById('gapStatTotalCombinations').textContent = totalCombinations;
        document.getElementById('gapStatRemovedGaps').textContent = removedGaps;
        document.getElementById('gapStatActiveGaps').textContent = activeGaps;

        // Render first priority actions
        const firstPriorityDiv = document.getElementById('firstPriorityActions');
        if (gapPrioritizationData.length === 0) {
            firstPriorityDiv.innerHTML = '<div class="text-muted">No actions defined yet</div>';
            return;
        }

        let fpHtml = '';
        gapPrioritizationData.forEach(stream => {
            const firstGap = stream.currentSequence.find(g => !g.removed);
            if (firstGap) {
                fpHtml += `
                    <div class="first-priority-item">
                        <span class="fp-rank">${stream.finalRank}</span>
                        <span class="fp-stream">${stream.streamName}</span>
                        <span class="gap-badge ${getGapBadgeClass(firstGap.type)} fp-gap">${firstGap.type}</span>
                        <span class="fp-amount">${formatCurrency(stream.gaps[firstGap.type])}</span>
                    </div>
                `;
            }
        });

        firstPriorityDiv.innerHTML = fpHtml || '<div class="text-muted">No active gap actions</div>';
    }

    // Render Master Priority List
    function renderMasterPriorityList() {
        const tbody = document.getElementById('masterPriorityBody');

        if (gapPrioritizationData.length === 0) {
            tbody.innerHTML = `
                <tr class="placeholder-row">
                    <td colspan="4" class="text-center text-muted py-3">
                        <small>Master list will populate from gap priorities</small>
                    </td>
                </tr>
            `;
            return;
        }

        // Build master list: iterate through priorities, then streams
        const masterList = [];
        let masterPriority = 1;

        // For each stream, add their gaps in sequence order
        gapPrioritizationData.forEach(stream => {
            stream.currentSequence.forEach((gap, gapIndex) => {
                if (!gap.removed) {
                    masterList.push({
                        masterPriority: null, // Will be assigned after sorting
                        streamRank: stream.finalRank,
                        streamName: stream.streamName,
                        gapType: gap.type,
                        gapAmount: stream.gaps[gap.type] || 0,
                        gapPriority: gapIndex + 1,
                        isFirstInStream: gapIndex === stream.currentSequence.findIndex(g => !g.removed)
                    });
                }
            });
        });

        // Sort: by stream rank first, then by gap priority within stream
        masterList.sort((a, b) => {
            if (a.streamRank !== b.streamRank) return a.streamRank - b.streamRank;
            return a.gapPriority - b.gapPriority;
        });

        // Assign master priorities
        masterList.forEach((item, index) => {
            item.masterPriority = index + 1;
        });

        let html = '';
        masterList.forEach((item, index) => {
            const streamBreakClass = item.isFirstInStream && index > 0 ? 'stream-break' : '';
            html += `
                <tr class="master-priority-row ${streamBreakClass}">
                    <td class="text-center">
                        <span class="priority-number priority-${item.gapPriority}">${item.masterPriority}</span>
                    </td>
                    <td>${item.streamName}</td>
                    <td><span class="gap-badge ${getGapBadgeClass(item.gapType)}">${item.gapType}</span></td>
                    <td class="text-end fw-semibold">${formatCurrency(item.gapAmount)}</td>
                </tr>
            `;
        });

        tbody.innerHTML = html;
    }

    // ======================= REVENUE IMPACT & IMPROVEMENT SCORING =======================

    // Retained for the inert renderPriorityMatrix() function below; the chart
    // itself was removed from the UI.
    let matrixChart = null;

    // Build a flat list of all individual gaps across included streams, sorted by amount
    function buildRevenueImpactList() {
        const { finalRanking } = calculateFinalRankings();
        const allGaps = [];

        finalRanking.forEach(stream => {
            const isPropertyBased = stream.type === 'property-tax';
            const gapTypes = [
                { type: 'Compliance', amount: stream.complianceGap || 0 },
                { type: 'Coverage', amount: stream.coverageGap || 0 },
                { type: isPropertyBased ? 'Valuation' : 'Liability', amount: isPropertyBased ? (stream.valuationGap || 0) : (stream.liabilityGap || 0) }
            ];

            // Honour the user's Gap Sequencing decisions: a gap-type is only
            // surfaced in Top Gaps to Tackle / improvement scoring if it sits
            // in an *active* (non-removed) priority slot for this stream.
            // If gapPrioritizationData has no entry for this stream yet (eg.
            // first render before initializeGapPrioritizationData runs), fall
            // back to allowing all gap-types through.
            const seqEntry = (typeof gapPrioritizationData !== 'undefined')
                ? gapPrioritizationData.find(g => g.streamId === stream.id)
                : null;
            const activeGapTypes = seqEntry
                ? new Set(seqEntry.currentSequence.filter(s => !s.removed).map(s => s.type))
                : null; // null = no filter

            gapTypes.forEach(g => {
                if (g.amount <= 0) return;
                if (activeGapTypes && !activeGapTypes.has(g.type)) return;

                allGaps.push({
                    streamName: stream.name,
                    streamType: stream.type,
                    streamRank: stream.finalRank,
                    gapType: g.type,
                    amount: g.amount,
                    currentRevenue: stream.currentRevenue || 0,
                    potentialRevenue: stream.potentialRevenue || (stream.totalFunctionalGap + (stream.currentRevenue || 0)),
                    totalFunctionalGap: stream.totalFunctionalGap
                });
            });
        });

        // Sort by amount descending
        allGaps.sort((a, b) => b.amount - a.amount);

        const totalGapSum = allGaps.reduce((sum, g) => sum + g.amount, 0);
        allGaps.forEach(g => {
            g.share = totalGapSum > 0 ? (g.amount / totalGapSum) * 100 : 0;
        });

        return allGaps;
    }

    // ----- Top Gaps to Tackle (merges Revenue Impact + Improvement Score into one table) -----
    let topGapsSortBy = 'amount'; // 'amount' or 'score'

    function renderTopGapsTable() {
        const tbody = document.getElementById('topGapsBody');
        if (!tbody) return;

        // buildImprovementScores() already includes amount + share + score + gapRatio + cardCount
        const gaps = buildImprovementScores();

        if (gaps.length === 0) {
            tbody.innerHTML = '<tr class="placeholder-row"><td colspan="7" class="text-center text-muted py-3"><small>@Html.Raw(Localizer["Prio_TopGaps_NoData"].Value)</small></td></tr>';
            return;
        }

        // Sort by the currently selected key
        const sorted = gaps.slice().sort((a, b) => {
            return topGapsSortBy === 'score' ? (b.score - a.score) : (b.amount - a.amount);
        });
        const maxAmount = Math.max(...sorted.map(g => g.amount));

        let html = '';
        sorted.forEach((g, idx) => {
            const barWidth = maxAmount > 0 ? (g.amount / maxAmount) * 100 : 0;
            const barColor = g.gapType === 'Compliance' ? '#ef4444' :
                             g.gapType === 'Coverage'   ? '#f59e0b' :
                             g.gapType === 'Valuation'  ? '#3b82f6' : '#8b5cf6';
            const scoreClass = g.score >= 60 ? 'score-high' : g.score >= 35 ? 'score-medium' : 'score-low';
            const potentialClass = g.gapRatio >= 0.4 ? 'high' : g.gapRatio >= 0.2 ? 'medium' : 'low';
            const potentialLabel = g.gapRatio >= 0.4 ? 'High potential' : g.gapRatio >= 0.2 ? 'Moderate' : 'Lower';

            html += `
                <tr>
                    <td class="text-center"><span class="priority-number priority-${idx < 3 ? idx + 1 : 3}">${idx + 1}</span></td>
                    <td>${g.streamName}</td>
                    <td><span class="gap-badge ${getGapBadgeClass(g.gapType)}">${g.gapType}</span></td>
                    <td class="text-end fw-semibold">${formatCurrency(g.amount)}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="impact-bar flex-grow-1">
                                <div class="impact-bar-fill" style="width: ${barWidth}%; background: ${barColor};"></div>
                            </div>
                            <span class="small fw-semibold" style="min-width: 36px;">${g.share.toFixed(0)}%</span>
                        </div>
                    </td>
                    <td class="text-center"><span class="score-badge ${scoreClass}">${g.score}</span></td>
                    <td class="text-center"><span class="potential-label ${potentialClass}">${potentialLabel}</span></td>
                </tr>`;
        });

        tbody.innerHTML = html;

        // Visual indicator on the active sort header
        document.querySelectorAll('.top-gaps-sort').forEach(th => {
            th.classList.toggle('top-gaps-sort--active', th.dataset.sortBy === topGapsSortBy);
        });
    }

    // Wire up click-to-sort on the Amount / Score column headers (idempotent)
    function attachTopGapsSortHandlers() {
        document.querySelectorAll('.top-gaps-sort').forEach(th => {
            if (th.dataset.bound === '1') return;
            th.dataset.bound = '1';
            th.style.cursor = 'pointer';
            th.addEventListener('click', () => {
                topGapsSortBy = th.dataset.sortBy;
                renderTopGapsTable();
            });
        });
    }

    // Backwards-compat aliases — the original two render functions now both feed the combined table.
    function renderRevenueImpactTable() { attachTopGapsSortHandlers(); renderTopGapsTable(); }

    // Calculate improvement opportunity score for each gap
    // Score = weighted combination of: absolute gap size, gap-to-potential ratio, number of available solution cards
    function buildImprovementScores() {
        const gaps = buildRevenueImpactList();
        if (gaps.length === 0) return [];

        const maxAmount = Math.max(...gaps.map(g => g.amount));

        gaps.forEach(g => {
            // Factor 1: Size relative to largest gap (0-40 points)
            const sizeFactor = maxAmount > 0 ? (g.amount / maxAmount) * 40 : 0;

            // Factor 2: Gap as % of potential revenue (0-35 points)
            // Higher gap/potential ratio = more room to improve
            const gapRatio = g.potentialRevenue > 0 ? g.amount / g.potentialRevenue : 0;
            const ratioFactor = Math.min(gapRatio, 1) * 35;

            // Factor 3: Available solution cards for this gap type (0-25 points)
            let cardCount = 0;
            if (typeof SolutionsDatabase !== 'undefined') {
                if (g.streamType === 'property-tax') {
                    cardCount = SolutionsDatabase.getSolutionsByStreamAndGap('Property Tax', g.gapType).length;
                } else {
                    // For NP streams, count across all subgroups as a proxy
                    ['A', 'B', 'C'].forEach(sg => {
                        cardCount += SolutionsDatabase.getSolutionsBySubgroupAndGap(sg, g.gapType).length;
                    });
                    cardCount = Math.round(cardCount / 3); // Average per subgroup
                }
            }
            const cardFactor = Math.min(cardCount / 10, 1) * 25;

            g.score = Math.round(sizeFactor + ratioFactor + cardFactor);
            g.cardCount = cardCount;
            g.gapRatio = gapRatio;
        });

        // Sort by score descending
        gaps.sort((a, b) => b.score - a.score);
        return gaps;
    }

    // Improvement scoring is now folded into renderTopGapsTable() — keep this stub for callers.
    function renderImprovementScoreTable() { /* merged into renderTopGapsTable() */ }

    // Priority Matrix bubble chart was removed from the UI. The function below
    // is no longer called from renderRevenueAndScoring(), but is kept inert in
    // case any external code path still calls it — its DOM lookups will all
    // return null and the function will exit early.
    function renderPriorityMatrix() {
        const placeholder = document.getElementById('matrixPlaceholder');
        const canvas = document.getElementById('priorityMatrixChart');
        // Toggle the wrapper (which has the fixed height) instead of the canvas
        // itself — otherwise Chart.js sizes the canvas to an unbounded parent
        // and we get a chart that's thousands of pixels tall.
        const wrapper = document.getElementById('priorityMatrixWrapper');
        const gaps = buildImprovementScores();

        if (matrixChart) matrixChart.destroy();

        if (gaps.length === 0) {
            if (placeholder) placeholder.style.display = 'block';
            if (wrapper) wrapper.style.display = 'none';
            return;
        }

        if (placeholder) placeholder.style.display = 'none';
        if (wrapper) wrapper.style.display = 'block';

        // Map gap types to colors
        const gapColors = {
            'Compliance': 'rgba(239, 68, 68, 0.7)',
            'Coverage': 'rgba(245, 158, 11, 0.7)',
            'Valuation': 'rgba(59, 130, 246, 0.7)',
            'Liability': 'rgba(139, 92, 246, 0.7)'
        };

        const gapBorderColors = {
            'Compliance': '#ef4444',
            'Coverage': '#f59e0b',
            'Valuation': '#3b82f6',
            'Liability': '#8b5cf6'
        };

        // Shorten a stream name to a 2-3 character tag we can draw inside the
        // bubble — saves the user from hovering to figure out which stream is
        // which. "Property Tax" → "PT", "Business License" → "BL",
        // "Parking Fee" → "PF", "Solid Waste Fee" → "SWF", etc.
        function streamAbbrev(name) {
            if (!name) return '?';
            const explicit = {
                'Property Tax': 'PT',
                'Business License': 'BL',
                'Business Licenses': 'BL'
            };
            if (explicit[name]) return explicit[name];
            const initials = name.trim().split(/\s+/).map(w => w[0]).join('').toUpperCase();
            return initials.slice(0, 3);
        }

        // Build datasets: one per gap type for legend
        const byGapType = {};
        gaps.forEach(g => {
            if (!byGapType[g.gapType]) byGapType[g.gapType] = [];
            byGapType[g.gapType].push({
                x: g.amount,
                y: g.cardCount,
                r: Math.max(8, Math.min(30, g.score / 2)),
                label: g.streamName + ' — ' + g.gapType,
                streamName: g.streamName,
                streamTag: streamAbbrev(g.streamName),
                score: g.score
            });
        });

        const datasets = Object.keys(byGapType).map(gapType => ({
            label: gapType,
            data: byGapType[gapType],
            backgroundColor: gapColors[gapType] || 'rgba(107, 114, 128, 0.7)',
            borderColor: gapBorderColors[gapType] || '#6b7280',
            borderWidth: 2
        }));

        // Render a "tag → stream" legend under the chart so readers can decode
        // the abbreviations without hovering on every bubble.
        const keyEl = document.getElementById('priorityMatrixStreamKey');
        if (keyEl) {
            const uniquePairs = new Map();
            gaps.forEach(g => {
                const tag = streamAbbrev(g.streamName);
                if (!uniquePairs.has(tag)) uniquePairs.set(tag, g.streamName);
            });
            if (uniquePairs.size > 0) {
                keyEl.style.display = 'block';
                keyEl.innerHTML = '<strong>Streams:</strong> ' + Array.from(uniquePairs.entries())
                    .map(([tag, name]) => '<span class="badge bg-light text-dark border me-1" style="font-weight:500;">' + tag + '</span>' + name)
                    .join(' &nbsp;·&nbsp; ');
            } else {
                keyEl.style.display = 'none';
            }
        }

        // Inline Chart.js plugin: draw the stream abbreviation at the centre of
        // each bubble so readers can identify the stream without hovering.
        // Small bubbles (r < 10px) are skipped to avoid cramped text.
        const streamTagPlugin = {
            id: 'streamTag',
            afterDatasetsDraw(chart) {
                const ctx2 = chart.ctx;
                ctx2.save();
                ctx2.textAlign = 'center';
                ctx2.textBaseline = 'middle';
                ctx2.fillStyle = '#1f2937';
                ctx2.font = '600 11px -apple-system, "Segoe UI", Roboto, sans-serif';
                chart.data.datasets.forEach((ds, dsIdx) => {
                    const meta = chart.getDatasetMeta(dsIdx);
                    meta.data.forEach((element, i) => {
                        const point = ds.data[i];
                        if (!point || !point.streamTag) return;
                        const radius = element.options && element.options.radius ? element.options.radius : (point.r || 0);
                        if (radius < 10) return;
                        const { x, y } = element.getCenterPoint();
                        ctx2.fillText(point.streamTag, x, y);
                    });
                });
                ctx2.restore();
            }
        };

        const ctx = canvas.getContext('2d');
        matrixChart = new Chart(ctx, {
            type: 'bubble',
            data: { datasets: datasets },
            plugins: [streamTagPlugin],
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { usePointStyle: true, padding: 15 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const d = context.raw;
                                return [
                                    d.label,
                                    'Revenue impact: ' + formatCurrency(d.x),
                                    'Solution cards: ' + d.y,
                                    'Opportunity score: ' + d.score
                                ];
                            }
                        }
                    }
                },
                // Leave headroom at the top so the tallest bubble doesn't
                // overlap the legend, and on the right so the last bubble isn't
                // clipped. Chart.js's default auto-scale places the max data
                // point flush against the plot edge.
                layout: { padding: { top: 16, right: 24, bottom: 4, left: 4 } },
                scales: {
                    x: {
                        title: { display: true, text: 'Revenue Impact (Gap Amount)', font: { weight: 'bold' } },
                        beginAtZero: true,
                        suggestedMax: (function() {
                            const maxX = Math.max(0, ...gaps.map(g => g.amount));
                            return maxX * 1.08;
                        })(),
                        ticks: {
                            callback: function(value) {
                                var abs = Math.abs(value);
                                if (abs >= 1e9) return currencySymbol + (value / 1e9).toFixed(1) + 'B';
                                if (abs >= 1e6) return currencySymbol + (value / 1e6).toFixed(1) + 'M';
                                if (abs >= 1e3) return currencySymbol + (value / 1e3).toFixed(0) + 'K';
                                return currencySymbol + value;
                            }
                        }
                    },
                    y: {
                        title: { display: true, text: 'Available Solution Cards', font: { weight: 'bold' } },
                        beginAtZero: true,
                        // Leave ~20% headroom above the tallest bubble so the
                        // legend at the top doesn't collide with data points.
                        suggestedMax: (function() {
                            const maxY = Math.max(0, ...gaps.map(g => g.cardCount));
                            return Math.ceil(maxY * 1.2) + 1;
                        })(),
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
        if (window.registerChart) registerChart('priorityMatrixChart', matrixChart);
    }

    // Render all Step 3 components
    function renderRevenueAndScoring() {
        renderRevenueImpactTable();
        renderImprovementScoreTable();
    }

    // Hook into gap prioritization init so Step 3 updates whenever Step 2 does
    const _origInitGapPrioritization = initializeGapPrioritization;
    initializeGapPrioritization = function() {
        _origInitGapPrioritization();
        renderRevenueAndScoring();
    };

    // Initialize Gap Prioritization on load
    initializeGapPrioritization();
});
</script>
