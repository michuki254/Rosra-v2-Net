        // Strip thousand separators and parse a formatted number back to a float. Returns 0 on empty/invalid input.
        function parseFormattedNumber(value) {
            if (value === null || value === undefined) return 0;
            const cleaned = String(value).replace(/,/g, '').trim();
            if (!cleaned) return 0;
            const n = parseFloat(cleaned);
            return isNaN(n) ? 0 : n;
        }

        // Live-format a numeric <input type="text"> with thousand separators while the user types.
        // Preserves the caret position so typing feels natural. Pass integerOnly=true to strip decimals (e.g. Population).
        function formatNumberInput(el, integerOnly) {
            const raw = el.value;
            if (!raw) return;
            const caretEnd = el.selectionEnd || 0;
            const digitsBeforeCaret = (raw.slice(0, caretEnd).match(/[\d.]/g) || []).length;

            // Keep digits, a single decimal point, and a leading minus sign. Disallow decimals when integerOnly.
            let cleaned = raw.replace(integerOnly ? /[^\d-]/g : /[^\d.-]/g, '');
            if (cleaned.startsWith('-')) cleaned = '-' + cleaned.slice(1).replace(/-/g, '');
            else cleaned = cleaned.replace(/-/g, '');
            if (!integerOnly) {
                const firstDot = cleaned.indexOf('.');
                if (firstDot !== -1) cleaned = cleaned.slice(0, firstDot + 1) + cleaned.slice(firstDot + 1).replace(/\./g, '');
            }
            if (!cleaned || cleaned === '-' || cleaned === '.' || cleaned === '-.') { el.value = cleaned; return; }

            const negative = cleaned.startsWith('-');
            const body = negative ? cleaned.slice(1) : cleaned;
            const parts = body.split('.');
            const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            const formatted = (negative ? '-' : '') + (parts.length > 1 ? intPart + '.' + parts[1] : intPart);

            el.value = formatted;

            // Restore caret: find the position in `formatted` that contains the same count of digits-or-dot as before.
            let count = 0, newCaret = formatted.length;
            for (let i = 0; i < formatted.length; i++) {
                if (/[\d.]/.test(formatted[i])) {
                    count++;
                    if (count === digitsBeforeCaret) { newCaret = i + 1; break; }
                }
            }
            if (typeof el.setSelectionRange === 'function') el.setSelectionRange(newCaret, newCaret);
        }

        // Download a sample Peer SNG CSV template with headers, example rows and a notes block
        function downloadPeerTemplate() {
            const countryCode = (getCurrentCountryCode() || 'XXX').toUpperCase();
            // Data rows come first so the file opens clean in Excel/Sheets; the column reference
            // is appended as '#' comment lines at the bottom (both client-side and server-side
            // uploaders ignore '#' lines, so the file uploads as-is).
            const lines = [
                'SNG,OSR,GCP,Population,Include',
                'Sample Region A,18500000000,4200000000000,4397000,1',
                'Sample Region B,5200000000,680000000000,1208000,1',
                'Sample Region C,1800000000,240000000000,610000,1',
                'Sample Region D,2100000000,310000000000,2162000,1',
                'Sample Region E,3400000000,520000000000,2417000,0',
                '',
                '# ============================================================================',
                '# ROSRA Peer SNG Data Template  -  Column Reference',
                '# ============================================================================',
                '#',
                '# REQUIRED COLUMNS',
                '# ----------------------------------------------------------------------------',
                '#   SNG         Subnational government name',
                '#               (county, province, state, municipality, etc.)',
                '#',
                '#   OSR         Own-Source Revenue  -  annual, in local currency',
                '#                 - plain number only (no commas, no currency symbols)',
                '#                 - decimals allowed (e.g. 321400000.00)',
                '#',
                '#   GCP         Gross sub-national Product',
                '#                 - same currency and units as OSR',
                '#',
                '# OPTIONAL COLUMNS',
                '# ----------------------------------------------------------------------------',
                '#   Population  Total population (whole number)',
                '#                 - only needed for OSR-per-capita analysis',
                '#                 - leave as 0 to skip',
                '#',
                '#   Include     Frontier analysis inclusion flag',
                '#                 - 1  =  include (default when blank)',
                '#                 - 0  =  exclude',
                '#',
                '# TIPS',
                '# ----------------------------------------------------------------------------',
                '#   * Replace the sample rows above with your own data.',
                '#   * Keep the header row (SNG,OSR,GCP,Population,Include) unchanged.',
                '#   * Use the same fiscal year and currency for every row.',
                '#   * Lines starting with "#" are comments and are ignored by the uploader.',
                '# ============================================================================'
            ];
            const csv = lines.join('\r\n') + '\r\n';
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `peer_sng_template_${countryCode}.csv`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        // Upload peer CSV file (parse client-side, store in memory)
        async function uploadPeerCSV() {
            const fileInput = document.getElementById('peerCsvUpload');
            const countryCode = getCurrentCountryCode();

            if (!fileInput.files || !fileInput.files[0]) {
                alert('Please select a CSV file first');
                return;
            }

            if (!countryCode) {
                alert('Please select a country first');
                return;
            }

            const file = fileInput.files[0];

            try {
                // Parse CSV client-side. Blank lines and lines starting with '#' are treated as comments.
                const text = await file.text();
                const lines = text.split('\n')
                    .map(line => line.trim())
                    .filter(line => line.length > 0 && !line.startsWith('#'));

                if (lines.length < 2) {
                    alert('CSV file must have at least a header and one data row');
                    return;
                }

                // Parse header to find column indices
                const header = lines[0].split(',').map(h => h.trim().toLowerCase());
                const sngIdx = header.findIndex(h => h === 'sng' || h === 'name');
                const osrIdx = header.findIndex(h => h === 'osr');
                const gcpIdx = header.findIndex(h => h === 'gcp' || h === 'gdp');
                const popIdx = header.findIndex(h => h === 'population' || h === 'pop');
                const incIdx = header.findIndex(h => h === 'include' || h === 'included');

                if (sngIdx === -1 || osrIdx === -1 || (gcpIdx === -1 && popIdx === -1)) {
                    alert('CSV must have columns: SNG (or Name), OSR, and GCP/GDP (preferred) or Population');
                    return;
                }

                // Parse data rows
                const peers = [];
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(',').map(c => c.trim());
                    if (cols.length > Math.max(sngIdx, osrIdx, gcpIdx)) {
                        const sng = cols[sngIdx];
                        const osr = parseFormattedNumber(cols[osrIdx]);
                        const gcp = gcpIdx !== -1 && cols[gcpIdx] !== undefined ? parseFormattedNumber(cols[gcpIdx]) : 0;
                        const population = popIdx !== -1 && cols[popIdx] !== undefined ? Math.round(parseFormattedNumber(cols[popIdx])) : 0;
                        const includeRaw = incIdx !== -1 && cols[incIdx] !== undefined ? cols[incIdx].toLowerCase() : '1';
                        const include = !(includeRaw === '0' || includeRaw === 'false' || includeRaw === 'no');

                        // Note §12: name + OSR, plus GCP (preferred) or population
                        if (sng && osr > 0 && (gcp > 0 || population > 0)) {
                            peers.push({ sng: sng, osr: osr, gcp: gcp, population: population, include: include });
                        }
                    }
                }

                if (peers.length === 0) {
                    alert('No valid peer data found in CSV');
                    return;
                }

                // Store custom data in memory (will be saved with report)
                customPeerData = {
                    dataSource: 'custom',
                    countryCode: countryCode,
                    customPeers: peers,
                    timestamp: new Date().toISOString()
                };

                console.log('Custom peer data from CSV stored in memory:', customPeerData);

                // Populate dropdown from custom data
                populatePeerDropdownFromCustomData(peers);

                // Hide input section and show success message
                togglePeerDataInputSection(false);
                showPeerDataSuccessMessage(`${peers.length} peers loaded from CSV. Data will be saved with your report.`);

                // Clear file input
                fileInput.value = '';

            } catch (e) {
                console.error('Error parsing CSV:', e);
                alert('Error parsing CSV file. Please check the format and try again.');
            }
        }

