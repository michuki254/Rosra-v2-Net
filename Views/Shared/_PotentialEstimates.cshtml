        // Function to format number with commas
        function formatNumberWithCommas(value) {
            if (!value) return '';
            
            // Remove any existing commas and non-numeric characters except decimal point
            value = value.replace(/,/g, '').replace(/[^\d.]/g, '');
            
            // Check if it's a valid number
            if (isNaN(parseFloat(value))) return '';
            
            // Split by decimal point
            const parts = value.split('.');
            
            // Format the integer part with commas
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            
            // Join back with decimal part if exists
            return parts.length > 1 ? parts[0] + '.' + parts[1] : parts[0];
        }
        
        // Add event listeners to format numbers on input
        numberFormatInputs.forEach(input => {
            // Pre-format any value the field renders with on page load
            if (input.value) {
                input.value = formatNumberWithCommas(input.value);
            }

            // Live formatting while the user types — preserves cursor position by counting digits
            input.addEventListener('input', function () {
                const oldValue  = this.value;
                const oldCursor = this.selectionStart || 0;
                // count digit / decimal characters before the caret in the unformatted view
                const digitsBefore = oldValue.slice(0, oldCursor).replace(/[^\d.]/g, '').length;

                const newValue = formatNumberWithCommas(oldValue);
                if (newValue === oldValue) return; // nothing to do
                this.value = newValue;

                // walk forward in the formatted string until we have re-passed the same digit count
                let newCursor = 0, digitCount = 0;
                while (digitCount < digitsBefore && newCursor < newValue.length) {
                    if (/[\d.]/.test(newValue[newCursor])) digitCount++;
                    newCursor++;
                }
                try { this.setSelectionRange(newCursor, newCursor); } catch (e) { /* unsupported */ }
            });

            // Re-format on blur as a safety net (covers paste / autofill edge cases)
            input.addEventListener('blur', function () {
                this.value = formatNumberWithCommas(this.value);
            });

            // Strip commas right before form submission so server receives clean numbers
            const form = input.closest('form');
            if (form) {
                form.addEventListener('submit', function () {
                    numberFormatInputs.forEach(i => { i.value = i.value.replace(/,/g, ''); });
                });
            }
        });
        
