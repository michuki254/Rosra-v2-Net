        // Fetch and display Peer SNG Analysis
        async function fetchPeerSNGAnalysis(sngName) {
            if (!sngName) {
                module2Placeholder.style.display = 'block';
                module2Content.style.display = 'none';
                return;
            }

            try {
                let response;
                const countryCode = getCurrentCountryCode();

                // If custom peer data is available, send it with the request (POST)
                if (customPeerData && customPeerData.customPeers && customPeerData.customPeers.length > 0) {
                    console.log('Using custom peer data for analysis:', customPeerData.customPeers.length, 'peers');
                    response = await fetch('/Rosra/GetPeerSNGAnalysisWithCustomPeers', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({
                            Sng: sngName,
                            CountryCode: countryCode,
                            CustomPeers: customPeerData.customPeers.map(p => ({
                                Sng: p.sng,
                                Osr: p.osr,
                                Gcp: p.gcp,
                                Population: p.population || 0,
                                Include: p.include !== false
                            }))
                        })
                    });
                } else {
                    // Use reference data from database (GET)
                    console.log('Using reference data for analysis');
                    const url = countryCode
                        ? `/Rosra/GetPeerSNGAnalysis?sng=${encodeURIComponent(sngName)}&countryCode=${encodeURIComponent(countryCode)}`
                        : `/Rosra/GetPeerSNGAnalysis?sng=${encodeURIComponent(sngName)}`;
                    response = await fetch(url);
                }
                const data = await response.json();

                if (!data.success) {
                    console.warn('Peer SNG Analysis failed:', data.message);
                    module2Placeholder.style.display = 'block';
                    module2Content.style.display = 'none';
                    return;
                }

                // Debug logging - check browser console (F12) to see calculation details
                console.log('=== Peer SNG Analysis Debug ===');
                console.log('Selected SNG:', data.sng);
                console.log('--- KEY VALUES ---');
                console.log('Actual OSR:', data.metrics.actualOSR);
                console.log('Subnational GDP:', data.metrics.subnationalGDP);
                console.log('Peer Frontier Multiplier:', data.metrics.peerFrontierMultiplier);
                console.log('OSR Potential:', data.metrics.osrPotential);
                console.log('OSR Gap:', data.metrics.osrGap);
                console.log('Performance Index:', data.metrics.performanceIndex, '%');
                if (data.debug) {
                    console.log('--- CALCULATION DEBUG ---');
                    console.log('Total peers in DB:', data.debug.totalPeersInDb);
                    console.log('Peers with Include=true:', data.debug.peersWithIncludeTrue);
                    console.log('Peers with valid data:', data.debug.peersWithValidData);
                    console.log('90th percentile threshold:', data.debug.percentile90Threshold);
                    console.log('Top multipliers count:', data.debug.topMultipliersCount);
                    console.log('Top multipliers:', data.debug.topMultipliers.join(', '));
                    console.log('Calculation:', data.debug.calculationSteps.step5_osrPotential);
                }

                if (true) {
                    // Hide placeholder, show content
                    module2Placeholder.style.display = 'none';
                    module2Content.style.display = 'block';

                    // A successful domestic analysis means Tier 1/2 is active —
                    // make sure the domestic card (not the WoFi card) is shown,
                    // e.g. when restoring a saved report.
                    window.__RosraTopDownTier = data.dataSource === 'custom' ? 'custom' : 'preloaded';
                    setDomesticSourceBadge(window.__RosraTopDownTier);
                    showTopDownCard('domestic');

                    // Currency labels follow the dataset (preloaded rows are USD 2024),
                    // not the report currency. Used by the gap bar chart + exports.
                    window.__RosraPeerCurrency = data.currency || null;
                    const unitsNote = document.getElementById('domesticUnitsNote');
                    if (unitsNote) unitsNote.style.display = data.currency === 'USD' ? '' : 'none';
                    const watchNote = document.getElementById('domesticWatchlistNote');
                    if (watchNote) watchNote.style.display = data.watchlist ? '' : 'none';

                    // OSR-per-capita fallback (note §12): show its banner and hide
                    // the GDP-based metric rows that don't apply.
                    const perCapita = data.method === 'osr_per_capita';
                    window.__RosraPeerMethod = data.method || 'osr_gdp';
                    const pcNote = document.getElementById('domesticPerCapitaNote');
                    if (pcNote) pcNote.style.display = perCapita ? '' : 'none';
                    document.querySelectorAll('#module2ContentTop .gdp-method-only').forEach(el => {
                        el.style.display = perCapita ? 'none' : '';
                    });

                    // Extract metrics from the nested object
                    const metrics = data.metrics;

                    // Cache the raw numbers in the same shape the WoFi estimator
                    // uses so the Recommendations "Generate Report" flow can build
                    // the current-vs-potential chart regardless of the active tier.
                    window.__RosraWofiResult = {
                        actualOsr:     metrics.actualOSR,
                        potentialOsr:  metrics.osrPotential,
                        osrGap:        metrics.osrGap,
                        frontierIndex: (metrics.performanceIndex || 0) / 100,
                    };

                    // Update metric values (format like Excel - multipliers as decimals, performance as decimal)
                    document.getElementById('m2ActualOSRTop').textContent = formatCurrency(metrics.actualOSR);
                    document.getElementById('m2SubnationalGDPTop').textContent = formatCurrency(metrics.subnationalGDP);
                    document.getElementById('m2FrontierMultiplierTop').textContent = metrics.peerFrontierMultiplier.toFixed(6);
                    document.getElementById('m2SubjectMultiplierTop').textContent = metrics.subjectMultiplier.toFixed(6);
                    document.getElementById('m2OSRPotentialTop').textContent = formatCurrency(metrics.osrPotential);
                    document.getElementById('m2OSRGapTop').textContent = formatCurrency(metrics.osrGap);
                    document.getElementById('m2PerformanceIndexTop').textContent = (metrics.performanceIndex / 100).toFixed(6);

                    // Per capita diagnostics
                    document.getElementById('m2OSRPerCapitaTop').textContent = formatCurrency(metrics.osrPerCapita);
                    document.getElementById('m2PotentialOSRPerCapitaTop').textContent = formatCurrency(metrics.potentialOSRPerCapita);
                    document.getElementById('m2PerCapitaGapTop').textContent = formatCurrency(metrics.perCapitaGap);

                    // Update performance bar (performanceIndex is already a percentage from the API)
                    const performanceBar = document.getElementById('m2PerformanceBarTop');
                    const performancePercent = Math.min(metrics.performanceIndex, 100);
                    performanceBar.style.width = performancePercent + '%';

                    // Transform chartData to expected format (x = gdp, y = osr;
                    // in the per-capita fallback x = population instead)
                    const chartDataTransformed = data.chartData.map(p => ({
                        name: p.name,
                        x: perCapita ? p.population : p.gdp,
                        y: p.osr
                    }));

                    // Create the Peer Frontier Scatter Chart with helper data for frontier line
                    createPeerFrontierScatterChart(chartDataTransformed, data.frontierSlope, sngName, data.helpers);

                    // Create the Actual vs Potential Bar Chart (including OSR Gap)
                    createActualVsPotentialChart(metrics.actualOSR, metrics.osrPotential, metrics.osrGap);

                    // Update the analysis result text (performanceIndex is already %, so divide by 100)
                    updateModule2ResultText(metrics.performanceIndex / 100, metrics.osrGap, sngName, metrics.actualOSR, metrics.osrPotential);

                    // Update helper values for the modal (if modal elements exist)
                    if (data.helpers) {
                        const h = data.helpers;
                        const setTextIfExists = (id, value) => {
                            const el = document.getElementById(id);
                            if (el) el.textContent = value;
                        };
                        setTextIfExists('helperValidPeers', h.validPeersUsed);
                        setTextIfExists('helperTop20Count', h.top20Count);
                        setTextIfExists('helperFrontierMultiplier', h.frontierMultiplier.toFixed(8));
                        setTextIfExists('helperPercentile80', h.percentile80Threshold.toFixed(8));
                        setTextIfExists('helperMinGDP', formatCurrency(h.minGDP));
                        setTextIfExists('helperMaxGDP', formatCurrency(h.maxGDP));
                        setTextIfExists('helperFrontierYMin', h.frontierYAtMinGDP.toFixed(2));
                        setTextIfExists('helperFrontierYMax', h.frontierYAtMaxGDP.toFixed(2));
                        setTextIfExists('helperSubjectMultiplier', h.subjectMultiplier.toFixed(8));
                        setTextIfExists('helperOSRPotential', h.osrPotential.toFixed(2));
                        setTextIfExists('helperTopPerformers', h.topPerformersUsed);
                        setTextIfExists('helperAbove80th', h.isAbove80thPercentile ? 'Above 80th percentile' : 'Below 80th percentile');
                        setTextIfExists('helperActual', formatCurrency(metrics.actualOSR));
                        setTextIfExists('helperPotential', h.osrPotential.toFixed(2));
                    }

                    console.log('Peer SNG analysis loaded for:', sngName);
                } else {
                    console.log('Peer SNG analysis not available:', data.message);
                    module2Placeholder.innerHTML = `
                        <i class="bi bi-exclamation-circle"></i>
                        <p>${data.message || 'Analysis not available for this subnational government'}</p>
                    `;
                    module2Placeholder.style.display = 'block';
                    module2Content.style.display = 'none';
                }
            } catch (error) {
                console.error('Error fetching peer SNG analysis:', error);
                module2Placeholder.innerHTML = `
                    <i class="bi bi-exclamation-triangle"></i>
                    <p>Error loading peer SNG analysis</p>
                `;
                module2Placeholder.style.display = 'block';
                module2Content.style.display = 'none';
            }
        }

        // Format currency helper
        function formatCurrency(value) {
            if (value === null || value === undefined || isNaN(value)) return '-';
            return value.toLocaleString(undefined, { maximumFractionDigits: 0 });
        }

        // Format percentage helper
        function formatPercentage(value) {
            if (value === null || value === undefined || isNaN(value)) return '-';
            return (value * 100).toFixed(2) + '%';
        }

        // Create Peer Frontier Scatter Chart
        function createPeerFrontierScatterChart(chartData, frontierSlope, selectedSng, helpers) {
            const ctx = document.getElementById('peerSngChartTop');
            if (!ctx) return;

            // Destroy existing chart if it exists
            if (peerFrontierScatterChart) {
                peerFrontierScatterChart.destroy();
            }

            // Separate the selected SNG from other peers
            const otherPeers = chartData.filter(p => p.name !== selectedSng);
            const selectedPeer = chartData.find(p => p.name === selectedSng);

            // Calculate frontier line using helper values (from MinGDP to MaxGDP)
            // This matches Excel: X = {MinGDP, MaxGDP}, Y = {FrontierY@Min, FrontierY@Max}
            const frontierLineData = helpers ? [
                { x: helpers.minGDP, y: helpers.frontierYAtMinGDP },
                { x: helpers.maxGDP, y: helpers.frontierYAtMaxGDP }
            ] : [
                { x: 0, y: 0 },
                { x: Math.max(...chartData.map(p => p.x)) * 1.1, y: Math.max(...chartData.map(p => p.x)) * 1.1 * frontierSlope }
            ];

            peerFrontierScatterChart = new Chart(ctx, {
                type: 'scatter',
                data: {
                    datasets: [
                        // Peers (all peer SNGs except selected)
                        {
                            label: 'Peers',
                            data: otherPeers.map(p => ({ x: p.x, y: p.y, name: p.name })),
                            backgroundColor: 'rgba(68, 114, 196, 0.7)',
                            borderColor: '#4472C4',
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            pointStyle: 'circle',
                            datalabels: {
                                display: false // Don't show labels for all peers
                            }
                        },
                        // Frontier line (Top-20% avg)
                        {
                            label: 'Frontier (Top-20% avg)',
                            data: frontierLineData,
                            borderColor: '#ED7D31',
                            borderWidth: 2,
                            pointRadius: 0,
                            showLine: true,
                            fill: false,
                            tension: 0,
                            datalabels: {
                                display: false
                            }
                        },
                        // Selected SNG (highlighted point)
                        {
                            label: selectedSng,
                            data: selectedPeer ? [{ x: selectedPeer.x, y: selectedPeer.y }] : [],
                            backgroundColor: '#70AD47',
                            borderColor: '#70AD47',
                            pointRadius: 10,
                            pointHoverRadius: 12,
                            pointStyle: 'circle',
                            datalabels: {
                                display: true,
                                align: 'top',
                                anchor: 'end',
                                offset: 5,
                                color: '#70AD47',
                                font: { weight: 'bold', size: 11 },
                                formatter: function(value) {
                                    return selectedSng;
                                }
                            }
                        }
                    ]
                },
                plugins: [ChartDataLabels],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 10,
                                font: { size: 10 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    // Skip tooltip for frontier line
                                    if (context.datasetIndex === 1) return null;
                                    const point = context.raw;
                                    // For peers, try to find the name
                                    if (context.datasetIndex === 0) {
                                        const peerIndex = context.dataIndex;
                                        const peerName = otherPeers[peerIndex]?.name || 'Peer';
                                        return `${peerName}: GDP ${point.x.toLocaleString()}, OSR ${point.y.toLocaleString()}`;
                                    }
                                    // For selected SNG
                                    return `${selectedSng}: GDP ${point.x.toLocaleString()}, OSR ${point.y.toLocaleString()}`;
                                }
                            }
                        },
                        datalabels: {
                            display: false // Default off, enabled per dataset
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: window.__RosraPeerMethod === 'osr_per_capita' ? 'Population' : 'Subnational GDP (economic base)',
                                font: { size: 12, weight: 'bold' }
                            },
                            ticks: {
                                font: { size: 11, weight: '700' },
                                color: '#1f2937',
                                autoSkip: true,
                                maxTicksLimit: 8,
                                callback: function(value) {
                                    if (value >= 1000000000) return (value / 1000000000).toFixed(1) + 'B';
                                    if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                                    return value.toLocaleString();
                                }
                            },
                            grid: { color: '#e9ecef' },
                            beginAtZero: true,
                            suggestedMax: Math.max(...chartData.map(p => p.x)) * 1.2
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Own-Source Revenues (OSR)',
                                font: { size: 12, weight: 'bold' }
                            },
                            ticks: {
                                font: { size: 11, weight: '700' },
                                color: '#1f2937',
                                autoSkip: true,
                                maxTicksLimit: 8,
                                callback: function(value) {
                                    if (value >= 1000000000) return (value / 1000000000).toFixed(1) + 'B';
                                    if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                                    return value.toLocaleString();
                                }
                            },
                            grid: { color: '#e9ecef' },
                            beginAtZero: true,
                            suggestedMax: Math.max(...chartData.map(p => p.y)) * 1.2
                        }
                    }
                }
            });
            if (window.registerChart) registerChart('peerSngChartTop', peerFrontierScatterChart);
        }

        // Custom plugin to draw values on bars
        const barValuePlugin = {
            id: 'barValuePlugin',
            afterDatasetsDraw: function(chart) {
                const ctx = chart.ctx;
                const chartData = chart.data;
                const colors = ['#00b2e3', '#0095c0', '#FD9D24'];

                function formatValue(value) {
                    if (value >= 1000000000) return (value / 1000000000).toFixed(2) + 'B';
                    if (value >= 1000000) return (value / 1000000).toFixed(2) + 'M';
                    return value.toLocaleString(undefined, { maximumFractionDigits: 0 });
                }

                chart.data.datasets.forEach(function(dataset, datasetIndex) {
                    const meta = chart.getDatasetMeta(datasetIndex);
                    meta.data.forEach(function(bar, index) {
                        const value = dataset.data[index];
                        const formattedValue = formatValue(value);

                        ctx.save();
                        ctx.font = 'bold 12px Arial';
                        ctx.fillStyle = colors[index] || '#333';
                        ctx.textAlign = 'left';
                        ctx.textBaseline = 'middle';

                        // Position text at end of bar + offset
                        const x = bar.x + 10;
                        const y = bar.y;

                        ctx.fillText(formattedValue, x, y);
                        ctx.restore();
                    });
                });
            }
        };

        let actualVsPotentialChart = null;

        // Create "Current OSR vs Potential — Gap to Frontier" stacked bar chart
        function createActualVsPotentialChart(actualOSR, osrPotential, osrGap) {
            // Domestic (Tier 1/2) gap chart — its own canvas; the WoFi card owns
            // the #actualVsPotentialChart id and renders via its scoped twin.
            const canvas = document.getElementById('actualVsPotentialChartDomestic');
            if (!canvas) return;

            if (actualVsPotentialChart) {
                actualVsPotentialChart.destroy();
            }

            // Preloaded datasets carry their own currency (USD 2024); fall back
            // to the report currency symbol for user-provided/legacy data.
            const symbolEl = document.getElementById('currency-symbol');
            const rawSymbol = window.__RosraPeerCurrency || (symbolEl ? symbolEl.textContent : '').trim();
            const symbol    = (!rawSymbol || rawSymbol === '-') ? '' : rawSymbol;

            // Update header units indicator (e.g. "AMOUNTS IN KSH (B)").
            // Format string comes from the data-units-format attribute so the prefix/suffix are localised.
            const unitsEl = document.getElementById('gapFrontierUnits');
            if (unitsEl) {
                const unitText = symbol ? symbol.toUpperCase() : 'LCU';
                const fmt = unitsEl.getAttribute('data-units-format') || 'AMOUNTS IN {0} (B)';
                unitsEl.textContent = fmt.replace('{0}', unitText);
            }

            const fmtShort = function (v) {
                if (v == null || isNaN(v)) return '0';
                if (Math.abs(v) >= 1e9) return (v / 1e9).toFixed(2) + 'B';
                if (Math.abs(v) >= 1e6) return (v / 1e6).toFixed(2) + 'M';
                if (Math.abs(v) >= 1e3) return (v / 1e3).toFixed(1) + 'K';
                return v.toLocaleString();
            };
            const fmtFull = function (v) {
                return (symbol ? symbol + ' ' : '') + fmtShort(v);
            };
            const pctOfPotential = (osrPotential > 0) ? Math.round((osrGap / osrPotential) * 100) : 0;
            const currentPctOfPotential = (osrPotential > 0) ? Math.round((actualOSR / osrPotential) * 100) : 0;

            // Custom plugin: total labels above bars, segment values, dashed connector, right-side gap bracket
            const gapAnnotPlugin = {
                id: 'gapAnnotations',
                afterDatasetsDraw: function (chart) {
                    const c = chart.ctx;
                    const m0 = chart.getDatasetMeta(0); // base (blue) — Current OSR portion of both bars
                    const m1 = chart.getDatasetMeta(1); // gap (orange) — only on Potential bar
                    if (!m0 || !m1) return;
                    const bar0Cur = m0.data[0]; // Current OSR bar
                    const bar0Pot = m0.data[1]; // Potential bar — blue base
                    const bar1Pot = m1.data[1]; // Potential bar — orange top
                    if (!bar0Cur || !bar0Pot || !bar1Pot) return;

                    c.save();

                    // 1) Total amount label above each bar
                    c.font = '700 13px Roboto, "Segoe UI", Arial, sans-serif';
                    c.fillStyle = '#1f2937';
                    c.textAlign = 'center';
                    c.textBaseline = 'bottom';
                    c.fillText(fmtFull(actualOSR),    bar0Cur.x, bar0Cur.y - 8);
                    c.fillText(fmtFull(osrPotential), bar1Pot.x, bar1Pot.y - 8);

                    // 2) Segment value labels (white) inside each filled segment
                    c.fillStyle = '#ffffff';
                    c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                    c.textBaseline = 'middle';
                    if (Math.abs(bar0Cur.base - bar0Cur.y) > 22) {
                        c.fillText(fmtShort(actualOSR), bar0Cur.x, (bar0Cur.y + bar0Cur.base) / 2);
                    }
                    if (Math.abs(bar0Pot.base - bar0Pot.y) > 22) {
                        c.fillText(fmtShort(actualOSR), bar0Pot.x, (bar0Pot.y + bar0Pot.base) / 2);
                    }
                    if (Math.abs(bar1Pot.base - bar1Pot.y) > 22) {
                        c.fillText(fmtShort(osrGap),    bar1Pot.x, (bar1Pot.y + bar1Pot.base) / 2);
                    }

                    // 3) Dashed connector — top of Current OSR → top of blue base in Potential
                    const halfW = (bar0Cur.width || 60) / 2;
                    c.strokeStyle = '#9ca3af';
                    c.lineWidth = 1;
                    c.setLineDash([4, 4]);
                    c.beginPath();
                    c.moveTo(bar0Cur.x + halfW, bar0Cur.y);
                    c.lineTo(bar0Pot.x - halfW, bar0Pot.y);
                    c.stroke();
                    c.setLineDash([]);

                    // 4) Right-side gap bracket + labels
                    if (osrGap > 0) {
                        const bracketX = bar1Pot.x + ((bar1Pot.width || 60) / 2) + 18;
                        const topY = bar1Pot.y;
                        const botY = bar1Pot.base;
                        c.strokeStyle = '#FD9D24';
                        c.lineWidth = 1.5;
                        // vertical
                        c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX, botY); c.stroke();
                        // top tick
                        c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX - 6, topY); c.stroke();
                        // bottom tick
                        c.beginPath(); c.moveTo(bracketX, botY); c.lineTo(bracketX - 6, botY); c.stroke();

                        const midY = (topY + botY) / 2;
                        c.fillStyle = '#FD9D24';
                        c.textAlign = 'left';
                        c.font = '700 10px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'bottom';
                        c.fillText('Estimated', bracketX + 8, midY - 16);
                        c.fillText('improvement gap', bracketX + 8, midY - 4);
                        c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'top';
                        c.fillText(fmtShort(osrGap), bracketX + 8, midY + 2);
                        c.fillStyle = '#94a3b8';
                        c.font = '500 11px Roboto, "Segoe UI", Arial, sans-serif';
                        // Wrap the label onto two lines so it doesn't run off
                        // the chart's right edge in narrower PDF layouts.
                        c.fillText(currentPctOfPotential + '% — Current OSR', bracketX + 8, midY + 22);
                        c.fillText('as % of estimated potential', bracketX + 8, midY + 34);
                    }

                    c.restore();
                }
            };

            actualVsPotentialChart = new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: ['Current OSR', 'Estimated OSR potential'],
                    datasets: [
                        {
                            label: 'Current OSR',
                            data: [actualOSR, actualOSR],
                            backgroundColor: '#00b2e3',
                            stack: 'osr',
                            borderWidth: 0,
                            barThickness: 110,
                            maxBarThickness: 130
                        },
                        {
                            label: 'Estimated improvement gap',
                            data: [0, osrGap],
                            backgroundColor: '#FD9D24',
                            stack: 'osr',
                            borderWidth: 0,
                            barThickness: 110,
                            maxBarThickness: 130
                        }
                    ]
                },
                plugins: [gapAnnotPlugin],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { top: 36, right: 150, bottom: 8, left: 8 } },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ctx.dataset.label + ': ' + fmtFull(ctx.parsed.y);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            ticks: {
                                font: { size: 12, weight: '700' },
                                color: '#1f2937',
                                padding: 8
                            },
                            grid: { display: false },
                            border: { display: false }
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: {
                                font: { size: 11, weight: '700' },
                                color: '#1f2937',
                                callback: function (v) {
                                    if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
                                    if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
                                    if (v >= 1e3) return (v / 1e3).toFixed(0) + 'K';
                                    return v.toLocaleString();
                                }
                            },
                            grid: { color: '#eef0f3', drawBorder: false }
                        }
                    }
                }
            });
            if (window.registerChart) registerChart('actualVsPotentialChart', actualVsPotentialChart);
        }

        // Update Module 2 Analysis Result Text
        // Localized analysis result templates (injected from server-side resources)
        var _resultTemplates = {
            largeGap: '@Html.Raw(Localizer["JS_Result_LargeGap"].Value.Replace("'", "\\'"))',
            meaningfulGap: '@Html.Raw(Localizer["JS_Result_MeaningfulGap"].Value.Replace("'", "\\'"))',
            closeToFrontier: '@Html.Raw(Localizer["JS_Result_CloseToFrontier"].Value.Replace("'", "\\'"))'
        };

        function updateModule2ResultText(performanceIndex, osrGap, sngName, actualOSR, osrPotential) {
            const resultText = document.getElementById('module2ResultTextTop');
            if (!resultText) return;

            const perfPercent = Math.round(performanceIndex * 100);
            const actualFormatted = Math.round(actualOSR).toLocaleString();
            const potentialFormatted = Math.round(osrPotential).toLocaleString();
            const gapFormatted = Math.round(osrGap).toLocaleString();

            let template = '';
            if (performanceIndex < 0.3) {
                template = _resultTemplates.largeGap;
            } else if (performanceIndex < 0.7) {
                template = _resultTemplates.meaningfulGap;
            } else {
                template = _resultTemplates.closeToFrontier;
            }

            // Replace {0},{1},{2},{3} placeholders with actual values
            resultText.textContent = template
                .replace('{0}', perfPercent)
                .replace('{1}', actualFormatted)
                .replace('{2}', potentialFormatted)
                .replace('{3}', gapFormatted);
        }

        // Handle Peer SNG selection change — legacy listener for the removed
        // Peer SNG dropdown. Guarded so it no-ops when the element is gone.
        if (peerSngSelect) peerSngSelect.addEventListener('change', function() {
            fetchPeerSNGAnalysis(this.value);

            // Sync with State/Region dropdown (two-way binding)
            if (this.value && regionSelect) {
                // Check if the value exists in regionSelect
                const matchingOption = Array.from(regionSelect.options).find(opt =>
                    opt.value.toLowerCase() === this.value.toLowerCase() ||
                    opt.text.toLowerCase() === this.value.toLowerCase()
                );
                if (matchingOption && regionSelect.value !== matchingOption.value) {
                    regionSelect.value = matchingOption.value;
                    // Trigger change event on regionSelect to update any dependent logic
                    regionSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    // Update Select2 if used
                    if (typeof $ !== 'undefined' && $.fn.select2 && $(regionSelect).data('select2')) {
                        $(regionSelect).trigger('change.select2');
                    }
                }
            }
        });

        // ========================================
        // SYNC STATE/REGION WITH SUBNATIONAL GOVERNMENT
        // ========================================
        // When State/Region changes, update Subnational Government dropdown
        regionSelect.addEventListener('change', function() {
            // Reset lower levels when Level 1 changes
            if (!this.value) {
                cityInput.value = '';
                govUnitLevel3Input.value = '';
                level1IsFinal.checked = false;
                level2IsFinal.checked = false;
            }
            updateGovernmentUnitVisibility();

            // Sync with PeerSNG dropdown
            if (this.value && peerSngSelect) {
                const matchingOption = Array.from(peerSngSelect.options).find(opt =>
                    opt.value.toLowerCase() === this.value.toLowerCase() ||
                    opt.text.toLowerCase() === this.value.toLowerCase()
                );
                if (matchingOption && peerSngSelect.value !== matchingOption.value) {
                    peerSngSelect.value = matchingOption.value;
                    if (typeof $ !== 'undefined' && $.fn.select2 && $(peerSngSelect).data('select2')) {
                        $(peerSngSelect).trigger('change.select2');
                    }
                    fetchPeerSNGAnalysis(matchingOption.value);
                }
            }
        });

        // ========================================
        // HELPERS MODAL HANDLING (Bootstrap)
        // ========================================
        const viewHelpersBtn = document.getElementById('viewHelpersBtn');
        const helpersModalElement = document.getElementById('helpersModalOverlay');
        let helpersModal = null;

        // Initialize Bootstrap modal
        if (helpersModalElement) {
            helpersModal = new bootstrap.Modal(helpersModalElement);
        }

        // Open modal
        if (viewHelpersBtn && helpersModal) {
            viewHelpersBtn.addEventListener('click', function() {
                helpersModal.show();
            });
        }

        // ========================================
        // FORMULA TOOLTIP HANDLING
        // ========================================
        let activeFormulaPopup = null;

        function showFormulaPopup(button) {
            // Remove any existing popup
            hideFormulaPopup();

            // Prefer the descriptive text; fall back to data-formula only if no
            // description has been supplied (legacy buttons).
            const description = button.getAttribute('data-description');
            const formula = button.getAttribute('data-formula');
            const content = description || formula;
            if (!content) return;

            // Create popup element
            const popup = document.createElement('div');
            popup.className = 'formula-popup';
            // Escape HTML since description may contain user-facing punctuation
            const tmp = document.createElement('div');
            tmp.textContent = content;
            popup.innerHTML = `<div class="formula-popup-content">${tmp.innerHTML}</div>`;

            document.body.appendChild(popup);
            activeFormulaPopup = popup;

            // Position the popup near the button
            const buttonRect = button.getBoundingClientRect();
            const popupRect = popup.getBoundingClientRect();

            // Calculate position
            let left = buttonRect.left + (buttonRect.width / 2) - 20;
            let top = buttonRect.bottom + 8;

            // Check if popup goes off right edge
            if (left + popupRect.width > window.innerWidth - 10) {
                left = window.innerWidth - popupRect.width - 10;
                popup.classList.add('arrow-right');
            }

            // Check if popup goes off bottom edge
            if (top + popupRect.height > window.innerHeight - 10) {
                top = buttonRect.top - popupRect.height - 8;
                popup.style.setProperty('--arrow-position', 'bottom');
            }

            popup.style.left = `${Math.max(10, left)}px`;
            popup.style.top = `${top}px`;
        }

        function hideFormulaPopup() {
            if (activeFormulaPopup) {
                activeFormulaPopup.remove();
                activeFormulaPopup = null;
            }
        }

        // Event delegation for formula tooltip buttons
        document.addEventListener('click', function(e) {
            const tooltipBtn = e.target.closest('.formula-tooltip-btn');

            if (tooltipBtn) {
                e.preventDefault();
                e.stopPropagation();

                // If clicking the same button, toggle off
                if (activeFormulaPopup && tooltipBtn.dataset.popupActive === 'true') {
                    hideFormulaPopup();
                    tooltipBtn.dataset.popupActive = 'false';
                } else {
                    // Remove active state from all buttons
                    document.querySelectorAll('.formula-tooltip-btn').forEach(btn => {
                        btn.dataset.popupActive = 'false';
                    });

                    showFormulaPopup(tooltipBtn);
                    tooltipBtn.dataset.popupActive = 'true';
                }
            } else {
                // Click outside - close popup
                hideFormulaPopup();
                document.querySelectorAll('.formula-tooltip-btn').forEach(btn => {
                    btn.dataset.popupActive = 'false';
                });
            }
        });

        // Close popup on scroll
        document.addEventListener('scroll', hideFormulaPopup, true);

        // Load Select2 dynamically after jQuery is available, then load Peer SNGs
        function loadSelect2ThenPeerSNGs() {
            if (typeof $ !== 'undefined') {
                // Check if Select2 is already loaded
                if ($.fn.select2) {
                    loadPeerSNGs();
                } else {
                    // Load Select2 script dynamically
                    const script = document.createElement('script');
                    script.src = '/lib/select2/select2.min.js';
                    script.onload = function() {
                        loadPeerSNGs();
                    };
                    script.onerror = function() {
                        console.warn('Failed to load Select2, loading Peer SNGs without it');
                        loadPeerSNGs();
                    };
                    document.head.appendChild(script);
                }
            } else {
                // jQuery not loaded yet, wait and retry
                setTimeout(loadSelect2ThenPeerSNGs, 100);
            }
        }

        // Note: loadSelect2ThenPeerSNGs() is now called from loadCountries() after countries are loaded
        // This ensures peer SNGs are loaded after the country dropdown is populated

        // Expose functions to global scope for onclick handlers in HTML
        window.addPeerRow = addPeerRow;
        window.removePeerRow = removePeerRow;
        window.savePeerDataManually = savePeerDataManually;
        window.uploadPeerCSV = uploadPeerCSV;
        window.downloadPeerTemplate = downloadPeerTemplate;
        window.formatNumberInput = formatNumberInput;
        window.parseFormattedNumber = parseFormattedNumber;

    });
</script>

<script>
    // ============================================================
    // Configuration Card behaviour — Get Analysis + Add Level 3
    // ============================================================
    document.addEventListener('DOMContentLoaded', function () {
        // Bootstrap tooltips on the (i) info buttons next to the L2/L3 checkboxes.
        if (window.bootstrap && bootstrap.Tooltip) {
            document.querySelectorAll('.cfg-info-btn[data-bs-toggle="tooltip"]').forEach(function (el) {
                new bootstrap.Tooltip(el);
            });
        }

        var addL3Toggle = document.getElementById('addLevel3Toggle');
        var l3Input     = document.getElementById('govUnitLevel3');
        if (addL3Toggle && l3Input) {
            // initial state: show input only if a value already exists
            var hasValue = l3Input.value && l3Input.value.trim() !== '';
            addL3Toggle.checked = hasValue;
            l3Input.style.display = hasValue ? 'block' : 'none';
            addL3Toggle.addEventListener('change', function () {
                l3Input.style.display = this.checked ? 'block' : 'none';
                if (!this.checked) { l3Input.value = ''; }
                else { l3Input.focus(); }
            });
        }

        // Level 2 toggle — selects whether the user enters a Level 2 unit.
        // Input stays visible; unchecking disables it and clears the value.
        // NOTE: do NOT dispatch an input event after clearing. updateGovernmentUnitVisibility()
        // is a progressive-disclosure cascade that hides the entire gov-unit block (Country,
        // Level 1, Level 2, Level 3) when no country is selected — firing it from here makes
        // the surrounding rows disappear.
        var l2Toggle  = document.getElementById('level2Toggle');
        var cityInput = document.getElementById('city');
        if (l2Toggle && cityInput) {
            var hasCity = cityInput.value && cityInput.value.trim() !== '';
            l2Toggle.checked = hasCity || l2Toggle.checked;
            cityInput.disabled = !l2Toggle.checked;
            l2Toggle.addEventListener('change', function () {
                cityInput.disabled = !this.checked;
                if (!this.checked) {
                    cityInput.value = '';
                } else {
                    setTimeout(function () { cityInput.focus(); }, 0);
                }
            });
        }

        // ============================================================
        // WoFi Top-Down OSR Potential Estimator — wire-up.
        // - On country change: fetch national GDPpc + meta, fill the
        //   auto-populated stat in the LG Profile card.
        // - On economic profile change: surface the descriptive tooltip.
        // - On "Get Analysis" click: gather inputs, POST to
        //   /Rosra/WofiEstimatePotential, and render the result panel.
        // ============================================================
        (function wireUpWofiEstimator() {
            var URL_COUNTRY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("WofiCountryReference", "Rosra")));
            var URL_ESTIMATE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("WofiEstimatePotential", "Rosra")));
            // Localised strings serialised via JsonSerializer so they survive
            // apostrophes/quotes regardless of the active culture (en/fr/es).
            var L = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                interpStrong = Localizer["Wofi_FrontierInterp_Strong"].Value,
                interpModerate = Localizer["Wofi_FrontierInterp_Moderate"].Value,
                interpSignificant = Localizer["Wofi_FrontierInterp_Significant"].Value,
                interpLarge = Localizer["Wofi_FrontierInterp_Large"].Value,
                autoHelp = Localizer["LgProfile_Grp_AutoHelp"].Value,
                validationCountry = Localizer["Wofi_ValidationMissingCountry"].Value,
                validationProfile = Localizer["Wofi_ValidationMissingProfile"].Value,
                validationPopulation = Localizer["Wofi_ValidationMissingPopulation"].Value,
                validationOsr = Localizer["Wofi_ValidationMissingOsr"].Value,
            }));
            var INTERP_TEXT = {
                Strong:      L.interpStrong,
                Moderate:    L.interpModerate,
                Significant: L.interpSignificant,
                Large:       L.interpLarge,
            };

            var countryEl   = document.getElementById('country');
            var profileEl   = document.getElementById('economicProfile');
            var gdpEl       = document.getElementById('gdpPerCapita');
            var gdpSourceEl = document.getElementById('gdpPerCapitaSource');
            var profileDescEl = document.getElementById('economicProfileDescription');
            var actualOsrEl = document.getElementById('actualOsr');
            var populationEl = document.getElementById('population');
            var currencyCodeEl = document.getElementById('currency');
            var currencySymbolEl = document.getElementById('currencySymbol');
            var financialYearEl = document.getElementById('financialYear');
            var cityEl      = document.getElementById('city');
            var getBtn      = document.getElementById('getAnalysisBtn');
            var panel       = document.getElementById('analysisPanelWrap');
            var placeholder = document.getElementById('wofiPlaceholder');
            var content     = document.getElementById('wofiContent');

            // ---- Number / currency helpers ----
            function parseNumber(raw) {
                if (raw == null) return 0;
                var s = String(raw).replace(/[^0-9.\-]/g, '');
                var n = parseFloat(s);
                return isNaN(n) ? 0 : n;
            }
            function formatNumber(n, maxFractionDigits) {
                if (n == null || isNaN(n)) return '—';
                return Number(n).toLocaleString(undefined, {
                    maximumFractionDigits: maxFractionDigits == null ? 0 : maxFractionDigits,
                });
            }
            function currencyUnit() {
                var sym = (currencySymbolEl && currencySymbolEl.value) ? currencySymbolEl.value.trim() : '';
                var code = (currencyCodeEl && currencyCodeEl.value) ? currencyCodeEl.value.trim() : '';
                return (sym || code) ? (sym || code) : 'LCU';
            }
            function withCurrency(n, fractionDigits) {
                if (n == null || isNaN(n)) return '—';
                return currencyUnit() + ' ' + formatNumber(n, fractionDigits);
            }
            function withCurrencyShort(n) {
                if (n == null || isNaN(n)) return '—';
                var abs = Math.abs(n);
                var unit = currencyUnit();
                if (abs >= 1e9) return unit + ' ' + (n / 1e9).toFixed(2) + 'B';
                if (abs >= 1e6) return unit + ' ' + (n / 1e6).toFixed(2) + 'M';
                if (abs >= 1e3) return unit + ' ' + (n / 1e3).toFixed(2) + 'K';
                return unit + ' ' + formatNumber(n, 0);
            }

            // ---- Country change → load national reference data ----
            function loadCountryReference(countryName) {
                if (!countryName) {
                    if (gdpEl) gdpEl.value = '';
                    if (gdpSourceEl) gdpSourceEl.textContent = L.autoHelp;
                    return Promise.resolve(null);
                }
                var url = URL_COUNTRY + '?country=' + encodeURIComponent(countryName);
                return fetch(url, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (!data) return null;
                        if (gdpEl && data.nationalGdpPerCapita != null) {
                            gdpEl.value = formatNumber(data.nationalGdpPerCapita, 2);
                        }
                        if (gdpSourceEl) {
                            var src = 'World Bank WDI';
                            if (data.dataYear) src += ' ' + data.dataYear;
                            gdpSourceEl.textContent = src;
                        }
                        return data;
                    })
                    .catch(function () { return null; });
            }
            if (countryEl) {
                countryEl.addEventListener('change', function () {
                    loadCountryReference(this.value);
                });
                // Initial load if a country is already selected (edit / sample mode)
                if (countryEl.value) loadCountryReference(countryEl.value);
            }

            // ---- Economic profile change → show descriptive caption ----
            function refreshProfileDescription() {
                if (!profileEl || !profileDescEl) return;
                var opt = profileEl.options[profileEl.selectedIndex];
                profileDescEl.textContent = (opt && opt.title) ? opt.title : '';
            }
            if (profileEl) {
                profileEl.addEventListener('change', refreshProfileDescription);
                refreshProfileDescription();
            }

            // ---- Get Analysis → run the estimator ----
            function gatherInputs() {
                return {
                    Country: countryEl ? countryEl.value : null,
                    EconomicProfile: profileEl ? profileEl.value : null,
                    ActualOsr: parseNumber(actualOsrEl ? actualOsrEl.value : 0),
                    LocalPopulation: parseNumber(populationEl ? populationEl.value : 0),
                    LocalGovernmentName: cityEl ? cityEl.value : null,
                    OsrYear: financialYearEl ? financialYearEl.value : null,
                };
            }

            function renderResult(result) {
                if (!result) return;
                if (placeholder) placeholder.style.display = 'none';
                if (content) content.style.display = '';

                // Header meta strip
                setText('wofiIncomeGroupLabel', result.incomeGroup || '—');
                setText(
                    'wofiBenchmarkLabel',
                    result.finalHeadlineFrontierPctGdp != null
                        ? formatNumber(result.finalHeadlineFrontierPctGdp, 2) + '% of GDP'
                            + (result.peerStage ? ' · stage ' + result.peerStage + ', ' + result.peerCount + ' peers' : '')
                        : '—'
                );
                setText(
                    'wofiProfileFactorLabel',
                    result.economicProfileFactor != null
                        ? '×' + formatNumber(result.economicProfileFactor, 2)
                        : '—'
                );

                if (!result.isValid) {
                    if (placeholder) {
                        placeholder.style.display = '';
                        var p = placeholder.querySelector('p');
                        if (p) p.textContent = result.validationMessage || 'Cannot estimate potential.';
                    }
                    if (content) content.style.display = 'none';
                    return;
                }

                // Tiles
                setText('wofiPotentialValue', withCurrencyShort(result.potentialOsr));
                setText('wofiGapValue', withCurrencyShort(result.osrGap));
                var idx = result.frontierIndex || 0;
                setText('wofiFrontierIndexValue', (idx * 100).toFixed(0) + '%');
                setText('wofiFrontierInterpretation', INTERP_TEXT[result.frontierInterpretation] || '');

                // Cache the raw numeric WoFi result on window so the
                // Recommendations "Generate Report" flow can always rebuild the
                // "Current revenue + estimated gap = potential" chart, even when
                // the live Chart.js canvas isn't capturable (e.g. hidden tab,
                // 0-sized layout) or the formatted tile text fails to parse.
                window.__RosraWofiResult = {
                    actualOsr:    result.actualOsr,
                    potentialOsr: result.potentialOsr,
                    osrGap:       result.osrGap,
                    frontierIndex: result.frontierIndex,
                };

                // Bar — Chart.js two-bar stacked column with gap bracket
                var unitsEl = document.getElementById('wofiBarUnits');
                if (unitsEl) {
                    var fmt = unitsEl.getAttribute('data-units-format') || 'AMOUNTS IN {0} (B)';
                    unitsEl.textContent = fmt.replace('{0}', currencyUnit().toUpperCase());
                }
                createActualVsPotentialChart(result.actualOsr || 0, result.potentialOsr || 0, result.osrGap || 0);

                // Warning ribbon
                var warn = document.getElementById('wofiWarning');
                var warnMsg = document.getElementById('wofiWarningMessage');
                if (warn) {
                    if (result.warningLevel && result.warningLevel !== 'OK' && result.warningMessage) {
                        warn.style.display = '';
                        warn.setAttribute('data-level', result.warningLevel);
                        if (warnMsg) warnMsg.textContent = result.warningMessage;
                    } else if (result.peerSetWarning) {
                        // Note §11: small peer set → treat results as indicative
                        warn.style.display = '';
                        warn.setAttribute('data-level', 'AMBER');
                        if (warnMsg) warnMsg.textContent = result.peerSetWarning;
                    } else {
                        warn.style.display = 'none';
                    }
                }

                // Methodology echoes
                setText('wofiMethodGdp', withCurrency(result.nationalGdpPerCapita, 2));
                setText('wofiMethodLocalGdp', withCurrencyShort(result.estimatedLocalGdp));
                setText('wofiMethodBenchmark',
                    (result.finalHeadlineFrontierPctGdp != null
                        ? formatNumber(result.finalHeadlineFrontierPctGdp, 2) + '% of GDP'
                        : '—')
                );
                setText('wofiMethodGdpShare',
                    (result.gdpShareNational != null
                        ? (result.gdpShareNational * 100).toFixed(2) + '%'
                        : '—')
                );
                // Staged peer selection diagnostics (v13 mechanism): which
                // stage was used, how many peer countries, and the top peers.
                var peersText = '—';
                if (result.peerStage) {
                    peersText = 'Stage ' + result.peerStage + ' — ' + result.peerCount + ' countries';
                    if (result.topPeers && result.topPeers.length) {
                        peersText += ': ' + result.topPeers.slice(0, 8).map(function (p) { return p.country; }).join(', ')
                            + (result.topPeers.length > 8 ? ', …' : '');
                    }
                    if (result.peerSetWarning) {
                        peersText += ' — ' + result.peerSetWarning;
                    }
                }
                setText('wofiMethodPeers', peersText);
                setText('wofiMethodSource', result.nationalDataSource || '—');
            }

            function setText(id, text) {
                var el = document.getElementById(id);
                if (el) el.textContent = text == null ? '—' : text;
            }

            // ----------------------------------------------------------
            // Chart.js — two-bar stacked column chart with right-side
            // gap bracket annotation. Restored from the legacy
            // _PotentialEstimates within-country chart so the visual
            // language stays consistent. Solid colours (no gradients).
            // ----------------------------------------------------------
            var actualVsPotentialChart = null;
            function createActualVsPotentialChart(actualOSR, osrPotential, osrGap) {
                var canvas = document.getElementById('actualVsPotentialChart');
                if (!canvas || typeof window.Chart === 'undefined') return;
                if (actualVsPotentialChart) {
                    actualVsPotentialChart.destroy();
                    actualVsPotentialChart = null;
                }

                var sym = currencyUnit();
                var fmtShort = function (v) {
                    if (v == null || isNaN(v)) return '0';
                    if (Math.abs(v) >= 1e9) return (v / 1e9).toFixed(2) + 'B';
                    if (Math.abs(v) >= 1e6) return (v / 1e6).toFixed(2) + 'M';
                    if (Math.abs(v) >= 1e3) return (v / 1e3).toFixed(1) + 'K';
                    return Number(v).toLocaleString();
                };
                var fmtFull = function (v) { return sym + ' ' + fmtShort(v); };
                var pctOfPotential = (osrPotential > 0) ? Math.round((osrGap / osrPotential) * 100) : 0;
                var currentPctOfPotential = (osrPotential > 0) ? Math.round((actualOSR / osrPotential) * 100) : 0;

                var gapAnnotPlugin = {
                    id: 'gapAnnotations',
                    afterDatasetsDraw: function (chart) {
                        var c = chart.ctx;
                        var m0 = chart.getDatasetMeta(0);
                        var m1 = chart.getDatasetMeta(1);
                        if (!m0 || !m1) return;
                        var bar0Cur = m0.data[0];
                        var bar0Pot = m0.data[1];
                        var bar1Pot = m1.data[1];
                        if (!bar0Cur || !bar0Pot || !bar1Pot) return;

                        c.save();

                        // 1) Total amount label above each bar
                        c.font = '700 13px Roboto, "Segoe UI", Arial, sans-serif';
                        c.fillStyle = '#1f2937';
                        c.textAlign = 'center';
                        c.textBaseline = 'bottom';
                        c.fillText(fmtFull(actualOSR),    bar0Cur.x, bar0Cur.y - 8);
                        c.fillText(fmtFull(osrPotential), bar1Pot.x, bar1Pot.y - 8);

                        // 2) Segment value labels (white) inside each filled segment
                        c.fillStyle = '#ffffff';
                        c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'middle';
                        if (Math.abs(bar0Cur.base - bar0Cur.y) > 22) {
                            c.fillText(fmtShort(actualOSR), bar0Cur.x, (bar0Cur.y + bar0Cur.base) / 2);
                        }
                        if (Math.abs(bar0Pot.base - bar0Pot.y) > 22) {
                            c.fillText(fmtShort(actualOSR), bar0Pot.x, (bar0Pot.y + bar0Pot.base) / 2);
                        }
                        if (Math.abs(bar1Pot.base - bar1Pot.y) > 22) {
                            c.fillText(fmtShort(osrGap),    bar1Pot.x, (bar1Pot.y + bar1Pot.base) / 2);
                        }

                        // 3) Dashed connector — top of Current OSR → top of blue base in Potential
                        var halfW = (bar0Cur.width || 60) / 2;
                        c.strokeStyle = '#9ca3af';
                        c.lineWidth = 1;
                        c.setLineDash([4, 4]);
                        c.beginPath();
                        c.moveTo(bar0Cur.x + halfW, bar0Cur.y);
                        c.lineTo(bar0Pot.x - halfW, bar0Pot.y);
                        c.stroke();
                        c.setLineDash([]);

                        // 4) Right-side gap bracket + labels
                        if (osrGap > 0) {
                            var bracketX = bar1Pot.x + ((bar1Pot.width || 60) / 2) + 18;
                            var topY = bar1Pot.y;
                            var botY = bar1Pot.base;
                            c.strokeStyle = '#FD9D24';
                            c.lineWidth = 1.5;
                            c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX, botY); c.stroke();
                            c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX - 6, topY); c.stroke();
                            c.beginPath(); c.moveTo(bracketX, botY); c.lineTo(bracketX - 6, botY); c.stroke();

                            var midY = (topY + botY) / 2;
                            c.fillStyle = '#FD9D24';
                            c.textAlign = 'left';
                            c.font = '700 10px Roboto, "Segoe UI", Arial, sans-serif';
                            c.textBaseline = 'bottom';
                            c.fillText('Estimated', bracketX + 8, midY - 16);
                            c.fillText('improvement gap', bracketX + 8, midY - 4);
                            c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                            c.textBaseline = 'top';
                            c.fillText(fmtShort(osrGap), bracketX + 8, midY + 2);
                            c.fillStyle = '#94a3b8';
                            c.font = '500 11px Roboto, "Segoe UI", Arial, sans-serif';
                            // Wrap onto two lines so it fits the chart width.
                            c.fillText(currentPctOfPotential + '% — Current OSR', bracketX + 8, midY + 22);
                            c.fillText('as % of estimated potential', bracketX + 8, midY + 34);
                        }

                        c.restore();
                    }
                };

                actualVsPotentialChart = new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: ['Current OSR', 'Estimated OSR potential'],
                        datasets: [
                            {
                                label: 'Current OSR',
                                data: [actualOSR, actualOSR],
                                backgroundColor: '#00b2e3',
                                stack: 'osr',
                                borderWidth: 0,
                                barThickness: 110,
                                maxBarThickness: 130
                            },
                            {
                                label: 'Estimated improvement gap',
                                data: [0, osrGap],
                                backgroundColor: '#FD9D24',
                                stack: 'osr',
                                borderWidth: 0,
                                barThickness: 110,
                                maxBarThickness: 130
                            }
                        ]
                    },
                    plugins: [gapAnnotPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { top: 36, right: 150, bottom: 8, left: 8 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ctx.dataset.label + ': ' + fmtFull(ctx.parsed.y);
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                ticks: { font: { size: 12, weight: '700' }, color: '#1f2937', padding: 8 },
                                grid: { display: false },
                                border: { display: false }
                            },
                            y: {
                                stacked: true,
                                beginAtZero: true,
                                ticks: {
                                    font: { size: 11, weight: '700' },
                                    color: '#1f2937',
                                    callback: function (v) {
                                        if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
                                        if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
                                        if (v >= 1e3) return (v / 1e3).toFixed(0) + 'K';
                                        return v.toLocaleString();
                                    }
                                },
                                grid: { color: '#eef0f3', drawBorder: false }
                            }
                        }
                    }
                });

                // Expose to the global chart registry so the Recommendations
                // report export can pick it up via window.captureAllCharts().
                if (window.registerChart) registerChart('actualVsPotentialChart', actualVsPotentialChart);
            }

            function runEstimator() {
                var inputs = gatherInputs();
                // Minimal client-side validation for fast feedback
                if (!inputs.Country) {
                    return showPlaceholder(L.validationCountry);
                }
                if (!inputs.EconomicProfile) {
                    return showPlaceholder(L.validationProfile);
                }
                if (!inputs.LocalPopulation || inputs.LocalPopulation <= 0) {
                    return showPlaceholder(L.validationPopulation);
                }
                if (!inputs.ActualOsr || inputs.ActualOsr <= 0) {
                    return showPlaceholder(L.validationOsr);
                }

                return fetch(URL_ESTIMATE, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(inputs),
                })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (result) {
                        renderResult(result);
                    })
                    .catch(function (e) {
                        showPlaceholder('Could not compute potential. Please retry.');
                    });
            }

            function showPlaceholder(message) {
                if (placeholder) {
                    placeholder.style.display = '';
                    var p = placeholder.querySelector('p');
                    if (p && message) p.textContent = message;
                }
                if (content) content.style.display = 'none';
            }

            // Tier routing (Omar 2026-06): preloaded domestic peers → user-provided
            // peers → WoFi global fallback. The router lives in the main closure
            // (window.RosraDecideTopDownTier); it shows the WoFi card only when
            // the global benchmark is the selected tier.
            function routeOrRunEstimator() {
                if (typeof window.RosraDecideTopDownTier === 'function') {
                    window.RosraDecideTopDownTier().then(function () {
                        if (window.__RosraTopDownTier === 'global') {
                            // Chooser strip is showing; precompute nothing — the
                            // estimator runs when the user picks the global path.
                            // If the chooser is absent (markup missing), run directly.
                            if (!document.getElementById('tierChooserStrip')) runEstimator();
                        }
                    });
                } else {
                    runEstimator();
                }
            }

            if (getBtn && panel) {
                // If a country is already selected (edit / sample mode), show panel
                // immediately and try to compute. If inputs aren't complete, the
                // renderer will leave the placeholder visible.
                if (countryEl && countryEl.value) {
                    panel.style.display = '';
                    setTimeout(routeOrRunEstimator, 200);
                }

                getBtn.addEventListener('click', function () {
                    panel.style.display = '';
                    routeOrRunEstimator();
                    setTimeout(function () {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 50);
                });
            }

            // Expose runEstimator so the Recommendations report-generation flow
            // can force a recompute when __RosraWofiResult isn't yet cached
            // (e.g., user clicks Generate Report before the auto-fired estimator
            // has resolved, or they navigated straight to the recommendations tab).
            window.RosraWofiRunEstimator = runEstimator;
        })();

        // "Next step → Analyse Each Revenue Stream" CTA — switches umbrella tab to the per-stream pipeline
        var nextStepBtn = document.getElementById('goToStreamAnalysisBtn');
        if (nextStepBtn) {
            nextStepBtn.addEventListener('click', function () {
                var umbrellaInput = document.getElementById('umbrellaTabIdInput');
                var tabInput      = document.getElementById('tabIdInput');
                var form          = document.getElementById('rosraForm');
                if (!umbrellaInput || !form) {
                    // Fallback: hard-navigate (no tab state) so the user still gets there
                    window.location.href = '/Rosra?umbrellaTab=bottom-up&activeTab=gap-analysis';
                    return;
                }
                umbrellaInput.value = 'bottom-up';
                if (tabInput) tabInput.value = 'gap-analysis';
                form.action = '@Url.Action("SwitchTab", "Rosra")';
                form.submit();
            });
        }

        // "More analysis & methodology" expandable
        var moreToggle  = document.getElementById('moreAnalysisToggle');
        var moreContent = document.getElementById('moreAnalysisContent');
        if (moreToggle && moreContent) {
            var labelEl = moreToggle.querySelector('.more-analysis-toggle__label');
            var labelExpand   = moreToggle.getAttribute('data-label-expand')   || 'Expand';
            var labelCollapse = moreToggle.getAttribute('data-label-collapse') || 'Collapse';
            moreToggle.addEventListener('click', function () {
                var isOpen = moreContent.style.display !== 'none';
                if (isOpen) {
                    moreContent.style.display = 'none';
                    moreToggle.classList.remove('is-expanded');
                    moreToggle.setAttribute('aria-expanded', 'false');
                    if (labelEl) labelEl.textContent = labelExpand;
                } else {
                    moreContent.style.display = '';
                    moreToggle.classList.add('is-expanded');
                    moreToggle.setAttribute('aria-expanded', 'true');
                    if (labelEl) labelEl.textContent = labelCollapse;
                    // any embedded Chart.js charts may need a resize after their container becomes visible
                    if (window.Chart && Chart.instances) {
                        Object.values(Chart.instances).forEach(function (ch) { try { ch.resize(); } catch (e) {} });
                    }
                }
            });
        }
    });
</script>
