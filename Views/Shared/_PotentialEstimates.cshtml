.compact-field .select2-container--bootstrap-5 .select2-selection:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ========================================
        // PEER SNG DATA ISOLATION
        // Custom peer data stored per-report, not in global database
        // ========================================

        // Custom peer data - stores user-entered data in memory (saved with report)
        // Schema: { dataSource: 'custom'|'reference', countryCode: string, customPeers: [{sng, osr, gcp, include}], timestamp: string }
        let customPeerData = null;

        // Function to get custom peer data (for use in report save)
        window.getCustomPeerData = function() {
            return customPeerData;
        };

        // Function to set custom peer data (for loading saved reports)
        window.setCustomPeerData = function(data) {
            customPeerData = data;
            console.log('Custom peer data set:', data ? `${data.customPeers?.length || 0} peers` : 'null');
        };

        // Function to clear custom peer data (reset to reference data)
        window.clearCustomPeerData = function() {
            customPeerData = null;
            console.log('Custom peer data cleared, using reference data');
        };

        // Get the country and region elements
        const countrySelect = document.getElementById('country');
        const regionSelect = document.getElementById('region');
        const savedCountry = '@Model.Country' || '';
        const savedRegion = '@Model.Region' || '';
        const savedCity = '@Model.City' || '';
        const savedGovUnitLevel3 = '@Model.GovUnitLevel3' || '';
        const savedFinalUnitLevel = parseInt('@Model.FinalUnitLevel') || 0;

        // Government Unit Hierarchy elements
        const govUnitLevel1Row = document.getElementById('govUnitLevel1Row');
        const govUnitLevel2Row = document.getElementById('govUnitLevel2Row');
        const govUnitLevel3Row = document.getElementById('govUnitLevel3Row');
        const level1IsFinal = document.getElementById('level1IsFinal');
        const level2IsFinal = document.getElementById('level2IsFinal');
        const govUnitLevel3Input = document.getElementById('govUnitLevel3');
        const cityInput = document.getElementById('city');
        const finalUnitLevelInput = document.getElementById('finalUnitLevel');
        const hierarchyNote = document.getElementById('hierarchyNote');

        // Progressive disclosure for government unit hierarchy
        function updateGovernmentUnitVisibility() {
            const countrySelected = countrySelect.value !== '';
            const level1Selected = regionSelect.value !== '';
            const level1Checked = level1IsFinal.checked;
            const level2Filled = cityInput.value.trim() !== '';
            const level2Checked = level2IsFinal.checked;

            // Level 1 row (Country + Level 1 selects) must stay visible — it CONTAINS the country
            // select itself, so hiding it would prevent the user from re-selecting after clearing.

            // Show/hide Level 2 row
            govUnitLevel2Row.style.display = (countrySelected && level1Selected && !level1Checked) ? '' : 'none';

            // Show/hide Level 3 row — independent of Level 2 fill so the user can opt into either level directly.
            govUnitLevel3Row.style.display = (countrySelected && level1Selected && !level1Checked) ? '' : 'none';

            // Show hierarchy note when country is selected
            hierarchyNote.style.display = countrySelected ? '' : 'none';

            // Update the hidden FinalUnitLevel field
            if (level1Checked) {
                finalUnitLevelInput.value = '1';
            } else if (level2Checked) {
                finalUnitLevelInput.value = '2';
            } else if (govUnitLevel3Input.value.trim() !== '') {
                finalUnitLevelInput.value = '3';
            } else if (level2Filled) {
                finalUnitLevelInput.value = '2';
            } else if (level1Selected) {
                finalUnitLevelInput.value = '1';
            } else {
                finalUnitLevelInput.value = '';
            }
        }

        // Level 1 checkbox change
        level1IsFinal.addEventListener('change', function() {
            if (this.checked) {
                cityInput.value = '';
                govUnitLevel3Input.value = '';
                level2IsFinal.checked = false;
            }
            updateGovernmentUnitVisibility();
        });

        // Level 2 checkbox change
        level2IsFinal.addEventListener('change', function() {
            if (this.checked) {
                govUnitLevel3Input.value = '';
            }
            updateGovernmentUnitVisibility();
        });

        // Level 2 text input change (triggers Level 3 visibility)
        cityInput.addEventListener('input', function() {
            updateGovernmentUnitVisibility();
        });

        // Level 3 text input change (updates final unit level)
        govUnitLevel3Input.addEventListener('input', function() {
            updateGovernmentUnitVisibility();
        });

        // Data Input Block collapse toggle event listeners
        const dataInputBody = document.getElementById('dataInputBody');
        const collapsibleHeader = document.querySelector('.collapsible-header[data-bs-target="#dataInputBody"]');

        if (dataInputBody && collapsibleHeader) {
            // When collapse starts hiding
            dataInputBody.addEventListener('hide.bs.collapse', function() {
                collapsibleHeader.classList.add('collapsed');
            });

            // When collapse starts showing
            dataInputBody.addEventListener('show.bs.collapse', function() {
                collapsibleHeader.classList.remove('collapsed');
            });
        }

        // Fiscal Decentralisation Chart
        let fiscalChart = null;

        // Custom plugin to draw quadrant labels
        const quadrantLabelsPlugin = {
            id: 'quadrantLabels',
            afterDraw: function(chart) {
                const ctx = chart.ctx;
                const chartArea = chart.chartArea;
                const xScale = chart.scales.x;
                const yScale = chart.scales.y;

                // Get pixel positions for the threshold lines (80%)
                const xThreshold = xScale.getPixelForValue(80);
                const yThreshold = yScale.getPixelForValue(80);

                // Calculate quadrant centers
                const leftCenterX = (chartArea.left + xThreshold) / 2;
                const rightCenterX = (xThreshold + chartArea.right) / 2;
                const topCenterY = (chartArea.top + yThreshold) / 2;
                const bottomCenterY = (yThreshold + chartArea.bottom) / 2;

                // Set text style
                ctx.save();
                ctx.font = 'bold 12px Arial, sans-serif';
                ctx.fillStyle = '#495057';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';

                // Top-left quadrant: "Small and self-reliant"
                ctx.fillText('Small and', leftCenterX, topCenterY - 8);
                ctx.fillText('self-reliant', leftCenterX, topCenterY + 8);

                // Top-right quadrant: "Large & autonomous"
                ctx.fillText('Large &', rightCenterX, topCenterY - 8);
                ctx.fillText('autonomous', rightCenterX, topCenterY + 8);

                // Bottom-left quadrant: "Small & dependent"
                ctx.fillText('Small &', leftCenterX, bottomCenterY - 8);
                ctx.fillText('dependent', leftCenterX, bottomCenterY + 8);

                // Bottom-right quadrant: "Large but transfer"
                ctx.fillText('Large but', rightCenterX, bottomCenterY - 8);
                ctx.fillText('transfer', rightCenterX, bottomCenterY + 8);

                ctx.restore();
            }
        };

        function createFiscalDecentralisationChart(fundingIndex, autonomyIndex, countryName) {
            const ctx = document.getElementById('fiscalDecentralisationChart');
            if (!ctx) return;

            // Destroy existing chart if it exists
            if (fiscalChart) {
                fiscalChart.destroy();
            }

            // Convert percentages to decimals for plotting (0-120 scale)
            const fundingValue = fundingIndex;
            const autonomyValue = autonomyIndex;

            // Create the chart
            fiscalChart = new Chart(ctx, {
                type: 'scatter',
                data: {
                    datasets: [
                        // Country data point
                        {
                            label: countryName,
                            data: [{ x: fundingValue, y: autonomyValue }],
                            backgroundColor: '#0d6efd',
                            borderColor: '#0d6efd',
                            pointRadius: 8,
                            pointHoverRadius: 10,
                            showLine: false
                        },
                        // Funding threshold (vertical line at 80%)
                        {
                            label: 'Funding threshold',
                            data: [
                                { x: 80, y: 0 },
                                { x: 80, y: 120 }
                            ],
                            borderColor: '#17a2b8',
                            borderWidth: 2,
                            pointRadius: 0,
                            showLine: true,
                            fill: false
                        },
                        // Autonomy threshold (horizontal line at 80%)
                        {
                            label: 'Autonomy threshold',
                            data: [
                                { x: 0, y: 80 },
                                { x: 120, y: 80 }
                            ],
                            borderColor: '#17a2b8',
                            borderWidth: 2,
                            pointRadius: 0,
                            showLine: true,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                font: {
                                    size: 11
                                },
                                filter: function(legendItem, data) {
                                    // Only show country name in legend
                                    return legendItem.datasetIndex === 0;
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        return `${context.dataset.label}: Funding ${context.parsed.x}%, Autonomy ${context.parsed.y}%`;
                                    }
                                    return null;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            type: 'linear',
                            min: 0,
                            max: 120,
                            title: {
                                display: true,
                                text: 'Funding index',
                                font: {
                                    size: 12,
                                    weight: 'bold'
                                }
                            },
                            ticks: {
                                stepSize: 20,
                                callback: function(value) {
                                    return value + '%';
                                }
                            },
                            grid: {
                                color: '#e9ecef'
                            }
                        },
                        y: {
                            type: 'linear',
                            min: 0,
                            max: 120,
                            title: {
                                display: true,
                                text: 'Autonomy index',
                                font: {
                                    size: 12,
                                    weight: 'bold'
                                }
                            },
                            ticks: {
                                stepSize: 20,
                                callback: function(value) {
                                    return value + '%';
                                }
                            },
                            grid: {
                                color: '#e9ecef'
                            }
                        }
                    }
                },
                plugins: [quadrantLabelsPlugin]
            });
            if (window.registerChart) registerChart('fiscalDecentralisationChart', fiscalChart);
        }

        // Localized cross-country analysis templates
        var _ccTemplates = {
            bothHigh: '@Html.Raw(Localizer["JS_CC_BothHigh"].Value.Replace("'", "\\'"))',
            fundingHighAutLow: '@Html.Raw(Localizer["JS_CC_FundingHighAutLow"].Value.Replace("'", "\\'"))',
            fundingLowAutHigh: '@Html.Raw(Localizer["JS_CC_FundingLowAutHigh"].Value.Replace("'", "\\'"))',
            bothLow: '@Html.Raw(Localizer["JS_CC_BothLow"].Value.Replace("'", "\\'"))'
        };

        function updateAnalysisResultText(fundingIndex, autonomyIndex) {
            const resultText = document.getElementById('analysisResultText');
            if (!resultText) return;

            const fundingThreshold = 80;
            const autonomyThreshold = 80;
            let template = '';

            if (fundingIndex >= fundingThreshold && autonomyIndex >= autonomyThreshold) {
                template = _ccTemplates.bothHigh;
            } else if (fundingIndex >= fundingThreshold && autonomyIndex < autonomyThreshold) {
                template = _ccTemplates.fundingHighAutLow;
            } else if (fundingIndex < fundingThreshold && autonomyIndex >= autonomyThreshold) {
                template = _ccTemplates.fundingLowAutHigh;
            } else {
                template = _ccTemplates.bothLow;
            }

            resultText.textContent = template
                .replace('{0}', fundingIndex)
                .replace('{1}', autonomyIndex);
        }

        console.log('Initial values - Country:', savedCountry, 'Region:', savedRegion);

        // Load countries from API
        async function loadCountries() {
            try {
                const response = await fetch('/Rosra/GetCountries');
                const countries = await response.json();

                console.log('Loaded', countries.length, 'countries from API');

                // Clear existing options except the placeholder
                countrySelect.innerHTML = '<option value="">Select a country</option>';

                // Add countries to the dropdown
                countries.forEach(country => {
                    const option = document.createElement('option');
                    option.value = country.name;
                    option.textContent = country.name;
                    option.dataset.currency = country.currency || '';
                    option.dataset.currencySymbol = country.currencySymbol || '';
                    option.dataset.currencyName = country.currency || '';
                    option.dataset.governmentType = country.governmentType || '';
                    option.dataset.incomeLevel = country.incomeLevel || '';
                    // Set country code from ISO codes mapping for peer SNG filtering
                    option.dataset.code = countryIsoCodes[country.name] || '';
                    // 2-letter ISO for flag CDN (flagcdn.com)
                    option.dataset.flag = countryFlagCodes[country.name] || '';

                    // Select the saved country if it matches
                    if (savedCountry && country.name === savedCountry) {
                        option.selected = true;
                        // Show flag
                        updateCountryFlag(savedCountry);
                        // Auto-populate Government Type and Income Level
                        document.getElementById('governmentType').value = country.governmentType || '';
                        document.getElementById('incomeLevel').value = country.incomeLevel || '';
                        // Auto-populate Currency — separate code and symbol fields
                        if (country.currency) {
                            document.getElementById('currency').value = country.currency;
                            localCurrencyName = country.currency;
                        }
                        var _symEl = document.getElementById('currencySymbol');
                        if (_symEl) _symEl.value = country.currencySymbol || '';
                        localCurrencyCode = country.currencySymbol || '';
                        if (country.currencySymbol) {
                            updateCurrencySymbols(country.currencySymbol);
                        }
                    }

                    countrySelect.appendChild(option);
                });

                // If a country was saved, load its states and fetch GDP per capita
                if (savedCountry) {
                    await loadStates(savedCountry, savedRegion);
                    // Restore government unit hierarchy state
                    if (savedFinalUnitLevel === 1) {
                        level1IsFinal.checked = true;
                    } else if (savedFinalUnitLevel === 2 && savedCity) {
                        level2IsFinal.checked = true;
                    }
                    if (savedGovUnitLevel3) {
                        govUnitLevel3Input.value = savedGovUnitLevel3;
                    }
                    updateGovernmentUnitVisibility();
                    // Fetch GDP per capita from World Bank API for the auto-selected country
                    fetchGdpPerCapita(savedCountry);
                }

                // Initialize Select2 for searchable country dropdown.
                // The Select2 library is loaded dynamically by loadSelect2ThenPeerSNGs() below,
                // so $.fn.select2 may not exist yet on first try — poll until it is available.
                (function initCountrySelect2() {
                    if (typeof $ === 'undefined' || !$.fn.select2) {
                        setTimeout(initCountrySelect2, 100);
                        return;
                    }
                    if ($(countrySelect).data('select2')) return; // already initialized

                    // Render each option / the selected entry with a flag from flagcdn.com.
                    function formatCountryOption(state) {
                        if (!state.id || !state.element) return state.text;
                        const code = state.element.dataset.flag;
                        if (!code) return state.text;
                        const $row = $('<span class="cfg-country-row"></span>');
                        $('<img class="cfg-country-flag" alt="" loading="lazy">')
                            .attr({
                                src: 'https://flagcdn.com/w20/' + code + '.png',
                                srcset: 'https://flagcdn.com/w40/' + code + '.png 2x'
                            })
                            .appendTo($row);
                        $('<span></span>').text(state.text).appendTo($row);
                        return $row;
                    }

                    $(countrySelect).select2({
                        theme: 'bootstrap-5',
                        placeholder: 'Search for a country...',
                        allowClear: true,
                        width: '100%',
                        templateResult: formatCountryOption,
                        templateSelection: formatCountryOption
                    });
                    $(countrySelect).on('select2:select', function() {
                        countrySelect.dispatchEvent(new Event('change', { bubbles: true }));
                    });
                    $(countrySelect).on('select2:clear', function() {
                        countrySelect.dispatchEvent(new Event('change', { bubbles: true }));
                    });
                })();

                // Load peer SNGs after countries are loaded and selected country is set
                loadSelect2ThenPeerSNGs();
            } catch (error) {
                console.error('Error loading countries:', error);
            }
        }

        // Load states for a country from API
        async function loadStates(countryName, selectedState = null) {
            try {
                const response = await fetch(`/Rosra/GetStatesByCountry?country=${encodeURIComponent(countryName)}`);
                const states = await response.json();

                console.log('Loaded', states.length, 'states for', countryName);

                const container = regionSelect.parentElement;

                if (states.length > 0) {
                    // Has state data — show dropdown
                    if (document.getElementById('regionTextInput')) {
                        document.getElementById('regionTextInput').remove();
                    }
                    regionSelect.style.display = '';
                    regionSelect.innerHTML = '<option value="">Select a state/region</option>';

                    states.forEach(state => {
                        const option = document.createElement('option');
                        option.value = state.name;
                        option.textContent = state.name;
                        if (selectedState && state.name === selectedState) {
                            option.selected = true;
                        }
                        regionSelect.appendChild(option);
                    });
                } else {
                    // No state data for this country — switch to text input
                    regionSelect.style.display = 'none';
                    regionSelect.innerHTML = '<option value="">Select a state/region</option>';

                    if (!document.getElementById('regionTextInput')) {
                        const textInput = document.createElement('input');
                        textInput.type = 'text';
                        textInput.id = 'regionTextInput';
                        textInput.className = 'form-control form-control-sm';
                        textInput.placeholder = 'Type region / state / province name';
                        textInput.value = selectedState || '';
                        container.appendChild(textInput);

                        // Sync text input value to the hidden select so form submission works
                        textInput.addEventListener('input', function() {
                            // Add the typed value as the selected option
                            regionSelect.innerHTML = '<option value="' + this.value + '" selected>' + this.value + '</option>';
                            regionSelect.dispatchEvent(new Event('change'));
                        });
                    } else {
                        document.getElementById('regionTextInput').value = selectedState || '';
                    }
                }
            } catch (error) {
                console.error('Error loading states:', error);
            }
        }

        // Country name to ISO code mapping for World Bank API
        const countryIsoCodes = {
            'Afghanistan': 'AFG', 'Albania': 'ALB', 'Algeria': 'DZA', 'Angola': 'AGO', 'Argentina': 'ARG',
