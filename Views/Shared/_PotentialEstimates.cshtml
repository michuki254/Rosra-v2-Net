<!-- Tier-2 pop-up: user-provided peer SNG data (manual table or CSV). The inner
     #peerDataInputSection markup is the legacy panel the still-live JS targets
     (addPeerRow / savePeerDataManually / uploadPeerCSV). -->
<div class="modal fade" id="peerDataModal" tabindex="-1" aria-labelledby="peerDataModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="peerDataModalLabel"><i class="bi bi-table me-2"></i>Peer local government data</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="peerDataInputSection" class="peer-data-input-section" style="display: block;">
                    <div class="peer-data-alert">
                        <i class="bi bi-info-circle"></i>
                        <span>Provide data for peer local governments in your country (including your own). At minimum: name, OSR, and subnational GDP/GCP — all in the same currency.</span>
                    </div>

                    <!-- Input method tabs -->
                    <ul class="nav nav-tabs peer-input-tabs" id="peerInputTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="peer-manual-tab" data-bs-toggle="tab" data-bs-target="#peerManualPane" type="button" role="tab" aria-controls="peerManualPane" aria-selected="true">
                                <i class="bi bi-pencil-square me-1"></i> Manual Entry
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="peer-upload-tab" data-bs-toggle="tab" data-bs-target="#peerUploadPane" type="button" role="tab" aria-controls="peerUploadPane" aria-selected="false">
                                <i class="bi bi-file-earmark-arrow-up me-1"></i> Upload CSV
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content peer-input-tab-content">
                        <!-- Manual Entry pane (default) -->
                        <div class="tab-pane fade show active" id="peerManualPane" role="tabpanel" aria-labelledby="peer-manual-tab">
                            <small class="text-muted d-block mb-2"><i class="bi bi-info-circle"></i> <strong>SNG Name and OSR</strong> are required, plus <strong>GDP/GCP (preferred)</strong> or <strong>Population</strong>. Without GDP/GCP the tool uses an OSR-per-capita benchmark.</small>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered" id="peerManualEntryTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>SNG Name <span class="text-danger">*</span></th>
                                            <th>OSR <span class="text-danger">*</span></th>
                                            <th>GCP <span class="text-muted fw-normal" style="font-size: 0.75em;">(preferred)</span></th>
                                            <th>Population <span class="text-muted fw-normal" style="font-size: 0.75em;">(if no GCP)</span></th>
                                            <th style="width: 70px;" title="Include this local government in the comparison">Include</th>
                                            <th style="width: 40px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="peerManualEntryBody">
                                        <tr>
                                            <td><input type="text" class="form-control form-control-sm" placeholder="Name" data-field="sng"></td>
                                            <td><input type="text" class="form-control form-control-sm text-end" placeholder="0" inputmode="decimal" data-field="osr" oninput="formatNumberInput(this)"></td>
                                            <td><input type="text" class="form-control form-control-sm text-end" placeholder="0" inputmode="decimal" data-field="gcp" oninput="formatNumberInput(this)"></td>
                                            <td><input type="text" class="form-control form-control-sm text-end" placeholder="if no GCP" inputmode="numeric" data-field="population" title="Required when GDP/GCP is not provided — enables the OSR-per-capita benchmark" oninput="formatNumberInput(this, true)"></td>
                                            <td class="text-center align-middle"><input type="checkbox" class="form-check-input" data-field="include" checked></td>
                                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removePeerRow(this)"><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addPeerRow()">
                                    <i class="bi bi-plus"></i> Add Row
                                </button>
                                <button type="button" class="btn btn-sm btn-primary ms-auto" onclick="savePeerDataManually()">
                                    <i class="bi bi-save"></i> Save Peer Data
                                </button>
                            </div>
                        </div>

                        <!-- Upload CSV pane -->
                        <div class="tab-pane fade" id="peerUploadPane" role="tabpanel" aria-labelledby="peer-upload-tab">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted mb-0">Upload a CSV file with your peer SNG data.</small>
                                <button type="button" class="btn btn-sm btn-link p-0" onclick="downloadPeerTemplate()" title="Download a sample CSV template with column headers and example rows">
                                    <i class="bi bi-download"></i> Download Template
                                </button>
                            </div>
                            <div class="input-group input-group-sm mb-2">
                                <input type="file" class="form-control" id="peerCsvUpload" accept=".csv">
                                <button type="button" class="btn btn-primary" onclick="uploadPeerCSV()">
                                    <i class="bi bi-upload"></i> Upload
                                </button>
                            </div>
                            <small class="text-muted d-block">CSV columns: <strong>SNG, OSR</strong>, GCP <em>(preferred)</em>, Population <em>(required if no GCP)</em>, Include <em>(optional, defaults to 1)</em>.</small>
                            <small class="text-muted d-block"><i class="bi bi-info-circle"></i> Without GCP the tool uses an <strong>OSR-per-capita</strong> benchmark.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

