        function updateHeaderCountryChip(countryName) {
            const wrap  = document.getElementById('config-header-country');
            const img   = document.getElementById('config-header-flag');
            const label = document.getElementById('config-header-country-name');
            if (!wrap || !img || !label) return;
            const code = countryFlagCodes[countryName];
            if (countryName && code) {
                img.src    = 'https://flagcdn.com/w40/' + code + '.png';
                img.srcset = 'https://flagcdn.com/w80/' + code + '.png 2x';
                label.textContent = countryName;
                wrap.hidden = false;
                // Pre-cache a base64 data URL of the flag so the PDF report (rendered
                // server-side by HtmlToPdfService, which blocks all outbound network)
                // can embed the flag without needing to fetch it. Done via an offscreen
                // <img crossorigin="anonymous"> + canvas.drawImage instead of fetch(),
                // because the page CSP allows img-src but blocks connect-src to flagcdn.
                prefetchFlagDataUrl(code);
            } else {
                wrap.hidden = true;
                img.removeAttribute('src');
                img.removeAttribute('srcset');
                label.textContent = '';
                window._cachedCountryFlag = null;
            }
        }

        // Load the flag into an offscreen <img crossOrigin="anonymous">, paint it
        // onto a canvas, and read the data URL. flagcdn.com sends permissive CORS
        // headers so the canvas is not tainted — pixel reads succeed.
        function prefetchFlagDataUrl(code) {
            // Skip if we already have the data URL for this code.
            const cached = window._cachedCountryFlag;
            if (cached && cached.code === code && cached.dataUrl) return;
            const loader = new Image();
            loader.crossOrigin = 'anonymous';
            loader.onload = function () {
                try {
                    const c = document.createElement('canvas');
                    c.width = loader.naturalWidth;
                    c.height = loader.naturalHeight;
                    c.getContext('2d').drawImage(loader, 0, 0);
                    window._cachedCountryFlag = { code: code, dataUrl: c.toDataURL('image/png') };
                } catch (_) { /* canvas tainted — abort */ }
            };
            loader.onerror = function () { /* swallow */ };
            loader.src = 'https://flagcdn.com/w160/' + code + '.png';
        }

        // Fetch GDP per capita from World Bank API based on selected year
        async function fetchGdpPerCapita(countryName, year = null) {
            // SUPERSEDED: the WoFi top-down estimator handles GDP per capita
            // server-side via /Rosra/WofiCountryReference (LCU, World Bank WDI
            // 2024). The old browser-direct call returned USD and clobbered
            // the LCU value. Kept as a no-op so legacy call sites don't break.
            return null;
            // eslint-disable-next-line no-unreachable
            const isoCode = countryIsoCodes[countryName];
            if (!isoCode) {
                console.log('No ISO code found for country:', countryName);
                return null;
            }

            // Use selected financial year or default to current year
            const selectedYear = year || document.getElementById('financialYear').value || new Date().getFullYear();

            const gdpInput = document.getElementById('gdpPerCapita');
            const originalPlaceholder = gdpInput.placeholder;
            gdpInput.placeholder = 'Loading...';

            try {
                // Fetch GDP for the specific year (with fallback range of ±2 years)
                const startYear = parseInt(selectedYear) - 2;
                const endYear = parseInt(selectedYear) + 2;

                const response = await fetch(
                    `https://api.worldbank.org/v2/country/${isoCode}/indicator/NY.GDP.PCAP.CD?format=json&per_page=10&date=${startYear}:${endYear}`
                );
                const data = await response.json();

                if (data && data[1] && data[1].length > 0) {
                    // First try to find exact year match
                    let gdpEntry = data[1].find(entry => entry.date === selectedYear.toString() && entry.value !== null);

                    // If no exact match, find the closest year with data
                    if (!gdpEntry) {
                        for (const entry of data[1]) {
                            if (entry.value !== null) {
                                gdpEntry = entry;
                                break;
                            }
                        }
                    }

                    if (gdpEntry && gdpEntry.value !== null) {
                        const gdpValue = Math.round(gdpEntry.value);
                        console.log(`GDP per capita for ${countryName} (${gdpEntry.date}): $${gdpValue}`);
                        gdpInput.value = formatNumberWithCommas(gdpValue.toString());
                        gdpInput.placeholder = originalPlaceholder;
                        // Trigger calculation update
                        gdpInput.dispatchEvent(new Event('change'));
                        return gdpValue;
                    }
                }
                console.log('No GDP data found for:', countryName, 'year:', selectedYear);
                gdpInput.placeholder = originalPlaceholder;
                return null;
            } catch (error) {
                console.error('Error fetching GDP per capita:', error);
                gdpInput.placeholder = originalPlaceholder;
                return null;
            }
        }

