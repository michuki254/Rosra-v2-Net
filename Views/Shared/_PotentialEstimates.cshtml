        // Save manually entered peer data (to memory, not database)
        async function savePeerDataManually() {
            const countryCode = getCurrentCountryCode();
            if (!countryCode) {
                alert('Please select a country first');
                return;
            }

            const tbody = document.getElementById('peerManualEntryBody');
            const rows = tbody.querySelectorAll('tr');
            const peers = [];

            rows.forEach(row => {
                const getVal = field => {
                    const el = row.querySelector(`[data-field="${field}"]`);
                    return el ? el.value : '';
                };
                const name = getVal('sng').trim();
                const osr = parseFormattedNumber(getVal('osr'));
                const gcp = parseFormattedNumber(getVal('gcp'));
                const population = Math.round(parseFormattedNumber(getVal('population')));
                const includeEl = row.querySelector('[data-field="include"]');
                const include = includeEl ? includeEl.checked : true;

                // Note §12: name + OSR required, plus GDP/GCP (preferred) or
                // population (enables the OSR-per-capita fallback benchmark).
                if (name && osr > 0 && (gcp > 0 || population > 0)) {
                    peers.push({ sng: name, osr: osr, gcp: gcp, population: population, include: include });
                }
            });

            if (peers.length === 0) {
                alert('Each peer needs a name, OSR, and either subnational GDP/GCP (preferred) or population.');
                return;
            }

            try {
                // Validate data with server (no database write)
                const response = await fetch('/Rosra/SavePeerSNGs', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ CountryCode: countryCode, Peers: peers.map(p => ({ SNG: p.sng, OSR: p.osr, GCP: p.gcp, Population: p.population, Include: p.include })) })
                });
                const result = await response.json();

                if (result.success) {
                    // Store custom data in memory (will be saved with report)
                    customPeerData = {
                        dataSource: 'custom',
                        countryCode: countryCode,
                        customPeers: peers,
                        timestamp: new Date().toISOString()
                    };

                    console.log('Custom peer data stored in memory:', customPeerData);

                    // Populate dropdown from custom data
                    populatePeerDropdownFromCustomData(peers);

                    // Hide input section and show success message
                    togglePeerDataInputSection(false);
                    showPeerDataSuccessMessage(`${peers.length} peers ready. Data will be saved with your report.`);
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (e) {
                console.error('Error validating peer data:', e);
                alert('Error validating data. Please try again.');
            }
        }

