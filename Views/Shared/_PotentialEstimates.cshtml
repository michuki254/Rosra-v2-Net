        function updateCountryFlag(countryName) {
            const flagEl = document.getElementById('country-flag');
            if (flagEl) {
                const code = countryFlagCodes[countryName];
                if (code) {
                    flagEl.className = 'fi fi-' + code;
                    flagEl.style.display = '';
                } else {
                    flagEl.className = 'fi';
                    flagEl.style.display = 'none';
                }
            }
            // Also surface the country in the card header as a flag chip.
            updateHeaderCountryChip(countryName);
