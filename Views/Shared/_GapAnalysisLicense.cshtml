@model RosraApp.Models.ViewModels.RosraFormViewModel
@{
    bool isViewMode = ViewData["ViewMode"] != null && (bool)ViewData["ViewMode"];
    string currencySymbol = string.IsNullOrEmpty(Model.CurrencySymbol) ? "$" : Model.CurrencySymbol;
}

<!-- Include Chart.js -->
<script src="~/lib/chart.js/chart-3.7.1.min.js" asp-append-version="true"></script>

<div class="business-license-gap-analysis" id="license-container" data-subgroup="@(Model.License.Subgroup ?? "")" data-subtype="@(Model.License.Subtype ?? "")">
    <!-- Stream classification hidden fields -->
    <input type="hidden" name="License.Subgroup" id="licenseSubgroup" value="@(Model.License.Subgroup ?? "")" />
    <input type="hidden" name="License.Subtype" id="licenseSubtype" value="@(Model.License.Subtype ?? "")" />

    <!-- Classification Header -->
    @if (!isViewMode)
    {
        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-file-earmark-text text-primary" style="font-size: 1.1rem;"></i>
                <span class="fw-bold" id="licenseHeaderName" style="font-size: 1rem;">@Model.BusinessLicenseDisplayName</span>
                @if (!string.IsNullOrEmpty(Model.License.Subgroup))
                {
                    var badgeColor = Model.License.Subgroup switch { "A" => "#4E79A7", "B" => "#F28E2B", "C" => "#59A14F", _ => "#666" };
                    var badgeText = Model.License.Subgroup switch { "A" => "Business Licences & Permits", "B" => "Service Fees & Billed Charges", "C" => "Daily / Point-of-Collection", _ => "Unclassified" };
                    <span class="badge ms-2" style="background-color: @badgeColor; font-size: 0.75rem;" id="licenseSubgroupBadge">@badgeText</span>
                }
                else
                {
                    <span class="badge ms-2 bg-secondary" style="font-size: 0.75rem;" id="licenseSubgroupBadge">Not classified</span>
                }
            </div>
            <button type="button" class="btn btn-outline-primary btn-sm stream-header-btn"
                    onclick="openEditLicenseMetaModal()" title="Edit classification" aria-label="Edit classification">
                <i class="bi bi-pencil-square"></i>
            </button>
        </div>
    }

    <div class="row">
        <!-- Left Column - Data Input Section -->
        <div class="col-lg-4">
            <!-- Required Data + Derived Metrics -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-input-cursor-text me-2"></i>@Localizer["DataEntry_Title"]</h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">@Localizer["DataEntry_Instructions"]</p>

                    <!-- User Input Fields (6 inputs) -->
                    <div class="mb-3">
                        <label for="blRegisteredBusinesses" class="form-label fw-bold">
                            @Localizer["RegisteredBusinesses"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["RegisteredBusinesses_Tooltip"]"></i>
                        </label>
                        <input type="text" class="form-control number-format bg-light fw-bold" id="blRegisteredBusinesses"
                               name="License.RegisteredBusinesses" value="@(Model.License.RegisteredBusinesses?.ToString("N0") ?? "")"
                               placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                    </div>

                    <div class="mb-3">
                        <label for="blEstimatedUnregisteredPercent" class="form-label fw-bold">
                            @Localizer["EstimatedUnregisteredPercent"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["EstimatedUnregisteredPercent_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control bg-light fw-bold" id="blEstimatedUnregisteredPercent"
                                   name="License.EstimatedUnregisteredPercent" value="@(Model.License.EstimatedUnregisteredPercent?.ToString() ?? "")"
                                   placeholder="@Localizer["EnterPercent"]" min="0" max="100" step="0.1" @(isViewMode ? "readonly" : "") data-input="true">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    @* COMMENTED OUT — "Total Estimated Businesses" label & input.
                       Input kept in DOM (display:none) so JS that writes to #blTotalEstimatedBusinesses keeps working. *@
                    <div class="mb-3" style="display:none;" aria-hidden="true">
                        <label for="blTotalEstimatedBusinesses" class="form-label text-primary">
                            @Localizer["TotalEstimatedBusinesses"]
                        </label>
                        <input type="text" class="form-control number-format" id="blTotalEstimatedBusinesses"
                               readonly value="0">
                    </div>

                    <div class="mb-3">
                        <label for="blBilledAmount" class="form-label fw-bold">
                            @Localizer["BilledAmount"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["BilledAmount_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="blBilledAmount"
                                   name="License.BilledAmount" value="@(Model.License.BilledAmount?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="blOutstandingAmount" class="form-label fw-bold">
                            @Localizer["OutstandingAmount"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["OutstandingAmount_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="blOutstandingAmount"
                                   name="License.OutstandingAmount" value="@(Model.License.OutstandingAmount?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>
                    </div>

                    @* COMMENTED OUT — "Revenue to Date" label & input.
                       Input kept in DOM (display:none) so JS / chart that read from #blRevenueToDate keep working,
                       and the model field License.RevenueToDate still posts on save. *@
                    <div class="mb-3" style="display:none;" aria-hidden="true">
                        <label for="blRevenueToDate" class="form-label text-primary">
                            @Localizer["RevenueToDate"] (<span class="currency-label">@currencySymbol</span>)
                        </label>
                        <input type="text" class="form-control number-format" id="blRevenueToDate"
                               name="License.RevenueToDate" value="@Model.License.RevenueToDate"
                               readonly>
                    </div>

                    @* COMMENTED OUT — "Compliant Businesses" label & input.
                       Input kept in DOM (display:none) so JS that writes to #blCompliantBusinesses keeps working,
                       and License.CompliantBusinesses still posts on save. *@
                    <div class="mb-3" style="display:none;" aria-hidden="true">
                        <label for="blCompliantBusinesses" class="form-label text-primary">
                            @Localizer["CompliantBusinesses"]
                        </label>
                        <input type="text" class="form-control number-format" id="blCompliantBusinesses"
                               name="License.CompliantBusinesses" value="@Model.License.CompliantBusinesses"
                               readonly>
                    </div>

                    <div class="mb-3">
                        <label for="blStatutoryAverageBilled" class="form-label fw-bold">
                            @Localizer["StatutoryAverageBilled"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["StatutoryAverageBilled_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="blStatutoryAverageBilled"
                                   name="License.StatutoryAverageBilled" value="@(Model.License.StatutoryAverageBilled?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="blRealisticImprovementPercent" class="form-label fw-bold">
                            @Localizer["RealisticImprovementPercent"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["RealisticImprovementPercent_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control bg-light fw-bold" id="blRealisticImprovementPercent"
                                   name="License.RealisticImprovementPercent" value="@(Model.License.RealisticImprovementPercent?.ToString() ?? "")"
                                   placeholder="@Localizer["EnterPercent"]" min="0" max="100" step="1" @(isViewMode ? "readonly" : "") data-input="true">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
            </div>

            @* COMMENTED OUT — "Useful Average Values" + "KPI Ratios" cards. Cards stay in DOM (display:none)
               so JS that writes to blAvgBilledAmount/blAchievableAvgBill/blDeltaA and the ratio bars/badges
               continues to work without null-reference errors. *@
            <div style="display:none;" aria-hidden="true">

            <!-- Useful Average Values -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-calculator me-2"></i>@Localizer["AvgValues_Title"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["AvgBilledAmount"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["AvgBilledAmount_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="blAvgBilledAmount" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["AchievableAvgBill"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["AchievableAvgBill_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="blAchievableAvgBill" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["DeltaA"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["DeltaA_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="blDeltaA" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Ratios -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>@Localizer["KPI_Title"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0">
                                @Localizer["ComplianceRatio"]
                                <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                   title="@Localizer["ComplianceRatio_Tooltip"]"></i>
                            </label>
                            <span id="blComplianceRatioValue" class="badge bg-success">0%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" id="blComplianceRatioBar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">@Localizer["ComplianceRatio_Formula"]</small>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0">
                                @Localizer["CoverageRatio"]
                                <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                   title="@Localizer["CoverageRatio_Tooltip"]"></i>
                            </label>
                            <span id="blCoverageRatioValue" class="badge bg-info">0%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" id="blCoverageRatioBar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">@Localizer["CoverageRatio_Formula"]</small>
                    </div>
                </div>
            </div>

            </div><!-- /hidden wrapper for AvgValues + KPI Ratios -->
        </div>

        <!-- Right Column - Results Section -->
        <div class="col-lg-8">
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>@Localizer["Results_Title"]</h6>
                </div>
                <div class="card-body">
                    @* COMMENTED OUT — Potential Revenue Breakdown table (kept in DOM via display:none so JS
                       writing to blTableRevenueToDate / blTableComplianceGap / etc. doesn't error). *@
                    <div class="mb-4" style="display:none;" aria-hidden="true">
                        <h6 class="text-center mb-3">@Localizer["PotentialRevenue_Title"]</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@Localizer["Table_RevenueAndGaps"]</th>
                                        <th class="text-end">@Localizer["Table_Amount"] (<span class="currency-label">@currencySymbol</span>)</th>
                                        <th class="text-end">@Localizer["Table_Share"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="table-success">
                                        <td>
                                            @Localizer["RevenueToDate_Label"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["RevenueToDate_TableTooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blTableRevenueToDate">0</td>
                                        <td class="text-end" id="blTableRevenueToDatePct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["ComplianceGap"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["ComplianceGap_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blTableComplianceGap">0</td>
                                        <td class="text-end" id="blTableComplianceGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["CoverageGap"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["CoverageGap_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blTableCoverageGap">0</td>
                                        <td class="text-end" id="blTableCoverageGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["LiabilityGap"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["LiabilityGap_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blTableLiabilityGap">0</td>
                                        <td class="text-end" id="blTableLiabilityGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["MixedGapComplianceLiability"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["MixedGapComplianceLiability_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blTableMixedGapCompliance">0</td>
                                        <td class="text-end" id="blTableMixedGapCompliancePct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["MixedGapCoverageLiability"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["MixedGapCoverageLiability_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blTableMixedGapCoverage">0</td>
                                        <td class="text-end" id="blTableMixedGapCoveragePct">0%</td>
                                    </tr>
                                    <tr class="table-secondary fw-bold">
                                        <td>@Localizer["TotalPotentialRevenue"]</td>
                                        <td class="text-end" id="blTableTotalPotential">0</td>
                                        <td class="text-end">100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* REMOVED — "Revenue and Functional Gaps" pie chart, title, and description.
                       JS keeps null-guards on #blPotentialRevenueChart so removal is safe. *@

                    <!-- Headline KPI: Total Revenue Gap. Updated by JS in calculateBusinessLicenseGaps(). -->
                    <div class="kpi-headline mb-3" role="region" aria-label="@Localizer["KpiHeadline_AriaLabel"]">
                        <div class="kpi-headline-row">
                            <div class="kpi-headline-label">
                                <span class="kpi-eyebrow">@Localizer["KpiHeadline_Eyebrow"]</span>
                                <span class="kpi-headline-title">@Localizer["KpiHeadline_Title"]</span>
                            </div>
                            <div class="kpi-headline-value">
                                <span class="kpi-value" id="blKpiGapValue">@currencySymbol 0</span>
                                <span class="kpi-pct"><strong id="blKpiGapPct">0%</strong> @Localizer["KpiHeadline_OfPotential"]</span>
                            </div>
                        </div>
                        <div class="kpi-headline-meta">
                            <span class="kpi-collected"><strong id="blKpiCollectedPct">0%</strong> @Localizer["KpiHeadline_Collected"]</span>
                            <span class="kpi-potential">@Localizer["KpiHeadline_Potential"] <strong id="blKpiPotentialValue">@currencySymbol 0</strong></span>
                        </div>
                    </div>

                    <!-- Revenue to date vs Potential — Gap to Potential (three-bar layout).
                         Note below explains how to read the three bars (parallel to the
                         Property Tax "Why only 2 bars?" note). -->
                    <div class="mb-4 revenue-gap-stack-section">
                        <div class="rg-stack-header">
                            <h6 class="rg-stack-title">@SharedLocalizer["Chart_ActualVsPotential_Title"]</h6>
                            <span class="rg-stack-units">AMOUNTS IN <span class="currency-label">@currencySymbol</span> (B)</span>
                        </div>
                        <div class="chart-container" style="height: 420px;">
                            <canvas id="blRevenueGapStackedBarChart"></canvas>
                        </div>
                        <p class="rg-stack-note">
                            <strong>@Localizer["RgStackNote_Heading"]</strong> @Localizer["RgStackNote_Body"]
                        </p>
                    </div>

                    <hr>

                    <!-- Matrix Gap Analysis Dashboard -->
                    <div class="mb-4">
                        <h6 class="text-center mb-3">@Localizer["MatrixDashboard_Title"]</h6>
                        <div class="row g-3 align-items-stretch">
                            <!-- Matrix Visualization -->
                            <div class="col-12">
                                <div class="matrix-container position-relative" style="height: 320px; min-height: 320px; border-radius: 8px; overflow: visible; background: #fff; margin-top: 15px;">
                                    <!-- Y-axis Title (rotated) -->
                                    <div class="position-absolute d-flex align-items-center justify-content-center" style="left: 0; top: 0; bottom: 30px; width: 20px; background: #f8f9fa;">
                                        <span style="transform: rotate(-90deg); white-space: nowrap; font-size: 0.6rem; color: #666;">@Localizer["Matrix_YAxisTitle"]</span>
                                    </div>

                                    <!-- Y-axis Labels Container - labels positioned at row BOUNDARIES -->
                                    <div class="matrix-y-labels position-absolute" id="blMatrixYLabelsContainer" style="left: 20px; top: 0; bottom: 30px; width: 72px; font-size: 0.6rem; background: #f8f9fa;">
                                        <!-- Estimated label at TOP boundary (top of matrix). translateY(0) so the
                                             whole label sits inside the matrix and isn't clipped by the card header.
                                             white-space:nowrap + tight line-heights keep label + count compact and
                                             prevent collision with the Registered label below. -->
                                        <div class="y-label-item" id="blYLabelEstimated" style="position: absolute; right: 3px; top: 0; text-align: right; transform: translateY(0); cursor: help; white-space: nowrap; line-height: 1;"
                                             data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="@Localizer["Matrix_Estimated_Tooltip"]">
                                            <small class="d-block fw-bold" style="font-size: 0.5rem; color: #334155; line-height: 1; margin-bottom: 1px;">@Localizer["Matrix_Estimated"]</small>
                                            <span id="blMatrixEstimatedLabel" class="fw-bold" style="font-size: 0.62rem; line-height: 1;">0</span>
                                        </div>
                                        <!-- Registered label at boundary between Row1 and Row2 -->
                                        <div class="y-label-item" id="blYLabelRegistered" style="position: absolute; right: 3px; text-align: right; transform: translateY(-50%); cursor: help; white-space: nowrap; line-height: 1;"
                                             data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="@Localizer["Matrix_Registered_Tooltip"]">
                                            <small class="d-block fw-bold" style="font-size: 0.5rem; color: #334155; line-height: 1; margin-bottom: 1px;">@Localizer["Matrix_Registered"]</small>
                                            <span id="blMatrixRegisteredLabel" class="fw-bold" style="font-size: 0.62rem; line-height: 1;">0</span>
                                        </div>
                                        <!-- Compliant label at boundary between Row2 and Row3 -->
                                        <div class="y-label-item" id="blYLabelCompliant" style="position: absolute; right: 3px; text-align: right; transform: translateY(-50%); cursor: help; white-space: nowrap; line-height: 1;"
                                             data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="@Localizer["Matrix_Compliant_Tooltip"]">
                                            <small class="d-block fw-bold" style="font-size: 0.5rem; color: #334155; line-height: 1; margin-bottom: 1px;">@Localizer["Matrix_Compliant"]</small>
                                            <span id="blMatrixCompliantLabel" class="fw-bold" style="font-size: 0.62rem; line-height: 1;">0</span>
                                        </div>
                                    </div>

                                    <!-- Matrix Grid Area -->
                                    <div class="matrix-grid position-absolute" id="blMatrixGridArea" style="left: 92px; top: 0; right: 0; bottom: 30px; display: flex; flex-direction: column;">
                                        <!-- Row 1: Unregistered (Estimated - Registered) -->
                                        <div class="matrix-row d-flex" id="blMatrixRowUnreg" style="flex: 1; min-height: 48px;">
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="blMatrixCoverageGap"
                                                 style="background-color: #F28E2B; color: white; flex: 1; min-width: 90px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_CoverageGap"]</small><br>
                                                    <span id="blMatrixCoverageGapVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="blMatrixMixedCoverage"
                                                 style="background-color: #B07AA1; color: white; flex: 1; min-width: 90px; cursor: help;"
                                                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title="@Localizer["Matrix_MixedCovLiab_Tooltip"]">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_MixedCovLiab"]</small><br>
                                                    <span id="blMatrixMixedCoverageVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Row 2: Non-Compliant Registered (Registered - Compliant) -->
                                        <div class="matrix-row d-flex" id="blMatrixRowNonCompliant" style="flex: 1; min-height: 48px;">
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="blMatrixComplianceGap"
                                                 style="background-color: #E15759; color: white; flex: 1; min-width: 90px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_ComplianceGap"]</small><br>
                                                    <span id="blMatrixComplianceGapVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="blMatrixMixedCompliance"
                                                 style="background-color: #76B7B2; color: white; flex: 1; min-width: 90px; cursor: help;"
                                                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title="@Localizer["Matrix_MixedCompLiab_Tooltip"]">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_MixedCompLiab"]</small><br>
                                                    <span id="blMatrixMixedComplianceVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Row 3: Compliant -->
                                        <div class="matrix-row d-flex" id="blMatrixRowCompliant" style="flex: 1; min-height: 48px;">
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="blMatrixActualRevenue"
                                                 style="background-color: #00B2E3; color: white; flex: 1; min-width: 90px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_ActualRevenue"]</small><br>
                                                    <span id="blMatrixActualRevenueVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="blMatrixLiabilityGap"
                                                 style="background-color: #4E79A7; color: white; flex: 1; min-width: 90px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_LiabilityGap"]</small><br>
                                                    <span id="blMatrixLiabilityGapVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- X-axis Labels - positioned at column BOUNDARIES -->
                                    <div class="matrix-x-axis position-absolute" id="blMatrixXAxisContainer" style="left: 92px; right: 0; bottom: 0; height: 30px; background: #f8f9fa;">
                                        <!-- X-axis label at left edge (origin = 0) -->
                                        <div class="x-label-item" id="blXLabelOrigin" style="position: absolute; left: 0; bottom: 2px; transform: translateX(0%); text-align: left; font-size: 0.6rem;">
                                            <span id="blMatrixOriginLabel" class="fw-bold" style="font-size: 0.65rem;">@currencySymbol 0</span>
                                        </div>
                                        <!-- X-axis label at column boundary (between left and right columns) -->
                                        <div class="x-label-item" id="blXLabelAvgBilled" style="position: absolute; bottom: 2px; transform: translateX(-50%); text-align: center; font-size: 0.6rem;">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_AvgBilled"]</small>
                                            <span id="blMatrixAvgBilledLabel" class="fw-bold" style="font-size: 0.65rem;">@currencySymbol 0</span>
                                        </div>
                                        <!-- X-axis label at right edge -->
                                        <div class="x-label-item" id="blXLabelAchievable" style="position: absolute; right: 0; bottom: 2px; transform: translateX(0%); text-align: right; font-size: 0.6rem;">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_AchievableAvg"]</small>
                                            <span id="blMatrixAchievableLabel" class="fw-bold" style="font-size: 0.65rem;">@currencySymbol 0</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!-- end row -->
                        <p class="small text-muted mt-3 text-center">
                            <strong>@Localizer["Description_Label"]</strong> @Localizer["MatrixDashboard_Description"]
                        </p>
                    </div>

                    <hr>

                    @* COMMENTED OUT — Gap Breakdown table (kept in DOM via display:none for JS safety). *@
                    <div class="mb-4" style="display:none;" aria-hidden="true">
                        <h6 class="text-center mb-3">@Localizer["GapBreakdown_Title"] (<span class="currency-label">@currencySymbol</span>)</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@Localizer["Table_FunctionalGaps"]</th>
                                        <th class="text-end">@Localizer["Table_Amount"] (<span class="currency-label">@currencySymbol</span>)</th>
                                        <th class="text-end">@Localizer["Table_Share"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            @Localizer["ComplianceGap"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["ComplianceGap_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blGapComplianceGap">0</td>
                                        <td class="text-end" id="blGapComplianceGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["CoverageGap"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["CoverageGap_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blGapCoverageGap">0</td>
                                        <td class="text-end" id="blGapCoverageGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["LiabilityGap"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["LiabilityGap_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blGapLiabilityGap">0</td>
                                        <td class="text-end" id="blGapLiabilityGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["MixedGapComplianceLiability"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["MixedGapComplianceLiability_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blGapMixedGapCompliance">0</td>
                                        <td class="text-end" id="blGapMixedGapCompliancePct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @Localizer["MixedGapCoverageLiability"]
                                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                               title="@Localizer["MixedGapCoverageLiability_Tooltip"]"></i>
                                        </td>
                                        <td class="text-end" id="blGapMixedGapCoverage">0</td>
                                        <td class="text-end" id="blGapMixedGapCoveragePct">0%</td>
                                    </tr>
                                    <tr class="table-secondary fw-bold">
                                        <td>@Localizer["TotalFunctionalGap"]</td>
                                        <td class="text-end" id="blTableTotalFunctionalGap">0</td>
                                        <td class="text-end">100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Gap Breakdown — horizontal bar chart.
                         Reviewer's note: a 5-slice doughnut with a long-label legend on the side
                         pushes small slices below readable resolution. A horizontal bar handles
                         5 categories with long labels much better — labels sit on the y-axis,
                         bar length encodes value, no legend needed. -->
                    <div class="mb-4">
                        <h6 class="text-center mb-3">@Localizer["GapBreakdownPie_Title"]</h6>
                        <div style="height: 320px; position: relative;">
                            <canvas id="blGapBreakdownChart"></canvas>
                        </div>
                        <p class="small text-muted mt-2 text-center">
                            <strong>@Localizer["Description_Label"]</strong> @Localizer["GapBreakdownPie_Description"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .business-license-gap-analysis .card {
        border-radius: 8px;
    }

    .business-license-gap-analysis .card-header {
        border-radius: 8px 8px 0 0;
    }

    /* Revenue vs Gap two-bar chart header */
    .revenue-gap-stack-section { background: #ffffff; border-radius: 10px; padding: 1rem 1.1rem 0.4rem; }
    .rg-stack-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
    .rg-stack-title { font-size: 1rem; font-weight: 700; color: #1f2937; margin: 0; }
    .rg-stack-units { font-size: 0.72rem; color: #94a3b8; letter-spacing: 1.2px; font-weight: 600; text-transform: uppercase; white-space: nowrap; }
    @@media (max-width: 600px) { .rg-stack-header { flex-direction: column; align-items: flex-start; gap: 0.25rem; } }

    .business-license-gap-analysis .form-control[readonly] {
        cursor: default;
    }

    .business-license-gap-analysis .progress {
        border-radius: 10px;
    }

    .business-license-gap-analysis .progress-bar {
        border-radius: 10px;
        transition: width 0.3s ease-in-out;
    }

    .business-license-gap-analysis .table th,
    .business-license-gap-analysis .table td {
        vertical-align: middle;
        font-size: 0.875rem;
    }

    /* Ensure table header text is visible with white color on dark background */
    .business-license-gap-analysis .table thead.table-dark th {
        color: #ffffff !important;
        background-color: #212529 !important;
    }

    /* KPI Ratio badges */
    .business-license-gap-analysis .card-body > .mb-3 .badge {
        width: auto;
        height: auto;
        border-radius: 0.25rem;
        padding: 0.35em 0.65em;
        font-size: 0.75em;
    }

    .business-license-gap-analysis .input-group-sm .form-control,
    .business-license-gap-analysis .input-group-sm .input-group-text {
        font-size: 0.8rem;
    }
    /* Marimekko matrix guard-rail rules (overflow/is-too-small/is-too-narrow)
       live in the parent _GapAnalysis.cshtml so they apply to all streams. */
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Chart instances
        let potentialRevenueChart = null;
        let gapBreakdownChart = null;
        let blRevenueGapStackedBarChart = null;

        // Get currency symbol from AppContext (single source of truth)
        function getCurrencySymbol() {
            if (window.AppContext) {
                return window.AppContext.get('currencySymbol') || '$';
            }
            return '$';
        }

        // Update all currency displays in Business License section
        function updateBusinessLicenseCurrencySymbols() {
            const symbol = getCurrencySymbol();
            console.log('Updating Business License currency symbols to:', symbol);

            // Update input group prefixes
            document.querySelectorAll('.business-license-gap-analysis .currency-prefix-display').forEach(el => {
                el.textContent = symbol;
            });

            // Update labels with currency
            document.querySelectorAll('.business-license-gap-analysis .currency-label').forEach(el => {
                el.textContent = symbol;
            });
        }

        // Default values for Business License (must be defined before any calculateBusinessLicenseGaps calls)
        // Subscribe to AppContext currency changes
        if (window.AppContext) {
            window.AppContext.subscribe('currencySymbol', function(newSymbol) {
                console.log('Business License received currency change via AppContext:', newSymbol);
                updateBusinessLicenseCurrencySymbols();
                calculateBusinessLicenseGaps();
            });
        }

        // Initial currency update
        updateBusinessLicenseCurrencySymbols();

        // Delayed updates for when currency is loaded from API
        setTimeout(function() {
            updateBusinessLicenseCurrencySymbols();
        }, 1000);

        setTimeout(function() {
            updateBusinessLicenseCurrencySymbols();
        }, 2000);

        // Initialize Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Initialize charts
        initializeCharts();

        // Add event listeners to all input fields
        const inputFields = document.querySelectorAll('.business-license-gap-analysis input[data-input="true"]');
        inputFields.forEach(field => {
            field.addEventListener('input', function() {
                calculateBusinessLicenseGaps();
            });
            field.addEventListener('change', function() {
                calculateBusinessLicenseGaps();
            });
        });

        // Initial calculation
        calculateBusinessLicenseGaps();

        // Recalculate when the License tab becomes visible. While the tab is
        // display:none, matrix cells measure 0×0 so the guard-rail step skips
        // them; re-running once the tab has real size applies the rails.
        document.addEventListener('tabShown', function(e) {
            if (e.detail && e.detail.tabId === 'license') {
                calculateBusinessLicenseGaps();
            }
        });

        function initializeCharts() {
            // ----- Revenue to date vs Potential — two-bar layout (mirrors Top-Down chart) -----
            const blRgCanvas = document.getElementById('blRevenueGapStackedBarChart');
            if (blRgCanvas) {
                // 2 sig figs — must match formatCurrencyShort / formatCompact so the
                // same value renders identically across the bar chart, matrix, and donut.
                const fmtCompact = function (v) {
                    if (v == null || isNaN(v)) return '0';
                    if (Math.abs(v) >= 1e9) return (v / 1e9).toFixed(1) + 'B';
                    if (Math.abs(v) >= 1e6) return (v / 1e6).toFixed(1) + 'M';
                    if (Math.abs(v) >= 1e3) return (v / 1e3).toFixed(0) + 'K';
                    return Math.round(v).toLocaleString();
                };

                // 2-bar plugin: Revenue to date / Realistic potential at the user's Improvement %.
                // Theoretical (100% improvement) bar removed — the realistic bar is the
                // actionable target and the headline KPI card already shows the gap to it.
                const blRgLabelsPlugin = {
                    id: 'blRgGapAnnotations',
                    afterDatasetsDraw: function (chart) {
                        const c  = chart.ctx;
                        const m0 = chart.getDatasetMeta(0);
                        const m1 = chart.getDatasetMeta(1);
                        if (!m0 || !m1) return;

                        const symbol = (typeof getCurrencySymbol === 'function') ? getCurrencySymbol() : '';
                        const v   = chart.config._rgValues || { rev: 0, gap: 0, total: 0 };
                        const fmtFull = function (n) { return (symbol ? symbol + ' ' : '') + fmtCompact(n); };

                        const totals = [v.rev, v.total];
                        const gaps   = [0,     v.gap];

                        c.save();
                        // Total labels above each bar
                        c.font = '700 13px Roboto, "Segoe UI", Arial, sans-serif';
                        c.fillStyle = '#1f2937';
                        c.textAlign = 'center';
                        c.textBaseline = 'bottom';
                        for (let i = 0; i < 2; i++) {
                            const bar = m1.data[i] || m0.data[i];
                            if (bar) c.fillText(fmtFull(totals[i]), bar.x, bar.y - 8);
                        }

                        // Segment values inside each bar (cyan = revenue, orange = gap)
                        c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'middle';
                        c.fillStyle = '#ffffff';
                        for (let i = 0; i < 2; i++) {
                            const cyan = m0.data[i];
                            if (cyan && v.rev > 0 && Math.abs(cyan.base - cyan.y) > 22) {
                                c.fillText(fmtCompact(v.rev), cyan.x, (cyan.y + cyan.base) / 2);
                            }
                            const orange = m1.data[i];
                            if (orange && gaps[i] > 0 && Math.abs(orange.base - orange.y) > 22) {
                                c.fillText(fmtCompact(gaps[i]), orange.x, (orange.y + orange.base) / 2);
                            }
                        }

                        // Dashed revenue line connecting the two bars (visual continuity for revenue base)
                        const halfW = (m0.data[0]?.width || 60) / 2;
                        c.strokeStyle = '#9ca3af';
                        c.lineWidth = 1;
                        c.setLineDash([4, 4]);
                        const a = m0.data[0], b = m0.data[1];
                        if (a && b) {
                            c.beginPath();
                            c.moveTo(a.x + halfW, a.y);
                            c.lineTo(b.x - halfW, b.y);
                            c.stroke();
                        }
                        c.setLineDash([]);

                        // Right-side gap bracket — orange annotation showing Gap / xxB / x% of potential
                        const bar1Pot = m1.data[1];
                        if (bar1Pot && v.gap > 0) {
                            const pct = v.total > 0 ? Math.round((v.gap / v.total) * 100) : 0;
                            const bracketX = bar1Pot.x + ((bar1Pot.width || 60) / 2) + 18;
                            const topY = bar1Pot.y;
                            const botY = bar1Pot.base;
                            c.strokeStyle = '#FD9D24';
                            c.lineWidth = 1.5;
                            c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX, botY); c.stroke();
                            c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX - 6, topY); c.stroke();
                            c.beginPath(); c.moveTo(bracketX, botY); c.lineTo(bracketX - 6, botY); c.stroke();

                            const midY = (topY + botY) / 2;
                            c.fillStyle = '#FD9D24';
                            c.textAlign = 'left';
                            c.font = '700 12px Roboto, "Segoe UI", Arial, sans-serif';
                            c.textBaseline = 'bottom';
                            c.fillText('Gap', bracketX + 8, midY - 4);
                            c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                            c.textBaseline = 'top';
                            c.fillText(fmtCompact(v.gap), bracketX + 8, midY + 2);
                            c.fillStyle = '#94a3b8';
                            c.font = '500 11px Roboto, "Segoe UI", Arial, sans-serif';
                            c.fillText(pct + '% of potential', bracketX + 8, midY + 22);
                        }

                        c.restore();
                    }
                };

                blRevenueGapStackedBarChart = new Chart(blRgCanvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: [
                            '@SharedLocalizer["Chart_ActualRevenue"]',
                            '@SharedLocalizer["Chart_PotentialRevenue"]'
                        ],
                        datasets: [
                            { label: 'Revenue to date', data: [0, 0], backgroundColor: '#00B2E3', stack: 'rg', borderWidth: 0, barThickness: 90, maxBarThickness: 110 },
                            { label: 'Gap',             data: [0, 0], backgroundColor: '#FD9D24', stack: 'rg', borderWidth: 0, barThickness: 90, maxBarThickness: 110 }
                        ]
                    },
                    plugins: [blRgLabelsPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { top: 36, right: 150, bottom: 8, left: 8 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const symbol = (typeof getCurrencySymbol === 'function') ? getCurrencySymbol() : '';
                                        return ctx.dataset.label + ': ' + symbol + ' ' + fmtCompact(ctx.parsed.y);
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { stacked: true, ticks: { font: { size: 12, weight: '700' }, color: '#1f2937', padding: 8 }, grid: { display: false }, border: { display: false } },
                            y: {
                                stacked: true, beginAtZero: true,
                                ticks: {
                                    font: { size: 11, weight: '700' }, color: '#1f2937',
                                    callback: function (v) {
                                        if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
                                        if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
                                        if (v >= 1e3) return (v / 1e3).toFixed(0) + 'K';
                                        return v.toLocaleString();
                                    }
                                },
                                grid: { color: '#eef0f3', drawBorder: false }
                            }
                        }
                    }
                });
                if (window.registerChart) registerChart('blRevenueGapStackedBarChart', blRevenueGapStackedBarChart);
            }

            // Potential Revenue Doughnut Chart
            const ctx1 = document.getElementById('blPotentialRevenueChart');
            if (ctx1) {
                potentialRevenueChart = new Chart(ctx1.getContext('2d'), {
                    type: 'doughnut',
                    plugins: [makeBlCenterPlugin('Total Potential')],
                    data: {
                        labels: ['Revenue to date', 'Compliance Gap', 'Coverage Gap', 'Liability Gap', 'Mixed (Comp.+Liab.)', 'Mixed (Cov.+Liab.)'],
                        datasets: [{
                            data: [0, 0, 0, 0, 0, 0],
                            backgroundColor: ['#59A14F', '#E15759', '#F28E2B', '#4E79A7', '#76B7B2', '#B07AA1'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    boxWidth: 12,
                                    font: { size: 10 },
                                    generateLabels: function(chart) {
                                        const data = chart.data;
                                        if (data.labels.length && data.datasets.length) {
                                            const total = data.datasets[0].data.reduce((a, b) => a + b, 0);
                                            return data.labels.map((label, i) => {
                                                const value = data.datasets[0].data[i];
                                                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                                return {
                                                    text: label + ' — ' + formatCurrencyShort(value) + ' (' + percentage + '%)',
                                                    fillStyle: data.datasets[0].backgroundColor[i],
                                                    hidden: false,
                                                    index: i
                                                };
                                            });
                                        }
                                        return [];
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return context.label + ': ' + formatCurrencyShort(value) + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
                if (window.registerChart) registerChart('blPotentialRevenueChart', potentialRevenueChart);
            }

            // Gap Breakdown — horizontal bar chart.
            // Was a doughnut with a 5-row legend on the side. Switched to horizontal
            // bar so labels sit on the y-axis (no separate legend), bar length encodes
            // value, and small categories don't get squashed below readable size.
            const ctx2 = document.getElementById('blGapBreakdownChart');
            if (ctx2) {
                // Custom plugin: draw "KSh X (YY%)" at the right end of each bar.
                const blGapBarValuesPlugin = {
                    id: 'blGapBarValues',
                    afterDatasetsDraw: function (chart) {
                        const c = chart.ctx;
                        const meta = chart.getDatasetMeta(0);
                        if (!meta) return;
                        const data = chart.data.datasets[0].data || [];
                        const total = data.reduce((a, b) => a + b, 0);
                        c.save();
                        c.font = '600 11px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'middle';
                        c.fillStyle = '#1f2937';
                        meta.data.forEach((bar, i) => {
                            if (!bar) return;
                            const value = data[i] || 0;
                            if (value <= 0) return;
                            const pct = total > 0 ? ((value / total) * 100).toFixed(1) : '0.0';
                            const text = formatCurrencyShort(value) + '  (' + pct + '%)';
                            c.textAlign = 'left';
                            c.fillText(text, bar.x + 6, bar.y);
                        });
                        c.restore();
                    }
                };

                gapBreakdownChart = new Chart(ctx2.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Compliance Gap', 'Coverage Gap', 'Liability Gap', 'Mixed (Comp.+Liab.)', 'Mixed (Cov.+Liab.)'],
                        datasets: [{
                            data: [0, 0, 0, 0, 0],
                            backgroundColor: ['#E15759', '#F28E2B', '#4E79A7', '#76B7B2', '#B07AA1'],
                            borderWidth: 0,
                            borderRadius: 3,
                            barThickness: 22
                        }]
                    },
                    plugins: [blGapBarValuesPlugin],
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { right: 110, left: 8, top: 8, bottom: 8 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return formatCurrencyShort(value) + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9', drawBorder: false },
                                ticks: {
                                    font: { size: 10 },
                                    color: '#64748b',
                                    callback: function (value) { return formatCurrencyShort(value); }
                                }
                            },
                            y: {
                                grid: { display: false, drawBorder: false },
                                ticks: { font: { size: 11, weight: '700' }, color: '#334155' }
                            }
                        }
                    }
                });
                if (window.registerChart) registerChart('blGapBreakdownChart', gapBreakdownChart);
            }
        }

        function parseNumber(value) {
            if (!value) return 0;
            const cleaned = String(value).replace(/[^0-9.-]/g, '');
            return parseFloat(cleaned) || 0;
        }

        function formatCurrency(value) {
            if (isNaN(value) || value === null) return '0';
            return new Intl.NumberFormat('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(value);
        }

        // Compact currency, 2 significant figures. KEEP IN SYNC with formatCompact()
        // in updateMatrixDashboard — both must round identically so the same value
        // doesn't render as "1.05B" in the donut and "1.1B" in the matrix.
        // KSh 24.9B / 8.8M / 541K / 250
        function formatCurrencyShort(value) {
            if (value == null || isNaN(value)) return '0';
            const sym = (typeof getCurrencySymbol === 'function') ? (getCurrencySymbol() + ' ') : '';
            const abs = Math.abs(value);
            if (abs >= 1e9) return sym + (value / 1e9).toFixed(1) + 'B';
            if (abs >= 1e6) return sym + (value / 1e6).toFixed(1) + 'M';
            if (abs >= 1e3) return sym + (value / 1e3).toFixed(0) + 'K';
            return sym + Math.round(value).toString();
        }

        function makeBlCenterPlugin(label) {
            return {
                id: 'centerTotal_' + label.replace(/\W/g, '_'),
                afterDraw(chart) {
                    const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                    if (!total) return;
                    const { ctx, chartArea } = chart;
                    const cx = (chartArea.left + chartArea.right) / 2;
                    const cy = (chartArea.top + chartArea.bottom) / 2;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '700 16px Roboto, system-ui, sans-serif';
                    ctx.fillStyle = '#0f172a';
                    ctx.fillText(formatCurrencyShort(total), cx, cy - 8);
                    ctx.font = '500 10px Roboto, system-ui, sans-serif';
                    ctx.fillStyle = '#64748b';
                    ctx.fillText(label, cx, cy + 11);
                    ctx.restore();
                }
            };
        }

        function formatPercentage(value) {
            if (isNaN(value) || value === null) return '0.00%';
            return value.toFixed(2) + '%';
        }

        function calculateBusinessLicenseGaps() {
            // Read the 6 user inputs. Empty/NaN is treated as 0 so the calc still
            // runs and derived fields show 0 on a blank form — we no longer force
            // demo values into the inputs when they're empty (previous behavior
            // broke "start a new report").
            const registeredBusinesses = parseNumber(document.getElementById('blRegisteredBusinesses')?.value) || 0;
            const rawEstUnreg = parseFloat(document.getElementById('blEstimatedUnregisteredPercent')?.value);
            const estimatedUnregisteredPercent = isNaN(rawEstUnreg) ? 0 : rawEstUnreg;
            const billedAmount = parseNumber(document.getElementById('blBilledAmount')?.value) || 0;
            const outstandingAmount = parseNumber(document.getElementById('blOutstandingAmount')?.value) || 0;
            const statutoryAverageBilled = parseNumber(document.getElementById('blStatutoryAverageBilled')?.value) || 0;
            const rawRealImp = parseFloat(document.getElementById('blRealisticImprovementPercent')?.value);
            const realisticImprovementPercent = isNaN(rawRealImp) ? 0 : rawRealImp;

            // Calculate Auto-Calculated Fields
            const totalEstimatedBusinesses = Math.max(0, registeredBusinesses * (1 + estimatedUnregisteredPercent / 100));
            const revenueToDate = Math.max(0, billedAmount - outstandingAmount);
            // Compliant businesses: clamped between 0 and registeredBusinesses
            const compliantBusinesses = billedAmount > 0
                ? Math.max(0, Math.min(registeredBusinesses, registeredBusinesses * (revenueToDate / billedAmount)))
                : 0;
            const avgBilledAmount = registeredBusinesses > 0 ? Math.max(0, billedAmount / registeredBusinesses) : 0;

            // ΔA = Realistic improvement % × MAX(0, Statutory average − Average billed)
            const deltaA = (realisticImprovementPercent / 100) * Math.max(0, statutoryAverageBilled - avgBilledAmount);

            // Achievable average bill = Avg Billed + ΔA
            const achievableAvgBill = avgBilledAmount + deltaA;

            // Calculate KPI Ratios (clamped 0-100%)
            const complianceRatio = billedAmount > 0 ? Math.max(0, Math.min(100, (revenueToDate / billedAmount) * 100)) : 0;
            const coverageRatio = totalEstimatedBusinesses > 0 ? Math.max(0, Math.min(100, (registeredBusinesses / totalEstimatedBusinesses) * 100)) : 0;

            // Calculate Gaps (all non-negative)
            const complianceGap = Math.max(0, outstandingAmount);
            const coverageGap = Math.max(0, (totalEstimatedBusinesses - registeredBusinesses) * avgBilledAmount);
            const liabilityGap = Math.max(0, compliantBusinesses * deltaA);
            const mixedGapCompliance = Math.max(0, (registeredBusinesses - compliantBusinesses) * deltaA);
            const mixedGapCoverage = Math.max(0, (totalEstimatedBusinesses - registeredBusinesses) * deltaA);

            // Calculate Totals
            const totalPotentialRevenue = revenueToDate + complianceGap + coverageGap + liabilityGap + mixedGapCompliance + mixedGapCoverage;
            const totalFunctionalGap = complianceGap + coverageGap + liabilityGap + mixedGapCompliance + mixedGapCoverage;

            // Calculate percentages for potential revenue
            const revenueToDatePct = totalPotentialRevenue > 0 ? (revenueToDate / totalPotentialRevenue) * 100 : 0;
            const complianceGapPct = totalPotentialRevenue > 0 ? (complianceGap / totalPotentialRevenue) * 100 : 0;
            const coverageGapPct = totalPotentialRevenue > 0 ? (coverageGap / totalPotentialRevenue) * 100 : 0;
            const liabilityGapPct = totalPotentialRevenue > 0 ? (liabilityGap / totalPotentialRevenue) * 100 : 0;
            const mixedGapCompliancePct = totalPotentialRevenue > 0 ? (mixedGapCompliance / totalPotentialRevenue) * 100 : 0;
            const mixedGapCoveragePct = totalPotentialRevenue > 0 ? (mixedGapCoverage / totalPotentialRevenue) * 100 : 0;

            // Calculate percentages for gap breakdown
            const gapComplianceGapPct = totalFunctionalGap > 0 ? (complianceGap / totalFunctionalGap) * 100 : 0;
            const gapCoverageGapPct = totalFunctionalGap > 0 ? (coverageGap / totalFunctionalGap) * 100 : 0;
            const gapLiabilityGapPct = totalFunctionalGap > 0 ? (liabilityGap / totalFunctionalGap) * 100 : 0;
            const gapMixedGapCompliancePct = totalFunctionalGap > 0 ? (mixedGapCompliance / totalFunctionalGap) * 100 : 0;
            const gapMixedGapCoveragePct = totalFunctionalGap > 0 ? (mixedGapCoverage / totalFunctionalGap) * 100 : 0;

            // Update auto-calculated displays
            document.getElementById('blTotalEstimatedBusinesses').value = formatCurrency(totalEstimatedBusinesses).replace('.00', '');
            document.getElementById('blRevenueToDate').value = formatCurrency(revenueToDate);
            document.getElementById('blCompliantBusinesses').value = formatCurrency(compliantBusinesses).replace('.00', '');
            document.getElementById('blAvgBilledAmount').value = formatCurrency(avgBilledAmount);
            document.getElementById('blAchievableAvgBill').value = formatCurrency(achievableAvgBill);
            document.getElementById('blDeltaA').value = formatCurrency(deltaA);

            // Update KPI progress bars
            updateKPIBar('blComplianceRatio', complianceRatio);
            updateKPIBar('blCoverageRatio', coverageRatio);

            // Update Potential Revenue Breakdown Table
            document.getElementById('blTableRevenueToDate').textContent = formatCurrency(revenueToDate);
            document.getElementById('blTableRevenueToDatePct').textContent = formatPercentage(revenueToDatePct);
            document.getElementById('blTableComplianceGap').textContent = formatCurrency(complianceGap);
            document.getElementById('blTableComplianceGapPct').textContent = formatPercentage(complianceGapPct);
            document.getElementById('blTableCoverageGap').textContent = formatCurrency(coverageGap);
            document.getElementById('blTableCoverageGapPct').textContent = formatPercentage(coverageGapPct);
            document.getElementById('blTableLiabilityGap').textContent = formatCurrency(liabilityGap);
            document.getElementById('blTableLiabilityGapPct').textContent = formatPercentage(liabilityGapPct);
            document.getElementById('blTableMixedGapCompliance').textContent = formatCurrency(mixedGapCompliance);
            document.getElementById('blTableMixedGapCompliancePct').textContent = formatPercentage(mixedGapCompliancePct);
            document.getElementById('blTableMixedGapCoverage').textContent = formatCurrency(mixedGapCoverage);
            document.getElementById('blTableMixedGapCoveragePct').textContent = formatPercentage(mixedGapCoveragePct);
            document.getElementById('blTableTotalPotential').textContent = formatCurrency(totalPotentialRevenue);

            // Update Gap Breakdown Table
            document.getElementById('blGapComplianceGap').textContent = formatCurrency(complianceGap);
            document.getElementById('blGapComplianceGapPct').textContent = formatPercentage(gapComplianceGapPct);
            document.getElementById('blGapCoverageGap').textContent = formatCurrency(coverageGap);
            document.getElementById('blGapCoverageGapPct').textContent = formatPercentage(gapCoverageGapPct);
            document.getElementById('blGapLiabilityGap').textContent = formatCurrency(liabilityGap);
            document.getElementById('blGapLiabilityGapPct').textContent = formatPercentage(gapLiabilityGapPct);
            document.getElementById('blGapMixedGapCompliance').textContent = formatCurrency(mixedGapCompliance);
            document.getElementById('blGapMixedGapCompliancePct').textContent = formatPercentage(gapMixedGapCompliancePct);
            document.getElementById('blGapMixedGapCoverage').textContent = formatCurrency(mixedGapCoverage);
            document.getElementById('blGapMixedGapCoveragePct').textContent = formatPercentage(gapMixedGapCoveragePct);
            document.getElementById('blTableTotalFunctionalGap').textContent = formatCurrency(totalFunctionalGap);

            // Update Charts (donut + breakdown — sufficient to use the 6 gap params)
            updateCharts(revenueToDate, complianceGap, coverageGap, liabilityGap, mixedGapCompliance, mixedGapCoverage);

            // Update "Revenue to date vs Realistic potential" two-bar chart.
            const rgRev   = Math.max(0, revenueToDate);
            const rgGap   = Math.max(0, complianceGap)
                          + Math.max(0, coverageGap)
                          + Math.max(0, liabilityGap)
                          + Math.max(0, mixedGapCompliance)
                          + Math.max(0, mixedGapCoverage);
            const rgTotal = rgRev + rgGap;

            if (blRevenueGapStackedBarChart) {
                blRevenueGapStackedBarChart.data.datasets[0].data = [rgRev, rgRev];
                blRevenueGapStackedBarChart.data.datasets[1].data = [0,     rgGap];
                blRevenueGapStackedBarChart.config._rgValues = {
                    rev: rgRev, gap: rgGap, total: rgTotal,
                    realisticPct: realisticImprovementPercent
                };
                blRevenueGapStackedBarChart.data.labels = [
                    '@SharedLocalizer["Chart_ActualRevenue"]',
                    '@SharedLocalizer["Chart_PotentialRevenue"]'
                ];
                blRevenueGapStackedBarChart.update();
            }

            // Update Headline KPI — same numbers as the realistic bar (so headline always
            // matches what the chart shows for bar 2).
            const kpiGapVal     = document.getElementById('blKpiGapValue');
            const kpiGapPct     = document.getElementById('blKpiGapPct');
            const kpiCollected  = document.getElementById('blKpiCollectedPct');
            const kpiPotential  = document.getElementById('blKpiPotentialValue');
            if (kpiGapVal)    kpiGapVal.textContent    = formatCurrencyShort(rgGap);
            if (kpiPotential) kpiPotential.textContent = formatCurrencyShort(rgTotal);
            const gapPct = rgTotal > 0 ? Math.round((rgGap / rgTotal) * 100) : 0;
            const colPct = rgTotal > 0 ? 100 - gapPct : 0;
            if (kpiGapPct)    kpiGapPct.textContent    = gapPct + '%';
            if (kpiCollected) kpiCollected.textContent = colPct + '%';

            // Update Matrix Dashboard
            updateMatrixDashboard({
                totalEstimatedBusinesses,
                registeredBusinesses,
                compliantBusinesses,
                avgBilledAmount,
                achievableAvgBill,
                revenueToDate,
                complianceGap,
                coverageGap,
                liabilityGap,
                mixedGapCompliance,
                mixedGapCoverage,
                totalPotentialRevenue,
                revenueToDatePct,
                complianceGapPct,
                coverageGapPct,
                liabilityGapPct,
                mixedGapCompliancePct,
                mixedGapCoveragePct
            });

            // Store values in localStorage for Total tab and Prioritization tab
            storeBusinessLicenseValues(revenueToDate, totalPotentialRevenue, totalFunctionalGap, complianceGap, coverageGap, liabilityGap, mixedGapCompliance, mixedGapCoverage, complianceRatio, coverageRatio);
        }

        function updateKPIBar(name, value) {
            const bar = document.getElementById(name + 'Bar');
            const valueSpan = document.getElementById(name + 'Value');
            const cappedValue = Math.min(Math.max(value, 0), 100);

            let colorClass, badgeClass;
            if (value >= 80) {
                colorClass = 'bg-success';
                badgeClass = 'bg-success';
            } else if (value >= 60) {
                colorClass = 'bg-warning';
                badgeClass = 'bg-warning text-dark';
            } else {
                colorClass = 'bg-danger';
                badgeClass = 'bg-danger';
            }

            if (bar) {
                bar.style.width = cappedValue + '%';
                bar.setAttribute('aria-valuenow', cappedValue);
                bar.classList.remove('bg-success', 'bg-warning', 'bg-danger', 'bg-info', 'bg-primary');
                bar.classList.add(colorClass);
            }
            if (valueSpan) {
                valueSpan.textContent = value.toFixed(1) + '%';
                valueSpan.classList.remove('bg-success', 'bg-warning', 'bg-danger', 'bg-info', 'bg-primary', 'text-dark');
                badgeClass.split(' ').forEach(cls => valueSpan.classList.add(cls));
            }
        }

        function updateCharts(revenueToDate, complianceGap, coverageGap, liabilityGap, mixedGapCompliance, mixedGapCoverage) {
            // Update Potential Revenue Chart
            if (potentialRevenueChart) {
                potentialRevenueChart.data.datasets[0].data = [
                    Math.max(0, revenueToDate),
                    Math.max(0, complianceGap),
                    Math.max(0, coverageGap),
                    Math.max(0, liabilityGap),
                    Math.max(0, mixedGapCompliance),
                    Math.max(0, mixedGapCoverage)
                ];
                potentialRevenueChart.update();
            }

            // Update Gap Breakdown Chart — sorted by value descending so the
            // biggest gap is on top. We sort labels, values, and colors together
            // so each category keeps its semantic color from the matrix.
            if (gapBreakdownChart) {
                const items = [
                    { label: 'Compliance Gap',      value: Math.max(0, complianceGap),       color: '#E15759' },
                    { label: 'Coverage Gap',        value: Math.max(0, coverageGap),         color: '#F28E2B' },
                    { label: 'Liability Gap',       value: Math.max(0, liabilityGap),        color: '#4E79A7' },
                    { label: 'Mixed (Comp.+Liab.)', value: Math.max(0, mixedGapCompliance),  color: '#76B7B2' },
                    { label: 'Mixed (Cov.+Liab.)',  value: Math.max(0, mixedGapCoverage),    color: '#B07AA1' }
                ];
                items.sort((a, b) => b.value - a.value);
                gapBreakdownChart.data.labels = items.map(x => x.label);
                gapBreakdownChart.data.datasets[0].data = items.map(x => x.value);
                gapBreakdownChart.data.datasets[0].backgroundColor = items.map(x => x.color);
                gapBreakdownChart.update();
            }
            // NB: the 3-bar Revenue/Realistic/Theoretical chart and the headline KPI
            // are updated inside calculateBusinessLicenseGaps(), where the additional
            // variables they depend on (statutoryAverageBilled, compliantBusinesses,
            // realisticImprovementPercent, etc.) are in scope.
        }

        function updateMatrixDashboard(data) {
            const currencySymbol = getCurrencySymbol();

            function formatCompact(value) {
                // Treat negative values as 0 for display
                var v = Math.max(0, value || 0);
                if (v >= 1000000000) {
                    return currencySymbol + ' ' + (v / 1000000000).toFixed(1) + 'B';
                } else if (v >= 1000000) {
                    return currencySymbol + ' ' + (v / 1000000).toFixed(1) + 'M';
                }
                return currencySymbol + ' ' + formatCurrency(v);
            }

            function formatBusinessCount(value) {
                if (value >= 1000000) {
                    return (value / 1000000).toFixed(1) + 'M';
                } else if (value >= 1000) {
                    return (value / 1000).toFixed(1) + 'K';
                }
                return Math.round(value).toLocaleString();
            }

            // Update Y-axis labels (business counts)
            const estLabel = document.getElementById('blMatrixEstimatedLabel');
            const regLabel = document.getElementById('blMatrixRegisteredLabel');
            const compLabel = document.getElementById('blMatrixCompliantLabel');

            if (estLabel) estLabel.textContent = formatBusinessCount(Math.max(0, data.totalEstimatedBusinesses));
            if (regLabel) regLabel.textContent = formatBusinessCount(Math.max(0, Math.min(data.registeredBusinesses, data.totalEstimatedBusinesses)));
            if (compLabel) compLabel.textContent = formatBusinessCount(Math.max(0, Math.min(data.compliantBusinesses, data.registeredBusinesses)));

            // Update X-axis labels
            const avgBilledLabel = document.getElementById('blMatrixAvgBilledLabel');
            const achievableLabel = document.getElementById('blMatrixAchievableLabel');
            const originLabel = document.getElementById('blMatrixOriginLabel');

            if (avgBilledLabel) avgBilledLabel.textContent = formatCompact(data.avgBilledAmount);
            if (achievableLabel) achievableLabel.textContent = formatCompact(data.achievableAvgBill);
            if (originLabel) originLabel.textContent = currencySymbol + ' 0';

            // Update matrix cell values
            const matrixActualRevenue = document.getElementById('blMatrixActualRevenueVal');
            const matrixLiabilityGap = document.getElementById('blMatrixLiabilityGapVal');
            const matrixComplianceGap = document.getElementById('blMatrixComplianceGapVal');
            const matrixMixedCompliance = document.getElementById('blMatrixMixedComplianceVal');
            const matrixCoverageGap = document.getElementById('blMatrixCoverageGapVal');
            const matrixMixedCoverage = document.getElementById('blMatrixMixedCoverageVal');

            if (matrixActualRevenue) matrixActualRevenue.textContent = formatCompact(data.revenueToDate);
            if (matrixLiabilityGap) matrixLiabilityGap.textContent = formatCompact(data.liabilityGap);
            if (matrixComplianceGap) matrixComplianceGap.textContent = formatCompact(data.complianceGap);
            if (matrixMixedCompliance) matrixMixedCompliance.textContent = formatCompact(data.mixedGapCompliance);
            if (matrixCoverageGap) matrixCoverageGap.textContent = formatCompact(data.coverageGap);
            if (matrixMixedCoverage) matrixMixedCoverage.textContent = formatCompact(data.mixedGapCoverage);

            // === DYNAMIC ROW HEIGHTS (proportional to business counts) ===
            // Clamp all segment counts to valid ranges
            const clampedRegistered = Math.max(0, Math.min(data.registeredBusinesses, data.totalEstimatedBusinesses));
            const clampedCompliant = Math.max(0, Math.min(data.compliantBusinesses, clampedRegistered));
            const totalBizRaw = data.totalEstimatedBusinesses || 0;
            const unregBiz = Math.max(0, totalBizRaw - clampedRegistered);
            const nonCompliantBiz = Math.max(0, clampedRegistered - clampedCompliant);
            const compliantBiz = Math.max(0, clampedCompliant);

            // Empty state: no data entered yet. Render a clean even 2×3 grid so all six
            // cells are legible — otherwise the Marimekko rows collapse to min-height
            // and cluster at the top, hiding the labels. Mirrors the Property Tax matrix.
            const rowsEmpty = totalBizRaw === 0 || (unregBiz + nonCompliantBiz + compliantBiz === 0);
            const totalBiz = rowsEmpty ? 1 : totalBizRaw;

            // True Marimekko: cell AREA encodes the underlying count, not a fixed grid.
            // Floor is 5% (down from 30%) — small cells stay visible (~16px on a 320px
            // container) without distorting the proportions of larger ones.
            const minFlex = 0.15;
            const unregFlex = rowsEmpty ? 1 : Math.max(minFlex, unregBiz / totalBiz);
            const nonCompliantFlex = rowsEmpty ? 1 : Math.max(minFlex, nonCompliantBiz / totalBiz);
            const compliantFlex = rowsEmpty ? 1 : Math.max(minFlex, compliantBiz / totalBiz);

            const rowUnreg = document.getElementById('blMatrixRowUnreg');
            const rowNonCompliant = document.getElementById('blMatrixRowNonCompliant');
            const rowCompliant = document.getElementById('blMatrixRowCompliant');

            if (rowUnreg) rowUnreg.style.flex = unregFlex.toString();
            if (rowNonCompliant) rowNonCompliant.style.flex = nonCompliantFlex.toString();
            if (rowCompliant) rowCompliant.style.flex = compliantFlex.toString();

            // === DYNAMIC COLUMN WIDTHS (proportional to billing amounts) ===
            const totalBillingRaw = data.achievableAvgBill || 0;
            const avgBilled = data.avgBilledAmount || 0;
            const liabilityDiff = Math.max(0, (data.achievableAvgBill || 0) - (data.avgBilledAmount || 0));
            const colsEmpty = totalBillingRaw === 0 || (avgBilled + liabilityDiff === 0);
            const totalBilling = colsEmpty ? 1 : totalBillingRaw;

            // Column floor 5% — same Marimekko principle as rows.
            const minColWidth = 0.15;
            const leftColFlex = colsEmpty ? 1 : Math.max(minColWidth, avgBilled / totalBilling);
            const rightColFlex = colsEmpty ? 1 : Math.max(minColWidth, liabilityDiff / totalBilling);

            // Apply to all row cells
            const allRows = document.querySelectorAll('#blMatrixGridArea .matrix-row');
            allRows.forEach(row => {
                const cells = row.querySelectorAll('.matrix-cell');
                if (cells.length >= 2) {
                    cells[0].style.flex = leftColFlex.toString();
                    cells[1].style.flex = rightColFlex.toString();
                }
            });

            // === POSITION Y-AXIS LABELS AT ROW BOUNDARIES (percentage-based) ===
            const totalFlex = unregFlex + nonCompliantFlex + compliantFlex;
            const row1Pct = (unregFlex / totalFlex) * 100;
            const row2Pct = (nonCompliantFlex / totalFlex) * 100;

            const yLabelEstimated = document.getElementById('blYLabelEstimated');
            const yLabelRegistered = document.getElementById('blYLabelRegistered');
            const yLabelCompliant = document.getElementById('blYLabelCompliant');

            // Estimated at top (0%)
            if (yLabelEstimated) {
                yLabelEstimated.style.top = '0%';
            }
            // Registered at boundary between row1 and row2
            if (yLabelRegistered) {
                yLabelRegistered.style.top = row1Pct + '%';
            }
            // Compliant at boundary between row2 and row3
            if (yLabelCompliant) {
                yLabelCompliant.style.top = (row1Pct + row2Pct) + '%';
            }

            // === POSITION X-AXIS LABEL AT COLUMN BOUNDARY ===
            const xAxisContainer = document.getElementById('blMatrixXAxisContainer');
            const xLabelAvgBilled = document.getElementById('blXLabelAvgBilled');

            if (xAxisContainer && xLabelAvgBilled) {
                const totalColFlex = leftColFlex + rightColFlex;
                const leftColPercent = (leftColFlex / totalColFlex) * 100;

                // Always show the "Avg. Billed" label — it's the user's actual current
                // billed average and should never be hidden. Adapt the anchor so the
                // label doesn't collide with the corner labels:
                //   - boundary near right edge → right-align (extends into left column)
                //   - boundary near left edge → left-align (extends into right column)
                //   - middle → centered on the boundary line
                xLabelAvgBilled.style.left = leftColPercent + '%';
                xLabelAvgBilled.style.visibility = 'visible';
                if (leftColPercent > 80) {
                    xLabelAvgBilled.style.transform = 'translateX(-100%)';
                    xLabelAvgBilled.style.textAlign = 'right';
                } else if (leftColPercent < 20) {
                    xLabelAvgBilled.style.transform = 'translateX(0%)';
                    xLabelAvgBilled.style.textAlign = 'left';
                } else {
                    xLabelAvgBilled.style.transform = 'translateX(-50%)';
                    xLabelAvgBilled.style.textAlign = 'center';
                }
            }

            // === GUARD RAILS: hide cell text when the cell is too small =====
            // Once the flex sizing has been applied, measure each cell. Below
            // these thresholds the two-line label+value can't render without
            // bleeding into adjacent cells, so we suppress it. Information is
            // preserved via a native title tooltip on hover.
            requestAnimationFrame(() => {
                document.querySelectorAll('#blMatrixGridArea .matrix-cell').forEach(cell => {
                    const rect = cell.getBoundingClientRect();
                    // Skip when the matrix is hidden (e.g. License tab not active).
                    // We'd measure 0×0 and wrongly classify every cell as too small.
                    // The tabShown listener below re-runs this once the tab is visible.
                    if (rect.width === 0 || rect.height === 0) return;
                    const content = cell.querySelector('.text-center');
                    if (!content) return;

                    const tooShort = rect.height < 28;   // can't fit label + value
                    const tooNarrow = rect.width < 70;   // value text would overflow

                    cell.classList.toggle('is-too-small', tooShort);
                    cell.classList.toggle('is-too-narrow', !tooShort && tooNarrow);

                    // Fallback tooltip for cells that don't already have a
                    // Bootstrap tooltip configured. Skip cells with
                    // data-bs-toggle so we don't clobber their static title.
                    if (!cell.hasAttribute('data-bs-toggle')) {
                        const label = content.querySelector('small')?.textContent?.trim() || '';
                        const value = content.querySelector('span')?.textContent?.trim() || '';
                        cell.title = label && value ? `${label}: ${value}` : (label || value);
                    }
                });
            });
        }

        function storeBusinessLicenseValues(revenueToDate, totalPotentialRevenue, totalFunctionalGap, complianceGap, coverageGap, liabilityGap, mixedGapCompliance, mixedGapCoverage, complianceRatio, coverageRatio) {
            try {
                // Use RosraStateManager if available (preferred method)
                if (typeof RosraStateManager !== 'undefined') {
                    RosraStateManager.updateBusinessLicense({
                        currentRevenue: revenueToDate,
                        potentialRevenue: totalPotentialRevenue,
                        totalFunctionalGap: totalFunctionalGap,
                        complianceGap: complianceGap,
                        coverageGap: coverageGap,
                        liabilityGap: liabilityGap,
                        mixedGapCompliance: mixedGapCompliance,
                        mixedGapCoverage: mixedGapCoverage,
                        complianceRatio: complianceRatio,
                        coverageRatio: coverageRatio
                    });
                    console.log('Business License: Updated via RosraStateManager');
                }

                // Also keep localStorage for backward compatibility
                localStorage.setItem('licenseCurrentValue', revenueToDate);
                localStorage.setItem('licensePotentialValue', totalPotentialRevenue);
                localStorage.setItem('licenseGapValue', totalFunctionalGap);
                localStorage.setItem('licenseGap', totalFunctionalGap);
                localStorage.setItem('licenseComplianceGap', complianceGap);
                localStorage.setItem('licenseCoverageGap', coverageGap);
                localStorage.setItem('licenseLiabilityGap', liabilityGap);
                localStorage.setItem('licenseMixedGapCompliance', mixedGapCompliance);
                localStorage.setItem('licenseMixedGapCoverage', mixedGapCoverage);
                localStorage.setItem('licenseComplianceRatio', complianceRatio);
                localStorage.setItem('licenseCoverageRatio', coverageRatio);

                const licenseValuesUpdated = new CustomEvent('licenseValuesUpdated', {
                    detail: {
                        current: revenueToDate,
                        potential: totalPotentialRevenue,
                        gap: totalFunctionalGap
                    }
                });
                document.dispatchEvent(licenseValuesUpdated);
            } catch (e) {
                console.error('Error storing Business License values in localStorage:', e);
            }
        }

        // Expose function globally
        window.calculateBusinessLicenseGaps = calculateBusinessLicenseGaps;
    });
</script>

<!-- Edit License Classification Modal -->
<div class="modal fade" id="editLicenseMetaModal" tabindex="-1" aria-labelledby="editLicenseMetaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--un-blue, #00b2e3); color: #fff;">
                <h5 class="modal-title" id="editLicenseMetaModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Edit Stream Classification
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="editLicenseMetaName" class="form-label fw-bold">Stream Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="editLicenseMetaName" placeholder="Enter stream name">
                </div>
                <div class="mb-3">
                    <label for="editLicenseMetaSubgroup" class="form-label fw-bold">Stream Type (Subgroup) <span class="text-danger">*</span></label>
                    <select class="form-select" id="editLicenseMetaSubgroup" onchange="onEditLicenseSubgroupChange()">
                        <option value="">-- Select stream type --</option>
                        <option value="A">Business licences and recurrent operating permits</option>
                        <option value="B">Service fees and billed use charges</option>
                        <option value="C">Daily or point-of-collection charges</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="editLicenseMetaSubtype" class="form-label">Specific Revenue Type</label>
                    <select class="form-select" id="editLicenseMetaSubtype">
                        <option value="">-- Select specific type (optional) --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmEditLicenseMetaBtn">
                    <i class="bi bi-check-circle me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';

    window.openEditLicenseMetaModal = function() {
        var nameEl = document.getElementById('businessLicenseLabel') || document.getElementById('licenseHeaderName');
        var currentName = nameEl ? nameEl.textContent.trim() : 'Business License';
        var currentSubgroup = document.getElementById('licenseSubgroup') ? document.getElementById('licenseSubgroup').value : '';
        var currentSubtype = document.getElementById('licenseSubtype') ? document.getElementById('licenseSubtype').value : '';

        document.getElementById('editLicenseMetaName').value = currentName;
        document.getElementById('editLicenseMetaSubgroup').value = currentSubgroup;

        // Populate subtypes
        onEditLicenseSubgroupChange();

        // Set current subtype after populating
        if (currentSubtype) {
            document.getElementById('editLicenseMetaSubtype').value = currentSubtype;
        }

        var modal = new bootstrap.Modal(document.getElementById('editLicenseMetaModal'));
        modal.show();
    };

    window.onEditLicenseSubgroupChange = function() {
        var subgroup = document.getElementById('editLicenseMetaSubgroup').value;
        var subtypeSelect = document.getElementById('editLicenseMetaSubtype');
        subtypeSelect.innerHTML = '<option value="">-- Select specific type (optional) --</option>';
        if (subgroup && typeof StreamClassification !== 'undefined') {
            StreamClassification.getSubtypesForSubgroup(subgroup).forEach(function(st) {
                var opt = document.createElement('option');
                opt.value = st;
                opt.textContent = st;
                subtypeSelect.appendChild(opt);
            });
        }
    };

    document.getElementById('confirmEditLicenseMetaBtn').addEventListener('click', function() {
        var newName = document.getElementById('editLicenseMetaName').value.trim();
        var newSubgroup = document.getElementById('editLicenseMetaSubgroup').value;
        var newSubtype = document.getElementById('editLicenseMetaSubtype').value;

        if (!newName) { alert('Please enter a stream name.'); return; }
        if (!newSubgroup) { alert('Please select a stream type.'); return; }

        // Check if subgroup changed — warn and reset selections
        var oldSubgroup = document.getElementById('licenseSubgroup').value || '';
        if (oldSubgroup && oldSubgroup !== newSubgroup) {
            if (!confirm('Changing the stream type will reset the recommendations already selected for this stream. Do you want to continue?')) {
                return;
            }
            // Reset selections for this stream
            if (typeof resetStreamSelections === 'function') {
                var currentName = document.getElementById('businessLicenseLabel')
                    ? document.getElementById('businessLicenseLabel').textContent.trim()
                    : 'Business License';
                resetStreamSelections(currentName);
            }
        }

        // Update hidden fields
        document.getElementById('licenseSubgroup').value = newSubgroup;
        document.getElementById('licenseSubtype').value = newSubtype;

        // Update container data attributes
        var container = document.getElementById('license-container');
        if (container) {
            container.setAttribute('data-subgroup', newSubgroup);
            container.setAttribute('data-subtype', newSubtype);
        }

        // Update display name
        var displayNameInput = document.getElementById('businessLicenseDisplayName');
        if (displayNameInput) displayNameInput.value = newName;

        // Update tab label
        var tabLabel = document.getElementById('businessLicenseLabel');
        if (tabLabel) tabLabel.textContent = newName;

        // Update header name inside the license view
        var headerName = document.getElementById('licenseHeaderName');
        if (headerName) headerName.textContent = newName;

        // Update or create the subgroup badge in the header
        var subgroupColor = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupColor(newSubgroup) : '#666';
        var subgroupLabel = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupShortLabel(newSubgroup) : newSubgroup;
        var badge = document.getElementById('licenseSubgroupBadge');
        if (badge) {
            badge.style.backgroundColor = subgroupColor;
            badge.textContent = subgroupLabel;
            badge.classList.remove('bg-secondary');
        }

        // Update the tab button to show subgroup badge
        var tabBtn = document.querySelector('.gap-tab-btn[data-tab="license"]');
        if (tabBtn) {
            tabBtn.setAttribute('data-subgroup', newSubgroup);
            // Add or update badge on the tab button
            var tabBadge = tabBtn.querySelector('.badge');
            if (!tabBadge) {
                tabBadge = document.createElement('span');
                tabBadge.className = 'badge ms-1';
                tabBadge.style.fontSize = '0.6rem';
                tabBadge.style.verticalAlign = 'middle';
                tabBtn.insertBefore(tabBadge, tabBtn.querySelector('.rename-tab-btn'));
            }
            tabBadge.style.backgroundColor = subgroupColor;
            tabBadge.textContent = newSubgroup;
        }

        // Save to localStorage for persistence
        localStorage.setItem('rosraBusinessLicenseDisplayName', newName);
        localStorage.setItem('rosraBusinessLicenseSubgroup', newSubgroup);
        localStorage.setItem('rosraBusinessLicenseSubtype', newSubtype);

        // Close modal
        var modal = bootstrap.Modal.getInstance(document.getElementById('editLicenseMetaModal'));
        modal.hide();
    });

    // Restore saved classification on page load
    document.addEventListener('DOMContentLoaded', function() {
        var savedSubgroup = localStorage.getItem('rosraBusinessLicenseSubgroup');
        var savedSubtype = localStorage.getItem('rosraBusinessLicenseSubtype');

        if (savedSubgroup) {
            var subgroupInput = document.getElementById('licenseSubgroup');
            if (subgroupInput && !subgroupInput.value) subgroupInput.value = savedSubgroup;

            var container = document.getElementById('license-container');
            if (container && !container.getAttribute('data-subgroup')) {
                container.setAttribute('data-subgroup', savedSubgroup);
            }

            // Update badge
            var badge = document.getElementById('licenseSubgroupBadge');
            if (badge && badge.classList.contains('bg-secondary')) {
                var color = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupColor(savedSubgroup) : '#666';
                var label = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupShortLabel(savedSubgroup) : savedSubgroup;
                badge.style.backgroundColor = color;
                badge.textContent = label;
                badge.classList.remove('bg-secondary');
            }

            // Update tab button
            var tabBtn = document.querySelector('.gap-tab-btn[data-tab="license"]');
            if (tabBtn) {
                tabBtn.setAttribute('data-subgroup', savedSubgroup);
                var tabBadge = tabBtn.querySelector('.badge');
                if (!tabBadge) {
                    var color = typeof StreamClassification !== 'undefined' ? StreamClassification.getSubgroupColor(savedSubgroup) : '#666';
                    tabBadge = document.createElement('span');
                    tabBadge.className = 'badge ms-1';
                    tabBadge.style.cssText = 'font-size: 0.6rem; vertical-align: middle; background-color:' + color;
                    tabBadge.textContent = savedSubgroup;
                    tabBtn.insertBefore(tabBadge, tabBtn.querySelector('.rename-tab-btn'));
                }
            }
        }

        if (savedSubtype) {
            var subtypeInput = document.getElementById('licenseSubtype');
            if (subtypeInput && !subtypeInput.value) subtypeInput.value = savedSubtype;
        }
    });
})();
</script>
