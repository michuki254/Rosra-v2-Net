@model RosraApp.Models.ViewModels.RosraFormViewModel
@{
    bool isViewMode = ViewData["ViewMode"] != null && (bool)ViewData["ViewMode"];
    string currencySymbol = string.IsNullOrEmpty(Model.CurrencySymbol) ? "$" : Model.CurrencySymbol;
}

<!-- Include Chart.js -->
<script src="~/lib/chart.js/chart-3.7.1.min.js" asp-append-version="true"></script>

<div class="property-tax-gap-analysis">
    <div class="row">
        <!-- Left Column - Data Input Section -->
        <div class="col-lg-4">
            <!-- Required Data + Derived Metrics -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-input-cursor-text me-2"></i>@Localizer["DataEntry_Title"]</h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">@Localizer["DataEntry_Instructions"]</p>

                    <!-- User Input Fields -->
                    <div class="mb-3">
                        <label for="registeredProperties" class="form-label fw-bold">
                            @Localizer["RegisteredProperties"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["RegisteredProperties_Tooltip"]"></i>
                        </label>
                        <input type="text" class="form-control number-format bg-light fw-bold" id="registeredProperties"
                               name="PropertyTax.RegisteredProperties" value="@(Model.PropertyTax.RegisteredProperties?.ToString("N0") ?? "")"
                               placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                    </div>

                    <div class="mb-3">
                        <label for="nonRegisteredProperties" class="form-label fw-bold">
                            @Localizer["NonRegisteredProperties"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["NonRegisteredProperties_Tooltip"]"></i>
                        </label>
                        <input type="text" class="form-control number-format bg-light fw-bold" id="nonRegisteredProperties"
                               name="PropertyTax.NonRegisteredProperties" value="@(Model.PropertyTax.NonRegisteredProperties?.ToString("N0") ?? "")"
                               placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">

                        <!-- Estimation Option -->
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="estimateNonRegistered" @(isViewMode ? "disabled" : "")>
                            <label class="form-check-label small text-muted" for="estimateNonRegistered">
                                @Localizer["EstimateCheckbox"]
                            </label>
                        </div>
                        <div id="estimatePercentageContainer" class="mt-2" style="display: none;">
                            <label class="form-label small text-primary">@Localizer["EstimateAsPercent"]</label>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control" id="nonRegisteredPercentage"
                                       value="5" min="0" max="100" step="0.1" @(isViewMode ? "readonly" : "")>
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">@Localizer["EstimatePercentHelper"]</small>
                        </div>
                    </div>

                    @* COMMENTED OUT — "Estimated Properties" + "Compliant Properties" labels & inputs.
                       Inputs kept in DOM (display:none) so the JS that writes to / reads from
                       #estimatedProperties and #compliantProperties continues to work. *@
                    <div class="mb-3" style="display:none;" aria-hidden="true">
                        <label for="estimatedProperties" class="form-label text-primary">
                            @Localizer["EstimatedProperties"]
                        </label>
                        <input type="text" class="form-control number-format" id="estimatedProperties"
                               readonly value="0">
                    </div>

                    <div class="mb-3" style="display:none;" aria-hidden="true">
                        <label for="compliantProperties" class="form-label text-primary">
                            @Localizer["CompliantProperties"]
                        </label>
                        <input type="text" class="form-control number-format" id="compliantProperties"
                               name="PropertyTax.CompliantProperties" value="@Model.PropertyTax.CompliantProperties"
                               readonly>
                    </div>

                    <div class="mb-3">
                        <label for="totalFiscalBase" class="form-label fw-bold">
                            @Localizer["TotalFiscalBase"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["TotalFiscalBase_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="totalFiscalBase"
                                   name="PropertyTax.TotalFiscalBase" value="@(Model.PropertyTax.TotalFiscalBase?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="totalMarketValue" class="form-label fw-bold">
                            @Localizer["TotalMarketValue"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["TotalMarketValue_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="totalMarketValue"
                                   name="PropertyTax.TotalMarketValue" value="@(Model.PropertyTax.TotalMarketValue?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>

                        <!-- Market Value Estimation Option -->
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="estimateMarketValue" @(isViewMode ? "disabled" : "")>
                            <label class="form-check-label small text-muted" for="estimateMarketValue">
                                @Localizer["MarketValueEstimateCheckbox"]
                            </label>
                        </div>
                        <div id="marketValueEstimateContainer" class="mt-2" style="display: none;">
                            <label class="form-label small text-primary">@Localizer["MarketValueHigherBy"]</label>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control" id="marketValuePercentage"
                                       value="30" min="0" max="500" step="1" @(isViewMode ? "readonly" : "")>
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">@Localizer["MarketValueEstimateHelper"]</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="billedAmount" class="form-label fw-bold">
                            @Localizer["BilledAmount"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["BilledAmount_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="billedAmount"
                                   name="PropertyTax.BilledAmount" value="@(Model.PropertyTax.BilledAmount?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="outstandingAmount" class="form-label fw-bold">
                            @Localizer["OutstandingAmount"] (<span class="currency-label">@currencySymbol</span>)
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["OutstandingAmount_Tooltip"]"></i>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control number-format bg-light fw-bold" id="outstandingAmount"
                                   name="PropertyTax.OutstandingAmount" value="@(Model.PropertyTax.OutstandingAmount?.ToString("N0") ?? "")"
                                   placeholder="@Localizer["EnterValue"]" @(isViewMode ? "readonly" : "") data-input="true">
                        </div>
                    </div>

                    @* COMMENTED OUT — "Revenue to Date" label & input.
                       Input kept in DOM (display:none) so the JS that writes to #revenueToDate
                       (and the chart that reads from it) continues to work. *@
                    <div class="mb-3" style="display:none;" aria-hidden="true">
                        <label for="revenueToDate" class="form-label text-primary">
                            @Localizer["RevenueToDate"] (<span class="currency-label">@currencySymbol</span>)
                        </label>
                        <input type="text" class="form-control number-format" id="revenueToDate"
                               name="PropertyTax.RevenueToDate" value="@Model.PropertyTax.RevenueToDate"
                               readonly>
                    </div>
                </div>
            </div>

            @* COMMENTED OUT — "Useful Average Values" and "KPI Ratios" sections wrapped together below.
               Cards are kept in the DOM (display:none) so the JS that writes to avgTaxableValue, avgMarketValue,
               effectiveTaxRate, avgBilledAmount, potentialBilling, complianceRatioBar/Value, coverageRatioBar/Value
               and valuationRatioBar/Value continues to work without null reference errors. *@
            <div style="display:none;" aria-hidden="true">

            <!-- Useful Average Values -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-calculator me-2"></i>@Localizer["AvgValues_Title"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["AvgTaxableValue"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["AvgTaxableValue_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="avgTaxableValue" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["AvgMarketValue"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["AvgMarketValue_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="avgMarketValue" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["EffectiveTaxRate"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["EffectiveTaxRate_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" id="effectiveTaxRate" readonly style="background-color: #e8f4fc;">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["AvgBilledAmount"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["AvgBilledAmount_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="avgBilledAmount" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-primary">
                            @Localizer["PotentialBilling"]
                            <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                               title="@Localizer["PotentialBilling_Tooltip"]"></i>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text currency-prefix-display">@currencySymbol</span>
                            <input type="text" class="form-control" id="potentialBilling" readonly style="background-color: #e8f4fc;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Ratios -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>@Localizer["KPI_Title"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0">
                                @Localizer["ComplianceRatio"]
                                <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                   title="@Localizer["ComplianceRatio_Tooltip"]"></i>
                            </label>
                            <span id="complianceRatioValue" class="badge bg-success">0%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" id="complianceRatioBar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">@Localizer["ComplianceRatio_Formula"]</small>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0">
                                @Localizer["CoverageRatio"]
                                <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                   title="@Localizer["CoverageRatio_Tooltip"]"></i>
                            </label>
                            <span id="coverageRatioValue" class="badge bg-info">0%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" id="coverageRatioBar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">@Localizer["CoverageRatio_Formula"]</small>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0">
                                @Localizer["ValuationRatio"]
                                <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right"
                                   title="@Localizer["ValuationRatio_Tooltip"]"></i>
                            </label>
                            <span id="valuationRatioValue" class="badge bg-primary">0%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" id="valuationRatioBar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">@Localizer["ValuationRatio_Formula"]</small>
                    </div>
                </div>
            </div>

            </div><!-- /hidden wrapper for AvgValues + KPI Ratios -->
        </div>

        <!-- Right Column - Results Section -->
        <div class="col-lg-8">
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>@Localizer["Results_Title"]</h6>
                </div>
                <div class="card-body">
                    @* COMMENTED OUT — Potential Revenue Breakdown table (kept hidden via display:none so the
                       JS that updates its cell IDs continues to work without null reference errors). *@
                    <div class="mb-4" style="display:none;" aria-hidden="true">
                        <h6 class="text-center mb-3">@Localizer["PotentialRevenue_Title"]</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@Localizer["Table_RevenueAndGaps"]</th>
                                        <th class="text-end">@Localizer["Table_Amount"] (<span class="currency-label">@currencySymbol</span>)</th>
                                        <th class="text-end">@Localizer["Table_Share"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="table-success">
                                        <td>@Localizer["RevenueToDate_Label"]</td>
                                        <td class="text-end" id="tableRevenueToDate">0</td>
                                        <td class="text-end" id="tableRevenueToDatePct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["ComplianceGap"]</td>
                                        <td class="text-end" id="tableComplianceGap">0</td>
                                        <td class="text-end" id="tableComplianceGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["CoverageGap"]</td>
                                        <td class="text-end" id="tableCoverageGap">0</td>
                                        <td class="text-end" id="tableCoverageGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["ValuationGap"]</td>
                                        <td class="text-end" id="tableValuationGap">0</td>
                                        <td class="text-end" id="tableValuationGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["MixedGapReg"]</td>
                                        <td class="text-end" id="tableMixedGapReg">0</td>
                                        <td class="text-end" id="tableMixedGapRegPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["MixedGapUnreg"]</td>
                                        <td class="text-end" id="tableMixedGapUnreg">0</td>
                                        <td class="text-end" id="tableMixedGapUnregPct">0%</td>
                                    </tr>
                                    <tr class="table-secondary fw-bold">
                                        <td>@Localizer["TotalPotentialRevenue"]</td>
                                        <td class="text-end" id="tableTotalPotential">0</td>
                                        <td class="text-end">100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Headline KPI: Total Revenue Gap. Updated by JS in calculatePropertyTaxGaps(). -->
                    <div class="kpi-headline mb-3" role="region" aria-label="@Localizer["KpiHeadline_AriaLabel"]">
                        <div class="kpi-headline-row">
                            <div class="kpi-headline-label">
                                <span class="kpi-eyebrow">@Localizer["KpiHeadline_Eyebrow"]</span>
                                <span class="kpi-headline-title">@Localizer["KpiHeadline_Title"]</span>
                            </div>
                            <div class="kpi-headline-value">
                                <span class="kpi-value" id="ptKpiGapValue">@currencySymbol 0</span>
                                <span class="kpi-pct"><strong id="ptKpiGapPct">0%</strong> @Localizer["KpiHeadline_OfPotential"]</span>
                            </div>
                        </div>
                        <div class="kpi-headline-meta">
                            <span class="kpi-collected"><strong id="ptKpiCollectedPct">0%</strong> @Localizer["KpiHeadline_Collected"]</span>
                            <span class="kpi-potential">@Localizer["KpiHeadline_Potential"] <strong id="ptKpiPotentialValue">@currencySymbol 0</strong></span>
                        </div>
                    </div>

                    <!-- Revenue to date vs Potential — Gap to Potential (mirrors Top-Down chart layout).
                         NB: Property Tax intentionally shows 2 bars (not 3 like License/Generic) because
                         it has no Realistic Improvement % input — its potential is anchored directly to
                         market value, which is a hard ceiling. The note below explains this to the user. -->
                    <div class="mb-4 revenue-gap-stack-section">
                        <div class="rg-stack-header">
                            <h6 class="rg-stack-title">Revenue to date vs Potential — Gap to Potential</h6>
                            <span class="rg-stack-units" id="revenueGapUnits">AMOUNTS IN <span class="currency-label">@currencySymbol</span> (B)</span>
                        </div>
                        <div class="chart-container" style="height: 420px;">
                            <canvas id="revenueGapStackedBarChart"></canvas>
                        </div>
                        <p class="rg-stack-note">
                            <strong>@Localizer["RgStackNote_Heading"]</strong> @Localizer["RgStackNote_Body"]
                        </p>
                    </div>

                    <hr>

                    <!-- Matrix Gap Analysis Dashboard (Primary Visualization) -->
                    <div class="mb-4">
                        <h6 class="text-center mb-3">@Localizer["MatrixDashboard_Title"]</h6>
                        <div class="row g-3 align-items-stretch">
                            <!-- Matrix Visualization -->
                            <div class="col-12">
                                <div class="matrix-container position-relative" style="height: 320px; min-height: 320px; border-radius: 8px; overflow: visible; background: #fff; margin-top: 15px;">
                                    <!-- Y-axis Title (rotated) -->
                                    <div class="position-absolute d-flex align-items-center justify-content-center" style="left: 0; top: 0; bottom: 30px; width: 20px; background: #f8f9fa;">
                                        <span style="transform: rotate(-90deg); white-space: nowrap; font-size: 0.6rem; color: #666;">@Localizer["Matrix_YAxisTitle"]</span>
                                    </div>

                                    <!-- Y-axis Labels Container - labels positioned at row BOUNDARIES.
                                         NB: keep this absolute so top:0/bottom:30px give it real height —
                                         a stray `position: relative;` here was collapsing the container to
                                         zero height, which made the JS that pins Registered/Compliant by
                                         pixel-top stack them all at the top. -->
                                    <div class="matrix-y-labels position-absolute" id="matrixYLabelsContainer" style="left: 20px; top: 0; bottom: 30px; width: 55px; font-size: 0.6rem; background: #f8f9fa;">
                                        <!-- Estimated label at TOP boundary (top of matrix) -->
                                        <div class="y-label-item" id="yLabelEstimated" style="position: absolute; right: 3px; top: 0; text-align: right; transform: translateY(-50%); cursor: help;"
                                             data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="@Localizer["Matrix_Estimated_Tooltip"]">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_Estimated"]</small>
                                            <span id="matrixEstimatedLabel" class="fw-bold" style="font-size: 0.65rem;">0</span>
                                        </div>
                                        <!-- Registered label at boundary between Row1 and Row2 -->
                                        <div class="y-label-item" id="yLabelRegistered" style="position: absolute; right: 3px; text-align: right; transform: translateY(-50%); cursor: help;"
                                             data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="@Localizer["Matrix_Registered_Tooltip"]">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_Registered"]</small>
                                            <span id="matrixRegisteredLabel" class="fw-bold" style="font-size: 0.65rem;">0</span>
                                        </div>
                                        <!-- Compliant label at boundary between Row2 and Row3 -->
                                        <div class="y-label-item" id="yLabelCompliant" style="position: absolute; right: 3px; text-align: right; transform: translateY(-50%); cursor: help;"
                                             data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="@Localizer["Matrix_Compliant_Tooltip"]">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_Compliant"]</small>
                                            <span id="matrixCompliantLabel" class="fw-bold" style="font-size: 0.65rem;">0</span>
                                        </div>
                                    </div>

                                    <!-- Matrix Grid Area -->
                                    <div class="matrix-grid position-absolute" id="matrixGridArea" style="left: 75px; top: 0; right: 0; bottom: 30px; display: flex; flex-direction: column;">
                                        <!-- Row 1: Unregistered (Estimated - Registered) -->
                                        <div class="matrix-row d-flex" id="matrixRowUnreg" style="flex: 1; min-height: 12px;">
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="matrixCoverageGap"
                                                 style="background-color: #F28E2B; color: white; flex: 1; min-width: 30px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_CoverageGap"]</small><br>
                                                    <span id="matrixCoverageGapVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="matrixMixedUnreg"
                                                 style="background-color: #B07AA1; color: white; flex: 1; min-width: 30px; cursor: help;"
                                                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title="@Localizer["Matrix_MixedGapUnreg_Tooltip"]">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_MixedGapUnreg"]</small><br>
                                                    <span id="matrixMixedUnregVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Row 2: Non-Compliant Registered (Registered - Compliant) -->
                                        <div class="matrix-row d-flex" id="matrixRowNonCompliant" style="flex: 1; min-height: 12px;">
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="matrixComplianceGap"
                                                 style="background-color: #E15759; color: white; flex: 1; min-width: 30px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_ComplianceGap"]</small><br>
                                                    <span id="matrixComplianceGapVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="matrixMixedReg"
                                                 style="background-color: #76B7B2; color: white; flex: 1; min-width: 30px; cursor: help;"
                                                 data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title="@Localizer["Matrix_MixedGapReg_Tooltip"]">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_MixedGapReg"]</small><br>
                                                    <span id="matrixMixedRegVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Row 3: Compliant -->
                                        <div class="matrix-row d-flex" id="matrixRowCompliant" style="flex: 1; min-height: 12px;">
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="matrixActualRevenue"
                                                 style="background-color: #59A14F; color: white; flex: 1; min-width: 30px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_ActualRevenue"]</small><br>
                                                    <span id="matrixActualRevenueVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                            <div class="matrix-cell d-flex align-items-center justify-content-center" id="matrixValuationGap"
                                                 style="background-color: #4E79A7; color: white; flex: 1; min-width: 30px;">
                                                <div class="text-center p-1">
                                                    <small style="font-size: 0.7rem;">@Localizer["Matrix_ValuationGap"]</small><br>
                                                    <span id="matrixValuationGapVal" class="fw-bold" style="font-size: 0.8rem;">@currencySymbol 0</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- X-axis Labels - positioned at column BOUNDARIES -->
                                    <div class="matrix-x-axis position-absolute" id="matrixXAxisContainer" style="left: 75px; right: 0; bottom: 0; height: 30px; background: #f8f9fa;">
                                        <!-- X-axis label at left edge (origin = 0) -->
                                        <div class="x-label-item" id="xLabelOrigin" style="position: absolute; left: 0; bottom: 2px; transform: translateX(0%); text-align: left; font-size: 0.6rem;">
                                            <span id="matrixOriginLabel" class="fw-bold" style="font-size: 0.65rem;">@currencySymbol 0</span>
                                        </div>
                                        <!-- X-axis label at column boundary (between left and right columns) -->
                                        <div class="x-label-item" id="xLabelAvgBilled" style="position: absolute; bottom: 2px; transform: translateX(-50%); text-align: center; font-size: 0.6rem;">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_AvgBilled"]</small>
                                            <span id="matrixAvgBilledLabel" class="fw-bold" style="font-size: 0.65rem;">@currencySymbol 0</span>
                                        </div>
                                        <!-- X-axis label at right edge -->
                                        <div class="x-label-item" id="xLabelAchievable" style="position: absolute; right: 0; bottom: 2px; transform: translateX(0%); text-align: right; font-size: 0.6rem;">
                                            <small class="text-muted d-block" style="font-size: 0.55rem;">@Localizer["Matrix_AchievableAvg"]</small>
                                            <span id="matrixAvgMarketLabel" class="fw-bold" style="font-size: 0.65rem;">@currencySymbol 0</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!-- end row -->
                        <p class="small text-muted mt-3 text-center">
                            <strong>@Localizer["Description_Label"]</strong> @Localizer["MatrixDashboard_Description"]
                        </p>
                    </div>

                    <hr>

                    @* REMOVED — "Revenue and Administrative Gaps" pie chart, title, and description. *@
                    @* JS keeps null-guards on #potentialRevenueChart (lines ~808 / ~1169) so removal is safe. *@

                    @* COMMENTED OUT — Administrative Gap Breakdown table (kept hidden via display:none so the JS
                       at ~line 1036 that writes to admComplianceGap, admCoverageGap, etc. continues to work). *@
                    <div class="mb-4" style="display:none;" aria-hidden="true">
                        <h6 class="text-center mb-3">@Localizer["AdmGapBreakdown_Title"] (<span class="currency-label">@currencySymbol</span>)</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@Localizer["Table_AdmGaps"]</th>
                                        <th class="text-end">@Localizer["Table_Amount"] (<span class="currency-label">@currencySymbol</span>)</th>
                                        <th class="text-end">@Localizer["Table_Share"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@Localizer["ComplianceGap"]</td>
                                        <td class="text-end" id="admComplianceGap">0</td>
                                        <td class="text-end" id="admComplianceGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["CoverageGap"]</td>
                                        <td class="text-end" id="admCoverageGap">0</td>
                                        <td class="text-end" id="admCoverageGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["ValuationAssessmentGap"]</td>
                                        <td class="text-end" id="admValuationGap">0</td>
                                        <td class="text-end" id="admValuationGapPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["MixedGapValReg"]</td>
                                        <td class="text-end" id="admMixedGapReg">0</td>
                                        <td class="text-end" id="admMixedGapRegPct">0%</td>
                                    </tr>
                                    <tr>
                                        <td>@Localizer["MixedGapValUnreg"]</td>
                                        <td class="text-end" id="admMixedGapUnreg">0</td>
                                        <td class="text-end" id="admMixedGapUnregPct">0%</td>
                                    </tr>
                                    <tr class="table-secondary fw-bold">
                                        <td>@Localizer["TotalAdmGap"]</td>
                                        <td class="text-end" id="tableTotalAdmGap">0</td>
                                        <td class="text-end">100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Breakdown of Administrative Gaps — horizontal bar chart.
                         Was a doughnut with a 5-row legend on the side; switched to bar
                         so labels sit on the y-axis and small categories stay readable. -->
                    <div class="mb-4">
                        <h6 class="text-center mb-3">@Localizer["AdmGapsPie_Title"]</h6>
                        <div style="height: 320px; position: relative;">
                            <canvas id="adminGapChart"></canvas>
                        </div>
                        <p class="small text-muted mt-2 text-center">
                            <strong>@Localizer["Description_Label"]</strong> @Localizer["AdmGapsPie_Description"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .property-tax-gap-analysis .card {
        border-radius: 8px;
    }

    .property-tax-gap-analysis .card-header {
        border-radius: 8px 8px 0 0;
    }

    /* Revenue vs Gap stacked bar header */
    .revenue-gap-stack-section {
        background: #ffffff;
        border-radius: 10px;
        padding: 1rem 1.1rem 0.4rem;
    }
    .rg-stack-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.4rem;
    }
    .rg-stack-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }
    .rg-stack-units {
        font-size: 0.72rem;
        color: #94a3b8;
        letter-spacing: 1.2px;
        font-weight: 600;
        text-transform: uppercase;
        white-space: nowrap;
    }
    @@media (max-width: 600px) {
        .rg-stack-header { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    }

    .property-tax-gap-analysis .form-control[readonly] {
        cursor: default;
    }

    .property-tax-gap-analysis .progress {
        border-radius: 10px;
    }

    .property-tax-gap-analysis .progress-bar {
        border-radius: 10px;
        transition: width 0.3s ease-in-out;
    }

    .property-tax-gap-analysis .table th,
    .property-tax-gap-analysis .table td {
        vertical-align: middle;
        font-size: 0.875rem;
    }

    /* Ensure table header text is visible with white color on dark background */
    .property-tax-gap-analysis .table thead.table-dark th {
        color: #ffffff !important;
        background-color: #212529 !important;
    }

    /* KPI Ratio badges should display as normal Bootstrap badges */
    .property-tax-gap-analysis .card-body > .mb-3 .badge {
        width: auto;
        height: auto;
        border-radius: 0.25rem;
        padding: 0.35em 0.65em;
        font-size: 0.75em;
    }

    .property-tax-gap-analysis .input-group-sm .form-control,
    .property-tax-gap-analysis .input-group-sm .input-group-text {
        font-size: 0.8rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Chart instances
        let potentialRevenueChart = null;
        let adminGapChart = null;
        let revenueGapStackedBarChart = null;

        // Get currency symbol from AppContext (single source of truth)
        function getCurrencySymbol() {
            if (window.AppContext) {
                return window.AppContext.get('currencySymbol') || '$';
            }
            return '$';
        }

        // Update all currency displays in Property Tax section
        function updatePropertyTaxCurrencySymbols() {
            const symbol = getCurrencySymbol();
            console.log('Updating Property Tax currency symbols to:', symbol);

            // Update input group prefixes
            document.querySelectorAll('.property-tax-gap-analysis .currency-prefix-display').forEach(el => {
                el.textContent = symbol;
            });

            // Update labels with currency
            document.querySelectorAll('.property-tax-gap-analysis .currency-label').forEach(el => {
                el.textContent = symbol;
            });
        }

        // Subscribe to AppContext currency changes (similar to useContext in React)
        if (window.AppContext) {
            window.AppContext.subscribe('currencySymbol', function(newSymbol) {
                console.log('Property Tax received currency change via AppContext:', newSymbol);
                updatePropertyTaxCurrencySymbols();
                // Also recalculate to update matrix dashboard with new currency
                calculatePropertyTaxGaps();
            });
        }

        // Initial currency update
        updatePropertyTaxCurrencySymbols();

        // Delayed update to catch currency loaded from API (after country data loads)
        setTimeout(function() {
            updatePropertyTaxCurrencySymbols();
        }, 1000);

        // Another update after 2 seconds for slower connections
        setTimeout(function() {
            updatePropertyTaxCurrencySymbols();
        }, 2000);

        // Initialize Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Initialize charts
        initializeCharts();

        // Add event listeners to all input fields
        const inputFields = document.querySelectorAll('.property-tax-gap-analysis input[data-input="true"]');
        inputFields.forEach(field => {
            field.addEventListener('input', function() {
                calculatePropertyTaxGaps();
            });
            field.addEventListener('change', function() {
                calculatePropertyTaxGaps();
            });
        });

        // Non-registered Properties Estimation Logic
        const estimateCheckbox = document.getElementById('estimateNonRegistered');
        const estimateContainer = document.getElementById('estimatePercentageContainer');
        const nonRegisteredInput = document.getElementById('nonRegisteredProperties');
        const percentageInput = document.getElementById('nonRegisteredPercentage');
        const registeredInput = document.getElementById('registeredProperties');

        if (estimateCheckbox) {
            estimateCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    // Show percentage input, make non-registered field readonly
                    estimateContainer.style.display = 'block';
                    nonRegisteredInput.readOnly = true;
                    nonRegisteredInput.style.backgroundColor = '#e8f4fc';
                    nonRegisteredInput.classList.remove('bg-light');
                    // Calculate based on percentage
                    updateNonRegisteredFromPercentage();
                } else {
                    // Hide percentage input, make non-registered field editable
                    estimateContainer.style.display = 'none';
                    nonRegisteredInput.readOnly = false;
                    nonRegisteredInput.style.backgroundColor = '';
                    nonRegisteredInput.classList.add('bg-light');
                }
            });
        }

        if (percentageInput) {
            percentageInput.addEventListener('input', updateNonRegisteredFromPercentage);
            percentageInput.addEventListener('change', updateNonRegisteredFromPercentage);
        }

        // Also recalculate when registered properties change (if estimate mode is on)
        if (registeredInput) {
            registeredInput.addEventListener('input', function() {
                if (estimateCheckbox && estimateCheckbox.checked) {
                    updateNonRegisteredFromPercentage();
                }
            });
        }

        function updateNonRegisteredFromPercentage() {
            if (!estimateCheckbox || !estimateCheckbox.checked) return;

            const registered = parseNumber(registeredInput?.value);
            const percentage = parseFloat(percentageInput?.value) || 0;

            const nonRegistered = Math.round(registered * (percentage / 100));
            nonRegisteredInput.value = formatCurrency(nonRegistered).replace('.00', '');

            // Trigger recalculation
            calculatePropertyTaxGaps();
        }

        // Total Market Value Estimation Logic
        const marketValueCheckbox = document.getElementById('estimateMarketValue');
        const marketValueContainer = document.getElementById('marketValueEstimateContainer');
        const marketValueInput = document.getElementById('totalMarketValue');
        const marketValuePercentageInput = document.getElementById('marketValuePercentage');
        const fiscalBaseInput = document.getElementById('totalFiscalBase');

        if (marketValueCheckbox) {
            marketValueCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    // Show percentage input, make market value field readonly
                    marketValueContainer.style.display = 'block';
                    marketValueInput.readOnly = true;
                    marketValueInput.style.backgroundColor = '#e8f4fc';
                    marketValueInput.classList.remove('bg-light');
                    // Calculate based on percentage
                    updateMarketValueFromPercentage();
                } else {
                    // Hide percentage input, make market value field editable
                    marketValueContainer.style.display = 'none';
                    marketValueInput.readOnly = false;
                    marketValueInput.style.backgroundColor = '';
                    marketValueInput.classList.add('bg-light');
                }
            });
        }

        if (marketValuePercentageInput) {
            marketValuePercentageInput.addEventListener('input', updateMarketValueFromPercentage);
            marketValuePercentageInput.addEventListener('change', updateMarketValueFromPercentage);
        }

        // Also recalculate market value when fiscal base changes (if estimate mode is on)
        if (fiscalBaseInput) {
            fiscalBaseInput.addEventListener('input', function() {
                if (marketValueCheckbox && marketValueCheckbox.checked) {
                    updateMarketValueFromPercentage();
                }
            });
        }

        function updateMarketValueFromPercentage() {
            if (!marketValueCheckbox || !marketValueCheckbox.checked) return;

            const fiscalBase = parseNumber(fiscalBaseInput?.value);
            const percentage = parseFloat(marketValuePercentageInput?.value) || 0;

            // Market Value = Fiscal Base × (1 + percentage/100)
            const marketValue = fiscalBase * (1 + percentage / 100);
            marketValueInput.value = formatCurrency(marketValue);

            // Trigger recalculation
            calculatePropertyTaxGaps();
        }

        // Initial calculation
        calculatePropertyTaxGaps();

        // Recalculate when the Property Tax tab becomes visible. While the tab
        // is display:none, matrix cells measure 0×0 so the guard-rail step skips
        // them; re-running once the tab has real size applies the rails.
        document.addEventListener('tabShown', function(e) {
            if (e.detail && e.detail.tabId === 'property-tax') {
                calculatePropertyTaxGaps();
            }
        });

        function initializeCharts() {
            // ----- Revenue to date vs Potential — two-bar layout matching the Top-Down chart -----
            const rgCanvas = document.getElementById('revenueGapStackedBarChart');
            if (rgCanvas) {
                // 2 sig figs — must match formatCurrencyShort / formatCompact so the
                // same value renders identically across the bar chart, matrix, and donut.
                const fmtCompact = function (v) {
                    if (v == null || isNaN(v)) return '0';
                    if (Math.abs(v) >= 1e9) return (v / 1e9).toFixed(1) + 'B';
                    if (Math.abs(v) >= 1e6) return (v / 1e6).toFixed(1) + 'M';
                    if (Math.abs(v) >= 1e3) return (v / 1e3).toFixed(0) + 'K';
                    return Math.round(v).toLocaleString();
                };

                // Custom plugin: total labels above bars, segment values, dashed connector, right-side gap bracket
                const rgLabelsPlugin = {
                    id: 'rgGapAnnotations',
                    afterDatasetsDraw: function (chart) {
                        const c  = chart.ctx;
                        const m0 = chart.getDatasetMeta(0); // base (cyan) — Revenue to date in BOTH bars
                        const m1 = chart.getDatasetMeta(1); // gap (orange) — only on Potential bar
                        if (!m0 || !m1) return;
                        const bar0Cur = m0.data[0]; // Bar 1: Revenue to date
                        const bar0Pot = m0.data[1]; // Bar 2: cyan base (= revenue to date)
                        const bar1Pot = m1.data[1]; // Bar 2: orange top (= gap)
                        if (!bar0Cur || !bar0Pot || !bar1Pot) return;

                        const symbol = (typeof getCurrencySymbol === 'function') ? getCurrencySymbol() : '';
                        const v   = chart.config._rgValues || { rev: 0, gap: 0, total: 0 };
                        const pct = v.total > 0 ? Math.round((v.gap / v.total) * 100) : 0;

                        const fmtFull = function (n) { return (symbol ? symbol + ' ' : '') + fmtCompact(n); };

                        c.save();

                        // 1) Total amount label above each bar
                        c.font = '700 13px Roboto, "Segoe UI", Arial, sans-serif';
                        c.fillStyle = '#1f2937';
                        c.textAlign = 'center';
                        c.textBaseline = 'bottom';
                        c.fillText(fmtFull(v.rev),   bar0Cur.x, bar0Cur.y - 8);
                        c.fillText(fmtFull(v.total), bar1Pot.x, bar1Pot.y - 8);

                        // 2) In-segment labels (white bold)
                        c.fillStyle = '#ffffff';
                        c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'middle';
                        if (Math.abs(bar0Cur.base - bar0Cur.y) > 22 && v.rev > 0) {
                            c.fillText(fmtCompact(v.rev), bar0Cur.x, (bar0Cur.y + bar0Cur.base) / 2);
                        }
                        if (Math.abs(bar0Pot.base - bar0Pot.y) > 22 && v.rev > 0) {
                            c.fillText(fmtCompact(v.rev), bar0Pot.x, (bar0Pot.y + bar0Pot.base) / 2);
                        }
                        if (Math.abs(bar1Pot.base - bar1Pot.y) > 22 && v.gap > 0) {
                            c.fillText(fmtCompact(v.gap), bar1Pot.x, (bar1Pot.y + bar1Pot.base) / 2);
                        }

                        // 3) Dashed connector — top of Bar 1 to top of cyan base in Bar 2
                        const halfW = (bar0Cur.width || 60) / 2;
                        c.strokeStyle = '#9ca3af';
                        c.lineWidth = 1;
                        c.setLineDash([4, 4]);
                        c.beginPath();
                        c.moveTo(bar0Cur.x + halfW, bar0Cur.y);
                        c.lineTo(bar0Pot.x - halfW, bar0Pot.y);
                        c.stroke();
                        c.setLineDash([]);

                        // 4) Right-side gap bracket
                        if (v.gap > 0) {
                            const bracketX = bar1Pot.x + ((bar1Pot.width || 60) / 2) + 18;
                            const topY = bar1Pot.y;
                            const botY = bar1Pot.base;
                            c.strokeStyle = '#FD9D24';
                            c.lineWidth = 1.5;
                            c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX, botY); c.stroke();
                            c.beginPath(); c.moveTo(bracketX, topY); c.lineTo(bracketX - 6, topY); c.stroke();
                            c.beginPath(); c.moveTo(bracketX, botY); c.lineTo(bracketX - 6, botY); c.stroke();

                            const midY = (topY + botY) / 2;
                            c.fillStyle = '#FD9D24';
                            c.textAlign = 'left';
                            c.font = '700 12px Roboto, "Segoe UI", Arial, sans-serif';
                            c.textBaseline = 'bottom';
                            c.fillText('Gap', bracketX + 8, midY - 4);
                            c.font = '700 14px Roboto, "Segoe UI", Arial, sans-serif';
                            c.textBaseline = 'top';
                            c.fillText(fmtCompact(v.gap), bracketX + 8, midY + 2);
                            c.fillStyle = '#94a3b8';
                            c.font = '500 11px Roboto, "Segoe UI", Arial, sans-serif';
                            c.fillText(pct + '% of potential', bracketX + 8, midY + 22);
                        }

                        c.restore();
                    }
                };

                revenueGapStackedBarChart = new Chart(rgCanvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: [['Revenue to date', 'actual collection'], ['Potential', 'total potential']],
                        datasets: [
                            {
                                label: 'Revenue to date',
                                data: [0, 0],
                                backgroundColor: '#00B2E3',
                                stack: 'rg',
                                borderWidth: 0,
                                barThickness: 110,
                                maxBarThickness: 130
                            },
                            {
                                label: 'Gap',
                                data: [0, 0],
                                backgroundColor: '#FD9D24',
                                stack: 'rg',
                                borderWidth: 0,
                                barThickness: 110,
                                maxBarThickness: 130
                            }
                        ]
                    },
                    plugins: [rgLabelsPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { top: 36, right: 150, bottom: 8, left: 8 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const symbol = (typeof getCurrencySymbol === 'function') ? getCurrencySymbol() : '';
                                        return ctx.dataset.label + ': ' + symbol + ' ' + fmtCompact(ctx.parsed.y);
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                ticks: { font: { size: 12, weight: '700' }, color: '#1f2937', padding: 8 },
                                grid: { display: false },
                                border: { display: false }
                            },
                            y: {
                                stacked: true,
                                beginAtZero: true,
                                ticks: {
                                    font: { size: 11, weight: '500' },
                                    color: '#94a3b8',
                                    callback: function (v) {
                                        if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
                                        if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
                                        if (v >= 1e3) return (v / 1e3).toFixed(0) + 'K';
                                        return v.toLocaleString();
                                    }
                                },
                                grid: { color: '#eef0f3', drawBorder: false }
                            }
                        }
                    }
                });
                if (window.registerChart) registerChart('revenueGapStackedBarChart', revenueGapStackedBarChart);
            }

            // Potential Revenue Pie Chart
            const ctx1 = document.getElementById('potentialRevenueChart');
            if (ctx1) {
                potentialRevenueChart = new Chart(ctx1.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Revenue to date', 'Compliance Gap', 'Coverage Gap', 'Valuation Gap', 'Mixed Gap (reg.)', 'Mixed Gap (unreg.)'],
                        datasets: [{
                            data: [0, 0, 0, 0, 0, 0],
                            backgroundColor: ['#59A14F', '#E15759', '#F28E2B', '#4E79A7', '#76B7B2', '#B07AA1'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    boxWidth: 12,
                                    font: { size: 10 },
                                    generateLabels: function(chart) {
                                        const data = chart.data;
                                        if (data.labels.length && data.datasets.length) {
                                            const total = data.datasets[0].data.reduce((a, b) => a + b, 0);
                                            return data.labels.map((label, i) => {
                                                const value = data.datasets[0].data[i];
                                                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                                return {
                                                    text: label + ' (' + percentage + '%)',
                                                    fillStyle: data.datasets[0].backgroundColor[i],
                                                    hidden: false,
                                                    index: i
                                                };
                                            });
                                        }
                                        return [];
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return context.label + ': ' + formatCurrency(value) + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
                if (window.registerChart) registerChart('potentialRevenueChart', potentialRevenueChart);
            }

            // Administrative Gap — horizontal bar chart.
            // Was a doughnut with a 5-row legend on the side; switched to bar so labels
            // sit on the y-axis and small categories don't get squashed below readable size.
            const ctx2 = document.getElementById('adminGapChart');
            if (ctx2) {
                // Custom plugin: draw "KSh X (YY%)" at the right end of each bar.
                const adminGapBarValuesPlugin = {
                    id: 'adminGapBarValues',
                    afterDatasetsDraw: function (chart) {
                        const c = chart.ctx;
                        const meta = chart.getDatasetMeta(0);
                        if (!meta) return;
                        const data = chart.data.datasets[0].data || [];
                        const total = data.reduce((a, b) => a + b, 0);
                        c.save();
                        c.font = '600 11px Roboto, "Segoe UI", Arial, sans-serif';
                        c.textBaseline = 'middle';
                        c.fillStyle = '#1f2937';
                        meta.data.forEach((bar, i) => {
                            if (!bar) return;
                            const value = data[i] || 0;
                            if (value <= 0) return;
                            const pct = total > 0 ? ((value / total) * 100).toFixed(1) : '0.0';
                            const text = formatCurrencyShort(value) + '  (' + pct + '%)';
                            c.textAlign = 'left';
                            c.fillText(text, bar.x + 6, bar.y);
                        });
                        c.restore();
                    }
                };

                adminGapChart = new Chart(ctx2.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Compliance Gap', 'Coverage Gap', 'Valuation/assessment gap', 'Mixed Gap (reg.)', 'Mixed Gap (unreg.)'],
                        datasets: [{
                            data: [0, 0, 0, 0, 0],
                            backgroundColor: ['#E15759', '#F28E2B', '#4E79A7', '#76B7B2', '#B07AA1'],
                            borderWidth: 0,
                            borderRadius: 3,
                            barThickness: 22
                        }]
                    },
                    plugins: [adminGapBarValuesPlugin],
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { right: 110, left: 8, top: 8, bottom: 8 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return formatCurrencyShort(value) + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9', drawBorder: false },
                                ticks: {
                                    font: { size: 10 },
                                    color: '#64748b',
                                    callback: function (value) { return formatCurrencyShort(value); }
                                }
                            },
                            y: {
                                grid: { display: false, drawBorder: false },
                                ticks: { font: { size: 11 }, color: '#334155' }
                            }
                        }
                    }
                });
                if (window.registerChart) registerChart('adminGapChart', adminGapChart);
            }
        }

        function parseNumber(value) {
            if (!value) return 0;
            // Remove currency symbols, commas, spaces
            const cleaned = String(value).replace(/[^0-9.-]/g, '');
            return parseFloat(cleaned) || 0;
        }

        function formatCurrency(value) {
            if (isNaN(value) || value === null) return '0';
            return new Intl.NumberFormat('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(value);
        }

        // Compact currency, 2 significant figures. KEEP IN SYNC with formatCompact()
        // in updateMatrixDashboard — both must round identically so the same value
        // doesn't render as "1.05B" in one chart and "1.1B" in another.
        // 24,922,222,222 → "KSh 24.9B" / 8,830,000 → "KSh 8.8M" / 540,500 → "KSh 541K"
        function formatCurrencyShort(value) {
            if (isNaN(value) || value === null) return '0';
            const sym = (typeof getCurrencySymbol === 'function') ? (getCurrencySymbol() + ' ') : '';
            const abs = Math.abs(value);
            if (abs >= 1e9) return sym + (value / 1e9).toFixed(1) + 'B';
            if (abs >= 1e6) return sym + (value / 1e6).toFixed(1) + 'M';
            if (abs >= 1e3) return sym + (value / 1e3).toFixed(0) + 'K';
            return sym + Math.round(value).toString();
        }

        function formatPercentage(value) {
            if (isNaN(value) || value === null) return '0.00%';
            return value.toFixed(2) + '%';
        }

        function calculatePropertyTaxGaps() {
            // Get input values (user inputs)
            const registeredProperties = parseNumber(document.getElementById('registeredProperties')?.value);
            const nonRegisteredProperties = parseNumber(document.getElementById('nonRegisteredProperties')?.value);
            const totalFiscalBase = parseNumber(document.getElementById('totalFiscalBase')?.value);
            const totalMarketValue = parseNumber(document.getElementById('totalMarketValue')?.value);
            const billedAmount = parseNumber(document.getElementById('billedAmount')?.value);
            const outstandingAmount = parseNumber(document.getElementById('outstandingAmount')?.value);

            // AUTO-CALCULATE Revenue to Date = Billed - Outstanding
            const revenueToDate = billedAmount - outstandingAmount;
            document.getElementById('revenueToDate').value = formatCurrency(revenueToDate);

            // Calculate Derived Metrics
            const estimatedProperties = registeredProperties + nonRegisteredProperties;

            // Calculate Compliant Properties = Registered Properties × (Revenue to Date / Billed Amount)
            const compliantProperties = billedAmount > 0 ? registeredProperties * (revenueToDate / billedAmount) : 0;

            // Average values
            const avgTaxableValue = registeredProperties > 0 ? totalFiscalBase / registeredProperties : 0;
            const avgMarketValue = registeredProperties > 0 ? totalMarketValue / registeredProperties : 0;

            // Effective Tax Rate = Revenue to Date / (Avg Taxable Value × Compliant Properties)
            const effectiveTaxRate = (avgTaxableValue * compliantProperties) > 0
                ? (revenueToDate / (avgTaxableValue * compliantProperties)) * 100
                : 0;
            const effectiveTaxRateDecimal = effectiveTaxRate / 100;

            // Average Billed Amount = Effective Tax Rate × Average Taxable Value
            const avgBilledAmount = effectiveTaxRateDecimal * avgTaxableValue;

            // Potential Billing (market basis) = Effective Tax Rate × Average Market Value
            const potentialBilling = effectiveTaxRateDecimal * avgMarketValue;

            // Calculate KPI Ratios
            const complianceRatio = billedAmount > 0 ? (revenueToDate / billedAmount) * 100 : 0;
            const coverageRatio = estimatedProperties > 0 ? (registeredProperties / estimatedProperties) * 100 : 0;
            const valuationRatio = totalMarketValue > 0 ? (totalFiscalBase / totalMarketValue) * 100 : 0;

            // Calculate Gaps (using CORRECT formulas from spec)
            // Compliance Gap = Outstanding Amount
            const complianceGap = outstandingAmount;

            // Coverage Gap = (Estimated - Registered) × Avg Billed Amount
            const coverageGap = (estimatedProperties - registeredProperties) * avgBilledAmount;

            // Valuation Gap = Compliant Properties × (Potential Billing Market - Avg Billed)
            const valuationGap = compliantProperties * (potentialBilling - avgBilledAmount);

            // Mixed Gap (val./reg.) = (Registered - Compliant) × (Potential Billing Market - Avg Billed)
            const mixedGapReg = (registeredProperties - compliantProperties) * (potentialBilling - avgBilledAmount);

            // Mixed Gap (val./unreg.) = (Estimated - Registered) × (Potential Billing Market - Avg Billed)
            const mixedGapUnreg = (estimatedProperties - registeredProperties) * (potentialBilling - avgBilledAmount);

            // Calculate Totals
            const totalPotentialRevenue = revenueToDate + complianceGap + coverageGap + valuationGap + mixedGapReg + mixedGapUnreg;
            const totalAdminGap = complianceGap + coverageGap + valuationGap + mixedGapReg + mixedGapUnreg;

            // Calculate percentages for potential revenue
            const revenueToDatePct = totalPotentialRevenue > 0 ? (revenueToDate / totalPotentialRevenue) * 100 : 0;
            const complianceGapPct = totalPotentialRevenue > 0 ? (complianceGap / totalPotentialRevenue) * 100 : 0;
            const coverageGapPct = totalPotentialRevenue > 0 ? (coverageGap / totalPotentialRevenue) * 100 : 0;
            const valuationGapPct = totalPotentialRevenue > 0 ? (valuationGap / totalPotentialRevenue) * 100 : 0;
            const mixedGapRegPct = totalPotentialRevenue > 0 ? (mixedGapReg / totalPotentialRevenue) * 100 : 0;
            const mixedGapUnregPct = totalPotentialRevenue > 0 ? (mixedGapUnreg / totalPotentialRevenue) * 100 : 0;

            // Calculate percentages for admin gaps
            const admComplianceGapPct = totalAdminGap > 0 ? (complianceGap / totalAdminGap) * 100 : 0;
            const admCoverageGapPct = totalAdminGap > 0 ? (coverageGap / totalAdminGap) * 100 : 0;
            const admValuationGapPct = totalAdminGap > 0 ? (valuationGap / totalAdminGap) * 100 : 0;
            const admMixedGapRegPct = totalAdminGap > 0 ? (mixedGapReg / totalAdminGap) * 100 : 0;
            const admMixedGapUnregPct = totalAdminGap > 0 ? (mixedGapUnreg / totalAdminGap) * 100 : 0;

            // Update derived metrics display
            document.getElementById('estimatedProperties').value = formatCurrency(estimatedProperties).replace('.00', '');
            document.getElementById('compliantProperties').value = formatCurrency(compliantProperties).replace('.00', '');
            document.getElementById('avgTaxableValue').value = formatCurrency(avgTaxableValue);
            document.getElementById('avgMarketValue').value = formatCurrency(avgMarketValue);
            document.getElementById('effectiveTaxRate').value = effectiveTaxRate.toFixed(2);
            document.getElementById('avgBilledAmount').value = formatCurrency(avgBilledAmount);
            document.getElementById('potentialBilling').value = formatCurrency(potentialBilling);

            // Update KPI progress bars (colors are dynamic based on thresholds)
            updateKPIBar('complianceRatio', complianceRatio);
            updateKPIBar('coverageRatio', coverageRatio);
            updateKPIBar('valuationRatio', valuationRatio);

            // Update Potential Revenue Breakdown Table
            document.getElementById('tableRevenueToDate').textContent = formatCurrency(revenueToDate);
            document.getElementById('tableRevenueToDatePct').textContent = formatPercentage(revenueToDatePct);
            document.getElementById('tableComplianceGap').textContent = formatCurrency(complianceGap);
            document.getElementById('tableComplianceGapPct').textContent = formatPercentage(complianceGapPct);
            document.getElementById('tableCoverageGap').textContent = formatCurrency(coverageGap);
            document.getElementById('tableCoverageGapPct').textContent = formatPercentage(coverageGapPct);
            document.getElementById('tableValuationGap').textContent = formatCurrency(valuationGap);
            document.getElementById('tableValuationGapPct').textContent = formatPercentage(valuationGapPct);
            document.getElementById('tableMixedGapReg').textContent = formatCurrency(mixedGapReg);
            document.getElementById('tableMixedGapRegPct').textContent = formatPercentage(mixedGapRegPct);
            document.getElementById('tableMixedGapUnreg').textContent = formatCurrency(mixedGapUnreg);
            document.getElementById('tableMixedGapUnregPct').textContent = formatPercentage(mixedGapUnregPct);
            document.getElementById('tableTotalPotential').textContent = formatCurrency(totalPotentialRevenue);

            // Update Administrative Gap Breakdown Table
            document.getElementById('admComplianceGap').textContent = formatCurrency(complianceGap);
            document.getElementById('admComplianceGapPct').textContent = formatPercentage(admComplianceGapPct);
            document.getElementById('admCoverageGap').textContent = formatCurrency(coverageGap);
            document.getElementById('admCoverageGapPct').textContent = formatPercentage(admCoverageGapPct);
            document.getElementById('admValuationGap').textContent = formatCurrency(valuationGap);
            document.getElementById('admValuationGapPct').textContent = formatPercentage(admValuationGapPct);
            document.getElementById('admMixedGapReg').textContent = formatCurrency(mixedGapReg);
            document.getElementById('admMixedGapRegPct').textContent = formatPercentage(admMixedGapRegPct);
            document.getElementById('admMixedGapUnreg').textContent = formatCurrency(mixedGapUnreg);
            document.getElementById('admMixedGapUnregPct').textContent = formatPercentage(admMixedGapUnregPct);
            document.getElementById('tableTotalAdmGap').textContent = formatCurrency(totalAdminGap);

            // Update Charts
            updateCharts(revenueToDate, complianceGap, coverageGap, valuationGap, mixedGapReg, mixedGapUnreg);

            // Update Matrix Dashboard
            updateMatrixDashboard({
                estimatedProperties,
                registeredProperties,
                compliantProperties,
                avgBilledAmount,
                potentialBilling,
                revenueToDate,
                complianceGap,
                coverageGap,
                valuationGap,
                mixedGapReg,
                mixedGapUnreg,
                totalPotentialRevenue,
                revenueToDatePct,
                complianceGapPct,
                coverageGapPct,
                valuationGapPct,
                mixedGapRegPct,
                mixedGapUnregPct
            });

            // Store values in localStorage for Prioritization tab
            storePropertyTaxValues(revenueToDate, totalPotentialRevenue, totalAdminGap, complianceGap, coverageGap, valuationGap, mixedGapReg, mixedGapUnreg, complianceRatio, coverageRatio);
        }

        function storePropertyTaxValues(revenueToDate, totalPotentialRevenue, totalFunctionalGap, complianceGap, coverageGap, valuationGap, mixedGapReg, mixedGapUnreg, complianceRatio, coverageRatio) {
            try {
                // Use RosraStateManager if available (preferred method)
                if (typeof RosraStateManager !== 'undefined') {
                    RosraStateManager.updatePropertyTax({
                        currentRevenue: revenueToDate,
                        potentialRevenue: totalPotentialRevenue,
                        totalFunctionalGap: totalFunctionalGap,
                        complianceGap: complianceGap,
                        coverageGap: coverageGap,
                        valuationGap: valuationGap,
                        mixedGapReg: mixedGapReg,
                        mixedGapUnreg: mixedGapUnreg,
                        complianceRatio: complianceRatio,
                        coverageRatio: coverageRatio
                    });
                    console.log('Property Tax: Updated via RosraStateManager');
                }

                // Also keep localStorage for backward compatibility
                localStorage.setItem('propertyTaxCurrentValue', revenueToDate);
                localStorage.setItem('propertyTaxPotentialValue', totalPotentialRevenue);
                localStorage.setItem('propertyTaxGapValue', totalFunctionalGap);
                localStorage.setItem('propertyTaxGap', totalFunctionalGap);
                localStorage.setItem('propertyTaxComplianceGap', complianceGap);
                localStorage.setItem('propertyTaxCoverageGap', coverageGap);
                localStorage.setItem('propertyTaxValuationGap', valuationGap);
                localStorage.setItem('propertyTaxMixedGapReg', mixedGapReg);
                localStorage.setItem('propertyTaxMixedGapUnreg', mixedGapUnreg);
                localStorage.setItem('propertyTaxComplianceRatio', complianceRatio);
                localStorage.setItem('propertyTaxCoverageRatio', coverageRatio);

                const propertyTaxValuesUpdated = new CustomEvent('propertyTaxValuesUpdated', {
                    detail: {
                        current: revenueToDate,
                        potential: totalPotentialRevenue,
                        gap: totalFunctionalGap
                    }
                });
                document.dispatchEvent(propertyTaxValuesUpdated);
            } catch (e) {
                console.error('Error storing Property Tax values:', e);
            }
        }

        function updateKPIBar(name, value) {
            const bar = document.getElementById(name + 'Bar');
            const valueSpan = document.getElementById(name + 'Value');
            const cappedValue = Math.min(Math.max(value, 0), 100);

            // Determine color based on value: >80% Green, 60-80% Yellow, <60% Red
            let colorClass, badgeClass;
            if (value >= 80) {
                colorClass = 'bg-success';
                badgeClass = 'bg-success';
            } else if (value >= 60) {
                colorClass = 'bg-warning';
                badgeClass = 'bg-warning text-dark';
            } else {
                colorClass = 'bg-danger';
                badgeClass = 'bg-danger';
            }

            if (bar) {
                bar.style.width = cappedValue + '%';
                bar.setAttribute('aria-valuenow', cappedValue);
                // Remove old color classes and add new one
                bar.classList.remove('bg-success', 'bg-warning', 'bg-danger', 'bg-info', 'bg-primary');
                bar.classList.add(colorClass);
            }
            if (valueSpan) {
                valueSpan.textContent = value.toFixed(0) + '%';
                // Update badge color
                valueSpan.classList.remove('bg-success', 'bg-warning', 'bg-danger', 'bg-info', 'bg-primary', 'text-dark');
                badgeClass.split(' ').forEach(cls => valueSpan.classList.add(cls));
            }
        }

        function updateCharts(revenueToDate, complianceGap, coverageGap, valuationGap, mixedGapReg, mixedGapUnreg) {
            // Update Potential Revenue Chart
            if (potentialRevenueChart) {
                potentialRevenueChart.data.datasets[0].data = [
                    Math.max(0, revenueToDate),
                    Math.max(0, complianceGap),
                    Math.max(0, coverageGap),
                    Math.max(0, valuationGap),
                    Math.max(0, mixedGapReg),
                    Math.max(0, mixedGapUnreg)
                ];
                potentialRevenueChart.update();
            }

            // Update Admin Gap Chart — sorted by value descending so the biggest
            // gap is on top. Sort labels, values, and colors together so each keeps
            // its semantic color from the matrix.
            if (adminGapChart) {
                const items = [
                    { label: 'Compliance Gap',           value: Math.max(0, complianceGap),  color: '#E15759' },
                    { label: 'Coverage Gap',             value: Math.max(0, coverageGap),    color: '#F28E2B' },
                    { label: 'Valuation/assessment gap', value: Math.max(0, valuationGap),   color: '#4E79A7' },
                    { label: 'Mixed Gap (reg.)',         value: Math.max(0, mixedGapReg),    color: '#76B7B2' },
                    { label: 'Mixed Gap (unreg.)',       value: Math.max(0, mixedGapUnreg),  color: '#B07AA1' }
                ];
                items.sort((a, b) => b.value - a.value);
                adminGapChart.data.labels = items.map(x => x.label);
                adminGapChart.data.datasets[0].data = items.map(x => x.value);
                adminGapChart.data.datasets[0].backgroundColor = items.map(x => x.color);
                adminGapChart.update();
            }

            // Update "Revenue to date vs Potential" two-bar chart
            const rgRev   = Math.max(0, parseNumber(document.getElementById('revenueToDate')?.value));
            const rgGap   = Math.max(0, complianceGap)
                          + Math.max(0, coverageGap)
                          + Math.max(0, valuationGap)
                          + Math.max(0, mixedGapReg)
                          + Math.max(0, mixedGapUnreg);
            const rgTotal = rgRev + rgGap;
            if (revenueGapStackedBarChart) {
                // Bar 1 = "Revenue to date" (cyan only), Bar 2 = "Potential" (cyan base + orange gap)
                revenueGapStackedBarChart.data.datasets[0].data = [rgRev, rgRev];
                revenueGapStackedBarChart.data.datasets[1].data = [0,     rgGap];
                revenueGapStackedBarChart.config._rgValues = { rev: rgRev, gap: rgGap, total: rgTotal };
                revenueGapStackedBarChart.update();
            }

            // Update Headline KPI (Total Revenue Gap) — same numbers as the bar chart.
            const ptKpiGapVal    = document.getElementById('ptKpiGapValue');
            const ptKpiGapPct    = document.getElementById('ptKpiGapPct');
            const ptKpiCollected = document.getElementById('ptKpiCollectedPct');
            const ptKpiPotential = document.getElementById('ptKpiPotentialValue');
            if (ptKpiGapVal)    ptKpiGapVal.textContent    = formatCurrencyShort(rgGap);
            if (ptKpiPotential) ptKpiPotential.textContent = formatCurrencyShort(rgTotal);
            const ptGapPct = rgTotal > 0 ? Math.round((rgGap / rgTotal) * 100) : 0;
            const ptColPct = rgTotal > 0 ? 100 - ptGapPct : 0;
            if (ptKpiGapPct)    ptKpiGapPct.textContent    = ptGapPct + '%';
            if (ptKpiCollected) ptKpiCollected.textContent = ptColPct + '%';
        }

        function updateMatrixDashboard(data) {
            const currencySymbol = getCurrencySymbol();

            // Format number for display (compact for large numbers)
            function formatCompact(value) {
                if (value >= 1000000000) {
                    return currencySymbol + ' ' + (value / 1000000000).toFixed(1) + 'B';
                } else if (value >= 1000000) {
                    return currencySymbol + ' ' + (value / 1000000).toFixed(1) + 'M';
                } else if (value >= 1000) {
                    return currencySymbol + ' ' + (value / 1000).toFixed(1) + 'K';
                }
                return currencySymbol + ' ' + formatCurrency(value);
            }

            function formatPropertyCount(value) {
                if (value >= 1000000) {
                    return (value / 1000000).toFixed(1) + 'M';
                } else if (value >= 1000) {
                    return (value / 1000).toFixed(1) + 'K';
                }
                return Math.round(value).toLocaleString();
            }

            // Update Y-axis labels (property counts)
            const estLabel = document.getElementById('matrixEstimatedLabel');
            const regLabel = document.getElementById('matrixRegisteredLabel');
            const compLabel = document.getElementById('matrixCompliantLabel');

            if (estLabel) estLabel.textContent = formatPropertyCount(data.estimatedProperties);
            if (regLabel) regLabel.textContent = formatPropertyCount(data.registeredProperties);
            if (compLabel) compLabel.textContent = formatPropertyCount(data.compliantProperties);

            // Update X-axis labels (average billing amounts)
            const avgBilledLabel = document.getElementById('matrixAvgBilledLabel');
            const avgMarketLabel = document.getElementById('matrixAvgMarketLabel');
            const originLabel = document.getElementById('matrixOriginLabel');

            if (avgBilledLabel) avgBilledLabel.textContent = formatCompact(data.avgBilledAmount);
            if (avgMarketLabel) avgMarketLabel.textContent = formatCompact(data.potentialBilling);
            if (originLabel) originLabel.textContent = currencySymbol + ' 0';

            // Update matrix cell values
            const matrixActualRevenue = document.getElementById('matrixActualRevenueVal');
            const matrixValuationGap = document.getElementById('matrixValuationGapVal');
            const matrixComplianceGap = document.getElementById('matrixComplianceGapVal');
            const matrixMixedReg = document.getElementById('matrixMixedRegVal');
            const matrixCoverageGap = document.getElementById('matrixCoverageGapVal');
            const matrixMixedUnreg = document.getElementById('matrixMixedUnregVal');

            if (matrixActualRevenue) matrixActualRevenue.textContent = formatCompact(data.revenueToDate);
            if (matrixValuationGap) matrixValuationGap.textContent = formatCompact(data.valuationGap);
            if (matrixComplianceGap) matrixComplianceGap.textContent = formatCompact(data.complianceGap);
            if (matrixMixedReg) matrixMixedReg.textContent = formatCompact(data.mixedGapReg);
            if (matrixCoverageGap) matrixCoverageGap.textContent = formatCompact(data.coverageGap);
            if (matrixMixedUnreg) matrixMixedUnreg.textContent = formatCompact(data.mixedGapUnreg);

            // === DYNAMIC ROW HEIGHTS (proportional to property counts) ===
            const totalPropsRaw = data.estimatedProperties || 0;
            const unregProps = Math.max(0, (data.estimatedProperties || 0) - (data.registeredProperties || 0));
            const nonCompliantProps = Math.max(0, (data.registeredProperties || 0) - (data.compliantProperties || 0));
            const compliantProps = Math.max(0, data.compliantProperties || 0);
            // Empty state: no data entered yet. Render a clean even 2×3 grid so all six
            // cells are legible — otherwise the Marimekko rows collapse to min-height
            // and cluster at the top-left, hiding the labels.
            const rowsEmpty = totalPropsRaw === 0 || (unregProps + nonCompliantProps + compliantProps === 0);
            const totalProps = rowsEmpty ? 1 : totalPropsRaw;

            // True Marimekko: cell AREA encodes the underlying count.
            // Floor 5% — small cells stay visible without distorting proportions of larger ones.
            const minFlex = 0.05;
            const unregFlex = rowsEmpty ? 1 : Math.max(minFlex, unregProps / totalProps);
            const nonCompliantFlex = rowsEmpty ? 1 : Math.max(minFlex, nonCompliantProps / totalProps);
            const compliantFlex = rowsEmpty ? 1 : Math.max(minFlex, compliantProps / totalProps);

            const rowUnreg = document.getElementById('matrixRowUnreg');
            const rowNonCompliant = document.getElementById('matrixRowNonCompliant');
            const rowCompliant = document.getElementById('matrixRowCompliant');

            if (rowUnreg) rowUnreg.style.flex = unregFlex.toString();
            if (rowNonCompliant) rowNonCompliant.style.flex = nonCompliantFlex.toString();
            if (rowCompliant) rowCompliant.style.flex = compliantFlex.toString();

            // === DYNAMIC COLUMN WIDTHS (proportional to billing amounts) ===
            const totalBillingRaw = data.potentialBilling || 0;
            const avgBilled = data.avgBilledAmount || 0;
            const valuationDiff = Math.max(0, (data.potentialBilling || 0) - (data.avgBilledAmount || 0));
            const colsEmpty = totalBillingRaw === 0 || (avgBilled + valuationDiff === 0);
            const totalBilling = colsEmpty ? 1 : totalBillingRaw;

            // Column floor 5% — same Marimekko principle as rows.
            const minColWidth = 0.05;
            const leftColFlex = colsEmpty ? 1 : Math.max(minColWidth, avgBilled / totalBilling);
            const rightColFlex = colsEmpty ? 1 : Math.max(minColWidth, valuationDiff / totalBilling);

            // Apply to all row cells
            const allRows = document.querySelectorAll('.matrix-row');
            allRows.forEach(row => {
                const cells = row.querySelectorAll('.matrix-cell');
                if (cells.length >= 2) {
                    cells[0].style.flex = leftColFlex.toString();
                    cells[1].style.flex = rightColFlex.toString();
                }
            });

            // === POSITION Y-AXIS LABELS AT ROW BOUNDARIES ===
            // Get the grid area and y-axis container heights
            const gridArea = document.getElementById('matrixGridArea');
            const yAxisContainer = document.getElementById('matrixYLabelsContainer');

            if (gridArea && yAxisContainer) {
                const gridHeight = gridArea.offsetHeight;
                const totalFlex = unregFlex + nonCompliantFlex + compliantFlex;

                // Calculate row heights in pixels
                const row1Height = (unregFlex / totalFlex) * gridHeight;
                const row2Height = (nonCompliantFlex / totalFlex) * gridHeight;
                const row3Height = (compliantFlex / totalFlex) * gridHeight;

                // Position labels at boundaries
                const yLabelEstimated = document.getElementById('yLabelEstimated');
                const yLabelRegistered = document.getElementById('yLabelRegistered');
                const yLabelCompliant = document.getElementById('yLabelCompliant');

                // Estimated at top (0px from top)
                if (yLabelEstimated) {
                    yLabelEstimated.style.top = '0px';
                }
                // Registered at boundary between row1 and row2
                if (yLabelRegistered) {
                    yLabelRegistered.style.top = row1Height + 'px';
                }
                // Compliant at boundary between row2 and row3
                if (yLabelCompliant) {
                    yLabelCompliant.style.top = (row1Height + row2Height) + 'px';
                }
            }

            // === POSITION X-AXIS LABEL AT COLUMN BOUNDARY ===
            const xAxisContainer = document.getElementById('matrixXAxisContainer');
            const xLabelAvgBilled = document.getElementById('xLabelAvgBilled');

            if (xAxisContainer && xLabelAvgBilled) {
                const totalColFlex = leftColFlex + rightColFlex;
                const leftColPercent = (leftColFlex / totalColFlex) * 100;

                // Always show the "Avg. Billed" label — adapt the anchor so it doesn't
                // collide with the corner labels when the boundary is near an edge.
                xLabelAvgBilled.style.left = leftColPercent + '%';
                xLabelAvgBilled.style.visibility = 'visible';
                if (leftColPercent > 80) {
                    xLabelAvgBilled.style.transform = 'translateX(-100%)';
                    xLabelAvgBilled.style.textAlign = 'right';
                } else if (leftColPercent < 20) {
                    xLabelAvgBilled.style.transform = 'translateX(0%)';
                    xLabelAvgBilled.style.textAlign = 'left';
                } else {
                    xLabelAvgBilled.style.transform = 'translateX(-50%)';
                    xLabelAvgBilled.style.textAlign = 'center';
                }
            }

            // === GUARD RAILS: hide cell text when the cell is too small =====
            // Once the flex sizing has been applied, measure each cell. Below
            // these thresholds the two-line label+value can't render without
            // bleeding into adjacent cells, so we suppress it. Information is
            // preserved via a native title tooltip on hover.
            requestAnimationFrame(() => {
                document.querySelectorAll('#matrixGridArea .matrix-cell').forEach(cell => {
                    const rect = cell.getBoundingClientRect();
                    // Skip when the matrix is hidden (tab not active). We'd measure
                    // 0×0 and wrongly classify every cell as too small. The tabShown
                    // listener below re-runs this once the tab is visible.
                    if (rect.width === 0 || rect.height === 0) return;
                    const content = cell.querySelector('.text-center');
                    if (!content) return;

                    const tooShort = rect.height < 28;   // can't fit label + value
                    const tooNarrow = rect.width < 70;   // value text would overflow

                    cell.classList.toggle('is-too-small', tooShort);
                    cell.classList.toggle('is-too-narrow', !tooShort && tooNarrow);

                    // Fallback tooltip for cells that don't already have a
                    // Bootstrap tooltip configured. Skip cells with
                    // data-bs-toggle so we don't clobber their static title.
                    if (!cell.hasAttribute('data-bs-toggle')) {
                        const label = content.querySelector('small')?.textContent?.trim() || '';
                        const value = content.querySelector('span')?.textContent?.trim() || '';
                        cell.title = label && value ? `${label}: ${value}` : (label || value);
                    }
                });
            });
        }

        // Expose calculatePropertyTaxGaps globally
        window.calculatePropertyTaxGaps = calculatePropertyTaxGaps;
    });
</script>
