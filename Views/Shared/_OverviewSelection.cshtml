<!-- Solutions Data Modules (must load before solutionsDatabase.js) -->
<script src="~/js/solutionsData-PT-Compliance.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-PT-Coverage.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-PT-Valuation.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-NP-A.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-NP-B.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-NP-C.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-BL.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-Generic.js" asp-append-version="true"></script>
<script src="~/js/streamClassification.js" asp-append-version="true"></script>
<!-- Core Solutions Database API -->
<script src="~/js/solutionsDatabase.js" asp-append-version="true"></script>
<script>
(function() {
    'use strict';

    // Currency symbol from AppContext (single source of truth)
    let currencySymbol = '$';

    function getCurrencyFromContext() {
        if (typeof AppContext !== 'undefined') {
            return AppContext.get('currencySymbol') || '$';
        }
        return localStorage.getItem('selectedCurrencySymbol') || '$';
    }

    // State management for selections
    const selections = {
        selected: new Set(),
        skipped: new Set()
    };

    // Load selections from form field (primary) with localStorage fallback
    function loadSelections() {
        try {
            // Use FormStateManager for form field binding (best practice)
            if (typeof FormStateManager !== 'undefined') {
                const data = FormStateManager.getData('rosraOverviewSelections');
                if (data) {
                    selections.selected = new Set(data.selected || []);
                    selections.skipped = new Set(data.skipped || []);
                    console.log('OverviewSelection: Loaded selections from FormStateManager');
                }
            }

            // Fallback to localStorage for backward compatibility
            if (selections.selected.size === 0 && selections.skipped.size === 0) {
                const saved = localStorage.getItem('rosraOverviewSelections');
                if (saved) {
                    const data = JSON.parse(saved);
                    selections.selected = new Set(data.selected || []);
                    selections.skipped = new Set(data.skipped || []);
                    console.log('OverviewSelection: Loaded selections from localStorage (fallback)');
                }
            }

            // Backfill: sample reports (and older saves) ship the materialised
            // `selectedSolutions` array but omit the `selections.selected` ID
            // set. Without backfill, Recommendations shows N solutions while
            // Overview Selection shows 0 and the counts drift once the user
            // toggles anything. Reconstruct the ID set from the materialised
            // array when the primary store is empty.
            if (selections.selected.size === 0 && selections.skipped.size === 0) {
                try {
                    let materialised = null;
                    if (typeof FormStateManager !== 'undefined') {
                        materialised = FormStateManager.getData('rosraSelectedSolutions');
                    }
                    if (!Array.isArray(materialised)) {
                        const rawSolutions = localStorage.getItem('rosraSelectedSolutions');
                        if (rawSolutions) {
                            const parsed = JSON.parse(rawSolutions);
                            if (Array.isArray(parsed)) materialised = parsed;
                        }
                    }
                    if (Array.isArray(materialised) && materialised.length > 0) {
                        materialised.forEach(s => {
                            if (s && s.solutionId) selections.selected.add(s.solutionId);
                        });
                        console.log('OverviewSelection: Backfilled', selections.selected.size, 'selections from materialised solutions');
                    }
                } catch (e) {
                    console.warn('OverviewSelection: Backfill from rosraSelectedSolutions failed:', e);
                }
            }
        } catch (e) {
            console.error('Error loading selections:', e);
        }
    }

    // Save selections to form field (primary) and localStorage (backup)
    function saveSelections() {
        try {
            const selectionsData = {
                selected: Array.from(selections.selected),
                skipped: Array.from(selections.skipped)
            };

            // Use FormStateManager for form field binding (best practice)
            if (typeof FormStateManager !== 'undefined') {
                FormStateManager.setData('rosraOverviewSelections', selectionsData);
                console.log('OverviewSelection: Saved selections via FormStateManager');
            } else {
                // Fallback to localStorage only
                localStorage.setItem('rosraOverviewSelections', JSON.stringify(selectionsData));
            }

            // Also save full solution data for Recommendations module
            saveSelectedSolutionsForRecommendations();
        } catch (e) {
            console.error('Error saving selections:', e);
        }
    }

    // Map any raw timeline string on a solution card onto one of the three
    // canonical buckets the Recommendations module filters on. Exported to
    // window so recommendationsModule.js can apply the same mapping when it
    // reads back older (non-canonical) selections from localStorage.
    function canonicalizeTimeline(raw) {
        if (!raw) return '1-3 years';
        const s = String(raw).toLowerCase().trim();
        // Short term — "<1 year", "< 1 year", "less than a year",
        // "less than a year; repeat", "6-12 months", "90 days", etc.
        if (s.includes('90 day')
            || s.includes('less than a year')
            || /<\s*1\s*year/.test(s)
            || /6\s*-\s*12\s*month/.test(s)
            || s.startsWith('less than')) {
            return '<1 year';
        }
        // Long term — "3+ years", "3-5 years"
        if (/3\s*\+/.test(s) || /3\s*-\s*5\s*year/.test(s)) {
            return '3+ years';
        }
        // Everything else (1-2 years, 1-3 years, "launch; 1-3 years to deepen")
        return '1-3 years';
    }
    window.canonicalizeTimeline = canonicalizeTimeline;

    // Save full solution data for Recommendations module
    function saveSelectedSolutionsForRecommendations() {
        try {
            const selectedSolutions = [];
            const priorityData = getPrioritizationData();

            selections.selected.forEach(solutionId => {
                // Get full solution from database
                let solution = null;
                if (typeof SolutionsDatabase !== 'undefined') {
                    solution = SolutionsDatabase.getSolutionById(solutionId);
                }

                // Parse solution ID to determine stream/gap
                // New formats: PT-COM-01, PT-COV-01, NP-A-COV-01, NP-B-LIA-01
                // Legacy: BL-COM-01, GEN-COM-01
                const gapMap = {
                    'COM': 'Compliance',
                    'COV': 'Coverage',
                    'VAL': 'Valuation',
                    'LIA': 'Liability'
                };

                let streamName = solution?.stream || 'Unknown';
                let gapType = solution?.gap || 'Unknown';
                let subgroup = solution?.subgroup || null;

                // If solution not found in DB, parse the ID
                if (!solution) {
                    const parts = solutionId.split('-');
                    if (parts[0] === 'PT') {
                        streamName = 'Property Tax';
                        gapType = gapMap[parts[1]] || 'Unknown';
                    } else if (parts[0] === 'NP' && parts.length >= 3) {
                        subgroup = parts[1]; // A, B, or C
                        gapType = gapMap[parts[2]] || 'Unknown';
                    } else if (parts[0] === 'BL') {
                        streamName = 'Business License';
                        gapType = gapMap[parts[1]] || 'Unknown';
                        subgroup = 'A';
                    }
                }

                // For NP cards, find the actual stream name from prioritization data
                if (subgroup && streamName === 'Non-Property') {
                    // Try to find the matching stream from prioritization data
                    const matchingStream = priorityData.find(s => s.subgroup === subgroup);
                    if (matchingStream) streamName = matchingStream.name;
                }

                // Find rank and priority from prioritization data
                let streamInfo = priorityData.find(s => s.name === streamName);
                let gapInfo = streamInfo ? streamInfo.gaps.find(g => g.type === gapType) : null;

                selectedSolutions.push({
                    solutionId: solutionId,
                    streamName: streamName,
                    streamRank: streamInfo?.rank || 999,
                    gapType: gapType,
                    gapPriority: gapInfo?.priority || 999,
                    // Solution cards use many timeline strings ("< 1 year", "Less
                    // than a year", "6-12 months", "1-2 years", …). The downstream
                    // Recommendations module filters on the 3 canonical buckets
                    // below, so normalise here — otherwise the Timeline view and
                    // summary counts end up silently empty.
                    timeline: canonicalizeTimeline(solution?.timeline),
                    title: solution?.title || solution?.shortTitle || solutionId,
                    subgroup: subgroup || ''
                });
            });

            // Sort by stream rank then gap priority
            selectedSolutions.sort((a, b) => {
                if (a.streamRank !== b.streamRank) return a.streamRank - b.streamRank;
                return a.gapPriority - b.gapPriority;
            });

            // Use FormStateManager for form field binding (best practice)
            if (typeof FormStateManager !== 'undefined') {
                FormStateManager.setData('rosraSelectedSolutions', selectedSolutions);
                console.log('OverviewSelection: Saved', selectedSolutions.length, 'solutions via FormStateManager');
            } else {
                // Fallback to localStorage only
                localStorage.setItem('rosraSelectedSolutions', JSON.stringify(selectedSolutions));
                console.log('Saved', selectedSolutions.length, 'solutions for Recommendations (localStorage)');
            }
        } catch (e) {
            console.error('Error saving solutions for Recommendations:', e);
        }
    }

    // Get prioritization data from RosraStateManager or localStorage
    function getPrioritizationData() {
        let streams = [];

        // Try RosraStateManager first
        if (typeof RosraStateManager !== 'undefined') {
            const stateStreams = RosraStateManager.getStreamsByGapRanking();
            if (stateStreams.length > 0) {
                streams = stateStreams.map((s, idx) => ({
                    rank: s.finalRank || (idx + 1),
                    name: s.name,
                    type: s.type,
                    subgroup: s.subgroup || getSubgroupFromDOM(s.name),
                    gaps: getGapsForStream(s)
                }));
            }
        }

        // If no streams found, use default streams so cards are still visible
        if (streams.length === 0) {
            streams = [
                {
                    rank: 1,
                    name: 'Property Tax',
                    type: 'property-tax',
                    subgroup: null,
                    gaps: [
                        { priority: 1, type: 'Compliance', amount: 0 },
                        { priority: 2, type: 'Coverage', amount: 0 },
                        { priority: 3, type: 'Valuation', amount: 0 }
                    ]
                }
            ];

            // Also add any generic streams from the form
            const genericContainers = document.querySelectorAll('.generic-stream-gap-analysis');
            genericContainers.forEach((c, idx) => {
                const nameInput = c.querySelector('input[name$=".StreamName"]');
                const sgInput = c.querySelector('input[name$=".Subgroup"]');
                if (nameInput && nameInput.value) {
                    streams.push({
                        rank: idx + 2,
                        name: nameInput.value,
                        type: 'generic-stream',
                        subgroup: sgInput ? sgInput.value : null,
                        gaps: [
                            { priority: 1, type: 'Compliance', amount: 0 },
                            { priority: 2, type: 'Coverage', amount: 0 },
                            { priority: 3, type: 'Liability', amount: 0 }
                        ]
                    });
                }
            });
        }

        return streams;
    }

    // Try to find the subgroup from the DOM for a non-property stream
    function getSubgroupFromDOM(streamName) {
        // Look for hidden subgroup inputs in generic stream containers
        const containers = document.querySelectorAll('.generic-stream-gap-analysis');
        for (const c of containers) {
            const nameInput = c.querySelector('input[name$=".StreamName"]');
            if (nameInput && nameInput.value === streamName) {
                const sgInput = c.querySelector('input[name$=".Subgroup"]');
                return sgInput ? sgInput.value : null;
            }
        }
        // Also check tab buttons for data-subgroup
        const tabs = document.querySelectorAll('.gap-tab-btn[data-subgroup]');
        for (const tab of tabs) {
            const label = tab.querySelector('.stream-name-label');
            if (label && label.textContent === streamName) {
                return tab.getAttribute('data-subgroup') || null;
            }
        }
        return null;
    }

    // Extract gaps from a stream object
    function getGapsForStream(stream) {
        const gaps = [];
        const priorities = stream.gapPriorities || { compliance: 1, coverage: 2, third: 3 };

        if (stream.complianceGap > 0) {
            gaps.push({
                priority: priorities.compliance || 1,
                type: 'Compliance',
                amount: stream.complianceGap
            });
        }
        if (stream.coverageGap > 0) {
            gaps.push({
                priority: priorities.coverage || 2,
                type: 'Coverage',
                amount: stream.coverageGap
            });
        }
        if (stream.valuationGap > 0) {
            gaps.push({
                priority: priorities.third || 3,
                type: 'Valuation',
                amount: stream.valuationGap
            });
        }
        if (stream.liabilityGap > 0) {
            gaps.push({
                priority: priorities.third || 3,
                type: 'Liability',
                amount: stream.liabilityGap
            });
        }

        // Sort by priority
        gaps.sort((a, b) => a.priority - b.priority);
        return gaps;
    }

    // Format currency
    function formatCurrency(amount) {
        return currencySymbol + ' ' + new Intl.NumberFormat('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        }).format(amount);
    }

    // Get timeline badge class
    function getTimelineBadgeClass(timeline) {
        if (timeline === '<1 year') return 'timeline-badge quick';
        if (timeline === '1-3 years') return 'timeline-badge medium';
        return 'timeline-badge long';
    }

    // Localized labels for JS-rendered content
    var _t = {
        whatThisSolves: '@Html.Raw(Localizer["JS_WhatThisSolves"].Value)',
        whatYouDo: '@Html.Raw(Localizer["JS_WhatYouDo"].Value)',
        whenFitsBest: '@Html.Raw(Localizer["JS_WhenFitsBest"].Value)',
        minimumEnablers: '@Html.Raw(Localizer["JS_MinimumEnablers"].Value)',
        skip: '@Html.Raw(Localizer["JS_Skip"].Value)',
        select: '@Html.Raw(Localizer["JS_Select"].Value)',
        undo: '@Html.Raw(Localizer["JS_Undo"].Value)',
        selected: '@Html.Raw(Localizer["JS_Selected"].Value)',
        skipped: '@Html.Raw(Localizer["JS_Skipped"].Value)',
        gap: '@Html.Raw(Localizer["JS_Gap"].Value)',
        solutions: '@Html.Raw(Localizer["JS_Solutions"].Value)',
        rank: '@Html.Raw(Localizer["JS_Rank"].Value)'
    };

    // Helper: render array or string content for card sections
    function renderCardContent(val) {
        if (!val) return '';
        if (Array.isArray(val)) return '<ul class="mb-0 ps-3">' + val.map(v => '<li>' + v + '</li>').join('') + '</ul>';
        return val;
    }

    // Render a single solution card (supports both old and new card formats)
    function renderSolutionCard(solution) {
        const isSelected = selections.selected.has(solution.solutionId);
        const isSkipped = selections.skipped.has(solution.solutionId);
        const cardClass = isSelected ? 'selected' : (isSkipped ? 'skipped' : '');
        const safeId = solution.solutionId.replace(/[^a-zA-Z0-9]/g, '');
        const ov = solution.overview || {};

        // New format fields (fall back to old field names)
        const whatItDoes = ov.whatThisOptionDoes || ov.whatThisSolves || ov.mainPurpose || '';
        const whenUseful = renderCardContent(ov.mostUsefulWhen || ov.whenThisFitsBest || ov.whenStrongFit || '');
        const notBestFirst = renderCardContent(ov.usuallyNotBestFirstMove || '');
        const worksAlongside = renderCardContent(ov.oftenWorksBestAlongside || '');

        // Build collapsible sections
        let sections = '';
        if (whatItDoes) {
            sections += `
                <div class="solution-section">
                    <div class="solution-section-header" data-bs-toggle="collapse" data-bs-target="#${safeId}-what">
                        <span><i class="bi bi-lightbulb me-2"></i>What this option does</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="collapse show" id="${safeId}-what">
                        <div class="solution-section-content">${whatItDoes}</div>
                    </div>
                </div>`;
        }
        if (whenUseful) {
            sections += `
                <div class="solution-section">
                    <div class="solution-section-header" data-bs-toggle="collapse" data-bs-target="#${safeId}-when">
                        <span><i class="bi bi-calendar-check me-2"></i>Most useful when</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="collapse" id="${safeId}-when">
                        <div class="solution-section-content">${whenUseful}</div>
                    </div>
                </div>`;
        }
        if (notBestFirst) {
            sections += `
                <div class="solution-section">
                    <div class="solution-section-header" data-bs-toggle="collapse" data-bs-target="#${safeId}-notfirst">
                        <span><i class="bi bi-exclamation-triangle me-2"></i>Usually not the best first move when</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="collapse" id="${safeId}-notfirst">
                        <div class="solution-section-content">${notBestFirst}</div>
                    </div>
                </div>`;
        }
        if (worksAlongside) {
            sections += `
                <div class="solution-section">
                    <div class="solution-section-header" data-bs-toggle="collapse" data-bs-target="#${safeId}-alongside">
                        <span><i class="bi bi-link-45deg me-2"></i>Often works best alongside</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="collapse" id="${safeId}-alongside">
                        <div class="solution-section-content">${worksAlongside}</div>
                    </div>
                </div>`;
        }

        // Difficulty and sensitivity badges
        const diffBadge = solution.deliveryDifficulty ? `<span class="badge bg-light text-dark border" style="font-size:0.65rem;">${solution.deliveryDifficulty}</span>` : '';
        const polBadge = solution.politicalSensitivity ? `<span class="badge bg-light text-dark border" style="font-size:0.65rem;">Pol: ${solution.politicalSensitivity}</span>` : '';

        return `
            <div class="solution-card ${cardClass}" data-solution-id="${solution.solutionId}" data-timeline="${solution.timeline}" data-political="${solution.politicalFeasibility || ''}" data-gap="${(solution.gap || '').toLowerCase()}">
                <div class="solution-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="solution-id">${solution.solutionId}</span>
                        ${isSelected ? '<span class="badge bg-success">' + _t.selected + '</span>' : ''}
                        ${isSkipped ? '<span class="badge bg-secondary">' + _t.skipped + '</span>' : ''}
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        ${diffBadge}${polBadge}
                        <span class="badge ${getTimelineBadgeClass(solution.timeline)}">${solution.timeline}</span>
                    </div>
                </div>
                <div class="solution-title">${solution.title}</div>
                <div class="solution-content">
                    ${sections}
                </div>
                <div class="solution-actions">
                    ${isSelected || isSkipped ? `
                        <button class="btn btn-sm btn-undo" onclick="undoSelection('${solution.solutionId}')">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>${_t.undo}
                        </button>
                    ` : `
                        <button class="btn btn-sm btn-skip" onclick="skipSolution('${solution.solutionId}')">
                            <i class="bi bi-x-lg me-1"></i>${_t.skip}
                        </button>
                        <button class="btn btn-sm btn-select" onclick="selectSolution('${solution.solutionId}')">
                            <i class="bi bi-check-lg me-1"></i>${_t.select}
                        </button>
                    `}
                </div>
            </div>
        `;
    }

    // Render a gap section
    function renderGapSection(streamName, gap, solutions) {
        const gapType = gap.type.toLowerCase();
        const gapId = `${streamName.replace(/\s+/g, '')}-${gapType}`;
        const selectedCount = solutions.filter(s => selections.selected.has(s.solutionId)).length;

        return `
            <div class="gap-section" data-gap-type="${gapType}">
                <div class="gap-header ${gapType}" data-bs-toggle="collapse" data-bs-target="#${gapId}-solutions">
                    <div class="gap-title">
                        <span class="gap-icon ${gapType}">
                            <i class="bi bi-${gapType === 'compliance' ? 'check-circle' : gapType === 'coverage' ? 'geo-alt' : 'currency-dollar'}"></i>
                        </span>
                        <span>${gap.type.toUpperCase()} ${_t.gap}</span>
                        <span class="badge ms-2" style="background-color: ${
                            gapType === 'compliance' ? '#F44336' :
                            gapType === 'coverage' ? '#FF9800' :
                            gapType === 'valuation' ? '#2196F3' : '#9C27B0'
                        }; color: #fff; font-size: 0.7rem;">#${gap.priority}</span>
                    </div>
                    <div class="gap-stats">
                        <span class="gap-amount">${formatCurrency(gap.amount)}</span>
                        <span class="solutions-count">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>${selectedCount} / ${solutions.length} ${_t.solutions}
                        </span>
                        <i class="bi bi-chevron-down collapse-icon"></i>
                    </div>
                </div>
                <div class="collapse show" id="${gapId}-solutions">
                    <div class="solutions-grid">
                        ${solutions.map(s => renderSolutionCard(s)).join('')}
                    </div>
                </div>
            </div>
        `;
    }

    // Render a stream section
    function renderStreamSection(stream) {
        const subgroupBadge = (stream.subgroup && typeof StreamClassification !== 'undefined')
            ? `<span class="badge ms-2" style="background-color:${StreamClassification.getSubgroupColor(stream.subgroup)}; font-size: 0.7rem;">${StreamClassification.getSubgroupShortLabel(stream.subgroup)}</span>`
            : '';
        let html = `
            <div class="stream-section" data-stream="${stream.name}" data-subgroup="${stream.subgroup || ''}">
                <div class="stream-header">
                    <h5><i class="bi bi-bar-chart-line me-2"></i>${stream.name}${subgroupBadge}</h5>
                    <span class="stream-rank">${_t.rank} #${stream.rank}</span>
                </div>
        `;

        stream.gaps.forEach(gap => {
            const solutions = SolutionsDatabase.getSolutionsByStreamAndGap(stream.name, gap.type, stream.subgroup);
            if (solutions.length > 0) {
                html += renderGapSection(stream.name, gap, solutions);
            }
        });

        html += '</div>';
        return html;
    }

    // Render all solutions
    function renderSolutions() {
        const container = document.getElementById('solutionsContainer');
        const streams = getPrioritizationData();

        if (streams.length === 0) {
            container.innerHTML = `
                <div class="no-solutions">
                    <i class="bi bi-inbox"></i>
                    <h5>No Prioritization Data Available</h5>
                    <p>Please complete the Prioritization step first to see available solutions.</p>
                </div>
            `;
            return;
        }

        // Populate stream filter
        const streamFilter = document.getElementById('filterStream');
        streamFilter.innerHTML = '<option value="all">All Streams</option>';
        streams.forEach(stream => {
            streamFilter.innerHTML += `<option value="${stream.name}">${stream.name}</option>`;
        });

        // Render all streams
        container.innerHTML = streams.map(s => renderStreamSection(s)).join('');

        // Update progress
        updateProgress();
        updateSummary();
    }

    // Select a solution
    window.selectSolution = function(solutionId) {
        selections.selected.add(solutionId);
        selections.skipped.delete(solutionId);
        saveSelections();
        updateCardState(solutionId);
        updateProgress();
        updateSummary();
        updateHiddenFields();
    };

    // Skip a solution
    window.skipSolution = function(solutionId) {
        selections.skipped.add(solutionId);
        selections.selected.delete(solutionId);
        saveSelections();
        updateCardState(solutionId);
        updateProgress();
        updateSummary();
        updateHiddenFields();
    };

    // Undo selection
    window.undoSelection = function(solutionId) {
        selections.selected.delete(solutionId);
        selections.skipped.delete(solutionId);
        saveSelections();
        updateCardState(solutionId);
        updateProgress();
        updateSummary();
        updateHiddenFields();
    };

    // Update card visual state
    function updateCardState(solutionId) {
        const card = document.querySelector(`[data-solution-id="${solutionId}"]`);
        if (!card) return;

        const solution = SolutionsDatabase.getSolutionById(solutionId);
        if (!solution) return;

        // Re-render the card
        const newCard = document.createElement('div');
        newCard.innerHTML = renderSolutionCard(solution);
        card.replaceWith(newCard.firstElementChild);
    }

    // Update progress stats
    function updateProgress() {
        const total = SolutionsDatabase.getAllSolutions().length;
        const reviewed = selections.selected.size + selections.skipped.size;

        document.getElementById('progressTotal').textContent = total;
        document.getElementById('progressReviewed').textContent = reviewed;
        document.getElementById('progressSelected').textContent = selections.selected.size;
        document.getElementById('progressSkipped').textContent = selections.skipped.size;
        document.getElementById('totalSelected').textContent = selections.selected.size;
    }

    // Update summary sidebar
    function updateSummary() {
        const summaryEl = document.getElementById('selectionSummary');
        const streams = getPrioritizationData();

        if (selections.selected.size === 0) {
            summaryEl.innerHTML = '<p class="text-muted small">@Localizer["NoSolutions"]</p>';
            return;
        }

        let html = '';
        streams.forEach(stream => {
            const streamSolutions = SolutionsDatabase.getSolutionsByStream(stream.name, stream.subgroup);
            const selectedInStream = streamSolutions.filter(s => selections.selected.has(s.solutionId));

            if (selectedInStream.length > 0) {
                html += `<div class="summary-stream">`;
                html += `<div class="summary-stream-name">${stream.name}</div>`;

                stream.gaps.forEach(gap => {
                    const gapSolutions = SolutionsDatabase.getSolutionsByStreamAndGap(stream.name, gap.type, stream.subgroup);
                    const selectedInGap = gapSolutions.filter(s => selections.selected.has(s.solutionId));
                    const gapColor = SolutionsDatabase.getGapColor(gap.type);

                    html += `
                        <div class="summary-gap">
                            <span><i class="bi bi-check-circle-fill" style="color: ${gapColor}"></i>${gap.type}:</span>
                            <span>${selectedInGap.length} of ${gapSolutions.length}</span>
                        </div>
                    `;
                });

                html += '</div>';
            }
        });

        summaryEl.innerHTML = html;
    }

    // Update hidden form fields
    function updateHiddenFields() {
        const container = document.getElementById('selectedSolutionsFields');
        container.innerHTML = '';

        let index = 0;
        selections.selected.forEach(solutionId => {
            const solution = SolutionsDatabase.getSolutionById(solutionId);
            if (solution) {
                container.innerHTML += `
                    <input type="hidden" name="SelectedSolutions[${index}].SolutionId" value="${solution.solutionId}" />
                    <input type="hidden" name="SelectedSolutions[${index}].Title" value="${solution.title}" />
                    <input type="hidden" name="SelectedSolutions[${index}].Timeline" value="${solution.timeline}" />
                `;
                index++;
            }
        });
    }

    // Apply filters
    // ----- Personalisation questionnaire state (filters the 82-card pool) -----
    // null while user hasn't applied; { time, political, focus[] } after Apply.
    let personalise = null;

    // Map various raw timeline strings into 3 buckets: 'quick' (<1y), 'medium' (1-3y), 'long' (3y+)
    function timelineBucket(t) {
        if (!t) return 'unknown';
        const s = String(t).toLowerCase();
        if (s.includes('less than a year') || s.includes('< 1') || s.includes('<1') || s.includes('6-12 month') || s.includes('6 month')) return 'quick';
        if (s.includes('1-2 year') || s.includes('1-3 year') || s.includes('1 year')) return 'medium';
        if (s.includes('2-4 year') || s.includes('3+') || s.includes('3 year')) return 'long';
        // Compound timelines like "Less than a year to launch; 1-3 years to deepen" → quick (the launch part)
        if (s.includes('less than a year')) return 'quick';
        return 'unknown';
    }

    // Map politicalFeasibility text → bucket: 'higher' / 'moderate' / 'sensitive'
    function politicalBucket(p) {
        if (!p) return 'unknown';
        const s = String(p).toLowerCase();
        if (s.includes('more sensitive') || s.includes('sensitive')) return 'sensitive';
        if (s.includes('moderate')) return 'moderate';
        if (s.includes('usually higher') || s.includes('higher')) return 'higher';
        return 'unknown';
    }

    function cardMatchesPersonalise(card) {
        if (!personalise) return true; // no questionnaire applied yet → show all
        const tBucket = timelineBucket(card.dataset.timeline);
        const pBucket = politicalBucket(card.dataset.political);
        const gap = (card.dataset.gap || '').toLowerCase();

        // Q1 — time horizon (multi-select). Empty list = no constraint.
        if (personalise.time && personalise.time.length > 0 && !personalise.time.includes(tBucket)) {
            // 'unknown' bucket cards are shown if any timeline bucket is selected (don't punish them)
            if (tBucket !== 'unknown') return false;
        }

        // Q2 — political feasibility (multi-select). Empty list = no constraint.
        if (personalise.political && personalise.political.length > 0 && !personalise.political.includes(pBucket)) {
            if (pBucket !== 'unknown') return false;
        }

        // Q3 — focus areas (gap types). Empty list = no constraint.
        if (personalise.focus && personalise.focus.length > 0 && !personalise.focus.includes(gap)) {
            return false;
        }

        return true;
    }

    function applyFilters() {
        const streamFilter = document.getElementById('filterStream').value;
        const gapFilter = document.getElementById('filterGap').value;
        const timelineFilter = document.getElementById('filterTimeline').value;

        // Filter solution cards (combined: existing dropdowns + personalise questionnaire)
        document.querySelectorAll('.solution-card').forEach(card => {
            const timeline = card.dataset.timeline;
            const matchesTimeline = timelineFilter === 'all' || timeline === timelineFilter;
            const matchesPersonalise = cardMatchesPersonalise(card);
            card.style.display = (matchesTimeline && matchesPersonalise) ? '' : 'none';
        });

        // Filter gap sections — also hide if no visible cards remain inside
        document.querySelectorAll('.gap-section').forEach(section => {
            const gapType = section.dataset.gapType;
            const matchesGap = gapFilter === 'all' || gapType === gapFilter;
            const visibleCards = section.querySelectorAll('.solution-card:not([style*="display: none"])').length;
            section.style.display = (matchesGap && visibleCards > 0) ? '' : 'none';
        });

        // Filter stream sections — also hide if no visible gap sections
        document.querySelectorAll('.stream-section').forEach(section => {
            const streamName = section.dataset.stream;
            const matchesStream = streamFilter === 'all' || streamName === streamFilter;
            const visibleGaps = section.querySelectorAll('.gap-section:not([style*="display: none"])').length;
            section.style.display = (matchesStream && visibleGaps > 0) ? '' : 'none';
        });

        updatePersonaliseMatchCount();
    }

    function updatePersonaliseMatchCount() {
        const el = document.getElementById('personaliseMatchCount');
        if (!el) return;
        const visible = document.querySelectorAll('.solution-card:not([style*="display: none"])').length;
        el.textContent = visible;
    }

    // Read the questionnaire form into the `personalise` state (all three are multi-select arrays)
    function readPersonaliseForm() {
        const time      = Array.from(document.querySelectorAll('input[name="qTime"]:checked')).map(i => i.value);
        const political = Array.from(document.querySelectorAll('input[name="qPolitical"]:checked')).map(i => i.value);
        const focus     = Array.from(document.querySelectorAll('input[name="qFocus"]:checked')).map(i => i.value);
        return { time, political, focus };
    }

    // Render the chip-strip when banner is collapsed
    function renderPersonaliseChips() {
        const list = document.getElementById('personaliseChipList');
        if (!list || !personalise) return;
        const chips = [];

        const timeLabels = { quick: 'Quick wins', medium: 'Medium-term', long: 'Long-term' };
        const polLabels  = { higher: 'Higher feasibility', moderate: 'Moderate', sensitive: 'Lower feasibility' };
        const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);

        // Q1 — time
        if (personalise.time.length === 0) {
            chips.push(`<span class="personalise-chip text-warning"><i class="bi bi-exclamation-triangle"></i>No timeline selected</span>`);
        } else if (personalise.time.length === 3) {
            chips.push(`<span class="personalise-chip"><i class="bi bi-clock"></i>Any timeline</span>`);
        } else {
            chips.push(`<span class="personalise-chip"><i class="bi bi-clock"></i>${personalise.time.map(t => timeLabels[t]).join(' · ')}</span>`);
        }

        // Q2 — political
        if (personalise.political.length === 0) {
            chips.push(`<span class="personalise-chip text-warning"><i class="bi bi-exclamation-triangle"></i>No feasibility selected</span>`);
        } else if (personalise.political.length === 3) {
            chips.push(`<span class="personalise-chip"><i class="bi bi-shield"></i>Any feasibility</span>`);
        } else {
            chips.push(`<span class="personalise-chip"><i class="bi bi-shield"></i>${personalise.political.map(p => polLabels[p]).join(' · ')}</span>`);
        }

        // Q3 — focus
        if (personalise.focus.length === 0) {
            chips.push(`<span class="personalise-chip text-warning"><i class="bi bi-exclamation-triangle"></i>No gap types selected</span>`);
        } else if (personalise.focus.length === 4) {
            chips.push(`<span class="personalise-chip"><i class="bi bi-bullseye"></i>All gap types</span>`);
        } else {
            chips.push(`<span class="personalise-chip"><i class="bi bi-bullseye"></i>${personalise.focus.map(cap).join(' · ')}</span>`);
        }

        list.innerHTML = chips.join('');
    }

    // Reveal the cards section after the user submits or skips the questionnaire
    function revealCardsSection() {
        const wrap = document.getElementById('overviewCardsSection');
        if (wrap && wrap.style.display === 'none') {
            wrap.style.display = '';
            // Smooth scroll the user to the now-visible filter panel
            setTimeout(() => wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
        }
    }

    function showPersonaliseChips() {
        document.getElementById('personaliseForm').style.display = 'none';
        document.getElementById('personaliseChips').style.display = '';
        renderPersonaliseChips();
    }

    function showPersonaliseForm() {
        document.getElementById('personaliseChips').style.display = 'none';
        document.getElementById('personaliseForm').style.display = '';
    }

    // Select all quick wins
    function selectAllQuickWins() {
        const quickWins = SolutionsDatabase.getAllSolutions().filter(s => s.timeline === '<1 year');
        quickWins.forEach(s => {
            selections.selected.add(s.solutionId);
            selections.skipped.delete(s.solutionId);
        });
        saveSelections();
        renderSolutions();
    }

    // Clear all selections
    function clearAllSelections() {
        if (confirm('Are you sure you want to clear all selections?')) {
            selections.selected.clear();
            selections.skipped.clear();
            saveSelections();
            renderSolutions();
        }
    }

    // Expand all cards
    function expandAllCards() {
        document.querySelectorAll('.solution-content .collapse').forEach(el => {
            bootstrap.Collapse.getOrCreateInstance(el).show();
        });
    }

    // Collapse all cards
    function collapseAllCards() {
        document.querySelectorAll('.solution-content .collapse').forEach(el => {
            bootstrap.Collapse.getOrCreateInstance(el).hide();
        });
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        // Wait for SolutionsDatabase to be available
        if (typeof SolutionsDatabase === 'undefined') {
            console.error('SolutionsDatabase not loaded');
            return;
        }

        // Get initial currency from AppContext
        currencySymbol = getCurrencyFromContext();
        console.log('OverviewSelection: Initial currency symbol:', currencySymbol);

        loadSelections();
        renderSolutions();

        // Filter event listeners
        document.getElementById('filterStream').addEventListener('change', applyFilters);
        document.getElementById('filterGap').addEventListener('change', applyFilters);
        document.getElementById('filterTimeline').addEventListener('change', applyFilters);

        // Personalisation banner — Apply / Skip / Edit / Clear
        var applyBtn = document.getElementById('personaliseApplyBtn');
        if (applyBtn) {
            applyBtn.addEventListener('click', function () {
                personalise = readPersonaliseForm();
                showPersonaliseChips();
                revealCardsSection();
                applyFilters();
            });
        }
        var skipBtn = document.getElementById('personaliseSkipBtn');
        if (skipBtn) {
            skipBtn.addEventListener('click', function () {
                personalise = null;
                showPersonaliseChips();
                document.getElementById('personaliseChipList').innerHTML =
                    '<span class="personalise-chip"><i class="bi bi-eye"></i>Showing all 82 cards</span>';
                revealCardsSection();
                applyFilters();
            });
        }
        var editBtn = document.getElementById('personaliseEditBtn');
        if (editBtn) editBtn.addEventListener('click', showPersonaliseForm);

        var clearBtn = document.getElementById('personaliseClearBtn');
        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                personalise = null;
                applyFilters();
                document.getElementById('personaliseChipList').innerHTML =
                    '<span class="personalise-chip"><i class="bi bi-eye"></i>Showing all 82 cards</span>';
            });
        }

        // Quick action buttons
        document.getElementById('selectAllQuickWins').addEventListener('click', selectAllQuickWins);
        document.getElementById('clearSelections').addEventListener('click', clearAllSelections);
        document.getElementById('expandAllBtn').addEventListener('click', expandAllCards);
        document.getElementById('collapseAllBtn').addEventListener('click', collapseAllCards);

        // Subscribe to RosraStateManager updates
        if (typeof RosraStateManager !== 'undefined') {
            RosraStateManager.subscribe('streams', function() {
                renderSolutions();
            });
        }

        // Subscribe to currency changes from AppContext for reactive updates
        if (typeof AppContext !== 'undefined') {
            AppContext.subscribe('currencySymbol', function(newSymbol) {
                console.log('OverviewSelection: Currency changed to', newSymbol);
                currencySymbol = newSymbol || '$';
                renderSolutions();
            });
        }
    });
})();
</script>
