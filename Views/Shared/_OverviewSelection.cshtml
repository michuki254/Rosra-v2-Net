@model RosraApp.Models.ViewModels.RosraFormViewModel

<div class="overview-selection-module">
    <!-- Page Header -->
    <div class="module-header mb-4">
        <h4 class="mb-2">
            <i class="bi bi-clipboard-check me-2"></i>
            @Localizer["Title"]
        </h4>
        <p class="text-muted mb-0">
            @Localizer["Subtitle"]
        </p>
    </div>

    <!-- Personalisation Questionnaire (3 questions to narrow the 82 cards) -->
    <div class="card mb-3 personalise-card" id="personaliseCard">
        <!-- OPEN STATE: full questionnaire form -->
        <div id="personaliseForm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0">
                    <i class="bi bi-magic me-2"></i>
                    Personalise these recommendations
                </h6>
                <small class="opacity-90">3 quick questions to narrow the 82 cards to ones that fit your context — or skip and browse all.</small>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Q1: Time horizon (multi-select chips) -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <span class="q-num">1</span> How fast do you need results?
                        </label>
                        <div class="q-chips" data-question="time">
                            <label class="q-chip"><input type="checkbox" name="qTime" value="quick" checked><span>Quick wins<small class="d-block opacity-75">under a year</small></span></label>
                            <label class="q-chip"><input type="checkbox" name="qTime" value="medium" checked><span>Medium-term<small class="d-block opacity-75">1–3 years</small></span></label>
                            <label class="q-chip"><input type="checkbox" name="qTime" value="long" checked><span>Long-term<small class="d-block opacity-75">3+ years</small></span></label>
                        </div>
                        <small class="text-muted d-block mt-1">Pick one or more — leaving all checked shows every timeline.</small>
                    </div>

                    <!-- Q2: Political feasibility (multi-select chips) -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <span class="q-num">2</span> Which political feasibility are you open to?
                        </label>
                        <div class="q-chips" data-question="political">
                            <label class="q-chip"><input type="checkbox" name="qPolitical" value="higher" checked><span>Higher feasibility<small class="d-block opacity-75">low political cost</small></span></label>
                            <label class="q-chip"><input type="checkbox" name="qPolitical" value="moderate" checked><span>Moderate<small class="d-block opacity-75">some political cost</small></span></label>
                            <label class="q-chip"><input type="checkbox" name="qPolitical" value="sensitive"><span>Lower feasibility<small class="d-block opacity-75">high political cost</small></span></label>
                        </div>
                        <small class="text-muted d-block mt-1">Pick one or more — defaults skip the most politically risky cards.</small>
                    </div>

                    <!-- Q3: Focus areas (multi-select chips) -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <span class="q-num">3</span> Where do you most want to improve?
                        </label>
                        <div class="q-chips" data-question="focus" id="qFocusChips">
                            <label class="q-chip"><input type="checkbox" name="qFocus" value="compliance" checked><span>Compliance</span></label>
                            <label class="q-chip"><input type="checkbox" name="qFocus" value="coverage" checked><span>Coverage</span></label>
                            <label class="q-chip"><input type="checkbox" name="qFocus" value="valuation" checked><span>Valuation</span></label>
                            <label class="q-chip"><input type="checkbox" name="qFocus" value="liability" checked><span>Liability</span></label>
                        </div>
                        <small class="text-muted d-block mt-1">Pre-checked from your Step&nbsp;2 priorities — uncheck any you don't want to focus on.</small>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2 bg-white">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    You can edit answers later or browse all 82 cards at any time.
                </small>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="personaliseSkipBtn">
                        Skip — show all
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="personaliseApplyBtn">
                        <i class="bi bi-check-circle me-1"></i>Apply &amp; narrow down
                    </button>
                </div>
            </div>
        </div>

        <!-- COLLAPSED STATE: chip strip showing active filters -->
        <div id="personaliseChips" class="card-body py-3" style="display:none;">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="fw-semibold me-1"><i class="bi bi-funnel-fill text-primary me-1"></i>Showing cards matching:</span>
                <div id="personaliseChipList" class="d-flex flex-wrap gap-1"></div>
                <span class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-link btn-sm p-0 personalise-edit" id="personaliseEditBtn">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </button>
                    <button type="button" class="btn btn-link btn-sm p-0 personalise-clear text-muted" id="personaliseClearBtn">
                        <i class="bi bi-x-circle me-1"></i>Show all 82
                    </button>
                </span>
            </div>
            <div class="mt-2 small text-muted">
                <i class="bi bi-card-checklist me-1"></i>
                <span id="personaliseMatchCount">—</span> of 82 solution cards match.
            </div>
        </div>
    </div>

    <!-- Cards section is hidden until the user applies (or skips) the personalisation questionnaire above. -->
    <div id="overviewCardsSection" style="display:none;">

    <!-- Filter/Navigation Panel -->
    <div class="filter-panel card mb-4">
        <div class="card-body py-3">
            <div class="row align-items-center g-3">
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Localizer["FilterStream"]</label>
                    <select class="form-select form-select-sm" id="filterStream">
                        <option value="all">@Localizer["AllStreams"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Localizer["FilterGap"]</label>
                    <select class="form-select form-select-sm" id="filterGap">
                        <option value="all">@Localizer["AllGaps"]</option>
                        <option value="compliance">@Localizer["Compliance"]</option>
                        <option value="coverage">@Localizer["Coverage"]</option>
                        <option value="valuation">@Localizer["Valuation"]</option>
                        <option value="liability">@Localizer["Liability"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Localizer["Timeline"]</label>
                    <select class="form-select form-select-sm" id="filterTimeline">
                        <option value="all">@Localizer["AllTimelines"]</option>
                        <option value="<1 year">@Localizer["QuickWins"]</option>
                        <option value="1-3 years">@Localizer["MediumTerm"]</option>
                        <option value="3+ years">@Localizer["LongTerm"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Localizer["Progress"]</label>
                    <div class="progress-stats">
                        <span id="progressReviewed">0</span>/<span id="progressTotal">0</span> reviewed |
                        <span class="text-success"><span id="progressSelected">0</span> selected</span> |
                        <span class="text-muted"><span id="progressSkipped">0</span> skipped</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Content Area -->
        <div class="col-lg-9">
            <div id="solutionsContainer">
                <!-- Solutions will be rendered here by JavaScript -->
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">@Localizer["Loading"]</p>
                </div>
            </div>
        </div>

        <!-- Summary Sidebar -->
        <div class="col-lg-3">
            <div class="summary-sidebar sticky-top" style="top: 100px;">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0">
                            <i class="bi bi-list-check me-2"></i>@Localizer["SelectionSummary"]
                        </h6>
                    </div>
                    <div class="card-body" id="selectionSummary">
                        <p class="text-muted small">@Localizer["NoSolutions"]</p>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold">@Localizer["TotalSelected"]</span>
                            <span class="badge bg-success fs-6" id="totalSelected">0</span>
                        </div>
                        <button class="btn btn-outline-primary btn-sm w-100 mb-2" id="expandAllBtn">
                            <i class="bi bi-arrows-expand me-1"></i>@Localizer["ExpandAll"]
                        </button>
                        <button class="btn btn-outline-secondary btn-sm w-100" id="collapseAllBtn">
                            <i class="bi bi-arrows-collapse me-1"></i>@Localizer["CollapseAll"]
                        </button>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-lightning me-2"></i>@Localizer["QuickActions"]</h6>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-outline-success btn-sm w-100 mb-2" id="selectAllQuickWins">
                            <i class="bi bi-check-all me-1"></i>@Localizer["SelectAllQuickWins"]
                        </button>
                        <button class="btn btn-outline-warning btn-sm w-100 mb-2" id="clearSelections">
                            <i class="bi bi-x-circle me-1"></i>@Localizer["ClearAll"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div><!-- /#overviewCardsSection -->

    <!-- Hidden fields for form submission -->
    <div id="selectedSolutionsFields"></div>
</div>

<style>
    /* =========================================================
       Personalise questionnaire (3-question filter for the 82 cards)
       ========================================================= */
    .overview-selection-module .personalise-card { border: 1px solid #BDE3F0; }
    .overview-selection-module .q-num {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        background: #00B2E3; color: #fff; font-size: 0.75rem; font-weight: 700;
        margin-right: 0.4rem;
    }
    .overview-selection-module .q-options {
        display: flex; flex-direction: column; gap: 0.4rem;
    }
    .overview-selection-module .q-option {
        position: relative; cursor: pointer; user-select: none;
        background: #F8FAFC; border: 1px solid #E6EDF3; border-radius: 8px;
        padding: 0.55rem 0.75rem;
        transition: background 0.15s, border-color 0.15s;
    }
    .overview-selection-module .q-option:hover { background: #F0F9FC; border-color: #BDE3F0; }
    .overview-selection-module .q-option input[type="radio"] {
        position: absolute; opacity: 0; pointer-events: none;
    }
    .overview-selection-module .q-option span {
        display: flex; flex-direction: column; line-height: 1.25;
    }
    .overview-selection-module .q-option strong { font-size: 0.88rem; color: #1f2937; }
    .overview-selection-module .q-option small { font-size: 0.72rem; color: #64748b; }
    .overview-selection-module .q-option input[type="radio"]:checked + span strong { color: #00689D; }
    .overview-selection-module .q-option:has(input[type="radio"]:checked) {
        background: #E6F6FB; border-color: #00B2E3;
        box-shadow: 0 0 0 2px rgba(0, 178, 227, 0.15);
    }

    .overview-selection-module .q-chips {
        display: flex; flex-wrap: wrap; gap: 0.35rem;
    }
    .overview-selection-module .q-chip {
        position: relative; cursor: pointer; user-select: none;
        background: #F8FAFC; border: 1px solid #E6EDF3; border-radius: 999px;
        padding: 0.4rem 0.85rem; font-size: 0.82rem; font-weight: 600; color: #475569;
        transition: all 0.15s;
    }
    .overview-selection-module .q-chip input[type="checkbox"] {
        position: absolute; opacity: 0; pointer-events: none;
    }
    .overview-selection-module .q-chip:hover { background: #F0F9FC; border-color: #BDE3F0; color: #00689D; }
    .overview-selection-module .q-chip:has(input[type="checkbox"]:checked) {
        background: #00B2E3; border-color: #00B2E3; color: #ffffff;
    }

    .overview-selection-module .personalise-chip {
        display: inline-flex; align-items: center; gap: 0.3rem;
        background: #E6F6FB; color: #00689D; border: 1px solid #BDE3F0;
        border-radius: 999px; padding: 0.18rem 0.6rem;
        font-size: 0.76rem; font-weight: 600;
    }
    .overview-selection-module .personalise-chip i { font-size: 0.7rem; }

    /* ============================================
       UN-Habitat Design System - Overview Selection Module
       ============================================ */

    .overview-selection-module {
        /* UN-Habitat Brand Colors */
        --un-blue: #00b2e3;
        --un-blue-light: #4dc9ed;
        --un-blue-dark: #0095c0;
        --un-dark-blue: #00689D;
        --un-dark-blue-light: #0080bf;
        --un-orange: #FD9D24;
        --un-orange-dark: #E8891A;
        --un-orange-light: #FFB54D;

        /* Gap Colors - UN-Habitat Branded */
        --gap-compliance: #dc3545;
        --gap-compliance-light: #e85c6a;
        --gap-coverage: var(--un-orange);
        --gap-coverage-light: var(--un-orange-light);
        --gap-valuation: var(--un-blue);
        --gap-valuation-light: var(--un-blue-light);
        --gap-liability: var(--un-blue);
        --gap-liability-light: var(--un-blue-light);

        /* Semantic Colors */
        --success-color: #10b981;
        --success-light: #d1fae5;
        --warning-color: #f59e0b;
        --warning-light: #fef3c7;
        --danger-color: #ef4444;
        --danger-light: #fee2e2;

        /* Design Tokens */
        --card-radius: 12px;
        --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        --card-shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.12);
        --transition-fast: 0.2s ease;
        --transition-normal: 0.3s ease;

        min-height: 600px;
    }

    /* Module Header */
    .overview-selection-module .module-header {
        border-bottom: 2px solid var(--un-blue);
        padding-bottom: 0.6rem;
        margin-bottom: 0.9rem;
    }

    .overview-selection-module .module-header h4 {
        color: var(--un-blue);
        font-weight: 700;
        font-size: 1.15rem;
        margin-bottom: 0.25rem !important;
    }

    .overview-selection-module .module-header h4 i {
        color: var(--un-orange);
    }

    .overview-selection-module .module-header p {
        font-size: 0.85rem;
    }

    /* Filter Panel */
    .overview-selection-module .filter-panel {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
    }

    .overview-selection-module .filter-panel .form-select {
        border-radius: 8px;
        border: 1px solid #ced4da;
        transition: var(--transition-fast);
    }

    .overview-selection-module .filter-panel .form-select:focus {
        border-color: var(--un-blue);
        box-shadow: 0 0 0 0.2rem rgba(0, 104, 157, 0.15);
    }

    .overview-selection-module .progress-stats {
        font-size: 0.78rem;
        font-weight: 600;
        color: #495057;
    }

    .overview-selection-module .filter-panel .card-body {
        padding: 0.5rem 0.9rem !important;
    }

    .overview-selection-module .filter-panel .form-label {
        font-size: 0.72rem;
        margin-bottom: 0.15rem !important;
    }

    .overview-selection-module .filter-panel .form-select {
        font-size: 0.82rem;
        padding: 0.3rem 0.6rem;
    }

    .overview-selection-module .filter-panel {
        margin-bottom: 1rem !important;
    }

    .overview-selection-module .progress-stats .text-success {
        color: var(--success-color) !important;
    }

    /* Stream Section Styles */
    .overview-selection-module .stream-section {
        margin-bottom: 1rem;
        border: none;
        border-radius: var(--card-radius);
        overflow: hidden;
        box-shadow: var(--card-shadow);
        transition: var(--transition-normal);
    }

    .overview-selection-module .stream-section:hover {
        box-shadow: var(--card-shadow-hover);
    }

    .overview-selection-module .stream-header {
        background: var(--un-blue);
        color: white;
        padding: 0.55rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .overview-selection-module .stream-header h5 {
        margin: 0;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .overview-selection-module .stream-header h5 i {
        color: var(--un-orange);
    }

    .overview-selection-module .stream-rank {
        background: var(--un-orange) 100%);
        padding: 0.2rem 0.7rem;
        border-radius: 14px;
        font-size: 0.75rem;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    /* Gap Section Styles */
    .overview-selection-module .gap-section {
        border-bottom: 1px solid #e9ecef;
    }

    .overview-selection-module .gap-section:last-child {
        border-bottom: none;
    }

    .overview-selection-module .gap-header {
        padding: 0.55rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: var(--transition-fast);
        background: white;
        font-size: 0.9rem;
    }

    .overview-selection-module .gap-header:hover {
        background: #f8f9fa;
    }

    .overview-selection-module .gap-header.compliance {
        border-left: 5px solid var(--gap-compliance);
    }
    .overview-selection-module .gap-header.coverage {
        border-left: 5px solid var(--gap-coverage);
    }
    .overview-selection-module .gap-header.valuation {
        border-left: 5px solid var(--gap-valuation);
    }
    .overview-selection-module .gap-header.liability {
        border-left: 5px solid var(--gap-liability);
    }

    .overview-selection-module .gap-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        color: #2d3748;
    }

    .overview-selection-module .gap-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.72rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .overview-selection-module .gap-icon.compliance {
        background: var(--gap-compliance);
    }
    .overview-selection-module .gap-icon.coverage {
        background: var(--gap-coverage);
    }
    .overview-selection-module .gap-icon.valuation {
        background: var(--gap-valuation);
    }
    .overview-selection-module .gap-icon.liability {
        background: var(--gap-liability);
    }

    .overview-selection-module .gap-title .badge {
        background: var(--un-orange) 100%) !important;
        color: white !important;
        font-weight: 600;
    }

    .overview-selection-module .gap-stats {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.78rem;
    }

    .overview-selection-module .gap-amount {
        color: var(--un-blue);
        font-weight: 600;
    }

    .overview-selection-module .solutions-count {
        background: #e9ecef;
        padding: 0.22rem 0.6rem;
        border-radius: 14px;
        font-weight: 600;
        color: #495057;
        font-size: 0.75rem;
    }

    .overview-selection-module .solutions-count .text-success {
        color: var(--success-color) !important;
    }

    /* Solutions Container */
    .overview-selection-module .solutions-grid {
        padding: 0.7rem 0.9rem;
        background: #fafbfc;
    }

    /* Solution Card Styles */
    .overview-selection-module .solution-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: 0.55rem;
        transition: var(--transition-normal);
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        font-size: 0.85rem;
    }

    .overview-selection-module .solution-card:hover {
        box-shadow: var(--card-shadow-hover);
        transform: translateY(-2px);
    }

    .overview-selection-module .solution-card.selected {
        border-color: var(--success-color);
        border-width: 2px;
        background: #f0fdf4;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }

    .overview-selection-module .solution-card.skipped {
        opacity: 0.7;
        border-color: #9ca3af;
        background: #f9fafb;
    }

    .overview-selection-module .solution-card-header {
        padding: 0.5rem 0.85rem;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: #ffffff;
    }

    .overview-selection-module .solution-id {
        font-family: 'Roboto Mono', monospace;
        font-size: 0.8rem;
        color: var(--un-blue);
        background: #e0f2fe;
        padding: 0.25rem 0.625rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .overview-selection-module .solution-card-header .badge.bg-success {
        background: var(--success-color) !important;
        font-weight: 600;
    }

    .overview-selection-module .solution-card-header .badge.bg-secondary {
        background: #6b7280 !important;
    }

    .overview-selection-module .timeline-badge {
        font-size: 0.75rem;
        padding: 0.3rem 0.65rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .overview-selection-module .timeline-badge.quick {
        background: var(--success-color) !important;
        color: white !important;
    }
    .overview-selection-module .timeline-badge.medium {
        background: var(--warning-color) !important;
        color: white !important;
    }
    .overview-selection-module .timeline-badge.long {
        background: var(--un-orange) 100%) !important;
        color: white !important;
    }

    .overview-selection-module .solution-title {
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid #e9ecef;
        background: #f8fafc;
        color: #1e293b;
    }

    .overview-selection-module .solution-content {
        padding: 0;
    }

    .overview-selection-module .solution-section {
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid #f0f0f0;
    }

    .overview-selection-module .solution-section:last-child {
        border-bottom: none;
    }

    .overview-selection-module .solution-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
        transition: var(--transition-fast);
    }

    .overview-selection-module .solution-section-header:hover {
        color: var(--un-blue);
    }

    .overview-selection-module .solution-section-header i.bi-lightbulb,
    .overview-selection-module .solution-section-header i.bi-gear,
    .overview-selection-module .solution-section-header i.bi-calendar-check,
    .overview-selection-module .solution-section-header i.bi-check2-square {
        color: var(--un-orange);
    }

    .overview-selection-module .solution-section-content {
        margin-top: 0.625rem;
