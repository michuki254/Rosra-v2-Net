                    <h4><i class="fas fa-stream me-2"></i> @Localizer["Timeline_Title"]</h4>
                    <p>@Localizer["Timeline_Description"]</p>
                </div>
                <div class="timeline-content" id="timelineContent"></div>
            </div>
        </div>

        <!-- Progress Tracker View -->
        <div class="view-panel" id="progressView" style="display: none;">
            <div class="progress-tracker-container">
                <div class="progress-header">
                    <h4><i class="fas fa-tasks me-2"></i> @Localizer["Progress_Title"]</h4>
                    <p>@Localizer["Progress_Description"]</p>
                    <div class="progress-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="RecommendationsModule.resetAllProgress()">
                            <i class="fas fa-undo me-1"></i> @Localizer["Progress_ResetAll"]
                        </button>
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-download me-1"></i> @Localizer["Progress_ExportProgress"]
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" onclick="event.preventDefault(); RecommendationsModule.exportProgress('csv');"><i class="fas fa-file-csv me-2"></i>CSV (.csv)</a></li>
                                <li><a class="dropdown-item" href="#" onclick="event.preventDefault(); RecommendationsModule.exportProgress('excel');"><i class="fas fa-file-excel me-2"></i>Excel (.xls)</a></li>
                            </ul>
