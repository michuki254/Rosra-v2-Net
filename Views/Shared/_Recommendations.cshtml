<!-- Report Generation Modal -->
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="report-modal-icon">
                    <i class="fas fa-file-pdf"></i>
                </div>
                <div class="report-modal-titles">
                    <h5 class="modal-title" id="reportModalLabel">@Localizer["Modal_Title"]</h5>
                    <p class="modal-subtitle">@Localizer["Modal_Subtitle"]</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @* The report is now a fixed 4-section package — Quick OSR Estimate,
                   Stream Gap Analysis, Prioritization, and Recommendations summary.
                   The old per-section checkboxes were removed; the hidden inputs
                   below stay so the existing generateReport() JS contract reads
                   the same `include*` flags it always did. *@
                <div class="report-section-head">
                    <div>
                        <h6>@Localizer["Modal_IncludeInReport"]</h6>
                        <p class="report-section-help">@Localizer["Modal_IncludeHelp"]</p>
                    </div>
                </div>

                <div class="report-includes-list">
                    <span class="report-includes-pill"><i class="fas fa-clipboard-list"></i> @Localizer["Modal_QuickAnalysis"]</span>
                    <span class="report-includes-pill"><i class="fas fa-magnifying-glass-chart"></i> @Localizer["Modal_GapAnalysisSummary"]</span>
                    <span class="report-includes-pill"><i class="fas fa-list-ol"></i> @Localizer["Modal_Prioritization"]</span>
                    <span class="report-includes-pill"><i class="fas fa-check-double"></i> @Localizer["Modal_RecommendationsSummary"]</span>
                </div>

                @* Hidden flags drive the existing generateReport() include-section
                   logic. All four user-facing sections are always on; the leftover
                   legacy flags stay off (we never reintroduced Timeline / Progress
                   Tracker / Resources / Skipped lists in the editorial report). *@
                <div class="d-none" aria-hidden="true">
                    <input type="checkbox" id="includeExecSummary" checked>
                    <input type="checkbox" id="includeGapAnalysis" checked>
                    <input type="checkbox" id="includeStreamPrioritization" checked>
                    <input type="checkbox" id="includeGapSequencing" checked>
                    <input type="checkbox" id="includeSelectedSolutions" checked>
                    <input type="checkbox" id="includeSkippedSolutions">
                    <input type="checkbox" id="includeTimeline">
                    <input type="checkbox" id="includeProgressTracker">
                    <input type="checkbox" id="includeResources">
                </div>

                <div class="report-format mt-4">
                    <h6>@Localizer["Modal_FormatLabel"]</h6>
                    <div class="report-format-toggle" role="radiogroup" aria-label="Output format">
                        <input type="radio" name="reportFormatRadio" id="reportFormatPdf" value="pdf" checked>
                        <label for="reportFormatPdf"><i class="fas fa-file-pdf"></i> @Localizer["Modal_FormatPdf"]</label>
                        <input type="radio" name="reportFormatRadio" id="reportFormatHtml" value="html">
                        <label for="reportFormatHtml"><i class="fas fa-code"></i> @Localizer["Modal_FormatHtml"]</label>
                    </div>
                    @* Hidden select preserves the existing reportFormat.value contract used by RecommendationsModule.generateReport(). *@
                    <select id="reportFormat" hidden aria-hidden="true">
                        <option value="pdf" selected>@Localizer["Modal_FormatPdf"]</option>
                        <option value="html">@Localizer["Modal_FormatHtml"]</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">@Localizer["Modal_Cancel"]</button>
                <button type="button" class="btn btn-generate" onclick="RecommendationsModule.generateReport()">
                    <i class="fas fa-download me-2"></i>@Localizer["Modal_Generate"]
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var modal = document.getElementById('reportModal');
        if (!modal) return;

        // Mirror the segmented PDF/HTML control into the hidden <select id="reportFormat">.
        modal.querySelectorAll('input[name="reportFormatRadio"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                if (radio.checked) document.getElementById('reportFormat').value = radio.value;
            });
        });

        // Section checkboxes were removed — the report is now a fixed 4-section
        // package and the hidden include* flags above default to checked. No
        // bulk-toggle wiring needed.
    })();
</script>


<!-- Solutions Data Modules (must load before solutionsDatabase.js) -->
<script src="~/js/solutionsData-PT-Compliance.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-PT-Coverage.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-PT-Valuation.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-NP-A.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-NP-B.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-NP-C.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-BL.js" asp-append-version="true"></script>
<script src="~/js/solutionsData-Generic.js" asp-append-version="true"></script>
<script src="~/js/streamClassification.js" asp-append-version="true"></script>
<!-- Core Solutions Database API -->
<script src="~/js/solutionsDatabase.js" asp-append-version="true"></script>
<!-- Full Solutions Database (detailed solution information) -->
<script src="~/js/solutionsFullDatabase.js" asp-append-version="true"></script>
<!-- html2pdf (jsPDF + html2canvas) — self-hosted to avoid CDN/CSP ambiguity -->
<script src="~/lib/html2pdf/html2pdf.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/recommendationsModule.js" asp-append-version="true"></script>

<script>
    // ============================================================================
    // Personalisation chip filter (replaces the old Overview Selection step).
    //
    // Two responsibilities, both run after RecommendationsModule.init() has loaded:
    //   1) AUTO-SELECT — if the user has no manual selection in
    //      rosraSelectedSolutions, derive a default selection from the streams
    //      and gap types they prioritized (RosraStateManager.getStreams). This
    //      replaces the manual "browse 82 and check the ones you want" step.
    //   2) LIVE CHIP FILTER — three chip groups (Time / Risk / Focus) refine
    //      the visible cards via a DOM walk; state persists in
    //      localStorage['rosraOverviewSelections'] (same key the old step used)
    //      so saved reports keep working.
    // ============================================================================
    (function () {
        'use strict';
        var STORAGE_KEY = 'rosraOverviewSelections';
        var SELECTED_KEY = 'rosraSelectedSolutions';

        function timelineBucket(t) {
            if (!t) return 'unknown';
            var s = String(t).toLowerCase();
            if (s.indexOf('less than a year') >= 0 || s.indexOf('< 1') >= 0 || s.indexOf('<1') >= 0
                || s.indexOf('6-12 month') >= 0 || s.indexOf('6 month') >= 0) return 'quick';
            if (s.indexOf('1-2 year') >= 0 || s.indexOf('1-3 year') >= 0 || s.indexOf('1 year') >= 0) return 'medium';
            if (s.indexOf('2-4 year') >= 0 || s.indexOf('3+') >= 0 || s.indexOf('3 year') >= 0) return 'long';
            return 'unknown';
        }
        function politicalBucket(p) {
            if (!p) return 'unknown';
            var s = String(p).toLowerCase();
            if (s.indexOf('more sensitive') >= 0 || s.indexOf('sensitive') >= 0) return 'sensitive';
            if (s.indexOf('moderate') >= 0) return 'moderate';
            if (s.indexOf('usually higher') >= 0 || s.indexOf('higher') >= 0 || s.indexOf('low political') >= 0) return 'higher';
            return 'unknown';
        }

        // Build a per-included-stream meta record from Prioritization output.
        // Returns Map<canonicalKey, { displayName, rank, subgroup, gaps:Set<lowercase> }>
        // where canonicalKey is the user-facing stream name (the key we match cards by).
        // Business License and any generic A/B/C stream also gets indexed by its
        // subgroup so non-property DB cards (which carry stream="Non-Property") can
        // be routed back to the user's actual stream rather than being dropped.
        function includedStreamMeta() {
            var out = { byName: new Map(), bySubgroup: new Map() };
            if (typeof RosraStateManager === 'undefined') return out;
            var streams = (typeof RosraStateManager.getStreamsByGapRanking === 'function')
                ? RosraStateManager.getStreamsByGapRanking()
                : RosraStateManager.getStreams() || [];
            streams.forEach(function (s, idx) {
                if (s.included === false) return;
                var gaps = new Set();
                if ((s.complianceGap || 0) > 0) gaps.add('compliance');
                if ((s.coverageGap || 0) > 0) gaps.add('coverage');
                if ((s.valuationGap || 0) > 0) gaps.add('valuation');
                if ((s.liabilityGap || 0) > 0) gaps.add('liability');
                if ((s.mixedGapCompliance || s.mixedGapReg || 0) > 0) gaps.add('compliance');
                if ((s.mixedGapCoverage || s.mixedGapUnreg || 0) > 0) gaps.add('coverage');

                // Business License is the historical alias for non-property subgroup A —
                // even though state stores subgroup=null on it, the DB serves its cards
                // under stream="Non-Property" subgroup="A".
                var subgroup = s.subgroup || (s.id === 'business-license' ? 'A' : null);
                var rec = {
                    displayName: s.name,
                    rank: s.finalRank || s.adjustedRank || (idx + 1),
                    subgroup: subgroup,
                    gaps: gaps
                };
                out.byName.set(s.name, rec);
                if (subgroup && !out.bySubgroup.has(subgroup)) {
                    out.bySubgroup.set(subgroup, rec);
                }
            });
            return out;
        }

        // Build the auto-selected list of solution cards based on Prioritization.
        // Returns an array shaped like rosraSelectedSolutions entries so the existing
        // RecommendationsModule consumes it without changes.
        function autoSelectFromPrioritization() {
            if (typeof SolutionsDatabase === 'undefined') return [];
            var all = SolutionsDatabase.getAllSolutions();
            var meta = includedStreamMeta();

            // Empty prioritization → fall back to ALL 82 cards so the page is not blank.
            if (meta.byName.size === 0) {
                return all.map(function (c) { return shapeForSelected(c, null); });
            }

            var out = [];
            all.forEach(function (c) {
                // Try direct stream-name match first (Property Tax, or a user-named
                // stream that happens to match a DB card's stream string).
                var rec = meta.byName.get(c.stream);

                // Otherwise route non-property cards through subgroup → user stream.
                if (!rec && c.stream === 'Non-Property' && c.subgroup) {
                    rec = meta.bySubgroup.get(c.subgroup);
                }

                if (!rec) return;
                if (!rec.gaps.has(String(c.gap || '').toLowerCase())) return;
                out.push(shapeForSelected(c, rec));
            });
            return out;
        }
        function shapeForSelected(c, rec) {
            return {
                solutionId: c.solutionId,
                streamName: rec ? rec.displayName : c.stream,
                streamRank: rec ? rec.rank : 999,
                gapType: c.gap,
                gapPriority: 999,
                timeline: c.timeline,
                title: c.title || c.shortTitle || c.solutionId,
                subgroup: c.subgroup || (rec ? rec.subgroup : '') || ''
            };
        }

        // Persist a selection list using FormStateManager (preferred) with localStorage fallback.
        function saveSelected(list) {
            try {
                if (typeof FormStateManager !== 'undefined') FormStateManager.setData(SELECTED_KEY, list);
                else localStorage.setItem(SELECTED_KEY, JSON.stringify(list));
            } catch (e) { console.error('saveSelected failed', e); }
        }

        // Run auto-select if no selection exists yet, OR if the existing selection
        // doesn't yet cover every included stream the user has in Prioritization.
        // The "coverage" check is what un-sticks the bug the user hit: an earlier
        // visit auto-selected before Business License had gap data, the selection
        // got saved with only Property Tax entries, and ensureAutoSelected then
        // refused to refresh on later visits — leaving BL invisible forever even
        // after the user filled in BL gaps. We preserve sample-report curation
        // (e.g. the Kampala seed) because those entries name every included
        // stream by hand, so `allCovered` is true and we leave them alone.
        function ensureAutoSelected() {
            var existing = null;
            try {
                if (typeof FormStateManager !== 'undefined') existing = FormStateManager.getData(SELECTED_KEY);
                if (!existing) {
                    var raw = localStorage.getItem(SELECTED_KEY);
                    if (raw) existing = JSON.parse(raw);
                }
            } catch (e) { existing = null; }

            if (Array.isArray(existing) && existing.length > 0) {
                var meta = includedStreamMeta();
                if (meta.byName.size === 0) return; // no prioritization yet — keep what we have
                var covered = new Set();
                existing.forEach(function (e) { if (e && e.streamName) covered.add(e.streamName); });
                var allCovered = true;
                meta.byName.forEach(function (_rec, name) {
                    if (!covered.has(name)) allCovered = false;
                });
                if (allCovered) return;
            }
            saveSelected(autoSelectFromPrioritization());
        }

        // Smart-default the focus chips based on which gap types are actually present
        // in the user's prioritization. Other chip groups keep HTML defaults.
        function smartDefaultFocus() {
            var streamGaps = gapTypesPerIncludedStream();
            if (streamGaps.size === 0) return;
            var present = new Set();
            streamGaps.forEach(function (set) { set.forEach(function (g) { present.add(g); }); });
            if (present.size === 0) return;
            document.querySelectorAll('.rec-personalise-bar input[name="qFocus"]').forEach(function (i) {
                i.checked = present.has(i.value);
            });
        }

        // Restore chip state from localStorage if present, otherwise apply smart defaults.
        function restoreOrDefault() {
            var saved = null;
            try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch (e) {}
            if (saved && Array.isArray(saved.time) && Array.isArray(saved.political) && Array.isArray(saved.focus)) {
                document.querySelectorAll('.rec-personalise-bar input[name="qTime"]').forEach(function (i) { i.checked = saved.time.indexOf(i.value) >= 0; });
                document.querySelectorAll('.rec-personalise-bar input[name="qPolitical"]').forEach(function (i) { i.checked = saved.political.indexOf(i.value) >= 0; });
                document.querySelectorAll('.rec-personalise-bar input[name="qFocus"]').forEach(function (i) { i.checked = saved.focus.indexOf(i.value) >= 0; });
            } else {
                smartDefaultFocus();
            }
        }

        function readChips() {
            var state = { time: [], political: [], focus: [] };
            document.querySelectorAll('.rec-personalise-bar input[name="qTime"]:checked').forEach(function (i) { state.time.push(i.value); });
            document.querySelectorAll('.rec-personalise-bar input[name="qPolitical"]:checked').forEach(function (i) { state.political.push(i.value); });
            document.querySelectorAll('.rec-personalise-bar input[name="qFocus"]:checked').forEach(function (i) { state.focus.push(i.value); });
            return state;
        }

        // Apply the chip filter to whatever cards are currently rendered. Hides
        // cards that don't match and collapses now-empty gap/stream group containers.
        function applyChipFilter() {
            var state = readChips();
            var cards = document.querySelectorAll('#solutionCardsContainer .solution-card');
            var visible = 0;
            cards.forEach(function (card) {
                var t = timelineBucket(card.dataset.timeline);
                var p = politicalBucket(card.dataset.political);
                var g = (card.dataset.gap || '').toLowerCase();
                var match = true;
                if (state.time.length && state.time.indexOf(t) < 0 && t !== 'unknown') match = false;
                if (state.political.length && state.political.indexOf(p) < 0 && p !== 'unknown') match = false;
                if (state.focus.length && state.focus.indexOf(g) < 0) match = false;
                card.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            // Hide empty gap-section / stream-section containers so the page doesn't show empty headers.
            // Order matters: collapse gap-sections first, then collapse stream-sections that contain
            // zero visible cards across all their gap-sections.
            ['.gap-section', '.stream-section'].forEach(function (sel) {
                document.querySelectorAll('#solutionCardsContainer ' + sel).forEach(function (group) {
                    var any = group.querySelector('.solution-card:not([style*="display: none"])');
                    group.style.display = any ? '' : 'none';
                });
            });
            var vEl = document.getElementById('recVisibleCount');
            var tEl = document.getElementById('recTotalCount');
            if (vEl) vEl.textContent = visible;
            if (tEl) tEl.textContent = cards.length;
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
        }

        // Broaden the pool: load all 82 cards, open all chips, re-render.
        function showAll82() {
            if (typeof SolutionsDatabase === 'undefined') return;
            var all = SolutionsDatabase.getAllSolutions().map(shapeForSelected);
            saveSelected(all);
            document.querySelectorAll('.rec-personalise-bar input[type="checkbox"]').forEach(function (i) { i.checked = true; });
            try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
            if (typeof RecommendationsModule !== 'undefined' && RecommendationsModule.init) {
                RecommendationsModule.init();
            }
            setTimeout(applyChipFilter, 100);
        }

        // Restore default chip state (HTML defaults + smart focus) and re-filter.
        function resetChips() {
            try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
            document.querySelectorAll('.rec-personalise-bar input[name="qTime"]').forEach(function (i) { i.checked = true; });
            document.querySelectorAll('.rec-personalise-bar input[name="qPolitical"]').forEach(function (i) {
                i.checked = (i.value === 'higher' || i.value === 'moderate');
            });
            document.querySelectorAll('.rec-personalise-bar input[name="qFocus"]').forEach(function (i) { i.checked = true; });
            smartDefaultFocus();
            applyChipFilter();
        }

        function init() {
            ensureAutoSelected();
            restoreOrDefault();

            document.querySelectorAll('.rec-personalise-bar input[type="checkbox"]').forEach(function (input) {
                input.addEventListener('change', applyChipFilter);
            });
            var showBtn = document.getElementById('recShowAllBtn');
            if (showBtn) showBtn.addEventListener('click', showAll82);
            var emptyShowBtn = document.getElementById('recEmptyShowAllBtn');
            if (emptyShowBtn) emptyShowBtn.addEventListener('click', showAll82);
            var resetBtn = document.getElementById('recResetChipsBtn');
            if (resetBtn) resetBtn.addEventListener('click', resetChips);

            // RecommendationsModule.init() runs on the same DOMContentLoaded — give it a tick
            // to render the cards container, then apply the chip filter once.
            setTimeout(applyChipFilter, 250);

            // Re-apply whenever the cards container is re-rendered (e.g. after a stream
            // inclusion change in Prioritization). Cheap MutationObserver — only fires
            // on actual childList swaps, not on style/attribute toggles we make ourselves.
            var container = document.getElementById('solutionCardsContainer');
            if (container && typeof MutationObserver !== 'undefined') {
                var pending = false;
                new MutationObserver(function () {
                    if (pending) return;
                    pending = true;
                    setTimeout(function () { pending = false; applyChipFilter(); }, 50);
                }).observe(container, { childList: true, subtree: false });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
