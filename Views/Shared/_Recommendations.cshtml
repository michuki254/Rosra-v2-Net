                        <i class="fas fa-th me-2"></i> @Localizer["Personalise_ShowAll"]
                    </button>
                </div>
            </div>
            <div id="solutionCardsContainer"></div>
        </div>

        <!-- Timeline View -->
        <div class="view-panel" id="timelineView" style="display: none;">
            <div class="timeline-container">
