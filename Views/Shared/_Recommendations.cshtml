        <button type="button" class="summary-card" data-filter="1-3 years" onclick="RecommendationsModule.filterByTimeline('1-3 years')" title="Filter to medium term">
            <div class="summary-icon medium-term"><i class="fas fa-calendar-alt"></i></div>
            <div class="summary-content">
                <span class="summary-value" id="mediumTermCount">0</span>
                <span class="summary-label">@Localizer["Summary_MediumTerm"]</span>
            </div>
        </button>
        <button type="button" class="summary-card" data-filter="3+ years" onclick="RecommendationsModule.filterByTimeline('3+ years')" title="Filter to long term">
            <div class="summary-icon long-term"><i class="fas fa-clock"></i></div>
            <div class="summary-content">
