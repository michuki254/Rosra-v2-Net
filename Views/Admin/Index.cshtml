@model RosraApp.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

@functions {
    public string GetCountryCode(string country)
    {
        if (string.IsNullOrEmpty(country)) return "";

        var countryCodes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            // Africa
            { "Kenya", "ke" },
            { "Nigeria", "ng" },
            { "South Africa", "za" },
            { "Egypt", "eg" },
            { "Ethiopia", "et" },
            { "Ghana", "gh" },
            { "Tanzania", "tz" },
            { "Uganda", "ug" },
            { "Rwanda", "rw" },
            { "Morocco", "ma" },
            { "Algeria", "dz" },
            { "Senegal", "sn" },
            { "Cameroon", "cm" },
            { "Zambia", "zm" },
            { "Zimbabwe", "zw" },
            { "Botswana", "bw" },
            { "Namibia", "na" },
            { "Mozambique", "mz" },
            { "Mali", "ml" },
            { "Burkina Faso", "bf" },
            { "Ivory Coast", "ci" },
            { "Cote d'Ivoire", "ci" },
            { "Malawi", "mw" },
            { "Benin", "bj" },
            { "Togo", "tg" },
            { "Niger", "ne" },
            { "Sierra Leone", "sl" },
            { "Liberia", "lr" },

            // Europe
            { "United Kingdom", "gb" },
            { "UK", "gb" },
            { "Britain", "gb" },
            { "France", "fr" },
            { "Germany", "de" },
            { "Italy", "it" },
            { "Spain", "es" },
            { "Netherlands", "nl" },
            { "Belgium", "be" },
            { "Switzerland", "ch" },
            { "Sweden", "se" },
            { "Norway", "no" },
            { "Portugal", "pt" },
            { "Poland", "pl" },
            { "Denmark", "dk" },
            { "Finland", "fi" },
            { "Austria", "at" },
            { "Ireland", "ie" },
            { "Greece", "gr" },
            { "Czech Republic", "cz" },
            { "Romania", "ro" },
            { "Hungary", "hu" },

            // Americas
            { "United States", "us" },
            { "United States of America", "us" },
            { "USA", "us" },
            { "Canada", "ca" },
            { "Mexico", "mx" },
            { "Brazil", "br" },
            { "Argentina", "ar" },
            { "Chile", "cl" },
            { "Colombia", "co" },
            { "Peru", "pe" },
            { "Venezuela", "ve" },
            { "Ecuador", "ec" },
            { "Bolivia", "bo" },
            { "Paraguay", "py" },
            { "Uruguay", "uy" },
            { "Costa Rica", "cr" },
            { "Panama", "pa" },
            { "Guatemala", "gt" },
            { "Honduras", "hn" },
            { "El Salvador", "sv" },
            { "Nicaragua", "ni" },
            { "Jamaica", "jm" },
            { "Trinidad and Tobago", "tt" },

            // Asia
            { "China", "cn" },
            { "India", "in" },
            { "Japan", "jp" },
            { "Singapore", "sg" },
            { "South Korea", "kr" },
            { "Korea", "kr" },
            { "Thailand", "th" },
            { "Indonesia", "id" },
            { "Malaysia", "my" },
            { "Philippines", "ph" },
            { "Vietnam", "vn" },
            { "Pakistan", "pk" },
            { "Bangladesh", "bd" },
            { "Sri Lanka", "lk" },
            { "Nepal", "np" },
            { "Myanmar", "mm" },
            { "Cambodia", "kh" },
            { "Taiwan", "tw" },
            { "Hong Kong", "hk" },

            // Middle East
            { "UAE", "ae" },
            { "United Arab Emirates", "ae" },
            { "Saudi Arabia", "sa" },
            { "Israel", "il" },
            { "Turkey", "tr" },
            { "Iran", "ir" },
            { "Iraq", "iq" },
            { "Jordan", "jo" },
            { "Lebanon", "lb" },
            { "Kuwait", "kw" },
            { "Qatar", "qa" },
            { "Oman", "om" },
            { "Bahrain", "bh" },

            // Oceania
            { "Australia", "au" },
            { "New Zealand", "nz" },
            { "Fiji", "fj" },
            { "Papua New Guinea", "pg" },

            // Other
            { "Russia", "ru" },
            { "Ukraine", "ua" },
            { "Kazakhstan", "kz" },
            { "Uzbekistan", "uz" }
        };

        return countryCodes.TryGetValue(country, out var code) ? code : "";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/lib/flag-icons/css/flag-icons.min.css" asp-append-version="true" />
    <style>
        :root {
            --brand: #00689D;
            --brand-dark: #004d73;
            --brand-soft: rgba(0, 104, 157, 0.08);
            --ink-1: #0f172a;
            --ink-2: #475569;
            --ink-3: #94a3b8;
            --line: #e5e7eb;
            --line-soft: #f1f5f9;
            --surface: #ffffff;
            --surface-2: #f8fafc;
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05), 0 2px 8px rgba(15, 23, 42, 0.05), 0 8px 24px rgba(15, 23, 42, 0.04);
            --shadow-md: 0 2px 4px rgba(15, 23, 42, 0.06), 0 6px 16px rgba(15, 23, 42, 0.08), 0 16px 40px rgba(15, 23, 42, 0.06);
            --shadow-lg: 0 4px 8px rgba(15, 23, 42, 0.08), 0 12px 28px rgba(15, 23, 42, 0.10), 0 24px 56px rgba(15, 23, 42, 0.08);
            --radius: 12px;
            --radius-sm: 8px;
        }

        body, .admin-main { background: #ffffff !important; }

        /* ── Page Header ── */
        .admin-page-header {
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: var(--radius);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-sm);
        }

        .admin-page-header-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: white;
            flex-shrink: 0;
        }

        .admin-page-header h1 {
            color: var(--ink-1);
            font-weight: 600;
            font-size: 1.15rem;
            margin: 0 0 0.1rem;
            letter-spacing: -0.01em;
        }

        .admin-page-header p {
            color: var(--ink-2);
            font-size: 0.82rem;
            margin: 0;
        }

        .btn-manage-users {
            background: var(--brand);
            border: none;
            color: white;
            border-radius: var(--radius-sm);
            font-weight: 500;
            font-size: 0.82rem;
            padding: 0.5rem 1rem;
            transition: background 0.2s ease, transform 0.15s ease;
        }
        .btn-manage-users:hover {
            background: var(--brand-dark);
            color: white;
            transform: translateY(-1px);
        }

        /* ── KPI Stat Cards ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: var(--radius);
            padding: 1.15rem 1.25rem;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.25s ease, transform 0.2s ease;
        }
        .stat-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }

        .stat-content { display: flex; align-items: center; gap: 0.85rem; }

        .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: white;
            flex-shrink: 0;
        }
        .stat-icon.blue  { background: linear-gradient(135deg, #00689D 0%, #0084c7 100%); }
        .stat-icon.green { background: linear-gradient(135deg, #059669 0%, #10b981 100%); }
        .stat-icon.gray  { background: linear-gradient(135deg, #475569 0%, #64748b 100%); }
        .stat-icon.amber { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); }

        .stat-details { flex: 1; min-width: 0; }
        .stat-number {
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--ink-1);
            line-height: 1.1;
            margin-bottom: 0.15rem;
            letter-spacing: -0.01em;
        }
        .stat-label {
            font-size: 0.72rem;
            color: var(--ink-2);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        /* ── Quick Links ── */
        .admin-links { display: flex; gap: 0.55rem; flex-wrap: wrap; margin: 1.5rem 0 0; }
        .admin-link-card {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.95rem;
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: 999px;
            color: var(--ink-1);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.78rem;
            box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 2px 8px rgba(15,23,42,0.04);
            transition: box-shadow 0.2s ease, transform 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }
        .admin-link-card:hover {
            color: var(--brand);
            border-color: rgba(0,104,157,0.25);
            box-shadow: 0 2px 4px rgba(15,23,42,0.06), 0 8px 20px rgba(15,23,42,0.08);
            transform: translateY(-2px);
        }
        .admin-link-card i { font-size: 0.9rem; }

        /* ── Reports Section ── */
        .reports-section {
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: var(--radius);
            padding: 1.4rem;
            box-shadow: var(--shadow-md);
            margin-top: 1.5rem;
        }

        .reports-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.1rem;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .reports-header-title { display: flex; align-items: center; gap: 0.6rem; }
        .reports-header-title .section-icon {
            width: 30px; height: 30px; border-radius: 8px;
            background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%);
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 0.85rem;
        }
        .reports-header h5 {
            color: var(--ink-1);
            font-weight: 600;
            margin: 0;
            font-size: 0.95rem;
            letter-spacing: -0.005em;
        }
        .reports-header h5 small {
            color: var(--ink-3) !important;
            font-size: 0.78rem;
        }

        /* Search pill (matches top-bar search) */
        .reports-header form { display: flex; gap: 0.4rem; align-items: center; }
        .search-box {
            background: var(--surface-2);
            border: 1px solid transparent;
            border-radius: 999px;
            padding: 0.4rem 0.95rem;
            font-size: 0.82rem;
            color: var(--ink-1);
            transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
            min-width: 240px;
        }
        .search-box:focus {
            background: var(--surface);
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-soft);
            outline: none;
        }
        .search-box::placeholder { color: var(--ink-3); }

        /* ── Table ── */
        .reports-table { margin-bottom: 0; }
        .reports-table thead th {
            background: var(--surface-2);
            border-bottom: 1px solid var(--line);
            border-top: 1px solid var(--line);
            color: var(--ink-2);
            font-weight: 600;
            font-size: 0.7rem;
            padding: 0.7rem 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .reports-table thead th:first-child { border-left: 1px solid var(--line); border-radius: 8px 0 0 8px; }
        .reports-table thead th:last-child  { border-right: 1px solid var(--line); border-radius: 0 8px 8px 0; }
        .reports-table tbody td {
            padding: 0.85rem 0.9rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--line-soft);
        }
        .reports-table tbody tr { transition: background 0.15s ease; }
        .reports-table tbody tr:hover { background: var(--surface-2); }

        .report-title-cell {
            font-weight: 600;
            color: var(--ink-1);
            font-size: 0.85rem;
        }

        .user-info-cell { display: flex; flex-direction: column; }
        .user-name-cell { font-weight: 500; color: var(--ink-1); font-size: 0.82rem; }
        .user-email-cell { color: var(--ink-3); font-size: 0.74rem; }

        .location-cell { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--ink-1); }
        .country-flag {
            border-radius: 3px;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
            width: 22px; height: 16px;
            background-size: cover; background-position: center;
            flex-shrink: 0;
        }

        .date-cell { display: block; font-weight: 500; color: var(--ink-1); font-size: 0.8rem; }
        .time-cell { display: block; color: var(--ink-3); font-size: 0.72rem; }

        /* ── Status Badges (subtle modern pills) ── */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.22rem 0.6rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 600;
            white-space: nowrap;
            line-height: 1.2;
        }
        .status-badge i { font-size: 0.65rem; }
        .status-draft     { background: #f1f5f9; color: #475569; }
        .status-submitted { background: #fef3c7; color: #92400e; }
        .status-review    { background: #dbeafe; color: #1e40af; }
        .status-revision  { background: #fee2e2; color: #991b1b; }
        .status-validated { background: #d1fae5; color: #065f46; }

        /* ── Action buttons ── */
        .btn-view {
            background: var(--brand);
            color: white;
            border: none;
            padding: 0.32rem 0.6rem;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.78rem;
            transition: background 0.15s ease;
        }
        .btn-view:hover { background: var(--brand-dark); color: white; }

        .btn-action-ghost {
            background: transparent;
            border: 1px solid var(--line);
            color: var(--ink-2);
            padding: 0.32rem 0.55rem;
            border-radius: 8px;
            font-size: 0.78rem;
            transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
        }
        .btn-action-ghost:hover { color: var(--ink-1); border-color: #cbd5e1; background: var(--surface-2); }
        .btn-action-ghost.delete:hover { color: #ef4444; border-color: #fecaca; background: #fef2f2; }

        .select-all-col { width: 36px; }

        /* ── Bulk action bar (sticky-feel) ── */
        .bulk-bar {
            display: none;
            background: var(--ink-1);
            color: white;
            border-radius: var(--radius-sm);
            padding: 0.6rem 1rem;
            margin-bottom: 0.85rem;
            align-items: center;
            justify-content: space-between;
            font-size: 0.82rem;
        }
        .bulk-bar.active { display: flex; }
        .bulk-bar .btn { font-size: 0.78rem; }

        /* ── Pagination ── */
        .pagination .page-link {
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--ink-2);
            font-weight: 500;
            font-size: 0.82rem;
            padding: 0.4rem 0.75rem;
            margin: 0 0.1rem;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }
        .pagination .page-link:hover {
            background: var(--surface-2);
            color: var(--ink-1);
            border-color: var(--line);
        }
        .pagination .page-item.active .page-link {
            background: var(--brand);
            border-color: var(--brand);
            color: white;
        }

        /* ── Modals (modern light) ── */
        .modal-content.modal-modern {
            border: 1px solid var(--line) !important;
            border-radius: var(--radius) !important;
            box-shadow: 0 20px 60px -16px rgba(15, 23, 42, 0.18) !important;
            overflow: hidden;
        }
        .modal-modern .modal-header {
            border-bottom: 1px solid var(--line-soft);
            padding: 1rem 1.25rem;
            display: flex; align-items: center; gap: 0.7rem;
        }
        .modal-modern .modal-title {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--ink-1);
            margin: 0;
        }
        .modal-modern .modal-icon {
            width: 32px; height: 32px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 0.9rem;
            flex-shrink: 0;
        }
        .modal-modern .modal-icon--danger { background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); }
        .modal-modern .modal-icon--brand  { background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%); }
        .modal-modern .modal-body {
            padding: 1.25rem;
            color: var(--ink-2);
            font-size: 0.85rem;
        }
        .modal-modern .modal-footer {
            border-top: 1px solid var(--line-soft);
            background: var(--surface-2);
            padding: 0.75rem 1.25rem;
        }
        .btn-modal-secondary {
            background: var(--surface);
            color: var(--ink-1);
            border: 1px solid var(--line);
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.82rem;
            padding: 0.42rem 0.95rem;
        }
        .btn-modal-secondary:hover { background: var(--surface-2); border-color: #cbd5e1; }
        .btn-modal-danger {
            background: #ef4444;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.82rem;
            padding: 0.42rem 0.95rem;
        }
        .btn-modal-danger:hover { background: #dc2626; color: white; }
        .btn-modal-primary {
            background: var(--brand);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.82rem;
            padding: 0.42rem 0.95rem;
        }
        .btn-modal-primary:hover { background: var(--brand-dark); color: white; }

        /* ── Empty state ── */
        .reports-table tbody tr td.text-center i.display-4 {
            font-size: 2rem !important;
            color: var(--ink-3);
        }

        /* ── Container spacing trim ── */
        .container.py-4 { padding-top: 1.25rem !important; padding-bottom: 1.25rem !important; }
    </style>
}

<div class="container py-4">
    <!-- Header -->
    <div class="admin-page-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-page-header-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <h1>@Localizer["PageTitle"]</h1>
                <p>@Localizer["PageSubtitle"]</p>
            </div>
        </div>
        <a asp-action="Users" class="btn btn-manage-users">
            <i class="bi bi-people me-2"></i> @Localizer["ManageUsers"]
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon blue">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-details">
                    <div class="stat-number">@Model.TotalUsers</div>
                    <div class="stat-label">@Localizer["TotalUsers"]</div>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon green">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="stat-details">
                    <div class="stat-number">@Model.ActiveUsers</div>
                    <div class="stat-label">@Localizer["ActiveUsers"]</div>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon gray">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <div class="stat-details">
                    <div class="stat-number">@Model.InactiveUsers</div>
                    <div class="stat-label">@Localizer["InactiveUsers"]</div>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon amber">
                    <i class="bi bi-file-text-fill"></i>
                </div>
                <div class="stat-details">
                    <div class="stat-number">@Model.TotalReports</div>
                    <div class="stat-label">@Localizer["TotalReports"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Admin Links -->
    <div class="admin-links mb-3">
        <a asp-controller="Submission" asp-action="Queue" class="admin-link-card">
            <i class="bi bi-clipboard-check" style="color: #3B82F6;"></i> Review Queue
        </a>
        <a asp-controller="Submission" asp-action="Validated" class="admin-link-card">
            <i class="bi bi-patch-check" style="color: #10B981;"></i> Validated Assessments
        </a>
        <a asp-action="AllReports" class="admin-link-card">
            <i class="bi bi-grid" style="color: #8B5CF6;"></i> All Reports (Cards)
        </a>
        <a asp-action="DeletedReports" class="admin-link-card">
            <i class="bi bi-trash" style="color: #EF4444;"></i> Deleted Reports (Trash)
        </a>
        <a asp-action="AuditLog" class="admin-link-card">
            <i class="bi bi-clock-history" style="color: #F59E0B;"></i> Audit Log
        </a>
        <a asp-action="CreateRole" class="admin-link-card">
            <i class="bi bi-shield-lock" style="color: #06B6D4;"></i> Manage Roles
        </a>
        <a asp-action="DataUpload" class="admin-link-card">
            <i class="bi bi-cloud-upload" style="color: #8B5CF6;"></i> Data Upload
        </a>
    </div>

    <!-- Reports Data Table -->
    <div class="reports-section">
        <div class="reports-header">
            <div class="reports-header-title">
                <div class="section-icon">
                    <i class="bi bi-file-text"></i>
                </div>
                <h5>@Localizer["UserReports"]
                    <small class="fw-normal ms-2">(@Model.TotalCount total)</small>
                </h5>
            </div>
            <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 400px;">
                <input type="text" name="search" class="form-control form-control-sm search-box"
                       placeholder="@Localizer["SearchPlaceholder"].Value"
                       value="@Model.SearchTerm" />
                <button type="submit" class="btn btn-sm btn-view">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-sm btn-action-ghost delete">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </form>
        </div>

        <!-- Bulk Action Bar -->
        <div class="bulk-bar" id="bulkBar">
            <span><strong id="selectedCount">0</strong> report(s) selected</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" id="bulkArchiveBtn">
                    <i class="bi bi-archive me-1"></i> Archive Selected
                </button>
                <button class="btn btn-sm btn-danger" id="bulkDeleteBtn">
                    <i class="bi bi-trash me-1"></i> Delete Selected
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table reports-table" id="reportsTable">
                <thead>
                    <tr>
                        <th class="select-all-col">
                            <input type="checkbox" id="selectAll" class="form-check-input" />
                        </th>
                        <th>@Localizer["Title"]</th>
                        <th>@Localizer["User"]</th>
                        <th>@Localizer["Location"]</th>
                        <th>Status</th>
                        <th>@Localizer["CreatedDate"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllReports != null && Model.AllReports.Any())
                    {
                        @foreach (var report in Model.AllReports)
                        {
                            <tr id="report-row-@report.Id">
                                <td>
                                    <input type="checkbox" class="form-check-input report-checkbox" value="@report.Id" />
                                </td>
                                <td>
                                    <div class="report-title-cell">@report.Title</div>
                                </td>
                                <td>
                                    <div class="user-info-cell">
                                        <div class="user-name-cell">@report.UserName</div>
                                        <div class="user-email-cell">@report.UserEmail</div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(report.City) || !string.IsNullOrEmpty(report.Country))
                                    {
                                        <div class="location-cell">
                                            @{
                                                var countryCode = GetCountryCode(report.Country);
                                            }
                                            @if (!string.IsNullOrEmpty(countryCode))
                                            {
                                                <span class="country-flag fi fi-@countryCode"></span>
                                            }
                                            else if (!string.IsNullOrEmpty(report.Country))
                                            {
                                                <i class="bi bi-globe" style="color: #6A6A6A;"></i>
                                            }
                                            <span>@report.City@(!string.IsNullOrEmpty(report.City) && !string.IsNullOrEmpty(report.Country) ? ", " : "")@report.Country</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var reportStatus = (RosraApp.Models.Enums.ReportStatus)report.Status;
                                        var (statusClass, statusIcon) = reportStatus switch
                                        {
                                            RosraApp.Models.Enums.ReportStatus.Draft => ("status-draft", "bi-pencil"),
                                            RosraApp.Models.Enums.ReportStatus.Submitted => ("status-submitted", "bi-send"),
                                            RosraApp.Models.Enums.ReportStatus.UnderReview => ("status-review", "bi-hourglass-split"),
                                            RosraApp.Models.Enums.ReportStatus.NeedsRevision => ("status-revision", "bi-exclamation-triangle"),
                                            RosraApp.Models.Enums.ReportStatus.Validated => ("status-validated", "bi-patch-check-fill"),
                                            _ => ("status-draft", "bi-pencil")
                                        };
                                    }
                                    <span class="status-badge @statusClass">
                                        <i class="bi @statusIcon"></i> @reportStatus.ToString()
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var displayDate = report.UpdatedAt ?? report.CreatedAt;
                                    }
                                    <span class="date-cell">@displayDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                    <span class="time-cell">@displayDate.ToLocalTime().ToString("hh:mm tt")</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-controller="Dashboard" asp-action="ViewReport" asp-route-id="@report.PublicId"
                                           class="btn btn-sm btn-view" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button class="btn btn-sm btn-action-ghost archive-btn" data-id="@report.Id" title="Archive">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                        <button class="btn btn-sm btn-action-ghost delete delete-btn" data-id="@report.Id" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox display-4"></i>
                                <p class="mt-2">@Localizer["NoReportsFound"]</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Admin report pagination" class="mt-3">
                <ul class="pagination justify-content-center mb-2">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                           asp-route-search="@Model.SearchTerm">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-search="@Model.SearchTerm">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                           asp-route-search="@Model.SearchTerm">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
                <p class="text-center text-muted small mb-0">
                    Page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount reports)
                </p>
            </nav>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-modern">
            <div class="modal-header">
                <div class="modal-icon modal-icon--danger"><i class="bi bi-exclamation-triangle"></i></div>
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">This report will be moved to trash. You can restore it from the Deleted Reports page.</p>
                <input type="hidden" id="deleteReportId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-modal-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-modal-danger" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Delete Modal -->
<div class="modal fade" id="bulkDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-modern">
            <div class="modal-header">
                <div class="modal-icon modal-icon--danger"><i class="bi bi-trash"></i></div>
                <h5 class="modal-title">Bulk Delete</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Delete <strong id="bulkDeleteCount">0</strong> report(s)? They will be moved to trash.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-modal-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-modal-danger" id="confirmBulkDeleteBtn"><i class="bi bi-trash me-1"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Archive Modal -->
<div class="modal fade" id="bulkArchiveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-modern">
            <div class="modal-header">
                <div class="modal-icon modal-icon--brand"><i class="bi bi-archive"></i></div>
                <h5 class="modal-title">Bulk Archive</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Archive <strong id="bulkArchiveCount">0</strong> report(s)?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-modal-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-modal-primary" id="confirmBulkArchiveBtn"><i class="bi bi-archive me-1"></i> Archive</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toast" class="toast hide" role="alert">
        <div class="toast-header">
            <strong class="me-auto" id="toast-title">Notification</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="toast-message"></div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        $(document).ready(function() {
            var token = $('input[name="__RequestVerificationToken"]').val();

            function showToast(title, message, type) {
                $('#toast-title').text(title);
                $('#toast-message').text(message);
                $('#toast').removeClass('bg-danger bg-success').addClass(type === 'success' ? 'bg-success text-white' : 'bg-danger text-white');
                new bootstrap.Toast(document.getElementById('toast')).show();
            }

            // --- Single Delete ---
            $('.delete-btn').click(function() {
                $('#deleteReportId').val($(this).data('id'));
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            });

            $('#confirmDeleteBtn').click(function() {
                var id = $('#deleteReportId').val();
                $.ajax({
                    url: '@Url.Action("DeleteReport", "Dashboard")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(r) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        if (r.success) {
                            $('#report-row-' + id).fadeOut(300);
                            showToast('Success', r.message, 'success');
                        } else {
                            showToast('Error', r.message, 'error');
                        }
                    }
                });
            });

            // --- Single Archive ---
            $('.archive-btn').click(function() {
                var id = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("ArchiveReport", "Dashboard")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(r) {
                        if (r.success) {
                            $('#report-row-' + id).fadeOut(300);
                            showToast('Success', r.message, 'success');
                        } else {
                            showToast('Error', r.message, 'error');
                        }
                    }
                });
            });

            // --- Bulk Select ---
            function updateBulkBar() {
                var count = $('.report-checkbox:checked').length;
                $('#selectedCount').text(count);
                if (count > 0) {
                    $('#bulkBar').addClass('active');
                } else {
                    $('#bulkBar').removeClass('active');
                }
            }

            $('#selectAll').change(function() {
                $('.report-checkbox').prop('checked', this.checked);
                updateBulkBar();
            });

            $(document).on('change', '.report-checkbox', updateBulkBar);

            // --- Bulk Delete ---
            $('#bulkDeleteBtn').click(function() {
                var ids = $('.report-checkbox:checked').map(function() { return parseInt(this.value); }).get();
                if (!ids.length) return;
                $('#bulkDeleteCount').text(ids.length);
                new bootstrap.Modal(document.getElementById('bulkDeleteModal')).show();
            });

            $('#confirmBulkDeleteBtn').click(function() {
                var ids = $('.report-checkbox:checked').map(function() { return parseInt(this.value); }).get();
                bootstrap.Modal.getInstance(document.getElementById('bulkDeleteModal')).hide();
                $.ajax({
                    url: '@Url.Action("BulkDelete", "Dashboard")',
                    type: 'POST',
                    data: { ids: ids, __RequestVerificationToken: token },
                    traditional: true,
                    success: function(r) {
                        if (r.success) {
                            ids.forEach(function(id) { $('#report-row-' + id).fadeOut(300); });
                            showToast('Success', r.message, 'success');
                            updateBulkBar();
                        } else {
                            showToast('Error', r.message, 'error');
                        }
                    }
                });
            });

            // --- Bulk Archive ---
            $('#bulkArchiveBtn').click(function() {
                var ids = $('.report-checkbox:checked').map(function() { return parseInt(this.value); }).get();
                if (!ids.length) return;
                $('#bulkArchiveCount').text(ids.length);
                new bootstrap.Modal(document.getElementById('bulkArchiveModal')).show();
            });

            $('#confirmBulkArchiveBtn').click(function() {
                var ids = $('.report-checkbox:checked').map(function() { return parseInt(this.value); }).get();
                bootstrap.Modal.getInstance(document.getElementById('bulkArchiveModal')).hide();
                $.ajax({
                    url: '@Url.Action("BulkArchive", "Dashboard")',
                    type: 'POST',
                    data: { ids: ids, __RequestVerificationToken: token },
                    traditional: true,
                    success: function(r) {
                        if (r.success) {
                            ids.forEach(function(id) { $('#report-row-' + id).fadeOut(300); });
                            showToast('Success', r.message, 'success');
                            updateBulkBar();
                        } else {
                            showToast('Error', r.message, 'error');
                        }
                    }
                });
            });
        });
    </script>
}
