@model List<RosraApp.Models.SolutionCard>
@{
    ViewData["Title"] = "Solution Card Library";

    var search = ViewBag.Search as string;
    var stream = ViewBag.Stream as string;
    var gap = ViewBag.Gap as string;
    var subgroup = ViewBag.Subgroup as string;
    var timeline = ViewBag.Timeline as string;
    var status = ViewBag.Status as string;

    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 20);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalCount = (int)(ViewBag.TotalCount ?? 0);

    int totalCards = (int)(ViewBag.TotalCards ?? 0);
    int totalActive = (int)(ViewBag.TotalActive ?? 0);
    int totalInactive = (int)(ViewBag.TotalInactive ?? 0);
    int totalDeleted = (int)(ViewBag.TotalDeleted ?? 0);

    int rangeStart = totalCount > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    int rangeEnd = Math.Min(currentPage * pageSize, totalCount);

    bool hasFilters = !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(stream) ||
                      !string.IsNullOrEmpty(gap) || !string.IsNullOrEmpty(subgroup) ||
                      !string.IsNullOrEmpty(timeline) || (!string.IsNullOrEmpty(status) && status != "active");
}

@section Styles {
<style>
    :root {
        --brand: #00689D; --brand-dark: #004d73; --brand-soft: rgba(0,104,157,0.08);
        --ink-1: #0f172a; --ink-2: #475569; --ink-3: #94a3b8;
        --line: #e5e7eb; --line-soft: #f1f5f9;
        --surface: #fff; --surface-2: #f8fafc;
        --shadow-sm: 0 1px 2px rgba(15,23,42,0.05), 0 2px 8px rgba(15,23,42,0.05), 0 8px 24px rgba(15,23,42,0.04);
        --shadow-md: 0 2px 4px rgba(15,23,42,0.06), 0 6px 16px rgba(15,23,42,0.08), 0 16px 40px rgba(15,23,42,0.06);
        --radius: 12px; --radius-sm: 8px;
    }
    body, .admin-main { background: #fff !important; }
    .container.py-4 { padding-top: 1.25rem !important; padding-bottom: 1.25rem !important; }

    /* ── Header ── */
    .page-header {
        background: var(--surface); border: 1px solid var(--line-soft);
        border-radius: var(--radius); padding: 1.1rem 1.4rem;
        margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);
    }
    .page-header h1 {
        color: var(--ink-1); font-weight: 600; font-size: 1.15rem;
        margin: 0 0 0.1rem; letter-spacing: -0.01em;
    }
    .page-header p { color: var(--ink-2); font-size: 0.82rem; margin: 0; }
    .header-icon {
        width: 42px; height: 42px; border-radius: 10px;
        background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%) !important;
        color: #fff !important;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }

    .btn-back {
        background: var(--surface); border: 1px solid var(--line); color: var(--ink-1);
        border-radius: var(--radius-sm); font-size: 0.82rem; font-weight: 500;
        padding: 0.5rem 0.95rem; transition: background 0.15s, border-color 0.15s; text-decoration: none;
    }
    .btn-back:hover { background: var(--surface-2); border-color: #cbd5e1; color: var(--ink-1); }
    .header-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }

    .btn-add {
        background: var(--brand); color: #fff; border: none; border-radius: var(--radius-sm);
        padding: 0.5rem 0.95rem; font-size: 0.82rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;
        transition: background 0.15s, transform 0.15s;
    }
    .btn-add:hover { background: var(--brand-dark); color: #fff; transform: translateY(-1px); }
    .btn-export-json {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #fff; border: none; border-radius: var(--radius-sm);
        padding: 0.5rem 0.95rem; font-size: 0.82rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;
        transition: filter 0.15s, transform 0.15s;
    }
    .btn-export-json:hover { filter: brightness(0.95); color: #fff; transform: translateY(-1px); }
    .btn-import {
        background: var(--surface); color: #7c3aed; border: 1px solid #ddd6fe;
        border-radius: var(--radius-sm); padding: 0.5rem 0.95rem;
        font-size: 0.82rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }
    .btn-import:hover { background: #f5f3ff; border-color: #7c3aed; }

    /* ── KPI Cards ── */
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .kpi-card {
        background: var(--surface); border: 1px solid var(--line-soft);
        border-radius: var(--radius); padding: 1.1rem 1.2rem;
        box-shadow: var(--shadow-sm); transition: box-shadow 0.25s, transform 0.2s;
        cursor: pointer; text-decoration: none; display: block;
        position: relative; overflow: hidden;
    }
    .kpi-card::before {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0;
        width: 3px; background: var(--accent, var(--brand));
    }
    .kpi-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
    .kpi-card.selected::before { width: 4px; }
    .kpi-card.selected { box-shadow: var(--shadow-md); }
    .kpi-value { font-size: 1.4rem; font-weight: 600; line-height: 1.1; letter-spacing: -0.01em; }
    .kpi-label {
        font-size: 0.7rem; color: var(--ink-2); margin-top: 0.2rem;
        text-transform: uppercase; letter-spacing: 0.04em; font-weight: 500;
    }

    /* ── Filter Panel ── */
    .filter-panel {
        background: var(--surface); border: 1px solid var(--line-soft);
        border-radius: var(--radius); padding: 1.1rem 1.25rem;
        box-shadow: var(--shadow-sm); margin-bottom: 1.5rem;
    }
    .filter-title {
        font-size: 0.78rem; font-weight: 600; color: var(--ink-1);
        margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.45rem;
    }
    .filter-title i { color: var(--brand); }
    .filter-row { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: end; }
    .filter-group { flex: 1; min-width: 140px; }
    .filter-group label {
        font-size: 0.66rem; color: var(--ink-2); font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
        margin-bottom: 0.25rem; display: block;
    }
    .filter-group select, .filter-group input[type="text"] {
        width: 100%; background: var(--surface-2); border: 1px solid transparent;
        border-radius: var(--radius-sm); padding: 0.45rem 0.75rem;
        font-size: 0.8rem; color: var(--ink-1);
        transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .filter-group select:focus, .filter-group input[type="text"]:focus {
        background: var(--surface); border-color: var(--brand);
        outline: none; box-shadow: 0 0 0 3px var(--brand-soft);
    }
    .filter-actions { display: flex; gap: 0.5rem; align-items: end; padding-bottom: 1px; }
    .btn-filter {
        background: var(--brand); color: #fff; border: none;
        border-radius: var(--radius-sm); padding: 0.45rem 0.95rem;
        font-size: 0.8rem; font-weight: 500; cursor: pointer; white-space: nowrap;
        transition: background 0.15s;
    }
    .btn-filter:hover { background: var(--brand-dark); color: #fff; }
    .btn-clear {
        background: var(--surface); color: #ef4444; border: 1px solid #fecaca;
        border-radius: var(--radius-sm); padding: 0.45rem 0.95rem;
        font-size: 0.8rem; font-weight: 500; cursor: pointer;
        white-space: nowrap; text-decoration: none;
    }
    .btn-clear:hover { background: #fef2f2; color: #ef4444; }

    /* ── Table Card ── */
    .table-card {
        background: var(--surface); border: 1px solid var(--line-soft);
        border-radius: var(--radius); overflow: hidden;
        box-shadow: var(--shadow-md);
    }
    .table-toolbar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--line-soft);
        flex-wrap: wrap; gap: 0.7rem;
    }
    .table-toolbar-left { display: flex; align-items: center; gap: 0.7rem; }
    .section-icon {
        width: 30px; height: 30px; border-radius: 8px;
        background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%) !important;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 0.8rem;
    }
    .table-toolbar h5 { color: var(--ink-1); font-weight: 600; margin: 0; font-size: 0.95rem; }
    .table-toolbar h5 small { color: var(--ink-3) !important; font-size: 0.78rem; }
    .table-toolbar h5 small strong { color: var(--ink-1); }
    .result-count { font-size: 0.8rem; color: var(--ink-3); }
    .result-count strong { color: var(--ink-1); }

    .table-scroll { overflow-x: auto; max-height: 65vh; overflow-y: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .data-table thead th {
        background: var(--surface-2); color: var(--ink-2);
        font-weight: 600; font-size: 0.7rem;
        text-transform: uppercase; letter-spacing: 0.05em;
        padding: 0.7rem 0.85rem;
        position: sticky; top: 0; z-index: 1;
        white-space: nowrap;
        border-bottom: 1px solid var(--line);
    }
    .data-table tbody td {
        padding: 0.7rem 0.85rem; vertical-align: middle;
        border-bottom: 1px solid var(--line-soft);
        color: var(--ink-1); white-space: nowrap;
    }
    .data-table tbody tr { transition: background 0.15s; }
    .data-table tbody tr:hover { background: var(--surface-2); }

    /* Row left accent for gap type */
    .data-table tbody tr.gap-compliance { box-shadow: inset 3px 0 0 0 #ef4444; }
    .data-table tbody tr.gap-coverage   { box-shadow: inset 3px 0 0 0 #f59e0b; }
    .data-table tbody tr.gap-valuation  { box-shadow: inset 3px 0 0 0 #3b82f6; }
    .data-table tbody tr.gap-liability  { box-shadow: inset 3px 0 0 0 #7c3aed; }

    .title-cell { max-width: 260px; overflow: hidden; text-overflow: ellipsis; }

    /* ── Status / Stream / Gap badges ── */
    .status-badge {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.22rem 0.6rem; border-radius: 999px;
        font-size: 0.7rem; font-weight: 600; line-height: 1.2;
    }
    .status-badge i { font-size: 0.42rem; }
    .status-badge.active   { background: #d1fae5; color: #065f46; }
    .status-badge.inactive { background: #f1f5f9; color: #475569; }
    .status-badge.deleted  { background: #fee2e2; color: #991b1b; }

    .stream-badge {
        display: inline-flex; padding: 0.18rem 0.5rem; border-radius: 6px;
        font-size: 0.68rem; font-weight: 600;
    }
    .stream-pt { background: #fef3c7; color: #92400e; }
    .stream-np { background: #dbeafe; color: #1e40af; }

    .gap-badge {
        display: inline-flex; padding: 0.18rem 0.5rem; border-radius: 6px;
        font-size: 0.68rem; font-weight: 600;
    }
    .gap-badge.compliance { background: #fee2e2; color: #991b1b; }
    .gap-badge.coverage   { background: #fef3c7; color: #92400e; }
    .gap-badge.valuation  { background: #dbeafe; color: #1e40af; }
    .gap-badge.liability  { background: #ede9fe; color: #5b21b6; }

    /* ── Action Buttons ── */
    .btn-action {
        background: transparent; border: 1px solid var(--line);
        padding: 0.32rem 0.5rem; border-radius: 8px;
        font-size: 0.78rem; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: border-color 0.15s, background 0.15s, color 0.15s;
        color: var(--ink-2);
    }
    .btn-action:hover { background: var(--surface-2); border-color: #cbd5e1; }
    .btn-action.edit       { color: var(--brand); text-decoration: none; }
    .btn-action.edit:hover { color: var(--brand-dark); border-color: rgba(0,104,157,0.3); background: var(--brand-soft); }
    .btn-action.toggle-on  { color: #10b981; }
    .btn-action.toggle-off { color: var(--ink-3); }
    .btn-action.delete     { color: #ef4444; }
    .btn-action.delete:hover { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
    .btn-action.restore    { color: #7c3aed; }
    .btn-action.restore:hover { color: #6d28d9; border-color: #ddd6fe; background: #f5f3ff; }
    .btn-action.history    { color: var(--ink-2); text-decoration: none; }

    /* ── Pagination ── */
    .table-footer {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.85rem 1.25rem; border-top: 1px solid var(--line-soft);
    }
    .pagination { margin: 0; }
    .pagination .page-link {
        border: 1px solid transparent; border-radius: 8px;
        color: var(--ink-2); font-weight: 500; font-size: 0.8rem;
        padding: 0.4rem 0.7rem; margin: 0 0.1rem;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .pagination .page-link:hover { background: var(--surface-2); color: var(--ink-1); border-color: var(--line); }
    .pagination .page-item.active .page-link { background: var(--brand); border-color: var(--brand); color: #fff; }

    /* ── Modal modern ── */
    .modal-content.modal-modern {
        border: 1px solid var(--line) !important; border-radius: var(--radius) !important;
        box-shadow: 0 20px 60px -16px rgba(15,23,42,0.18) !important; overflow: hidden;
    }
    .modal-modern .modal-header {
        border-bottom: 1px solid var(--line-soft); padding: 1rem 1.25rem;
        display: flex; align-items: center; gap: 0.7rem;
    }
    .modal-modern .modal-title { font-size: 0.95rem; font-weight: 600; color: var(--ink-1); margin: 0; }
    .modal-modern .modal-icon {
        width: 32px; height: 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 0.9rem; flex-shrink: 0;
    }
    .modal-icon--danger { background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); }
    .modal-icon--purple { background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%); }
    .modal-modern .modal-body { padding: 1.25rem; color: var(--ink-2); font-size: 0.85rem; }
    .modal-modern .modal-footer {
        border-top: 1px solid var(--line-soft); background: var(--surface-2);
        padding: 0.75rem 1.25rem;
    }
    .btn-modal-secondary {
        background: var(--surface); color: var(--ink-1); border: 1px solid var(--line);
        border-radius: 8px; font-weight: 500; font-size: 0.82rem; padding: 0.42rem 0.95rem;
    }
    .btn-modal-secondary:hover { background: var(--surface-2); border-color: #cbd5e1; }
    .btn-modal-danger {
        background: #ef4444; color: #fff; border: none; border-radius: 8px;
        font-weight: 600; font-size: 0.82rem; padding: 0.42rem 0.95rem;
    }
    .btn-modal-danger:hover { background: #dc2626; color: #fff; }
    .btn-modal-purple {
        background: #7c3aed; color: #fff; border: none; border-radius: 8px;
        font-weight: 600; font-size: 0.82rem; padding: 0.42rem 0.95rem;
    }
    .btn-modal-purple:hover { background: #6d28d9; color: #fff; }

    /* ── Toast ── */
    .success-toast, .error-toast {
        position: fixed; bottom: 24px; right: 24px; z-index: 9999;
        color: #fff; padding: 12px 18px; border-radius: 10px;
        font-size: 0.82rem; font-weight: 500;
        display: flex; align-items: center; gap: 0.5rem;
        animation: slideUp 0.3s ease-out;
    }
    .success-toast { background: linear-gradient(135deg, #059669 0%, #10b981 100%); box-shadow: 0 10px 30px -8px rgba(16,185,129,0.4); }
    .error-toast   { background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); box-shadow: 0 10px 30px -8px rgba(239,68,68,0.4); }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── Empty State ── */
    .empty-state { text-align: center; padding: 3rem 1rem; }
    .empty-state-icon {
        width: 56px; height: 56px; border-radius: 14px;
        background: var(--surface-2);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: var(--ink-3); margin-bottom: 0.85rem;
    }
    .empty-state p { color: var(--ink-2); font-size: 0.85rem; margin: 0; }

    @@media (max-width: 768px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .filter-row { flex-direction: column; }
        .filter-group { min-width: 100%; }
        .header-actions { width: 100%; justify-content: flex-end; }
    }
</style>
}

<div class="container py-4">

    <!-- Header -->
    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon" style="background: #E0F2FE; color: #00689D;">
                <i class="bi bi-card-checklist"></i>
            </div>
            <div>
                <h1>Solution Card Library</h1>
                <p>Manage ROSRA solution cards across all revenue streams and gap types</p>
            </div>
        </div>
        <div class="header-actions">
            <a asp-action="CreateSolutionCard" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add New Card
            </a>
            <a asp-action="ExportSolutionCards" class="btn-export-json">
                <i class="bi bi-download"></i> Export All (JSON)
            </a>
            <button type="button" class="btn-import" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload"></i> Import Cards
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <a asp-action="SolutionLibrary" asp-route-status=""
           class="kpi-card @(string.IsNullOrEmpty(status) ? "selected" : "")"
           style="--accent:#00689D;">
            <div class="kpi-value" style="color:#00689D;">@totalCards</div>
            <div class="kpi-label">Total Cards</div>
        </a>
        <a asp-action="SolutionLibrary" asp-route-status="active"
           asp-route-search="@search" asp-route-stream="@stream" asp-route-gap="@gap"
           asp-route-subgroup="@subgroup" asp-route-timeline="@timeline"
           class="kpi-card @(status == "active" ? "selected" : "")"
           style="--accent:#10b981;">
            <div class="kpi-value" style="color:#10b981;">@totalActive</div>
            <div class="kpi-label">Active</div>
        </a>
        <a asp-action="SolutionLibrary" asp-route-status="inactive"
           asp-route-search="@search" asp-route-stream="@stream" asp-route-gap="@gap"
           asp-route-subgroup="@subgroup" asp-route-timeline="@timeline"
           class="kpi-card @(status == "inactive" ? "selected" : "")"
           style="--accent:#6b7280;">
            <div class="kpi-value" style="color:#6b7280;">@totalInactive</div>
            <div class="kpi-label">Inactive</div>
        </a>
        <a asp-action="SolutionLibrary" asp-route-status="deleted"
           asp-route-search="@search" asp-route-stream="@stream" asp-route-gap="@gap"
           asp-route-subgroup="@subgroup" asp-route-timeline="@timeline"
           class="kpi-card @(status == "deleted" ? "selected" : "")"
           style="--accent:#ef4444;">
            <div class="kpi-value" style="color:#ef4444;">@totalDeleted</div>
            <div class="kpi-label">Deleted</div>
        </a>
    </div>

    <!-- Filter Panel -->
    <form id="filterForm" method="get" asp-action="SolutionLibrary">
        <div class="filter-panel">
            <div class="filter-title"><i class="bi bi-funnel"></i> Filters</div>
            <div class="filter-row">
                <div class="filter-group" style="min-width:200px;">
                    <label>Search</label>
                    <input type="text" name="search" value="@search" placeholder="Title, Solution ID..." />
                </div>
                <div class="filter-group">
                    <label>Stream</label>
                    <select name="stream">
                        <option value="">All</option>
                        <option value="Property Tax" selected="@(stream == "Property Tax")">Property Tax</option>
                        <option value="Non-Property" selected="@(stream == "Non-Property")">Non-Property</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Gap</label>
                    <select name="gap">
                        <option value="">All</option>
                        <option value="Coverage" selected="@(gap == "Coverage")">Coverage</option>
                        <option value="Compliance" selected="@(gap == "Compliance")">Compliance</option>
                        <option value="Valuation" selected="@(gap == "Valuation")">Valuation</option>
                        <option value="Liability" selected="@(gap == "Liability")">Liability</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Subgroup</label>
                    <select name="subgroup">
                        <option value="">All</option>
                        <option value="A" selected="@(subgroup == "A")">A - Business Licences</option>
                        <option value="B" selected="@(subgroup == "B")">B - Service Fees</option>
                        <option value="C" selected="@(subgroup == "C")">C - Daily Charges</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Timeline</label>
                    <select name="timeline">
                        <option value="">All</option>
                        <option value="<1 year" selected="@(timeline == "<1 year")">&lt;1 year</option>
                        <option value="1-3 years" selected="@(timeline == "1-3 years")">1-3 years</option>
                        <option value="2-4 years" selected="@(timeline == "2-4 years")">2-4 years</option>
                        <option value="3+ years" selected="@(timeline == "3+ years")">3+ years</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Status</label>
                    <select name="status">
                        <option value="" selected="@(string.IsNullOrEmpty(status))">All (non-deleted)</option>
                        <option value="active" selected="@(status == "active")">Active</option>
                        <option value="inactive" selected="@(status == "inactive")">Inactive</option>
                        <option value="deleted" selected="@(status == "deleted")">Deleted</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-filter"><i class="bi bi-search me-1"></i> Filter</button>
                    @if (hasFilters)
                    {
                        <a asp-action="SolutionLibrary" class="btn-clear"><i class="bi bi-x-lg me-1"></i> Clear</a>
                    }
                </div>
            </div>
        </div>
    </form>

    <!-- Cards Table -->
    <div class="table-card">
        <div class="table-toolbar">
            <div class="table-toolbar-left">
                <div class="section-icon" style="background:#00689D;"><i class="bi bi-card-checklist"></i></div>
                <h5>Solution Cards <small class="fw-normal ms-2">(<strong>@rangeStart</strong>-<strong>@rangeEnd</strong> of <strong>@totalCount</strong> cards)</small></h5>
            </div>
        </div>

        <div class="table-scroll">
            <table class="data-table" id="cardsTable">
                <thead>
                    <tr>
                        <th>Solution ID</th>
                        <th>Title</th>
                        <th>Stream</th>
                        <th>Gap</th>
                        <th>Subgroup</th>
                        <th>Timeline</th>
                        <th>Difficulty</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var card in Model)
                        {
                            var gapClass = card.Gap?.ToLower() switch {
                                "compliance" => "gap-compliance",
                                "coverage" => "gap-coverage",
                                "valuation" => "gap-valuation",
                                "liability" => "gap-liability",
                                _ => ""
                            };
                            var gapBadgeClass = card.Gap?.ToLower() switch {
                                "compliance" => "compliance",
                                "coverage" => "coverage",
                                "valuation" => "valuation",
                                "liability" => "liability",
                                _ => ""
                            };
                            var streamBadgeClass = card.StreamType == "property-based" ? "stream-pt" : "stream-np";
                            var statusClass = card.IsDeleted ? "deleted" : (card.IsActive ? "active" : "inactive");
                            var statusLabel = card.IsDeleted ? "Deleted" : (card.IsActive ? "Active" : "Inactive");

                            var diffColor = card.DeliveryDifficulty?.ToLower() switch {
                                "low" => "background:#D1FAE5; color:#065F46;",
                                "medium" => "background:#FEF3C7; color:#92400E;",
                                "high" => "background:#FEE2E2; color:#991B1B;",
                                _ => "background:#F3F4F6; color:#6B7280;"
                            };

                            <tr class="@gapClass" data-card-id="@card.Id">
                                <td>
                                    <span style="font-weight:600; font-family:monospace; font-size:0.8125rem; color:#00689D;">@card.SolutionId</span>
                                </td>
                                <td class="title-cell" title="@card.Title" style="white-space:normal; min-width:200px;">
                                    <span style="font-weight:500;">@card.Title</span>
                                    @if (!string.IsNullOrEmpty(card.ShortTitle))
                                    {
                                        <br /><span style="font-size:0.6875rem; color:#6A6A6A;">@card.ShortTitle</span>
                                    }
                                </td>
                                <td><span class="stream-badge @streamBadgeClass">@card.Stream</span></td>
                                <td><span class="gap-badge @gapBadgeClass">@card.Gap</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(card.Subgroup))
                                    {
                                        <span style="font-weight:500;">@card.Subgroup</span>
                                    }
                                    else
                                    {
                                        <span style="color:#ccc;">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(card.Timeline))
                                    {
                                        <span style="font-size:0.75rem;">@card.Timeline</span>
                                    }
                                    else
                                    {
                                        <span style="color:#ccc;">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(card.DeliveryDifficulty))
                                    {
                                        <span style="display:inline-flex; padding:0.15rem 0.45rem; border-radius:5px; font-size:0.6875rem; font-weight:600; @diffColor">@card.DeliveryDifficulty</span>
                                    }
                                    else
                                    {
                                        <span style="color:#ccc;">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        <i class="bi bi-circle-fill"></i>
                                        @statusLabel
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="EditSolutionCard" asp-route-id="@card.Id"
                                           class="btn-action edit" title="Edit card">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (!card.IsDeleted)
                                        {
                                            <button type="button"
                                                    class="btn-action @(card.IsActive ? "toggle-on" : "toggle-off") toggle-btn"
                                                    data-id="@card.Id" data-active="@(card.IsActive ? "true" : "false")"
                                                    data-title="@card.SolutionId"
                                                    title="@(card.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi bi-@(card.IsActive ? "toggle-on" : "toggle-off")"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn-action delete delete-btn"
                                                    data-id="@card.Id" data-title="@card.SolutionId"
                                                    title="Delete card">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn-action restore restore-btn"
                                                    data-id="@card.Id" data-title="@card.SolutionId"
                                                    title="Restore card">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }

                                        <a asp-action="SolutionCardHistory" asp-route-id="@card.Id"
                                           class="btn-action history" title="View history">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="py-0">
                                <div class="empty-state">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-card-checklist"></i>
                                    </div>
                                    <p>No solution cards match the current filters</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="table-footer">
                <span class="result-count">
                    Showing <strong>@rangeStart</strong>-<strong>@rangeEnd</strong> of <strong>@totalCount</strong> cards
                </span>
                <nav>
                    <ul class="pagination">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("SolutionLibrary", new { page = currentPage - 1, search, stream, gap, subgroup, timeline, status })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("SolutionLibrary", new { page = i, search, stream, gap, subgroup, timeline, status })">@i</a>
                            </li>
                        }
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("SolutionLibrary", new { page = currentPage + 1, search, stream, gap, subgroup, timeline, status })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-modern">
            <div class="modal-header">
                <div class="modal-icon modal-icon--danger"><i class="bi bi-trash3"></i></div>
                <h5 class="modal-title">Delete Solution Card</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete card <strong id="deleteCardTitle"></strong>? This is a soft delete and the card can be restored later.</p>
                <input type="hidden" id="deleteCardId" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-modal-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-modal-danger" id="confirmDeleteBtn"><i class="bi bi-trash3 me-1"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-modern">
            <div class="modal-header">
                <div class="modal-icon modal-icon--purple"><i class="bi bi-upload"></i></div>
                <h5 class="modal-title">Import Solution Cards</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom:1rem;">Upload a JSON file containing solution card data. Cards with duplicate Solution IDs will be skipped.</p>
                <div style="border:1.5px dashed #cbd5e1; border-radius:10px; padding:1.25rem; text-align:center; background:#f8fafc;">
                    <i class="bi bi-file-earmark-code" style="font-size:1.6rem; color:#7c3aed; display:block; margin-bottom:0.5rem;"></i>
                    <input type="file" id="importFile" accept=".json" class="form-control form-control-sm" style="max-width:280px; margin:0 auto;" />
                    <p style="font-size:0.72rem; color:#94a3b8; margin:0.5rem 0 0;">Accepts .json files only</p>
                </div>
                <div id="importProgress" style="display:none; margin-top:0.85rem;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm" role="status" style="color:#7c3aed;"></div>
                        <span style="font-size:0.8rem; color:#475569;">Importing cards...</span>
                    </div>
                </div>
                <div id="importResult" style="display:none; margin-top:0.85rem; padding:0.7rem 0.85rem; border-radius:8px; font-size:0.8rem;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-modal-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-modal-purple" id="confirmImportBtn"><i class="bi bi-upload me-1"></i> Import</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast container for TempData messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div id="serverToast" class="success-toast">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="serverToast" class="error-toast">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Dynamic toast (for JS actions) -->
<div id="dynamicToast" style="display:none;"></div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        $(document).ready(function () {
            var token = $('input[name="__RequestVerificationToken"]').val();

            // ── Auto-dismiss server toast after 3 seconds ──
            var serverToast = document.getElementById('serverToast');
            if (serverToast) {
                setTimeout(function () {
                    serverToast.style.transition = 'opacity 0.3s, transform 0.3s';
                    serverToast.style.opacity = '0';
                    serverToast.style.transform = 'translateY(20px)';
                    setTimeout(function () { serverToast.remove(); }, 300);
                }, 3000);
            }

            // ── Show dynamic toast ──
            function showToast(message, type) {
                var existing = document.querySelectorAll('.success-toast, .error-toast');
                existing.forEach(function (el) { el.remove(); });

                var cls = type === 'success' ? 'success-toast' : 'error-toast';
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
                var toast = $('<div class="' + cls + '"><i class="bi ' + icon + '"></i><span>' + message + '</span></div>');
                $('body').append(toast);

                setTimeout(function () {
                    toast.css({ transition: 'opacity 0.3s, transform 0.3s', opacity: 0, transform: 'translateY(20px)' });
                    setTimeout(function () { toast.remove(); }, 300);
                }, 3000);
            }

            // ── Toggle Active/Inactive ──
            $('.toggle-btn').click(function () {
                var btn = $(this);
                var cardId = btn.data('id');
                var cardTitle = btn.data('title');
                var isActive = btn.data('active') === 'true' || btn.data('active') === true;

                $.ajax({
                    url: '@Url.Action("ToggleSolutionCardActive", "Admin")',
                    type: 'POST',
                    data: { id: cardId, __RequestVerificationToken: token },
                    success: function (r) {
                        if (r.success) {
                            showToast(cardTitle + ' has been ' + (isActive ? 'deactivated' : 'activated'), 'success');
                            // Update row in place
                            var row = $('tr[data-card-id="' + cardId + '"]');
                            var badge = row.find('.status-badge');
                            if (isActive) {
                                badge.removeClass('active').addClass('inactive').html('<i class="bi bi-circle-fill"></i> Inactive');
                                btn.removeClass('toggle-on').addClass('toggle-off').data('active', 'false').attr('title', 'Activate');
                                btn.html('<i class="bi bi-toggle-off"></i>');
                            } else {
                                badge.removeClass('inactive').addClass('active').html('<i class="bi bi-circle-fill"></i> Active');
                                btn.removeClass('toggle-off').addClass('toggle-on').data('active', 'true').attr('title', 'Deactivate');
                                btn.html('<i class="bi bi-toggle-on"></i>');
                            }
                        } else {
                            showToast(r.message || 'Failed to toggle card status', 'error');
                        }
                    },
                    error: function () {
                        showToast('An error occurred while toggling card status', 'error');
                    }
                });
            });

            // ── Delete: show modal ──
            $('.delete-btn').click(function () {
                var cardId = $(this).data('id');
                var cardTitle = $(this).data('title');
                $('#deleteCardId').val(cardId);
                $('#deleteCardTitle').text(cardTitle);
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            });

            // ── Delete: confirm ──
            $('#confirmDeleteBtn').click(function () {
                var cardId = $('#deleteCardId').val();

                $.ajax({
                    url: '@Url.Action("DeleteSolutionCard", "Admin")',
                    type: 'POST',
                    data: { id: cardId, __RequestVerificationToken: token },
                    success: function (r) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        if (r.success) {
                            showToast('Card deleted successfully', 'success');
                            setTimeout(function () { location.reload(); }, 800);
                        } else {
                            showToast(r.message || 'Failed to delete card', 'error');
                        }
                    },
                    error: function () {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        showToast('An error occurred while deleting the card', 'error');
                    }
                });
            });

            // ── Restore ──
            $('.restore-btn').click(function () {
                var btn = $(this);
                var cardId = btn.data('id');
                var cardTitle = btn.data('title');

                $.ajax({
                    url: '@Url.Action("RestoreSolutionCard", "Admin")',
                    type: 'POST',
                    data: { id: cardId, __RequestVerificationToken: token },
                    success: function (r) {
                        if (r.success) {
                            showToast(cardTitle + ' has been restored', 'success');
                            setTimeout(function () { location.reload(); }, 800);
                        } else {
                            showToast(r.message || 'Failed to restore card', 'error');
                        }
                    },
                    error: function () {
                        showToast('An error occurred while restoring the card', 'error');
                    }
                });
            });

            // ── Import ──
            $('#confirmImportBtn').click(function () {
                var fileInput = document.getElementById('importFile');
                if (!fileInput.files.length) {
                    showToast('Please select a JSON file to import', 'error');
                    return;
                }

                var formData = new FormData();
                formData.append('file', fileInput.files[0]);
                formData.append('__RequestVerificationToken', token);

                $('#importProgress').show();
                $('#importResult').hide();
                $('#confirmImportBtn').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ImportSolutionCards", "Admin")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (r) {
                        $('#importProgress').hide();
                        $('#confirmImportBtn').prop('disabled', false);

                        if (r.success) {
                            $('#importResult')
                                .css({ background: '#D1FAE5', color: '#065F46' })
                                .html('<i class="bi bi-check-circle-fill me-1"></i> ' + r.message)
                                .show();
                            setTimeout(function () { location.reload(); }, 1500);
                        } else {
                            $('#importResult')
                                .css({ background: '#FEE2E2', color: '#991B1B' })
                                .html('<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (r.message || 'Import failed'))
                                .show();
                        }
                    },
                    error: function () {
                        $('#importProgress').hide();
                        $('#confirmImportBtn').prop('disabled', false);
                        $('#importResult')
                            .css({ background: '#FEE2E2', color: '#991B1B' })
                            .html('<i class="bi bi-exclamation-triangle-fill me-1"></i> An error occurred during import')
                            .show();
                    }
                });
            });
        });
    </script>
}
