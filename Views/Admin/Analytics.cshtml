@{
    ViewData["Title"] = "Analytics Dashboard";

    var reportsByStatus = ViewBag.ReportsByStatus as dynamic;
    var reportsByCountry = ViewBag.ReportsByCountry as dynamic;
    var cardsByStream = ViewBag.CardsByStream as dynamic;
    var cardsByGap = ViewBag.CardsByGap as dynamic;
    var cardsByTimeline = ViewBag.CardsByTimeline as dynamic;
    var topSelectedCards = ViewBag.TopSelectedCards as dynamic;
}

@section Styles {
    <style>
        :root {
            --brand: #00689D;
            --brand-dark: #004d73;
            --brand-soft: rgba(0, 104, 157, 0.08);
            --ink-1: #0f172a;
            --ink-2: #475569;
            --ink-3: #94a3b8;
            --line: #e5e7eb;
            --line-soft: #f1f5f9;
            --surface: #ffffff;
            --surface-2: #f8fafc;
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05), 0 2px 8px rgba(15, 23, 42, 0.05), 0 8px 24px rgba(15, 23, 42, 0.04);
            --shadow-md: 0 2px 4px rgba(15, 23, 42, 0.06), 0 6px 16px rgba(15, 23, 42, 0.08), 0 16px 40px rgba(15, 23, 42, 0.06);
            --radius: 12px;
            --radius-sm: 8px;
        }

        body, .admin-main { background: #ffffff !important; }
        .container.py-4 { padding-top: 1.25rem !important; padding-bottom: 1.25rem !important; }

        /* ── Page Header ── */
        .admin-page-header {
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: var(--radius);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-sm);
        }
        .admin-page-header-icon {
            width: 42px; height: 42px; border-radius: 10px;
            background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%);
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.1rem; flex-shrink: 0;
        }
        .admin-page-header h1 {
            color: var(--ink-1); font-weight: 600; font-size: 1.15rem;
            margin: 0 0 0.1rem; letter-spacing: -0.01em;
        }
        .admin-page-header p { color: var(--ink-2); font-size: 0.82rem; margin: 0; }
        .btn-back {
            background: var(--surface);
            color: var(--ink-1);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            font-weight: 500;
            font-size: 0.82rem;
            padding: 0.5rem 0.95rem;
            transition: background 0.15s, border-color 0.15s;
            text-decoration: none;
            display: inline-flex; align-items: center;
        }
        .btn-back:hover { background: var(--surface-2); border-color: #cbd5e1; color: var(--ink-1); }

        /* ── KPI Stat Cards (matches dashboard) ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: var(--radius);
            padding: 1.15rem 1.25rem;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.25s ease, transform 0.2s ease;
        }
        .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
        .stat-content { display: flex; align-items: center; gap: 0.85rem; }
        .stat-icon {
            width: 40px; height: 40px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1rem; flex-shrink: 0;
        }
        .stat-icon.blue   { background: linear-gradient(135deg, #00689D 0%, #0084c7 100%); }
        .stat-icon.green  { background: linear-gradient(135deg, #059669 0%, #10b981 100%); }
        .stat-icon.amber  { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); }
        .stat-icon.purple { background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%); }
        .stat-details { flex: 1; min-width: 0; }
        .stat-number {
            font-size: 1.35rem; font-weight: 600; color: var(--ink-1);
            line-height: 1.1; margin-bottom: 0.15rem; letter-spacing: -0.01em;
        }
        .stat-label {
            font-size: 0.72rem; color: var(--ink-2); font-weight: 500;
            text-transform: uppercase; letter-spacing: 0.04em;
        }

        /* ── Chart Sections ── */
        .chart-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
            margin-bottom: 1.25rem;
        }
        .chart-card {
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: var(--radius);
            padding: 1.25rem 1.4rem;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.25s ease, transform 0.2s ease;
        }
        .chart-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

        .chart-card h5 {
            display: flex; align-items: center; gap: 0.6rem;
            color: var(--ink-1);
            font-size: 0.95rem; font-weight: 600;
            margin: 0 0 1rem;
            letter-spacing: -0.005em;
        }
        .chart-card h5 .chart-icon {
            width: 28px; height: 28px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 0.8rem; flex-shrink: 0;
        }
        .chart-icon.brand  { background: linear-gradient(135deg, var(--brand) 0%, #0084c7 100%); }
        .chart-icon.purple { background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%); }
        .chart-icon.amber  { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); }
        .chart-icon.green  { background: linear-gradient(135deg, #059669 0%, #10b981 100%); }

        /* ── Stat Bars ── */
        .stat-bar {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--line-soft);
        }
        .stat-bar:last-child { border-bottom: none; }
        .stat-bar .bar-label {
            flex: 0 0 130px;
            font-size: 0.78rem; color: var(--ink-2); font-weight: 500;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .stat-bar .bar-fill {
            flex: 1; height: 8px;
            background: var(--surface-2);
            border-radius: 999px;
            overflow: hidden;
        }
        .stat-bar .bar-fill-inner {
            height: 100%; border-radius: 999px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-bar .bar-count {
            flex: 0 0 auto; min-width: 36px;
            text-align: right;
            font-weight: 600; font-size: 0.78rem; color: var(--ink-1);
            font-variant-numeric: tabular-nums;
        }

        /* ── Top Cards List ── */
        .top-cards-list { list-style: none; padding: 0; margin: 0; counter-reset: rank; }
        .top-cards-list li {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.6rem 0;
            border-bottom: 1px solid var(--line-soft);
            counter-increment: rank;
        }
        .top-cards-list li:last-child { border-bottom: none; }
        .top-cards-list li::before {
            content: counter(rank);
            width: 24px; height: 24px;
            display: flex; align-items: center; justify-content: center;
            background: var(--surface-2);
            color: var(--ink-2);
            border-radius: 6px;
            font-size: 0.72rem; font-weight: 600;
            flex-shrink: 0;
        }
        .top-cards-list li:nth-child(1)::before { background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); color: white; }
        .top-cards-list li:nth-child(2)::before { background: linear-gradient(135deg, #94a3b8 0%, #cbd5e1 100%); color: white; }
        .top-cards-list li:nth-child(3)::before { background: linear-gradient(135deg, #92400e 0%, #d97706 100%); color: white; }
        .top-cards-list .card-id {
            flex: 1;
            font-weight: 600; color: var(--brand);
            font-size: 0.82rem;
            font-family: 'Roboto Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .top-cards-list .card-count {
            background: var(--brand-soft);
            color: var(--brand);
            padding: 0.2rem 0.65rem;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 600;
            white-space: nowrap;
        }

        /* ── Empty state ── */
        .chart-card .text-muted {
            color: var(--ink-3) !important;
            font-size: 0.82rem;
        }

        @@media (max-width: 768px) {
            .chart-section { grid-template-columns: 1fr; }
            .stat-bar .bar-label { flex: 0 0 100px; font-size: 0.72rem; }
        }
    </style>
}

<div class="container py-4">
    <!-- Header -->
    <div class="admin-page-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-page-header-icon">
                <i class="bi bi-graph-up"></i>
            </div>
            <div>
                <h1>Analytics Dashboard</h1>
                <p>Insights across reports, users and solution cards</p>
            </div>
        </div>
        <a href="@Url.Action("Index")" class="btn-back">
            <i class="bi bi-arrow-left me-2"></i>Dashboard
        </a>
    </div>

    <!-- KPI Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon blue"><i class="bi bi-file-earmark-text-fill"></i></div>
                <div class="stat-details">
                    <div class="stat-number">@ViewBag.TotalReports</div>
                    <div class="stat-label">Total Reports</div>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon green"><i class="bi bi-people-fill"></i></div>
                <div class="stat-details">
                    <div class="stat-number">@ViewBag.TotalUsers</div>
                    <div class="stat-label">Total Users</div>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon amber"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-details">
                    <div class="stat-number">@ViewBag.ActiveUsers</div>
                    <div class="stat-label">Active Users</div>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-icon purple"><i class="bi bi-layers-fill"></i></div>
                <div class="stat-details">
                    <div class="stat-number">@ViewBag.TotalCards</div>
                    <div class="stat-label">Solution Cards</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="chart-section">
        <!-- Reports by Status -->
        <div class="chart-card">
            <h5><span class="chart-icon brand"><i class="bi bi-pie-chart-fill"></i></span>Reports by Status</h5>
            @if (reportsByStatus != null)
            {
                var statusColors = new Dictionary<string, string> { { "Draft", "#94a3b8" }, { "Submitted", "#3b82f6" }, { "UnderReview", "#f59e0b" }, { "NeedsRevision", "#ef4444" }, { "Validated", "#10b981" } };
                var maxStatus = 1;
                foreach (var s in reportsByStatus) { if (s.Count > maxStatus) maxStatus = s.Count; }
                foreach (var status in reportsByStatus)
                {
                    var color = statusColors.ContainsKey((string)status.Status) ? statusColors[(string)status.Status] : "#94a3b8";
                    var pct = (int)((double)status.Count / maxStatus * 100);
                    <div class="stat-bar">
                        <span class="bar-label">@status.Status</span>
                        <div class="bar-fill"><div class="bar-fill-inner" style="width:@(pct)%; background-color:@color;"></div></div>
                        <span class="bar-count">@status.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No data available.</p>
            }
        </div>

        <!-- Reports by Country -->
        <div class="chart-card">
            <h5><span class="chart-icon brand"><i class="bi bi-globe2"></i></span>Top Countries</h5>
            @if (reportsByCountry != null)
            {
                var maxCountry = 1;
                foreach (var c in reportsByCountry) { if (c.Count > maxCountry) maxCountry = c.Count; }
                foreach (var country in reportsByCountry)
                {
                    var pct = (int)((double)country.Count / maxCountry * 100);
                    <div class="stat-bar">
                        <span class="bar-label" title="@country.Country">@country.Country</span>
                        <div class="bar-fill"><div class="bar-fill-inner" style="width:@(pct)%; background-color:#00689D;"></div></div>
                        <span class="bar-count">@country.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No data available.</p>
            }
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="chart-section">
        <!-- Cards by Gap -->
        <div class="chart-card">
            <h5><span class="chart-icon purple"><i class="bi bi-layers-fill"></i></span>Solution Cards by Gap Type</h5>
            @if (cardsByGap != null)
            {
                var gapColors = new Dictionary<string, string> { { "Compliance", "#ef4444" }, { "Coverage", "#f59e0b" }, { "Valuation", "#3b82f6" }, { "Liability", "#7c3aed" } };
                var maxGap = 1;
                foreach (var g in cardsByGap) { if (g.Count > maxGap) maxGap = g.Count; }
                foreach (var gap in cardsByGap)
                {
                    var color = gapColors.ContainsKey((string)gap.Gap) ? gapColors[(string)gap.Gap] : "#94a3b8";
                    var pct = (int)((double)gap.Count / maxGap * 100);
                    <div class="stat-bar">
                        <span class="bar-label">@gap.Gap</span>
                        <div class="bar-fill"><div class="bar-fill-inner" style="width:@(pct)%; background-color:@color;"></div></div>
                        <span class="bar-count">@gap.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No data available.</p>
            }
        </div>

        <!-- Top Selected Solution Cards -->
        <div class="chart-card">
            <h5><span class="chart-icon amber"><i class="bi bi-trophy-fill"></i></span>Most Selected Solution Cards</h5>
            @if (topSelectedCards != null && ((IEnumerable<dynamic>)topSelectedCards).Any())
            {
                <ol class="top-cards-list">
                    @foreach (var card in topSelectedCards)
                    {
                        <li>
                            <span class="card-id">@card.SolutionId</span>
                            <span class="card-count">@card.Count reports</span>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="text-muted">No solution selections found across reports.</p>
            }
        </div>
    </div>

    <!-- Charts Row 3 -->
    <div class="chart-section">
        <!-- Cards by Timeline -->
        <div class="chart-card">
            <h5><span class="chart-icon green"><i class="bi bi-clock-fill"></i></span>Solution Cards by Timeline</h5>
            @if (cardsByTimeline != null)
            {
                var timeColors = new Dictionary<string, string> { { "<1 year", "#10b981" }, { "1-3 years", "#f59e0b" }, { "2-4 years", "#f97316" }, { "3+ years", "#ef4444" } };
                var maxTime = 1;
                foreach (var t in cardsByTimeline) { if (t.Count > maxTime) maxTime = t.Count; }
                foreach (var tl in cardsByTimeline)
                {
                    var color = timeColors.ContainsKey((string)tl.Timeline) ? timeColors[(string)tl.Timeline] : "#94a3b8";
                    var pct = (int)((double)tl.Count / maxTime * 100);
                    <div class="stat-bar">
                        <span class="bar-label">@tl.Timeline</span>
                        <div class="bar-fill"><div class="bar-fill-inner" style="width:@(pct)%; background-color:@color;"></div></div>
                        <span class="bar-count">@tl.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No data available.</p>
            }
        </div>

        <!-- Cards by Stream -->
        <div class="chart-card">
            <h5><span class="chart-icon brand"><i class="bi bi-collection-fill"></i></span>Solution Cards by Stream</h5>
            @if (cardsByStream != null)
            {
                var maxStream = 1;
                foreach (var s in cardsByStream) { if (s.Count > maxStream) maxStream = s.Count; }
                foreach (var stream in cardsByStream)
                {
                    var pct = (int)((double)stream.Count / maxStream * 100);
                    <div class="stat-bar">
                        <span class="bar-label">@stream.Stream</span>
                        <div class="bar-fill"><div class="bar-fill-inner" style="width:@(pct)%; background-color:#00689D;"></div></div>
                        <span class="bar-count">@stream.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No data available.</p>
            }
        </div>
    </div>
</div>
