@model RosraApp.Models.ViewModels.RosraFormViewModel
@{
    Layout = null;
    ViewData["ViewMode"] = true;
    var cs = Model.CurrencySymbol ?? "$";
}
@functions {
    public string GetCountryCode(string country)
    {
        if (string.IsNullOrEmpty(country)) return "";
        var codes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            {"Kenya","ke"},{"Nigeria","ng"},{"South Africa","za"},{"Egypt","eg"},{"Ethiopia","et"},
            {"Ghana","gh"},{"Tanzania","tz"},{"Uganda","ug"},{"Rwanda","rw"},{"Morocco","ma"},
            {"Algeria","dz"},{"Senegal","sn"},{"Cameroon","cm"},{"Zambia","zm"},{"Zimbabwe","zw"},
            {"Botswana","bw"},{"Namibia","na"},{"Mozambique","mz"},{"Mali","ml"},{"Burkina Faso","bf"},
            {"Ivory Coast","ci"},{"Cote d'Ivoire","ci"},{"Malawi","mw"},{"Benin","bj"},{"Togo","tg"},
            {"Niger","ne"},{"Sierra Leone","sl"},{"Liberia","lr"},
            {"United Kingdom","gb"},{"UK","gb"},{"Britain","gb"},{"France","fr"},{"Germany","de"},
            {"Italy","it"},{"Spain","es"},{"Netherlands","nl"},{"Belgium","be"},{"Switzerland","ch"},
            {"Sweden","se"},{"Norway","no"},{"Portugal","pt"},{"Poland","pl"},{"Denmark","dk"},
            {"Finland","fi"},{"Austria","at"},{"Ireland","ie"},{"Greece","gr"},{"Czech Republic","cz"},
            {"Romania","ro"},{"Hungary","hu"},
            {"United States","us"},{"United States of America","us"},{"USA","us"},{"Canada","ca"},
            {"Mexico","mx"},{"Brazil","br"},{"Argentina","ar"},{"Chile","cl"},{"Colombia","co"},
            {"Peru","pe"},{"Venezuela","ve"},{"Ecuador","ec"},{"Bolivia","bo"},{"Paraguay","py"},
            {"Uruguay","uy"},{"Costa Rica","cr"},{"Panama","pa"},{"Guatemala","gt"},{"Honduras","hn"},
            {"El Salvador","sv"},{"Nicaragua","ni"},{"Jamaica","jm"},{"Trinidad and Tobago","tt"},
            {"China","cn"},{"India","in"},{"Japan","jp"},{"Singapore","sg"},{"South Korea","kr"},
            {"Korea","kr"},{"Thailand","th"},{"Indonesia","id"},{"Malaysia","my"},{"Philippines","ph"},
            {"Vietnam","vn"},{"Pakistan","pk"},{"Bangladesh","bd"},{"Sri Lanka","lk"},{"Nepal","np"},
            {"Myanmar","mm"},{"Cambodia","kh"},{"Taiwan","tw"},{"Hong Kong","hk"},
            {"UAE","ae"},{"United Arab Emirates","ae"},{"Saudi Arabia","sa"},{"Israel","il"},
            {"Turkey","tr"},{"Iran","ir"},{"Iraq","iq"},{"Jordan","jo"},{"Lebanon","lb"},
            {"Kuwait","kw"},{"Qatar","qa"},{"Oman","om"},{"Bahrain","bh"},
            {"Australia","au"},{"New Zealand","nz"},{"Fiji","fj"},{"Papua New Guinea","pg"},
            {"Russia","ru"},{"Ukraine","ua"},{"Kazakhstan","kz"},{"Uzbekistan","uz"}
        };
        return codes.TryGetValue(country, out var code) ? code : "";
    }
}
@{
    var countryCode = GetCountryCode(Model.Country);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="~/images/LogoFavicon.png" />
    <title>@SharedLocalizer["Diagnostic_ReportTitle"] — @(Model.Country ?? "ROSRA")</title>
    <link rel="stylesheet" href="~/lib/roboto/roboto.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RosraApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/flag-icons/css/flag-icons.min.css" asp-append-version="true" />
    <style>
        * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }
        body { font-family: 'Roboto', sans-serif; margin: 0; padding: 0; background: #fff; }

        /* ============================
           COVER PAGE
           ============================ */
        .report-box {
            max-width: 960px;
            margin: 0 auto;
            background: #fff;
            overflow: hidden;
        }

        .cover-page {
            width: 100%;
            min-height: 100vh;
            background: #009EDB;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            page-break-after: always;
            box-sizing: border-box;
        }

        /* City background image overlay */
        .cover-bg-image {
            position: absolute;
            inset: 0;
            z-index: 0;
        }
        .cover-bg-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.12;
        }
        /* Solid color overlay on top of bg image */
        .cover-page::before {
            content: '';
            position: absolute;
            inset: 0;
            background: #009EDB;
            opacity: 0.88;
            z-index: 0;
        }

        /* ── Top section with circles ── */
        .cover-top {
            position: relative;
            z-index: 1;
            flex: 1;
            min-height: 420px;
        }

        /* Main large circle with city image */
        .cover-circle-main {
            width: 340px;
            height: 340px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px dashed rgba(255,255,255,0.25);
            position: absolute;
            top: 60px;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: none;
            z-index: 1;
        }
        .cover-circle-main img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Small accent squares */
        .cover-circle-sm {
            width: 75px;
            height: 75px;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid rgba(255,255,255,0.3);
            position: absolute;
            z-index: 2;
            box-shadow: none;
        }
        .cover-circle-sm img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        /* Top-right */
        .cover-circle-sm-1 { top: 50px; left: calc(50% + 170px); }
        /* Bottom-left — overlapping main circle edge */
        .cover-circle-sm-2 { top: 330px; left: calc(50% - 200px); }
        /* Right — mid height */
        .cover-circle-sm-3 { top: 200px; left: calc(50% + 185px); }

        /* Decorative dashed orbit ring */
        .cover-orbit {
            position: absolute;
            width: 420px;
            height: 420px;
            border: 2px dashed rgba(255,255,255,0.12);
            border-radius: 50%;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 0;
        }

        /* ── Title section ── */
        .cover-title-section {
            position: relative;
            z-index: 2;
            padding: 0 50px 0 50px;
        }
        .cover-title {
            font-size: 44px;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.15;
            margin: 0 0 12px;
            text-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }
        /* Longer concise subtitle from the v2 brief — smaller font, capped width so it wraps cleanly */
        .cover-subtitle {
            font-size: 14px;
            font-weight: 400;
            color: rgba(255,255,255,0.9);
            line-height: 1.45;
            max-width: 620px;
            margin: 0 0 20px;
        }
        .cover-location {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .cover-flag {
            font-size: 32px;
            line-height: 1;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: none;
        }
        .cover-country-name {
            font-size: 26px;
            font-weight: 500;
            color: #fff;
        }
        .cover-location-detail {
            font-size: 15px;
            color: rgba(255,255,255,0.75);
            margin-top: 2px;
        }
        .cover-location-detail span + span::before {
            content: '  |  ';
            opacity: 0.5;
        }

        /* ── Bottom geometric blocks ── */
        .cover-bottom {
            position: relative;
            z-index: 1;
            height: 220px;
            margin-top: auto;
            overflow: hidden;
        }
        /* Color blocks — UN-Habitat blue palette */
        .cover-block {
            position: absolute;
            border-radius: 0;
        }
        .cover-block-1 {
            width: 120px; height: 220px;
            background: #00b2e3;
            left: 0; bottom: 0;
        }
        .cover-block-2 {
            width: 140px; height: 140px;
            left: 120px; bottom: 80px;
            overflow: hidden;
            border-radius: 4px;
        }
        .cover-block-2 img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .cover-block-3 {
            width: 140px; height: 80px;
            background: #00689D;
            left: 120px; bottom: 0;
        }
        /* Large decorative circle */
        .cover-circle-deco {
            width: 320px;
            height: 320px;
            border-radius: 50%;
            position: absolute;
            right: -20px;
            bottom: -60px;
            overflow: hidden;
        }
        .cover-circle-deco-inner {
            width: 100%;
            height: 100%;
            position: relative;
        }
        .cover-circle-deco-inner::before {
            content: '';
            position: absolute;
            width: 50%;
            height: 100%;
            left: 0;
            background: #005a87;
        }
        .cover-circle-deco-inner::after {
            content: '';
            position: absolute;
            width: 50%;
            height: 100%;
            right: 0;
            background: #00b2e3;
        }
        /* Accent circle overlap */
        .cover-circle-accent {
            width: 260px;
            height: 260px;
            border: 2px dashed rgba(255,255,255,0.15);
            border-radius: 50%;
            position: absolute;
            right: 80px;
            bottom: -30px;
        }


        /* ── SDG strip on cover ── */
        .cover-sdg-strip {
            position: absolute;
            bottom: 80px;
            right: 30px;
            z-index: 3;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .cover-sdg-strip img.sdg-goal {
            height: 50px;
            border-radius: 3px;
        }
        .cover-sdg-strip img.sdg-wheel {
            height: 44px;
        }

        /* ============================
           REPORT CONTENT (page 2+)
           ============================ */
        .report-content {
            padding: 30px 35px;
            font-size: 0.8rem;
        }
        .report-content table { font-size: 0.8rem !important; }
        .report-content table td, .report-content table th { padding: 6px 8px !important; }
        .report-content h6 { font-size: 0.85rem !important; }
        .report-content .card-header h6 { font-size: 0.8rem !important; }
        .report-content-header {
            background: #009EDB;
            color: white;
            padding: 18px 25px;
            border-radius: 8px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .report-content-header h2 {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
        }
        .report-content-header .header-meta {
            font-size: 11px;
            opacity: 0.85;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .report-content-header .header-flag { font-size: 16px; border-radius: 2px; overflow: hidden; }
        .print-section { margin-bottom: 30px; }
        .print-section-title { color: #00689D; font-size: 16px; font-weight: 700; border-bottom: 2px solid #00b2e3; padding-bottom: 6px; margin-bottom: 15px; }

        /* ============================
           LG Profile data card (print-only)
           ============================
           The interactive editor uses a form-style config-card with inputs.
           In the printed diagnostic report we render a clean read-only data
           grid instead, then hide the form card via CSS below. This shows
           ALL LG Profile fields including the new EconomicProfile field. */
        .lg-profile-card {
            background: #ffffff;
            border: 1px solid #d1d9e0;
            border-radius: 8px;
            padding: 18px 22px;
            margin-bottom: 24px;
            break-inside: avoid;
            page-break-inside: avoid;
        }
        .lg-profile-card__header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 10px;
            margin-bottom: 12px;
            border-bottom: 1px solid #e2e8f0;
        }
        .lg-profile-card__flag {
            width: 36px;
            height: 26px;
            border-radius: 3px;
            object-fit: cover;
        }
        .lg-profile-card__title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
        }
        .lg-profile-card__subtitle {
            font-size: 0.78rem;
            color: #64748b;
        }
        .lg-profile-card__grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px 22px;
        }
        .lg-profile-field {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .lg-profile-field__label {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
        }
        .lg-profile-field__value {
            font-size: 0.92rem;
            font-weight: 600;
            color: #0f172a;
        }
        .lg-profile-field__value--muted {
            font-style: italic;
            color: #94a3b8;
            font-weight: 400;
        }

        /* Report section intro — What this shows / Why it matters / How to read */
        .report-section-intro { margin: 4px 0 18px; padding: 12px 16px; background: #f3f8fb; border-left: 3px solid #00b2e3; border-radius: 4px; }
        .report-section-intro p { margin: 0 0 8px; font-size: 0.78rem; color: #334; line-height: 1.5; }
        .report-section-intro p:last-child { margin-bottom: 0; }
        .report-section-intro .report-section-eyebrow { display: block; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #00689D; margin-bottom: 2px; }
        .report-section-body { font-size: 0.78rem; color: #334; line-height: 1.55; margin: 4px 0 18px; }

        /* ── Footer ── */
        .print-footer { margin-top: 30px; padding: 15px 20px 0; border-top: 2px solid #00689D; font-size: 9px; color: #868e96; }
        .print-footer-content { display: flex; align-items: center; justify-content: space-between; }
        .print-footer-left { display: flex; align-items: center; gap: 10px; }
        .print-footer-left img { height: 28px; object-fit: contain; }
        .print-footer-right { display: flex; align-items: center; gap: 6px; }
        .print-footer-right .sdg-footer-goal { height: 32px; border-radius: 2px; }
        .print-footer-right .sdg-footer-logo { height: 38px; margin-left: 4px; }
        .print-footer-center { text-align: center; font-size: 9px; color: #868e96; margin-top: 8px; }

        /* ── Hide interactive / irrelevant elements ── */
        .btn, button:not(.print-btn), .no-print,
        .tooltip-trigger .info-btn,
        .peer-data-section, .peer-upload-section, .custom-peer-section,
        .currency-override-toggle, .currency-override-select, #currencyOverrideRow,
        .form-check, .collapse-toggle-btn,
        #financialMetricsSection,
        .gov-unit-helper,
        .module2-selection,
        .frontier-placeholder { display: none !important; }

        /* Hide the form-style LG Profile config-card from _PotentialEstimates —
           the printable LG Profile data card above replaces it. Hidden form
           inputs are still in the DOM so seed-script logic that references
           #country, #financialYear, etc. continues to work. */
        .report-content .config-card { display: none !important; }

        /* Force the WoFi Quick OSR Estimate panel + its chart visible in
           the report (in the editor it's hidden until "Get Analysis" is
           clicked). The chart is rendered into #actualVsPotentialChart;
           keeping wofiContent shown lets Chart.js draw on first compute. */
        .report-content #analysisPanelWrap { display: block !important; }
        .report-content #wofiContent { display: block !important; }
        .report-content #wofiPlaceholder { display: none !important; }
        .report-content .next-step-cta-wrap { display: none !important; }

        /* ── Form elements as static text (TopDown) ── */
        .form-control, .form-select, select, input[type="text"], input[type="number"] {
            border: none !important;
            background: transparent !important;
            box-shadow: none !important;
            appearance: none !important;
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            pointer-events: none !important;
            font-weight: 500 !important;
            color: #212529 !important;
            padding-left: 2px !important;
            opacity: 1 !important;
        }
        .collapse { display: block !important; }
        [data-bs-toggle] { cursor: default !important; }

        /* ── Bottom-Up specific: hide input columns, keep in DOM for JS ── */
        .col-lg-4 { position: absolute !important; left: -9999px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; }
        .col-lg-8 { flex: 0 0 100% !important; max-width: 100% !important; width: 100% !important; }
        .sidebar, .nav, .report-content button, textarea,
        .gap-tabs-nav, .gap-tab-btn { display: none !important; }
        /* Show selects as static text (BottomUp) */
        select, .form-select {
            background-image: none !important;
            width: auto !important;
            font-size: 0.75rem !important;
            padding: 0 !important;
        }
        .row { margin: 0 !important; }
        .print-section .card { margin-bottom: 12px; }

        /* ── Fix matrix label clipping ── */
        .matrix-container { overflow: visible !important; margin-top: 15px !important; }

        /* ── Force col-md grid to stay side by side (Prioritization) ── */
        .prioritization-module .col-md-3 { flex: 0 0 25% !important; max-width: 25% !important; }
        .prioritization-module .col-md-6 { flex: 0 0 50% !important; max-width: 50% !important; }

        /* ── Scale down prioritization section ── */
        .prioritization-module { font-size: 0.75rem !important; }
        .prioritization-module table { font-size: 0.75rem !important; }
        .prioritization-module table td, .prioritization-module table th { font-size: 0.75rem !important; padding: 6px 8px !important; }
        .prioritization-module .rank-badge { width: 24px !important; height: 24px !important; font-size: 0.7rem !important; }
        .prioritization-module .priority-number { width: 20px !important; height: 20px !important; font-size: 0.65rem !important; }
        .prioritization-module .card-header h6 { font-size: 0.85rem !important; }
        .prioritization-module h3 { font-size: 1rem !important; }
        .prioritization-module h4, .prioritization-module .h4 { font-size: 0.95rem !important; }
        .prioritization-module h5 { font-size: 0.9rem !important; }
        .prioritization-module h6 { font-size: 0.75rem !important; }
        .prioritization-module .card-body { padding: 0.75rem !important; }
        .prioritization-module .text-muted.small, .prioritization-module p { font-size: 0.75rem !important; }

        /* ── Constrain prioritization charts ── */
        .prioritization-module canvas { max-height: 200px !important; }
        .prioritization-module .col-md-7,
        .prioritization-module .col-md-5 {
            flex: 0 0 auto !important;
            max-width: none !important;
        }
        .prioritization-module .col-md-7 { width: 58% !important; }
        .prioritization-module .col-md-5 { width: 42% !important; }

        /* ── Hide interactive elements from new sections ── */
        /* Prioritization */
        .prioritization-module .drag-handle,
        .prioritization-module input[type="checkbox"],
        .prioritization-module .form-check,
        .prioritization-module .alert,
        #modeExplanationAccordion { display: none !important; }

        /* Overview Selection */
        .overview-selection-container .filter-panel,
        .overview-selection-container .solution-card-actions,
        .overview-selection-container .progress-tracker,
        .overview-selection-container .selection-toolbar { display: none !important; }

        /* Recommendations */
        .recommendations-container .header-actions { display: none !important; }
        .recommendations-container .recommendations-header h2 { font-size: 1.1rem !important; }
        .recommendations-container .section-description { font-size: 0.75rem !important; }
        .recommendations-container .recommendations-summary { gap: 8px !important; }
        .recommendations-container .summary-card { padding: 10px !important; }
        .recommendations-container .summary-value { font-size: 1.2rem !important; }
        .recommendations-container .summary-label { font-size: 0.65rem !important; }
        .recommendations-container .solution-detail-card { font-size: 0.8rem !important; }
        .recommendations-container h3, .recommendations-container h4 { font-size: 0.95rem !important; }

        /* Force every solution card fully expanded in the PDF so readers see
           the detailed sections without clicking "Expand Details" (which has
           no meaning on paper). Also hide the now-redundant card toggle/copy
           action buttons. */
        .recommendations-container .solution-details { display: block !important; }
        .recommendations-container .solution-expand-btn,
        .recommendations-container .solution-actions { display: none !important; }
        .recommendations-container .solution-card-header { cursor: default !important; }
        /* With cards fully expanded, a single card is often taller than an A4
           page. Letting Chromium break BETWEEN detail-sections avoids the huge
           white gaps that `break-inside: avoid` on the whole card produced. */
        .recommendations-container .solution-card,
        .recommendations-container .solution-details {
            break-inside: auto !important; page-break-inside: auto !important;
        }
        .recommendations-container .detail-section {
            break-inside: avoid; page-break-inside: avoid;
        }
        /* Keep the card header glued to its overview + first detail-section so
           a title never orphans at the very bottom of a page. */
        .recommendations-container .solution-card-header,
        .recommendations-container .solution-overview {
            break-after: avoid; page-break-after: avoid;
        }

        /* Strip the stream banner's solid UN-blue background for print — keeps
           the heading readable against a white page and reduces ink usage. */
        .recommendations-container .stream-header {
            background: transparent !important;
            color: #00689D !important;
            border-bottom: 2px solid #cfe2f3 !important;
            padding: 8px 14px !important;
        }
        .recommendations-container .stream-header h3,
        .recommendations-container .stream-header h3 i { color: #00689D !important; }
        .recommendations-container .stream-rank {
            background: transparent !important;
            color: #00689D !important;
            border: 1px solid #00689D !important;
            box-shadow: none !important;
        }
        .recommendations-container .stream-toggle-btn {
            background: transparent !important;
            color: #00689D !important;
            border: 1px solid #00689D !important;
        }

        /* ── Page break helpers (applied globally for Playwright PDF + browser print) ── */
        .page-break { page-break-before: always; break-before: page; }

        /* Prevent sections from splitting across pages */
        .card, .input-card, .compact-card { break-inside: avoid; page-break-inside: avoid; }
        .module2-section { break-inside: avoid; page-break-inside: avoid; }
        .print-section, .matrix-container { break-inside: avoid; page-break-inside: avoid; }
        .print-section-title { break-after: avoid; page-break-after: avoid; }
        .report-content-header { break-inside: avoid; break-after: avoid; page-break-inside: avoid; }
        .print-footer { break-inside: avoid; page-break-inside: avoid; }
        .frontier-header, .module2-header { break-after: avoid; page-break-after: avoid; }
        h4, h5 { break-after: avoid; page-break-after: avoid; }
        img, svg, canvas { break-inside: avoid; page-break-inside: avoid; }
        table, .table { break-inside: avoid; page-break-inside: avoid; }
        .prioritization-module .col-md-6 .card { break-inside: avoid; page-break-inside: avoid; }
        /* .solution-card is handled in the expanded-card block above — do NOT
           re-apply page-break-inside: avoid here, or it forces each fully
           expanded card onto its own page even when it's taller than A4. */
        .recommendations-summary { break-inside: avoid; page-break-inside: avoid; }
        .gap-analysis-section { break-inside: avoid; page-break-inside: avoid; }
        .stream-section { break-inside: avoid; page-break-inside: avoid; }
        .kpi-row, .kpi-grid { break-inside: avoid; page-break-inside: avoid; }
        .chart-container, .chart-wrapper { break-inside: avoid; page-break-inside: avoid; }

        /* Force page breaks before major report sections */
        .section-page-break { break-before: page; page-break-before: always; }

        .print-btn-wrapper { display: block; }
        @@page {
            size: portrait;
            margin: 8mm;
        }
        @@page :first {
            margin: 0;
        }
        @@media print {
            body { margin: 0; padding: 0; background: #fff; }
            .print-btn-wrapper { display: none !important; }
            .report-box {
                max-width: 100%;
                margin: 0;
                border: none;
                border-radius: 0;
                box-shadow: none;
            }
            .cover-page { min-height: 0; height: 100vh; }
            .report-content { padding: 10px; }
        }
    </style>
</head>
<body>

    <!-- Seed state data from session model for partial JS to read -->
    <script>
        var isViewMode = true;
        // Seed localStorage so partial scripts can load data via fallback path.
        //
        // Audit F-8: emit the model fields via System.Text.Json.JsonSerializer.Serialize.
        // It produces a properly-escaped JS string literal that handles script-closing
        // tags, backslashes, control characters, and Unicode quotes — the previous
        // single-quote-only escape was XSS-prone the moment any of those got into the data.
        (function() {
            var prioritizationData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PrioritizationData ?? ""));
            if (prioritizationData) {
                try { localStorage.setItem('prioritizationData', prioritizationData); } catch(e) {}
            }
            var selectedSolutions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedSolutionsData ?? ""));
            if (selectedSolutions) {
                try {
                    localStorage.setItem('selectedSolutionsData', selectedSolutions);
                    // SelectedSolutionsData wraps { selections, selectedSolutions, timestamp }.
                    // The Recommendations module expects rosraSelectedSolutions to be the
                    // plain array, and the Overview Selection summary expects
                    // rosraOverviewSelections to be the inner selections object — unpack
                    // both here so those modules can render in the server-side print view.
                    var parsed = JSON.parse(selectedSolutions);
                    if (parsed && Array.isArray(parsed.selectedSolutions)) {
                        localStorage.setItem('rosraSelectedSolutions', JSON.stringify(parsed.selectedSolutions));
                    }
                    if (parsed && parsed.selections) {
                        localStorage.setItem('rosraOverviewSelections', JSON.stringify(parsed.selections));
                    }
                } catch(e) {}
            }
        })();
    </script>

    <!-- ════════════════════════════════
         BOXED REPORT CONTAINER
         ════════════════════════════════ -->
    <div class="report-box">

    <!-- Cover Page -->
    <div class="cover-page">
        <!-- City background image -->
        <div class="cover-bg-image">
            <img src="~/images/cities/nairobi.jpg" alt="" />
        </div>
        <!-- Orbit ring -->
        <div class="cover-orbit"></div>

        <!-- Top: City circle -->
        <div class="cover-top">
            <div class="cover-circle-main">
                <img src="~/images/cities/addis-ababa.jpg" alt="City skyline" />
            </div>
            <div class="cover-circle-sm cover-circle-sm-1">
                <img src="~/images/sdg/E_WEB_11.png" alt="SDG 11" />
            </div>
            <div class="cover-circle-sm cover-circle-sm-2">
                <img src="~/images/cities/nairobi.jpg" alt="City" />
            </div>
            <div class="cover-circle-sm cover-circle-sm-3">
                <img src="~/images/sdg/E_WEB_17.png" alt="SDG 17" />
            </div>
        </div>

        <!-- Title -->
        <div class="cover-title-section">
            <h1 class="cover-title">@SharedLocalizer["Diagnostic_ReportTitle"]</h1>
            <p class="cover-subtitle">@SharedLocalizer["Diagnostic_ReportSubtitle"]</p>
            <div class="cover-location">
                @if (!string.IsNullOrEmpty(countryCode))
                {
                    <span class="cover-flag fi fi-@countryCode"></span>
                }
                <span class="cover-country-name">@(Model.Country ?? "ROSRA")</span>
            </div>
            <div class="cover-location-detail">
                @if (Model.Region != null)
                {
                    <span>@Model.Region</span>
                }
                @if (Model.City != null)
                {
                    <span>@Model.City</span>
                }
                @if (Model.FinancialYear != null)
                {
                    <span>FY @Model.FinancialYear</span>
                }
                @if (Model.Currency != null)
                {
                    <span>@Model.Currency (@cs)</span>
                }
            </div>
        </div>

        <!-- Bottom geometric blocks -->
        <div class="cover-bottom">
            <div class="cover-block cover-block-1"></div>
            <div class="cover-block cover-block-2">
                <img src="~/images/sdg/E_WEB_11.png" alt="" />
            </div>
            <div class="cover-block cover-block-3"></div>
            <div class="cover-circle-deco">
                <div class="cover-circle-deco-inner"></div>
            </div>
            <div class="cover-circle-accent"></div>
        </div>

        <!-- SDG Goals strip -->
        <div class="cover-sdg-strip">
            <img class="sdg-goal" src="~/images/sdg/E_WEB_INVERTED_11.png" alt="SDG 11" />
            <img class="sdg-goal" src="~/images/sdg/E_WEB_INVERTED_16.png" alt="SDG 16" />
            <img class="sdg-goal" src="~/images/sdg/E_WEB_INVERTED_17.png" alt="SDG 17" />
            <img class="sdg-wheel" src="~/images/sdg/SDG_Wheel_WEB.png" alt="SDG Wheel" />
        </div>
    </div>

    <!-- ════════════════════════════════
         REPORT CONTENT (page 2+)
         ════════════════════════════════ -->
    <div class="report-content">

        <!-- ═══════════════════════════
             SECTION 1: LOCAL GOVERNMENT PROFILE + QUICK OSR ESTIMATE
             (The _PotentialEstimates partial renders both the LG Profile card and
             the WoFi Quick OSR Estimate card. The partial injects its own
             "Quick OSR Estimate" subsection header between them in view/print mode.)
             ═══════════════════════════ -->
        <div class="report-content-header">
            <h2>@SharedLocalizer["Report_LgProfile_Title"]</h2>
            <div class="header-meta">
                @if (!string.IsNullOrEmpty(countryCode))
                {
                    <span class="header-flag fi fi-@countryCode"></span>
                }
                <span>@(Model.Country ?? "-")</span>
                @if (Model.Region != null)
                {
                    <span>&rsaquo; @Model.Region</span>
                }
                @if (Model.City != null)
                {
                    <span>&rsaquo; @Model.City</span>
                }
            </div>
        </div>
        <p class="report-section-body">@SharedLocalizer["Report_LgProfile_Body"]</p>

        @{
            string FieldOrMissing(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;
            string FormatMoney(decimal? n) => n.HasValue ? $"{cs} {n.Value.ToString("#,##0")}" : null;
            string FormatPop(int? n) => n.HasValue ? n.Value.ToString("#,##0") : null;
            string FormatGdp(decimal? n) => n.HasValue ? $"USD {n.Value.ToString("#,##0")}" : null;
            string CurrencyDisplay()
            {
                if (string.IsNullOrWhiteSpace(Model.Currency) && string.IsNullOrWhiteSpace(Model.CurrencySymbol)) return null;
                if (!string.IsNullOrWhiteSpace(Model.Currency) && !string.IsNullOrWhiteSpace(Model.CurrencySymbol)
                    && !string.Equals(Model.Currency, Model.CurrencySymbol, StringComparison.OrdinalIgnoreCase))
                    return $"{Model.Currency} ({Model.CurrencySymbol})";
                return Model.Currency ?? Model.CurrencySymbol;
            }

            (string label, string value)[] profileFields = new[]
            {
                ("Country", FieldOrMissing(Model.Country)),
                ("Region / Level 1", FieldOrMissing(Model.Region)),
                ("City / Level 2", FieldOrMissing(Model.City)),
                ("Level 3", FieldOrMissing(Model.GovUnitLevel3)),
                ("Financial Year", FieldOrMissing(Model.FinancialYear)),
                ("Currency", CurrencyDisplay()),
                ("Government Type", FieldOrMissing(Model.GovernmentType)),
                ("Income Level", FieldOrMissing(Model.IncomeLevel)),
                ("Local Economic Profile", FieldOrMissing(Model.EconomicProfile)),
                ("Own-Source Revenue (OSR)", FormatMoney(Model.ActualOsr)),
                ("Population", FormatPop(Model.Population)),
                ("National GDP per capita", FormatGdp(Model.GdpPerCapita)),
            };
        }

        <!-- Read-only LG Profile data card (replaces the form-style config-card in print mode).
             Surfaces every field captured under the v2 Local Government Profile, including
             new fields like Local Economic Profile that weren't visible in the old layout. -->
        <div class="lg-profile-card">
            <div class="lg-profile-card__header">
                @if (!string.IsNullOrEmpty(countryCode))
                {
                    <img class="lg-profile-card__flag" src="https://flagcdn.com/w80/@(countryCode).png" alt="@(Model.Country ?? "")" />
                }
                <div>
                    <p class="lg-profile-card__title">@(Model.City ?? Model.Region ?? Model.Country ?? "Local Government")</p>
                    <span class="lg-profile-card__subtitle">@(Model.Country ?? "")@(Model.FinancialYear != null ? " — FY " + Model.FinancialYear : "")</span>
                </div>
            </div>
            <div class="lg-profile-card__grid">
                @foreach (var f in profileFields)
                {
                    <div class="lg-profile-field">
                        <span class="lg-profile-field__label">@f.label</span>
                        @if (f.value != null)
                        {
                            <span class="lg-profile-field__value">@f.value</span>
                        }
                        else
                        {
                            <span class="lg-profile-field__value lg-profile-field__value--muted">@SharedLocalizer["Report_NotAvailable"]</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Render the Potential Estimates partial. In print mode the partial's
             form-style config-card is hidden via CSS — only the WoFi Quick OSR
             Estimate panel (with chart) renders. -->
        @await Html.PartialAsync("_PotentialEstimates", Model)

        <!-- ═══════════════════════════
             PAGE BREAK — transition to Bottom-Up
             ═══════════════════════════ -->
        <div class="page-break"></div>

        <!-- ═══════════════════════════
             SECTION 2: STREAM GAP ANALYSIS RESULTS
             ═══════════════════════════ -->
        <div class="report-content-header">
            <h2>@SharedLocalizer["Report_StreamGap_Title"]</h2>
            <div class="header-meta">
                @if (!string.IsNullOrEmpty(countryCode))
                {
                    <span class="header-flag fi fi-@countryCode"></span>
                }
                <span>@(Model.Country ?? "-")</span>
                @if (Model.Region != null)
                {
                    <span>&rsaquo; @Model.Region</span>
                }
                @if (Model.City != null)
                {
                    <span>&rsaquo; @Model.City</span>
                }
            </div>
        </div>
        <div class="report-section-intro">
            <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionWhat"]</span>@SharedLocalizer["Report_StreamGap_What"]</p>
            <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionWhy"]</span>@SharedLocalizer["Report_StreamGap_Why"]</p>
            <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionHow"]</span>@SharedLocalizer["Report_StreamGap_How"]</p>
        </div>

        <!-- Property Tax Section -->
        <div class="print-section" data-gap-stream-id="property-tax">
            <div class="print-section-title">Property Tax Gap Analysis</div>
            @await Html.PartialAsync("_GapAnalysisPropertyTaxFixed", Model)
        </div>

        <!-- Business License Section -->
        <div class="print-section" data-gap-stream-id="business-license">
            <div class="print-section-title">Business License Gap Analysis</div>
            @await Html.PartialAsync("_GapAnalysisLicense", Model)
        </div>

        <!-- Generic Streams -->
        @if (Model.GenericStreams != null && Model.GenericStreams.Any())
        {
            @for (int i = 0; i < Model.GenericStreams.Count; i++)
            {
                var stream = Model.GenericStreams[i];
                // Always use the RosraStateManager stream-id format so the badge script can match.
                var gapStreamId = $"generic-stream-{i}";
                <div class="print-section" data-gap-stream-id="@gapStreamId">
                    <div class="print-section-title">@(stream.StreamName ?? "Revenue Stream") Gap Analysis</div>
                    @await Html.PartialAsync("_GapAnalysisGenericStream", stream, new ViewDataDictionary(ViewData) { { "CurrencySymbol", cs } })
                </div>
            }
        }

        <!-- Stream Prioritization + Gap Prioritization (rendered together by _Prioritization partial).
             Both intros are surfaced up front so the reader knows what the two sub-sections below mean. -->
        <div class="print-section">
            <div class="print-section-title">@SharedLocalizer["Report_StreamPrio_Title"]</div>
            <div class="report-section-intro">
                <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionWhat"]</span>@SharedLocalizer["Report_StreamPrio_What"]</p>
                <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionWhy"]</span>@SharedLocalizer["Report_StreamPrio_Why"]</p>
                <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionHow"]</span>@SharedLocalizer["Report_StreamPrio_How"]</p>
            </div>
            <div class="print-section-title" style="margin-top:1.5rem;">@SharedLocalizer["Report_GapPrio_Title"]</div>
            <div class="report-section-intro">
                <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionWhat"]</span>@SharedLocalizer["Report_GapPrio_What"]</p>
                <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionWhy"]</span>@SharedLocalizer["Report_GapPrio_Why"]</p>
                <p><span class="report-section-eyebrow">@SharedLocalizer["Report_SectionHow"]</span>@SharedLocalizer["Report_GapPrio_How"]</p>
            </div>
            @await Html.PartialAsync("_Prioritization", Model)
        </div>

        <!-- Reform Guidance — short paragraph only. Full solution cards live on the website,
             not in the diagnostic report (per v2 brief §4 and §5). The second paragraph
             surfaces the duplicate-collapse caveat from brief §12 so readers know the
             platform may group similar streams together. -->
        <div class="print-section">
            <div class="print-section-title">@SharedLocalizer["Report_ReformGuidance_Title"]</div>
            <p class="report-section-body">@SharedLocalizer["Report_ReformGuidance_Body"]</p>
            <p class="report-section-body" style="font-style:italic; color:#475569;">@SharedLocalizer["Duplicate_ReportNote"]</p>
        </div>

        <!-- Footer -->
        <div class="print-footer">
            <div class="print-footer-content">
                <div class="print-footer-left">
                    <img src="~/images/logo.d95ced55c7a543c8d241.png" alt="ROSRA UN-Habitat" />
                </div>
                <div class="print-footer-right">
                    <img class="sdg-footer-goal" src="~/images/sdg/E_WEB_11.png" alt="SDG 11" />
                    <img class="sdg-footer-goal" src="~/images/sdg/E_WEB_16.png" alt="SDG 16" />
                    <img class="sdg-footer-goal" src="~/images/sdg/E_WEB_17.png" alt="SDG 17" />
                    <img class="sdg-footer-logo" src="~/images/sdg/E_SDG_logo_horizontal_trans.png" alt="SDG" />
                </div>
            </div>
            <div class="print-footer-center">
                @SharedLocalizer["Diagnostic_FooterNote"] | &copy; @DateTime.Now.Year UN-Habitat. All rights reserved. | Generated @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>
    </div>

    </div> <!-- /.report-box -->

    <div class="print-btn-wrapper" style="position:fixed;top:15px;right:15px;z-index:9999;">
        <button class="print-btn" onclick="window.print()" style="background:#009EDB;color:#fff;border:none;padding:10px 24px;border-radius:6px;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.15);">
            &#128438; Print / Save as PDF
        </button>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/chart.js/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/formStateManager.js" asp-append-version="true"></script>
    <script src="~/js/rosraStateManager.js" asp-append-version="true"></script>
    <!-- Solution data for Overview Selection & Recommendations -->
    <script src="~/js/solutionsData-PT-Compliance.js"></script>
    <script src="~/js/solutionsData-PT-Coverage.js"></script>
    <script src="~/js/solutionsData-PT-Valuation.js"></script>
    <script src="~/js/solutionsData-NP-A.js"></script>
    <script src="~/js/solutionsData-NP-B.js"></script>
    <script src="~/js/solutionsData-NP-C.js"></script>
    <script src="~/js/solutionsData-BL.js"></script>
    <script src="~/js/solutionsData-Generic.js"></script>
    <script src="~/js/streamClassification.js"></script>
    <script src="~/js/solutionsDatabase.js"></script>
    <script src="~/js/solutionsFullDatabase.js"></script>
    <script src="~/js/recommendationsModule.js"></script>
    <script>
        $(document).ready(function() {
            // Populate select values for TopDown section
            function setSelectValue(id, value) {
                var el = document.getElementById(id);
                if (el && value) {
                    var opt = document.createElement('option');
                    opt.value = value;
                    opt.text = value;
                    opt.selected = true;
                    el.appendChild(opt);
                }
            }

            setSelectValue('country', '@Html.Raw(Model.Country?.Replace("'", "\\'") ?? "")');
            setSelectValue('financialYear', '@Html.Raw(Model.FinancialYear?.Replace("'", "\\'") ?? "")');
            setSelectValue('region', '@Html.Raw(Model.Region?.Replace("'", "\\'") ?? "")');
            // EconomicProfile is rendered server-side from WofiPotentialEstimator,
            // so the option likely exists already — but setSelectValue is idempotent
            // (only appends when value missing) so a no-op call is safe.
            setSelectValue('economicProfile', '@Html.Raw(Model.EconomicProfile?.Replace("'", "\\'") ?? "")');

            var region = '@Html.Raw(Model.Region?.Replace("'", "\\'") ?? "")';
            var city = '@Html.Raw(Model.City?.Replace("'", "\\'") ?? "")';
            var level3 = '@Html.Raw(Model.GovUnitLevel3?.Replace("'", "\\'") ?? "")';

            if (region) {
                var l1Row = document.getElementById('govUnitLevel1Row');
                if (l1Row) l1Row.style.display = '';
            }
            if (city) {
                var l2Row = document.getElementById('govUnitLevel2Row');
                if (l2Row) l2Row.style.display = '';
            }
            if (level3) {
                var l3Row = document.getElementById('govUnitLevel3Row');
                if (l3Row) l3Row.style.display = '';
            }

            // Step 1: Trigger gap calculations (Property Tax, Business License)
            setTimeout(function() {
                document.querySelectorAll('input[data-input="true"]').forEach(function(el) {
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                });
                document.querySelectorAll('input[type="range"]').forEach(function(el) {
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                });
            }, 1000);

            // Step 1b: Kick the Quick OSR Estimate (WoFi) flow IMMEDIATELY so the chart
            // is in flight before Playwright's NetworkIdle detection hits.
            //
            // Why the rush:
            //   - The partial's IIFE checks countryEl.value BEFORE setSelectValue runs,
            //     so the auto-show path doesn't trigger.
            //   - Playwright's PDF pipeline waits for NetworkIdle + 3s. If we wait too
            //     long to fire Get Analysis, the AJAX kicks off after NetworkIdle and
            //     the capture happens before the chart finishes drawing.
            //
            // Firing in the same tick as setSelectValue keeps the AJAX inside the
            // NetworkIdle window, so Playwright's 3s buffer always lands AFTER chart render.
            (function kickWofi() {
                var countryEl = document.getElementById('country');
                if (countryEl) countryEl.dispatchEvent(new Event('change', { bubbles: true }));
                var profileEl = document.getElementById('economicProfile');
                if (profileEl) profileEl.dispatchEvent(new Event('change', { bubbles: true }));
                var getBtn = document.getElementById('getAnalysisBtn');
                if (getBtn) getBtn.click();

                // After WoFi compute finishes, the Chart.js bar chart needs a resize tick
                // when the container was force-visible via print CSS — otherwise Chart.js
                // can cache a 0-height layout from its initial measurement and the canvas
                // renders empty. Re-running .resize() once at ~3.5s after compute gives
                // it the final container height in print viewport.
                setTimeout(function () {
                    if (typeof Chart !== 'undefined' && Chart.instances) {
                        Object.values(Chart.instances).forEach(function (c) {
                            try { c.resize(); c.update('none'); } catch (e) { /* ignore */ }
                        });
                    }
                }, 3500);
            })();

            // Step 2: After gap data is in localStorage, re-initialize Prioritization
            setTimeout(function() {
                window.dispatchEvent(new Event('gapDataReady'));
            }, 2500);

            // Step 3: Replace empty LG Profile fields with "Not available" per v2 brief §5.
            // Runs after gap-calcs so we don't clobber values that just got hydrated.
            setTimeout(replaceEmptyProfileValues, 2800);

            // Step 4: Auto-print if requested (opens Save as PDF dialog, then closes tab)
            // The legacy Overview Selection / Recommendations render step is gone — the
            // diagnostic report ends at Reform Guidance, which is a static paragraph.
            if (window.location.search.indexOf('autoPrint=true') >= 0) {
                setTimeout(function() {
                    window.print();
                    window.onafterprint = function() { window.close(); };
                }, 5000);
            }
        });

        /**
         * v2 brief §5 / P4.8 — empty fields in the Local Government Profile must
         * read as "Not available" in the printed report rather than rendering as
         * a bare currency prefix with nothing after it (e.g. "₱ " followed by
         * blank space). Walks the readable profile/quick-estimate inputs and
         * swaps empty values for the localised fallback text + a muted styling.
         */
        function replaceEmptyProfileValues() {
            var fallback = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Report_NotAvailable"].Value));
            // Profile field IDs we care about — these are the user-visible KPIs on
            // the LG Profile card. Adding new fields? List them here.
            var ids = ['actualOsr', 'budgetedOsr', 'population', 'gdpPerCapita',
                       'city', 'govUnitLevel3'];
            ids.forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                var v = (el.value || '').trim();
                if (v) return;
                // Replace the empty input cell with a styled span so the printed
                // PDF reads "Not available" instead of a blank field. Form binding
                // is irrelevant in view-mode so removing the input is safe here.
                var span = document.createElement('span');
                span.className = 'value-not-available';
                span.textContent = fallback;
                span.style.cssText = 'color:#6b7280; font-style:italic; font-size:0.9em;';
                if (el.parentNode) el.parentNode.replaceChild(span, el);
            });
        }

        // Paint "Excluded" badge on Gap Analysis section titles for any stream
        // the user excluded in Prioritization. Runs after _Prioritization partial
        // has applied saved state back into RosraStateManager.
        function paintGapAnalysisExclusionBadges() {
            if (typeof RosraStateManager === 'undefined') return;
            var excluded = {};
            RosraStateManager.getStreams().forEach(function(s) {
                if (s.included === false) excluded[s.id] = true;
            });
            document.querySelectorAll('.print-section[data-gap-stream-id]').forEach(function(section) {
                var title = section.querySelector('.print-section-title');
                if (!title) return;
                var existing = title.querySelector('.pdf-excluded-badge');
                var isExcluded = !!excluded[section.getAttribute('data-gap-stream-id')];
                if (isExcluded && !existing) {
                    var badge = document.createElement('span');
                    badge.className = 'badge pdf-excluded-badge';
                    badge.textContent = 'Excluded';
                    badge.style.cssText = 'background:#dc2626;color:#fff;font-size:0.65rem;margin-left:10px;padding:3px 8px;border-radius:4px;font-weight:600;letter-spacing:0.03em;vertical-align:middle;';
                    title.appendChild(badge);
                    var originalText = title.childNodes[0];
                    if (originalText && originalText.nodeType === Node.TEXT_NODE) {
                        var span = document.createElement('span');
                        span.textContent = originalText.textContent;
                        span.style.textDecoration = 'line-through';
                        span.style.opacity = '0.7';
                        title.replaceChild(span, originalText);
                    }
                } else if (!isExcluded && existing) {
                    existing.remove();
                }
            });
        }

        // Run after prioritizationData has been seeded and _Prioritization applied state.
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(paintGapAnalysisExclusionBadges, 300);
            setTimeout(paintGapAnalysisExclusionBadges, 1200);
            if (typeof RosraStateManager !== 'undefined' && RosraStateManager.subscribe) {
                RosraStateManager.subscribe('streams', paintGapAnalysisExclusionBadges);
            }
        });
    </script>
