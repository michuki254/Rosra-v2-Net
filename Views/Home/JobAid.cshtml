@{
    ViewData["Title"] = "User Guide";
}

@section Styles {
    <style>
        body {
            background: #f8f9fa;
        }

        /* ── Page Header ── */
        .guide-hero {
            background: linear-gradient(135deg, #00689D 0%, #0095C0 60%, #00B2E3 100%);
            color: white;
            padding: 3.25rem 0 3rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        /* Subtle dot grid behind the hero copy — keeps it modern without being noisy */
        .guide-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.18) 1px, transparent 1px);
            background-size: 22px 22px;
            opacity: 0.35;
            pointer-events: none;
        }

        .guide-hero > .container { position: relative; z-index: 1; }

        .guide-hero h1 {
            font-size: 2.25rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }

        .guide-hero .lead {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-bottom: 0;
            max-width: 720px;
        }

        .guide-hero .badge-version {
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 0.35rem 0.85rem;
            border-radius: 20px;
            font-size: 0.8125rem;
            font-weight: 500;
        }

        /* ── Sidebar TOC ── */
        .toc-sidebar {
            position: sticky;
            top: 100px;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
            padding-right: 1rem;
        }

        .toc-sidebar::-webkit-scrollbar {
            width: 3px;
        }

        .toc-sidebar::-webkit-scrollbar-thumb {
            background: #dee2e6;
            border-radius: 3px;
        }

        .toc-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            border: 1px solid #e9ecef;
            padding: 1.25rem;
        }

        .toc-card h6 {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #868e96;
            font-weight: 700;
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #f1f3f5;
        }

        .toc-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.45rem 0.65rem;
            border-radius: 6px;
            color: #495057;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s ease;
            margin-bottom: 2px;
        }

        .toc-link:hover,
        .toc-link.active {
            background: #e7f5ff;
            color: #00689D;
        }

        .toc-link i {
            font-size: 0.75rem;
            width: 18px;
            text-align: center;
            color: #adb5bd;
        }

        .toc-link:hover i,
        .toc-link.active i {
            color: #00689D;
        }

        .toc-sub {
            padding-left: 1.5rem;
        }

        .toc-sub .toc-link {
            font-size: 0.8rem;
            color: #6c757d;
            padding: 0.3rem 0.5rem;
        }

        /* ── Content Sections ── */
        .guide-section {
            background: white;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            border: 1px solid #e9ecef;
            padding: 2rem;
            margin-bottom: 1.5rem;
        }

        .guide-section h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid #e9ecef;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .guide-section h2 .section-icon {
            width: 38px;
            height: 38px;
            background: #00689D;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .guide-section h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #343a40;
            margin-top: 1.75rem;
            margin-bottom: 0.75rem;
        }

        .guide-section h4 {
            font-size: 1rem;
            font-weight: 600;
            color: #495057;
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
        }

        .guide-section p,
        .guide-section li {
            color: #495057;
            font-size: 0.925rem;
            line-height: 1.7;
        }

        .guide-section ol,
        .guide-section ul {
            padding-left: 1.25rem;
        }

        .guide-section ol li,
        .guide-section ul li {
            margin-bottom: 0.4rem;
        }

        /* ── Tables ── */
        .guide-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #e9ecef;
            margin: 1rem 0;
            font-size: 0.9rem;
        }

        .guide-table thead th {
            background: #f8f9fa;
            color: #495057;
            font-weight: 600;
            padding: 0.75rem 1rem;
            border-bottom: 2px solid #dee2e6;
            text-align: left;
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .guide-table tbody td {
            padding: 0.65rem 1rem;
            border-bottom: 1px solid #f1f3f5;
            color: #495057;
            vertical-align: top;
        }

        .guide-table tbody tr:last-child td {
            border-bottom: none;
        }

        .guide-table tbody tr:hover {
            background: #f8f9fa;
        }

        /* ── Tip / Note Boxes ── */
        .guide-tip {
            background: #e7f5ff;
            border-left: 4px solid #00b2e3;
            border-radius: 0 8px 8px 0;
            padding: 1rem 1.25rem;
            margin: 1rem 0;
            font-size: 0.9rem;
            color: #1c7ed6;
        }

        .guide-tip i {
            margin-right: 0.5rem;
        }

        .guide-warning {
            background: #fff9db;
            border-left: 4px solid #FD9D24;
            border-radius: 0 8px 8px 0;
            padding: 1rem 1.25rem;
            margin: 1rem 0;
            font-size: 0.9rem;
            color: #e67700;
        }

        .guide-warning i {
            margin-right: 0.5rem;
        }

        /* Visual walkthrough */
        .visual-walkthrough {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
            margin: 1.25rem 0;
        }

        .visual-shot {
            min-width: 0;
        }

        .visual-shot img {
            width: 100%;
            height: auto;
            max-height: 260px;
            object-fit: cover;
            object-position: top center;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background: #f8f9fa;
            display: block;
        }

        .visual-shot figcaption {
            margin-top: 0.55rem;
            font-size: 0.825rem;
            line-height: 1.5;
            color: #495057;
        }

        .visual-shot strong {
            color: #212529;
        }

        .guide-checklist {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75rem;
            margin: 1rem 0;
        }

        .guide-checkitem {
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
            padding: 0.85rem;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            background: #f8f9fa;
            color: #495057;
            font-size: 0.875rem;
            line-height: 1.55;
        }

        .guide-checkitem i {
            color: #00689D;
            flex-shrink: 0;
            margin-top: 0.15rem;
        }

        .input-example {
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin: 1rem 0;
            overflow: hidden;
        }

        .input-example-header {
            background: #f1f9fc;
            color: #00689D;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.7rem 0.9rem;
            border-bottom: 1px solid #d7eff7;
        }

        .input-example table {
            margin: 0;
            border: 0;
            border-radius: 0;
        }

        /* ── Status badges ── */
        .status-example {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.2rem 0.65rem;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .status-draft { background: #e9ecef; color: #495057; }
        .status-submitted { background: #d3f9d8; color: #2b8a3e; }
        .status-review { background: #d0ebff; color: #1971c2; }
        .status-revision { background: #fff3bf; color: #e67700; }
        .status-validated { background: #d3f9d8; color: #087f5b; }

        /* ── Workflow Diagram ── */
        .workflow-flow {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 1.25rem 0;
        }

        .workflow-step {
            background: white;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 0.6rem 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: #495057;
            text-align: center;
            min-width: 120px;
        }

        .workflow-step.active-step {
            border-color: #00689D;
            color: #00689D;
            background: #e7f5ff;
        }

        .workflow-arrow {
            color: #adb5bd;
            font-size: 1.25rem;
        }

        .workflow-branch {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.3rem;
        }

        /* Step Cards (for the Detailed Diagnostic workflow) */
        .step-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1.25rem;
            margin: 0.75rem 0;
            border-left: 4px solid #00689D;
        }

        .step-card h4 {
            color: #00689D;
            margin-top: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .step-number {
            width: 28px;
            height: 28px;
            background: #00689D;
            color: white;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        /* ── Gap Type Cards ── */
        .gap-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75rem;
            margin: 1rem 0;
        }

        .gap-card {
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
        }

        .gap-card.coverage { background: #fff3bf; border: 1px solid #ffd43b; }
        .gap-card.compliance { background: #d3f9d8; border: 1px solid #69db7c; }
        .gap-card.valuation { background: #d0ebff; border: 1px solid #74c0fc; }
        .gap-card.liability { background: #ffe8cc; border: 1px solid #ffc078; }

        .gap-card h5 {
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

        .gap-card p {
            font-size: 0.8rem;
            margin: 0;
        }

        /* ── Permissions Grid ── */
        .perm-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.5rem;
            margin: 0.75rem 0;
        }

        .perm-item {
            background: #f8f9fa;
            border-radius: 6px;
            padding: 0.5rem 0.75rem;
            font-size: 0.825rem;
            color: #495057;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .perm-item i {
            color: #00689D;
            font-size: 0.7rem;
        }

        /* ── FAQ Accordion ── */
        .faq-item {
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 0.5rem;
            overflow: hidden;
        }

        .faq-question {
            background: #f8f9fa;
            padding: 0.85rem 1.15rem;
            font-weight: 600;
            color: #343a40;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.925rem;
            transition: background 0.15s ease;
        }

        .faq-question:hover {
            background: #e9ecef;
        }

        .faq-question i {
            transition: transform 0.2s ease;
            color: #6c757d;
        }

        .faq-question[aria-expanded="true"] i {
            transform: rotate(180deg);
        }

        .faq-answer {
            padding: 0 1.15rem;
            font-size: 0.9rem;
            color: #495057;
            line-height: 1.7;
        }

        .faq-answer p {
            margin: 0.85rem 0;
        }

        /* ── Approach comparison cards (Quick Estimate vs Detailed Diagnostic) ── */
        .approach-compare {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
            margin: 1.25rem 0 0.5rem;
        }

        .approach-card {
            background: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 1.25rem 1.25rem 1.1rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .approach-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.06);
        }

        .approach-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: #00689D;
        }

        .approach-card--macro::before { background: #00689D; }
        .approach-card--micro::before { background: #00B2E3; }

        .approach-card-head {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            margin-bottom: 0.85rem;
        }

        .approach-card-head i {
            font-size: 1.5rem;
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-shrink: 0;
        }

        .approach-card--macro .approach-card-head i { background: #00689D; }
        .approach-card--micro .approach-card-head i { background: #00B2E3; }

        .approach-card-tag {
            display: inline-block;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            font-weight: 700;
            color: #868e96;
            margin-bottom: 0.1rem;
        }

        .approach-card h4 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #212529;
            margin: 0;
        }

        .approach-card-lede {
            font-size: 0.9rem;
            color: #495057;
            line-height: 1.55;
            margin: 0 0 0.85rem;
        }

        .approach-card-meta {
            list-style: none;
            padding: 0;
            margin: 0;
            border-top: 1px solid #f1f3f5;
            padding-top: 0.75rem;
        }

        .approach-card-meta li {
            font-size: 0.825rem;
            color: #495057;
            padding: 0.2rem 0;
        }

        .approach-card-meta strong {
            color: #343a40;
            font-weight: 600;
        }

        /* ── Section subtag (small pill next to h2 for "macro view" / "micro view") ── */
        .section-subtag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            font-weight: 700;
            background: #e7f5ff;
            color: #00689D;
            padding: 0.2rem 0.6rem;
            border-radius: 12px;
            margin-left: 0.4rem;
            white-space: nowrap;
            align-self: center;
        }

        /* ── Print Button ── */
        .btn-print-guide {
            background: white;
            border: 1px solid #dee2e6;
            color: #495057;
            border-radius: 6px;
            font-weight: 500;
            padding: 0.45rem 1rem;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .btn-print-guide:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
        }

        /* ── Responsive ── */
        @@media (max-width: 991.98px) {
            .toc-sidebar {
                position: static;
                max-height: none;
                margin-bottom: 1.5rem;
            }
        }

        @@media print {
            .guide-hero { padding: 1.5rem 0; }
            .toc-sidebar { display: none; }
            .guide-section { box-shadow: none; border: 1px solid #ccc; page-break-inside: avoid; }
            .btn-print-guide { display: none; }
        }
    </style>
}

<!-- Hero Header -->
<div class="guide-hero">
    <div class="container">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1><i class="bi bi-journal-bookmark-fill me-2"></i> ROSRA User Guide</h1>
                <p class="lead">A complete guide to using the Rapid Own-Source Revenue Analysis tool</p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <span class="badge-version">Version 2.0</span>
                <button class="btn-print-guide" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row">

        <!-- Sidebar TOC -->
        <div class="col-lg-3">
            <div class="toc-sidebar">
                <div class="toc-card">
                    <h6>Table of Contents</h6>
                    <nav>
                        <a href="#what-is-rosra" class="toc-link"><i class="bi bi-info-circle"></i> What is ROSRA?</a>
                        <a href="#getting-started" class="toc-link"><i class="bi bi-rocket-takeoff"></i> Getting Started</a>
                        <a href="#navigation" class="toc-link"><i class="bi bi-compass"></i> Navigation</a>
                        <a href="#creating-report" class="toc-link"><i class="bi bi-file-earmark-plus"></i> Creating a Report</a>
                        <a href="#visual-walkthrough" class="toc-link"><i class="bi bi-images"></i> Visual Walkthrough</a>
                        <a href="#quick-estimate" class="toc-link"><i class="bi bi-binoculars"></i> Quick Estimate <small class="text-muted">(macro)</small></a>
                        <a href="#detailed-diagnostic" class="toc-link"><i class="bi bi-zoom-in"></i> Detailed Diagnostic <small class="text-muted">(micro)</small></a>
                        <div class="toc-sub">
                            <a href="#step1-gap" class="toc-link"><i class="bi bi-1-circle"></i> Gap Analysis</a>
                            <a href="#step2-prioritize" class="toc-link"><i class="bi bi-2-circle"></i> Prioritization</a>
                            <a href="#step3-recommendations" class="toc-link"><i class="bi bi-3-circle"></i> Recommendations</a>
                        </div>
                        <a href="#dashboard" class="toc-link"><i class="bi bi-grid-1x2"></i> Your Dashboard</a>
                        <a href="#submitting" class="toc-link"><i class="bi bi-send"></i> Submitting Reports</a>
                        <a href="#review-process" class="toc-link"><i class="bi bi-clipboard-check"></i> Review Process</a>
                        <a href="#exporting" class="toc-link"><i class="bi bi-download"></i> Exporting & Printing</a>
                        <a href="#profile" class="toc-link"><i class="bi bi-person-gear"></i> Your Profile</a>
                        <a href="#languages" class="toc-link"><i class="bi bi-translate"></i> Language Support</a>
                        <a href="#glossary" class="toc-link"><i class="bi bi-book"></i> Glossary</a>
                        <a href="#faq" class="toc-link"><i class="bi bi-question-circle"></i> FAQ</a>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- 1. What is ROSRA? -->
            <section id="what-is-rosra" class="guide-section">
                <h2>
                    <span class="section-icon"><i class="bi bi-info-circle"></i></span>
                    What is ROSRA?
                </h2>
                <p>
                    <strong>ROSRA (Rapid Own-Source Revenue Analysis)</strong> is a diagnostic and planning tool developed by
                    <strong>UN-Habitat</strong> to help local governments assess and optimize their own-source revenue (OSR).
                    OSR is revenue that local governments generate independently &mdash; not from national transfers or grants.
                </p>
                <p>ROSRA analyses the following revenue streams:</p>
                <table class="guide-table">
                    <thead>
                        <tr><th>Revenue Type</th><th>Examples</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><strong>Property Tax</strong></td><td>Taxes levied on land and buildings</td></tr>
                        <tr><td><strong>Business Licenses</strong></td><td>Operating permits and trade license fees</td></tr>
                        <tr><td><strong>Short-Term User Charges</strong></td><td>Daily parking fees, market stall fees</td></tr>
                        <tr><td><strong>Long-Term User Charges</strong></td><td>Monthly leases, rental income</td></tr>
                        <tr><td><strong>Mixed User Charges</strong></td><td>Combinations of daily and monthly fees</td></tr>
                        <tr><td><strong>Non-Property Streams</strong></td><td>Any locally-specific non-property revenue source (fines, advertising levies, etc.)</td></tr>
                    </tbody>
                </table>
                <p>
                    The tool helps you identify where revenue is being lost, prioritize which streams to reform first,
                    and build an actionable recommendation plan.
                </p>
            </section>

            <!-- 2. Getting Started -->
            <section id="getting-started" class="guide-section">
                <h2>
                    <span class="section-icon"><i class="bi bi-rocket-takeoff"></i></span>
                    Getting Started
                </h2>

                <h3>Creating an Account</h3>
                <ol>
                    <li>Navigate to the ROSRA application home page.</li>
                    <li>Click <strong>Login</strong> in the top navigation bar.</li>
                    <li>Click the <strong>Register</strong> link on the login page.</li>
                    <li>Fill in your details:
                        <ul>
                            <li><strong>First Name</strong> and <strong>Last Name</strong></li>
                            <li><strong>Email Address</strong> &mdash; this will be your login username</li>
                            <li><strong>Organization</strong> (e.g., your municipality or agency)</li>
                            <li><strong>Phone Number</strong></li>
                            <li><strong>Password</strong> and confirmation</li>
                            <li><strong>Consent to be contacted</strong> for ROSRA follow-up, if needed</li>
                            <li><strong>Privacy/data-use acknowledgement</strong> before account creation</li>
                        </ul>
                    </li>
                    <li>Click <strong>Register</strong>. You will be automatically logged in.</li>
                </ol>

                <div class="guide-tip">
                    <i class="bi bi-shield-check"></i>
                    <strong>Privacy note:</strong> The consent and data-use acknowledgement confirm that ROSRA may use your account details and report metadata to support the assessment workflow. Report content you enter should be treated as official working data for your jurisdiction and shared only with users who are meant to review or administer the assessment.
                </div>

                <h3>Logging In</h3>
                <ol>
                    <li>Click <strong>Login</strong> in the navigation bar.</li>
