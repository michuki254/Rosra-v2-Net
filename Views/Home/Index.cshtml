@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- Hero Section -->
<div class="hero-container">
    <section id="hero" class="hero-section">
        <div class="hero-slides">
            <div class="hero-slide active">
                <img src="~/images/cities/nairobi.jpg" asp-append-version="true" alt="Nairobi, Kenya" />
            </div>
            <div class="hero-slide">
                <img src="~/images/cities/addis-ababa.jpg" asp-append-version="true" alt="Addis Ababa, Ethiopia" />
            </div>
            <div class="hero-slide">
                <img src="~/images/cities/lagos.jpg" asp-append-version="true" alt="Lagos, Nigeria" />
            </div>
            <div class="hero-slide">
                <img src="~/images/cities/dar-es-salaam.jpg" asp-append-version="true" alt="Dar es Salaam, Tanzania" />
            </div>
        </div>
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <h1 class="hero-title">@Localizer["Hero_Title"]</h1>
            <p class="hero-subtitle">@Localizer["Hero_Subtitle"]</p>
            <div class="hero-actions">
                <a asp-controller="Rosra" asp-action="NewReport" class="btn-hero-primary">@Localizer["Hero_StartAnalysis"]</a>
                <a asp-controller="Home" asp-action="SampleReports" class="btn-hero-secondary">@Localizer["Hero_ViewSampleReport"]</a>
            </div>
        </div>
        <div class="hero-indicators">
            <span class="indicator active" data-slide="0"></span>
            <span class="indicator" data-slide="1"></span>
            <span class="indicator" data-slide="2"></span>
            <span class="indicator" data-slide="3"></span>
        </div>
    </section>
</div>

<!-- How the ROSRA diagnostic works — process-flow diagram placed immediately after the hero -->
<section id="how-it-works" class="uh-section uh-section--light">
    <div class="container">
        <h2 class="uh-section-title">@Localizer["Flow_Title"]</h2>
        <p class="uh-section-subtitle">@Localizer["Flow_Body"]</p>

        @* ============================================================
           Process flow diagram — 5 cards (quick estimate, stream-specific
           gap analysis, prioritization, reform guidance, report output)
           plus a 4-segment phase timeline beneath. Built as HTML cards +
           inline SVG so it stays localizable, responsive, and prints clean.
           ============================================================ *@
        <div class="rosra-flow" role="img" aria-label="@Localizer["Diagram_AriaLabel"]">
            <div class="rosra-flow__cards">
                @* Card 1 — Quick potential estimate *@
                <div class="rosra-flow__card rosra-flow__card--cyan">
                    <div class="rosra-flow__num">1</div>
                    <h4 class="rosra-flow__title">@Localizer["Diagram_Card1_Title"]</h4>
                    <p class="rosra-flow__sub">@Localizer["Diagram_Card1_Sub"]</p>
                    <div class="rosra-flow__icon rosra-flow__icon--navy">
                        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect x="8"  y="40" width="9" height="16" rx="1.5" fill="currentColor"/>
                            <rect x="21" y="32" width="9" height="24" rx="1.5" fill="currentColor"/>
                            <rect x="34" y="24" width="9" height="32" rx="1.5" fill="currentColor"/>
                            <rect x="47" y="14" width="9" height="42" rx="1.5" fill="currentColor"/>
                            <path d="M6 30 L20 22 L34 16 L48 10 L56 6 M56 6 L50 6 M56 6 L56 12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </div>

                <svg class="rosra-flow__arrow" viewBox="0 0 40 40" aria-hidden="true">
                    <path d="M4 20 H30 M22 12 L30 20 L22 28" stroke="#0F2742" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                @* Card 2 — Stream-specific gap analysis (wide, with 3 sub-streams) *@
                <div class="rosra-flow__card rosra-flow__card--teal rosra-flow__card--wide">
                    <div class="rosra-flow__num rosra-flow__num--teal">2</div>
                    <h4 class="rosra-flow__title rosra-flow__title--teal">@Localizer["Diagram_Card2_Title"]</h4>
                    <p class="rosra-flow__sub">@Localizer["Diagram_Card2_Sub"]</p>
                    <div class="rosra-flow__streams">
                        <div class="rosra-flow__stream">
                            <div class="rosra-flow__stream-head">
                                <i class="fas fa-house" aria-hidden="true"></i>
                                <span>@Localizer["Diagram_PropertyTax"]</span>
                            </div>
                            <ul class="rosra-flow__gaps">
                                <li><i class="far fa-circle-dot" aria-hidden="true"></i>@Localizer["Diagram_Coverage"]</li>
                                <li><i class="fas fa-shield-halved" aria-hidden="true"></i>@Localizer["Diagram_Compliance"]</li>
                                <li><i class="fas fa-calculator" aria-hidden="true"></i>@Localizer["Diagram_LiabilityValuation"]</li>
                            </ul>
                        </div>
                        <div class="rosra-flow__stream">
                            <div class="rosra-flow__stream-head">
                                <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                                <span>@Localizer["Diagram_Licenses"]</span>
                            </div>
                            <ul class="rosra-flow__gaps">
                                <li><i class="far fa-circle-dot" aria-hidden="true"></i>@Localizer["Diagram_Coverage"]</li>
                                <li><i class="fas fa-shield-halved" aria-hidden="true"></i>@Localizer["Diagram_Compliance"]</li>
                                <li><i class="fas fa-calculator" aria-hidden="true"></i>@Localizer["Diagram_LiabilityValuation"]</li>
                            </ul>
                        </div>
                        <div class="rosra-flow__stream rosra-flow__stream--green">
                            <div class="rosra-flow__stream-head">
                                <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                                <span>@Localizer["Diagram_FeesCharges"]</span>
                            </div>
                            <ul class="rosra-flow__gaps">
                                <li><i class="far fa-circle-dot" aria-hidden="true"></i>@Localizer["Diagram_Coverage"]</li>
                                <li><i class="fas fa-shield-halved" aria-hidden="true"></i>@Localizer["Diagram_Compliance"]</li>
                                <li><i class="fas fa-calculator" aria-hidden="true"></i>@Localizer["Diagram_LiabilityValuation"]</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <svg class="rosra-flow__arrow" viewBox="0 0 40 40" aria-hidden="true">
                    <path d="M4 20 H30 M22 12 L30 20 L22 28" stroke="#0F2742" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                @* Card 3 — Prioritization *@
                <div class="rosra-flow__card rosra-flow__card--cyan">
                    <div class="rosra-flow__num">3</div>
                    <h4 class="rosra-flow__title">@Localizer["Diagram_Card3_Title"]</h4>
                    <p class="rosra-flow__sub">@Localizer["Diagram_Card3_Sub"]</p>
                    <ul class="rosra-flow__rank">
                        <li><span class="rosra-flow__rank-num">1</span><span class="rosra-flow__rank-bar rosra-flow__rank-bar--1"></span></li>
                        <li><span class="rosra-flow__rank-num">2</span><span class="rosra-flow__rank-bar rosra-flow__rank-bar--2"></span></li>
                        <li><span class="rosra-flow__rank-num">3</span><span class="rosra-flow__rank-bar rosra-flow__rank-bar--3"></span></li>
                    </ul>
                </div>

                <svg class="rosra-flow__arrow" viewBox="0 0 40 40" aria-hidden="true">
                    <path d="M4 20 H30 M22 12 L30 20 L22 28" stroke="#0F2742" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                @* Card 4 — Reform guidance *@
                <div class="rosra-flow__card rosra-flow__card--green">
                    <div class="rosra-flow__num rosra-flow__num--green">4</div>
                    <h4 class="rosra-flow__title rosra-flow__title--green">@Localizer["Diagram_Card4_Title"]</h4>
                    <p class="rosra-flow__sub">@Localizer["Diagram_Card4_Sub"]</p>
                    <div class="rosra-flow__icon rosra-flow__icon--navy">
                        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M30 6 H42 L50 14 L42 22 H30 Z" fill="#1F7B5A"/>
                            <path d="M34 26 H22 L14 34 L22 42 H34 Z" fill="#00B2E3"/>
                            <rect x="30" y="6"  width="4" height="52" fill="#0F2742"/>
                        </svg>
                    </div>
                </div>

                <svg class="rosra-flow__arrow" viewBox="0 0 40 40" aria-hidden="true">
                    <path d="M4 20 H30 M22 12 L30 20 L22 28" stroke="#0F2742" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                @* Card 5 — Report output (dashed) *@
                <div class="rosra-flow__card rosra-flow__card--report">
                    <div class="rosra-flow__icon rosra-flow__icon--teal">
                        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M14 6 H40 L52 18 V58 H14 Z" stroke="#1F7B5A" stroke-width="2.5" fill="#E6F4ED" stroke-linejoin="round"/>
                            <path d="M40 6 V18 H52" stroke="#1F7B5A" stroke-width="2.5" fill="none" stroke-linejoin="round"/>
                            <rect x="22" y="44" width="5" height="8" fill="#1F7B5A"/>
                            <rect x="30" y="38" width="5" height="14" fill="#1F7B5A"/>
                            <rect x="38" y="32" width="5" height="20" fill="#1F7B5A"/>
                        </svg>
                    </div>
                    <h4 class="rosra-flow__title rosra-flow__title--report">@Localizer["Diagram_Card5_Title"]</h4>
                </div>
            </div>

            @* Phase timeline below the cards *@
            <div class="rosra-flow__phases" aria-hidden="true">
                <div class="rosra-flow__phase rosra-flow__phase--cyan"><span class="rosra-flow__phase-label">@Localizer["Diagram_Phase1"]</span></div>
                <div class="rosra-flow__phase rosra-flow__phase--teal"><span class="rosra-flow__phase-label">@Localizer["Diagram_Phase2"]</span></div>
                <div class="rosra-flow__phase rosra-flow__phase--blue"><span class="rosra-flow__phase-label">@Localizer["Diagram_Phase3"]</span></div>
                <div class="rosra-flow__phase rosra-flow__phase--green"><span class="rosra-flow__phase-label">@Localizer["Diagram_Phase4"]</span></div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Rosra" asp-action="NewReport" class="uh-btn uh-btn--outline">@Localizer["HowItWorks_StartAnalysis"]</a>
        </div>
    </div>
</section>

